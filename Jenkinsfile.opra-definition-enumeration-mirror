              || { echo "FAIL: container $CONTAINER restarted between checks (startedAt $START1 -> $START2, restarts $RC1 -> $RC2) -- the mirror is crash-looping; last log:"; es4 "docker logs --tail 40 $CONTAINER 2>&1" || true; exit 1; }

