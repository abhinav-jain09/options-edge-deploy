# ---------------------------------------------------------------------------------------------
# REQ-5d parameters, applied DETERMINISTICALLY by checksetup on every boot rather than by hand.
# checksetup.pl is idempotent, so this file — not a human following a checklist — is what makes the
# portal's application state reproducible, and it is why a rebuild-from-empty rehearsal converges.
# ---------------------------------------------------------------------------------------------
$answer{'urlbase'}              = '@@BZ_URLBASE@@';

# env-SSO on the public listener, native CGI on the admin listener. The order matters: Env first, so
# a request that carries validated claim env vars authenticates through SSO, and one that does not
# (the admin listener) falls through to the native form.
$answer{'user_info_class'}      = 'Env,CGI';
$answer{'user_verify_class'}    = 'DB';

# Identity is keyed on the IMMUTABLE `sub` claim via Bugzilla's extern_id, never on email (which is
# mutable and can be reassigned). See REQ-5c and Bugzilla/Auth/Verify.pm:60-140 @ 276673ab6.
$answer{'auth_env_id'}          = 'OIDC_CLAIM_sub';
$answer{'auth_env_email'}       = 'OIDC_CLAIM_email';
$answer{'auth_env_realname'}    = 'OIDC_CLAIM_name';

# No anonymous surface at all, and no anonymous CGI self-signup. Verified from source: an empty
# createemailregexp does NOT block Env auto-provisioning — there is no reference to that param
# anywhere under Bugzilla/Auth/ at the pinned commit — so SSO users still auto-provision.
$answer{'requirelogin'}         = 1;
$answer{'createemailregexp'}    = '';

# Attachments live IN THE DATABASE, which is what makes the nightly mysqldump actually cover them
# (REQ-10a) and lets V-restore checksum attachment bytes. 10 MB is the bottom of the REQ-11 size
# chain: Bugzilla 10 MB < Apache 25 MB < the Cloudflare plan cap.
$answer{'maxlocalattachment'}   = 0;
$answer{'maxattachmentsize'}    = 10240;

# External users must not be able to enumerate each other; with no shared visibility group, the user
# directory and autocomplete surfaces are closed (REQ-5d matrix, user-enumeration rows).
$answer{'usevisibilitygroups'}  = 1;

# Private comments/attachments are unused, so the matrix's DENY rows for them are structural rather
# than policy. Upstream's template sets this to 'admin'; an empty value removes the feature.
$answer{'insidergroup'}         = '';

# Removes two fields the authorization matrix would otherwise have to govern, and makes `priority`
# a DENY cell for reporters — Bugzilla/Bug.pm:4650 checks letsubmitterchoosepriority by name.
$answer{'useqacontact'}         = 0;
$answer{'usetargetmilestone'}   = 0;
$answer{'letsubmitterchoosepriority'} = 0;
