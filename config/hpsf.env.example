# HPSF V2.1 Databento deployment defaults.
# HPSF is signal-only. Do not enable order placement flags.
APP_MARKET_DATA_SOURCE=DATABENTO
HPSF_ENABLED=true
HPSF_TOPOLOGY_ENABLED=true
HPSF_MODE=LIVE_SIGNAL_ONLY
HPSF_SCHEMA_VERSION=2
HPSF_ALGORITHM_VERSION=HPSF_V2.1
HPSF_CONFIG_VERSION=hpsf-v2.1-dev
KAFKA_BOOTSTRAP_SERVERS=192.168.100.252:9092
KAFKA_SCHEMA_REGISTRY_URL=http://192.168.100.252:8082
HPSF_STREAMS_REPLICATION_FACTOR=1
HPSF_STREAMS_NUM_STANDBY_REPLICAS=0
HPSF_STREAMS_STATE_DIR=/home/options-edge/data/kafka-streams/hpsf
HPSF_STATE_STORE_TYPE=memory
HPSF_STATE_CHANGELOG_ENABLED=true
HPSF_TOPIC_OPRA_TCBBO=options.opra.tcbbo
HPSF_TOPIC_UNDERLYING_ES_TRADES=underlying.es.trades
HPSF_TOPIC_UNDERLYING_SPX_PRICE=underlying.spx.price
HPSF_TOPIC_STRIKE_FLOW=options.hpsf.strike-flow
HPSF_TOPIC_STRIKE_SCORE=options.hpsf.strike-score
HPSF_TOPIC_SIGNAL=options.hpsf.signal
HPSF_TOPIC_LATEST_SIGNAL=options.hpsf.latest-signal
HPSF_TOPIC_AUDIT=options.hpsf.audit
HPSF_TOPIC_DLQ=options.hpsf.dlq
HPSF_TOPIC_WRITER_DLQ=options.hpsf.writer-dlq
HPSF_TOPIC_EXIT_SIGNAL=options.hpsf.exit-signal
HPSF_ORDER_PLACEMENT_ENABLED=false
ORDER_PLACEMENT_ENABLED=false
IBKR_ORDER_PLACEMENT_ENABLED=false
