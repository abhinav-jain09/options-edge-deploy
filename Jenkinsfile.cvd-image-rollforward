// Image-only CVD reader roll-forward. Existing workloads only; never creates or scales.
pipeline {
  agent { label 'local-mac' }
  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true, description: 'Required exact current deploy main commit.')
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: '2f6fc2ab7aa51eb8a9e8aa350f2d774cd2fb7a253de2591e43645a19a9886b24', description: 'Canonical guard digest; do not edit manually.')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'production'], description: 'Existing target cluster; fixed deployer identity and namespace UID.')
    choice(name: 'SERVICE', choices: ['context-tape', 'gamma-migration', 'close-direction', 'early-auction-verdict', 'es-compression-expansion', 'es-open-direction', 'es-open-direction-postgres-writer', 'es-spx-align', 'level-absorption', 'amt-order-bridge'], description: 'Existing CVD reader; no Home GEX or Indicator/Market Structure change.')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: true, description: 'Server admission only, no runtime patch.')
    booleanParam(name: 'CVD_READER_CLOSURE_CONFIRMED', defaultValue: false, description: 'Required for active workloads: all downstream readers, schemas and native runtime qualification complete. Zero holds stay zero.')
  }
  options { disableRestartFromStage(); disableConcurrentBuilds(); timeout(time: 25, unit: 'MINUTES') }
  stages {
    stage('Permitted commit guard') {
      options { timeout(time: 10, unit: 'MINUTES') }
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — no deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }
    stage('Validate and roll selected image') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' } }
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          sh 'PERMITTED_SHA="${PERMITTED_SHA:?}" bash scripts/jenkins/verify-permitted-tree.sh --dir . --allow-ignored .jenkins-tmp'
        }
        sh 'PYTHONDONTWRITEBYTECODE=1 python3 -m unittest tests.test_es4_pinned_image tests.test_cvd_reader_image tests.test_cvd_component_source_proof'
        timeout(time: 10, unit: 'MINUTES') {
          sh 'PERMITTED_SHA="${PERMITTED_SHA:?}" bash scripts/jenkins/verify-permitted-tree.sh --dir . --allow-ignored .jenkins-tmp'
        }
        sh 'PYTHONDONTWRITEBYTECODE=1 python3 scripts/deploy/cvd-image-rollforward.py'
      }
    }
  }
  post { always { archiveArtifacts artifacts: ".jenkins-tmp/es4-image-${env.BUILD_NUMBER}/receipt.json,.jenkins-tmp/es4-image-${env.BUILD_NUMBER}/patch.json", allowEmptyArchive: true } }
}
