// Daily 0DTE clean-slate Kafka/Streams reset for OptionsEdge prod.
//
// Runs the committed scripts/ops/daily-kafka-reset.sh ON the prod host (over SSH
// from the Jenkins agent), so all kubectl + kafka admin operations execute
// locally next to the brokers and the API — avoiding the flaky agent->prod link.
//
// SAFE BY DEFAULT: scheduled runs are DRY_RUN=true (they only log what they
// would reset). Flip DRY_RUN=false to actually wipe Streams state + prune junk.
//
// The reset uses `kubectl rollout restart` (rolling) — it never scales a
// deployment to 0 replicas, so a transient k8s API blip cannot leave prod down.
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    booleanParam(name: 'DRY_RUN', defaultValue: true,
      description: 'Dry-run: log what would be reset/deleted without changing anything. Uncheck to run live.')
    string(name: 'PROD_HOST', defaultValue: 'abhinav@192.168.100.252',
      description: 'SSH target where the reset runs locally (Kafka + k3s are local there).')
  }
  triggers {
    // 22:30 prod time (after US 0DTE close). Scheduled runs use default params (DRY_RUN=true).
    cron('30 22 * * *')
  }
  options {
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }
  environment {
    PROD_HOST = "${params.PROD_HOST}"
    DRY_RUN   = "${params.DRY_RUN}"
  }
  stages {
    stage('Run reset on prod') {
      steps {
        // One scp + one ssh (minimise connections to avoid the prod SSH rate-limiter).
        sh '''
          set -euo pipefail
          scp -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
            scripts/ops/daily-kafka-reset.sh "${PROD_HOST}:/home/abhinav/daily-kafka-reset.sh"
          echo "Running daily-kafka-reset on ${PROD_HOST} (DRY_RUN=${DRY_RUN})"
          ssh -o BatchMode=yes "${PROD_HOST}" \
            "chmod +x ~/daily-kafka-reset.sh && DRY_RUN=${DRY_RUN} ~/daily-kafka-reset.sh"
        '''
      }
    }
  }
  post {
    failure {
      echo 'Daily Kafka reset failed. If this was a live run, verify prod app replicas: kubectl -n options-edge get deploy'
    }
  }
}
