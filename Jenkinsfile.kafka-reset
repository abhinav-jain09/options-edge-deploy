// Daily 0DTE clean-slate Kafka/Streams reset for OptionsEdge prod.
//
// Runs the committed scripts/ops/daily-kafka-reset.sh ON the prod host (over SSH
// from the Jenkins agent), so all kubectl + kafka admin operations execute
// locally next to the brokers and the API — avoiding the flaky agent->prod link.
//
// SAFE BY DEFAULT: scheduled runs are DRY_RUN=true (they only log what they
// would reset). Flip DRY_RUN=false to actually wipe Streams state + prune junk.
//
// The reset uses `kubectl rollout restart` (rolling) — it never scales a
// deployment to 0 replicas, so a transient k8s API blip cannot leave prod down.
//
// RETIRED 2026-06-30 (off-hours clean-slate, decision #4): the gentle "keep
// real-data topics" daily reset is SUPERSEDED by the aggressive off-hours
// clean-slate (scripts/ops/offhours-clean-slate.sh / Jenkinsfile.offhours-clean-slate),
// which deletes state topics, purges ALL data topics to 0, clears the Streams
// PVCs, and truncates the flow DB. To avoid two jobs fighting over the same
// cluster, this job's nightly cron trigger is DISABLED — it remains runnable
// MANUALLY (for ad-hoc Streams-state pruning) but no longer self-fires.
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before any effect unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`.')
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: 'd2a653cfeb2e8ef7103e5590db93e9004adcb20673972f373617b63301ee6784',
      description: 'DO NOT EDIT BY HAND — the sha256 of scripts/jenkins/permitted-sha-guard.sh this definition runs (Deployment Permission Rule). The guard refuses to run under any other value. It is a DECLARATION, not proof that this job enforces the guard: a caller that triggers this job judges its SCM definition and its Jenkinsfile at the forwarded commit (scripts/jenkins/require-guarded-downstream.sh). Regenerate with scripts/jenkins/permitted-sha-guard-version.sh when the guard changes.')
    booleanParam(name: 'DRY_RUN', defaultValue: true,
      description: 'Dry-run: log what would be reset/deleted without changing anything. Uncheck to run live.')
    string(name: 'PROD_HOST', defaultValue: 'abhinav@192.168.100.252',
      description: 'SSH target where the reset runs locally (Kafka + k3s are local there).')
  }
  // triggers {} — DISABLED. Retired in favour of the off-hours clean-slate (see
  // header). No cron: this job no longer self-fires; it is manual-only now.
  options {
    disableRestartFromStage()   // Deployment Permission Rule: no "Restart from Stage" past the permitted-commit guard
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }
  environment {
    PROD_HOST = "${params.PROD_HOST}"
    DRY_RUN   = "${params.DRY_RUN}"
  }
  stages {
    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    // PERMITTED_SHA is REQUIRED. scripts/jenkins/permitted-sha-guard.sh refuses, in this order: a checkout
    // that is not on origin/main (the environment-branch restriction, kept as its own condition); a
    // missing, empty, short or otherwise malformed PERMITTED_SHA (nothing is substituted for it); a
    // checked-out HEAD that is not exactly PERMITTED_SHA. It runs FIRST, in the workspace every later
    // stage uses, so nothing below can build, push, apply, roll, restart, create a topic or copy a file
    // under an unpermitted commit — including a build queued for one commit that checked out a newer one.
    // error(), never catchError: a refusal is a stop, not a coloured result. Both SHAs are in the log.
    stage('Permitted commit guard') {
      options { timeout(time: 10, unit: 'MINUTES') }
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }
    stage('Run reset on prod') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' } }
      steps {
        // One scp + one ssh (minimise connections to avoid the prod SSH rate-limiter). The scp ships a file of the source
        // tree, so it is a DEDICATED step (its whole body is the one command) right after the verify of that tree
        // (Deployment Permission Rule, validator rule 9b): nothing can run between the verification and the copy.
        timeout(time: 10, unit: 'MINUTES') {
          sh 'PERMITTED_SHA="${PERMITTED_SHA:-}" bash scripts/jenkins/verify-permitted-tree.sh --dir . --allow-ignored target --allow-ignored .jenkins-tmp'
        }
        sh 'scp -o BatchMode=yes -o StrictHostKeyChecking=accept-new scripts/ops/daily-kafka-reset.sh "${PROD_HOST}:/home/abhinav/daily-kafka-reset.sh"'
        sh '''
          set -euo pipefail
          echo "Running daily-kafka-reset on ${PROD_HOST} (DRY_RUN=${DRY_RUN})"
          ssh -o BatchMode=yes "${PROD_HOST}" \
            "chmod +x ~/daily-kafka-reset.sh && DRY_RUN=${DRY_RUN} ~/daily-kafka-reset.sh"
        '''
      }
    }
  }
  post {
    failure {
      echo 'Daily Kafka reset failed. If this was a live run, verify prod app replicas: kubectl -n options-edge get deploy'
    }
  }
}
