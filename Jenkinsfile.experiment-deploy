@Library('oe') _

// Experiment (.2 native Mac) deploy — lean, separate from the heavyweight options-edge-deploy.
//
// WHY SEPARATE: options-edge-deploy digest-pins/preflights every image by querying the registry FROM
// the Jenkins agent. .2's registry (host.docker.internal:5001) is node-local on .2 and NOT reachable
// from the dev-Mac agent, so that model can't run for experiment. Instead, the experiment build jobs
// push mutable :dev images to .2's local registry; this job just `kubectl apply -k`s the experiment
// overlay (which references those :dev images with imagePullPolicy: Always) to .2's Docker-Desktop k8s
// and rollout-restarts so the new images are pulled. .2 mirrors the dev Mac, so the overlay is the dev
// overlay with the Keycloak issuer pointed at 192.168.100.2.
//
// CONNECTIVITY: the deploy talks to .2's k8s API through an SSH tunnel (key auth — no password needed
// for ssh/kubectl here; the .2 keychain password is only needed by the BUILD jobs for `docker push`).
// Docker-Desktop's kube API port on .2 is DYNAMIC, so we discover it over ssh and open a fresh tunnel
// to it on LOCAL_TUNNEL_PORT, which oeProfile('experiment').kubeconfigDeployer points at (127.0.0.1:16443).

pipeline {
  agent { label 'hpsf-replay-mac' }   // the dev-Mac Jenkins agent (same as options-edge-deploy)
  options { disableConcurrentBuilds() }
  parameters {
    string(name: 'SSH_TARGET', defaultValue: 'AMSKEL@192.168.100.2',
           description: 'SSH user@host of the .2 box (key auth). Used to discover the kube API port + open the tunnel.')
    string(name: 'LOCAL_TUNNEL_PORT', defaultValue: '16443',
           description: 'Local port for the .2 k8s API tunnel — must match the server in oeProfile.kubeconfigDeployer.')
    string(name: 'ROLLOUT_TIMEOUT', defaultValue: '300s', description: 'rollout status timeout for the web pod.')
    string(name: 'DATABENTO_API_KEY_CREDENTIAL_ID', defaultValue: 'options-edge-databento-api-key',
           description: 'Jenkins Secret-text credential id for the Databento API key (used to materialise options-edge-databento-feed-env).')
    string(name: 'SMOKE_AUTH_PASSWORD_CREDENTIAL_ID', defaultValue: 'options-edge-smoke-password',
           description: 'OPTIONAL Jenkins Secret-text credential id for the synthetic-auth smoke user. If absent, the runtime-secrets Secret is still created with an empty SMOKE_AUTH_PASSWORD.')
  }
  environment {
    ENVIRONMENT = 'experiment'
  }
  stages {
    stage('Resolve profile') {
      steps {
        script {
          def p = oeProfile('experiment')          // single source of truth
          env.KUBECONFIG = p.kubeconfigDeployer     // server: https://127.0.0.1:16443 (the tunnel)
          env.NAMESPACE  = p.namespace
          echo "experiment deploy: ns=${env.NAMESPACE} kubeconfig=${env.KUBECONFIG}"
        }
      }
    }

    stage('Open .2 k8s tunnel') {
      steps {
        sh '''
          set -eu
          case "$SSH_TARGET"        in -*|*[!a-zA-Z0-9._@-]*|'') echo "invalid SSH_TARGET: '$SSH_TARGET'" >&2; exit 1 ;; esac
          case "$LOCAL_TUNNEL_PORT" in ''|*[!0-9]*)              echo "invalid LOCAL_TUNNEL_PORT: '$LOCAL_TUNNEL_PORT'" >&2; exit 1 ;; esac
          DOCKER_KUBECTL=/Applications/Docker.app/Contents/Resources/bin/kubectl
          # Docker-Desktop's kube API port on .2 is dynamic — discover the current one over ssh.
          api="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$SSH_TARGET" "$DOCKER_KUBECTL config view --minify -o jsonpath='{.clusters[0].cluster.server}'")"
          port="${api##*:}"
          case "$port" in ''|*[!0-9]*) echo "FATAL: could not parse .2 kube API port from '$api'" >&2; exit 1 ;; esac
          echo "discovered .2 kube API at $api -> tunneling 127.0.0.1:$LOCAL_TUNNEL_PORT"
          # Replace any stale tunnel on this local port, then open a fresh background one.
          pkill -f "ssh.*-L 127.0.0.1:$LOCAL_TUNNEL_PORT:127.0.0.1:" 2>/dev/null || true
          ssh -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -f -N \
            -L "127.0.0.1:$LOCAL_TUNNEL_PORT:127.0.0.1:$port" "$SSH_TARGET"
          for i in 1 2 3 4 5 6 7 8; do nc -z 127.0.0.1 "$LOCAL_TUNNEL_PORT" 2>/dev/null && break; sleep 1; done
          kubectl --kubeconfig "$KUBECONFIG" get nodes
        '''
      }
    }

    // The experiment overlay's pods reference options-edge-runtime-secrets (POSTGRES_PASSWORD,
    // SMOKE_AUTH_PASSWORD) and options-edge-databento-feed-env (DATABENTO_API_KEY). Without these the
    // pods enter CreateContainerConfigError and nothing starts. We materialise them here from
    // Jenkins-bound credentials BEFORE the kustomize apply, using the same dry-run|apply idempotent
    // pattern as options-edge-deploy (so re-running the job is safe and updates secrets in place).
    // Mirrors the main Jenkinsfile's 'Secrets' stage, scoped to the secrets the experiment overlay
    // actually consumes (Keycloak is production-only and intentionally omitted).
    stage('Secrets') {
      steps {
        script {
          def baseBindings = [
            string(credentialsId: params.DATABENTO_API_KEY_CREDENTIAL_ID, variable: 'DATABENTO_API_KEY')
          ]
          def applySecrets = {
            sh '''
              set -euo pipefail
              test -n "$DATABENTO_API_KEY"
              # Feed secret material via 0600 mktemp env-files (NOT --from-literal, which puts the values
              # in the kubectl process argv where anyone on the agent can ps them — the same pattern the
              # main Jenkinsfile uses for the Keycloak Secret). Trap-cleans the files even on error.
              umask 077
              rtEnv="$(mktemp)"; fdEnv="$(mktemp)"
              trap 'rm -f "$rtEnv" "$fdEnv"' EXIT
              # These secrets have env-shaped keys, so --from-env-file works.
              printf 'POSTGRES_PASSWORD=%s\nSMOKE_AUTH_PASSWORD=%s\n' \
                "${POSTGRES_PASSWORD:-Options#100}" "${SMOKE_AUTH_PASSWORD:-}" > "$rtEnv"
              printf 'DATABENTO_API_KEY=%s\n' "$DATABENTO_API_KEY" > "$fdEnv"
              kubectl --kubeconfig "$KUBECONFIG" create namespace "$NAMESPACE" --dry-run=client -o yaml \
                | kubectl --kubeconfig "$KUBECONFIG" apply -f -
              kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" create secret generic options-edge-runtime-secrets \
                --from-env-file="$rtEnv" \
                --dry-run=client -o yaml | kubectl --kubeconfig "$KUBECONFIG" apply -f -
              kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" create secret generic options-edge-databento-feed-env \
                --from-env-file="$fdEnv" \
                --dry-run=client -o yaml | kubectl --kubeconfig "$KUBECONFIG" apply -f -
            '''
          }
          def smokeId = params.SMOKE_AUTH_PASSWORD_CREDENTIAL_ID?.trim()
          boolean haveSmoke = false
          if (smokeId) {
            try {
              withCredentials([string(credentialsId: smokeId, variable: 'SMOKE_AUTH_PASSWORD')]) { /* probe */ }
              haveSmoke = true
            } catch (ignored) {
              echo "WARN: smoke-auth credential '${smokeId}' not found; creating options-edge-runtime-secrets with an EMPTY SMOKE_AUTH_PASSWORD. The synthetic auth check will fail until the credential is created."
            }
          }
          if (haveSmoke) {
            withCredentials(baseBindings + [string(credentialsId: smokeId, variable: 'SMOKE_AUTH_PASSWORD')]) { applySecrets() }
          } else {
            withCredentials(baseBindings) { applySecrets() }
          }
        }
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          set -eu
          # Apply the full experiment overlay (creates ns + all ~26 services from the :dev images the
          # build jobs pushed to .2's local registry). rollout restart forces a re-pull of :dev on redeploys
          # (imagePullPolicy: Always); on a first apply the pods pull :dev immediately and the restart is a no-op.
          kubectl --kubeconfig "$KUBECONFIG" apply -k k8s/overlays/experiment
          # Reconcile resources REMOVED from the overlay over time. `kubectl apply -k` only creates/updates;
          # it does NOT delete resources that USED to be in the overlay and were later excluded. Without
          # this step their Deployments would still be in the cluster, `rollout restart deploy` below would
          # restart them, and their pods would sit in ImagePullBackOff forever because the build job no
          # longer builds their image. ibkr-feed-service (no IBKR on .2) and options-edge-integration-test
          # (no synthetic tester on .2) are excluded by the experiment overlay; reconcile-delete them
          # idempotently here (--ignore-not-found, so this is a no-op once the cluster is clean). Add to
          # this list when removing a workload from the experiment overlay.
          kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" delete --ignore-not-found=true \
            deployment/ibkr-feed-service deployment/options-edge-integration-test \
            service/ibkr-feed-service service/options-edge-integration-test
          kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" rollout restart deploy
          echo "--- waiting for the web pod (the Option Chain page) ---"
          kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" rollout status deploy/options-edge-web --timeout="$ROLLOUT_TIMEOUT"
          echo "Experiment deploy applied to .2."
          kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" get deploy
        '''
      }
    }
  }

  post {
    always {
      sh 'pkill -f "ssh.*-L 127.0.0.1:${LOCAL_TUNNEL_PORT:-16443}:127.0.0.1:" 2>/dev/null || true'
    }
  }
}
