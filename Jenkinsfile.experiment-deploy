@Library('oe') _

// Experiment (.2 native Mac) deploy — lean, separate from the heavyweight options-edge-deploy.
//
// WHY SEPARATE: options-edge-deploy digest-pins/preflights every image by querying the registry FROM
// the Jenkins agent. .2's registry (host.docker.internal:5001) is node-local on .2 and NOT reachable
// from the dev-Mac agent, so that model can't run for experiment. Instead, the experiment build jobs
// push mutable :dev images to .2's local registry; this job just `kubectl apply -k`s the experiment
// overlay (which references those :dev images with imagePullPolicy: Always) to .2's Docker-Desktop k8s
// and rollout-restarts so the new images are pulled. .2 mirrors the dev Mac, so the overlay is the dev
// overlay with the Keycloak issuer pointed at 192.168.100.2.
//
// CONNECTIVITY: the deploy talks to .2's k8s API through an SSH tunnel (key auth — no password needed
// for ssh/kubectl here; the .2 keychain password is only needed by the BUILD jobs for `docker push`).
// Docker-Desktop's kube API port on .2 is DYNAMIC, so we discover it over ssh and open a fresh tunnel
// to it on LOCAL_TUNNEL_PORT, which oeProfile('experiment').kubeconfigDeployer points at (127.0.0.1:16443).

pipeline {
  agent { label 'hpsf-replay-mac' }   // the dev-Mac Jenkins agent (same as options-edge-deploy)
  options { timestamps(); disableConcurrentBuilds() }
  parameters {
    string(name: 'SSH_TARGET', defaultValue: 'AMSKEL@192.168.100.2',
           description: 'SSH user@host of the .2 box (key auth). Used to discover the kube API port + open the tunnel.')
    string(name: 'LOCAL_TUNNEL_PORT', defaultValue: '16443',
           description: 'Local port for the .2 k8s API tunnel — must match the server in oeProfile.kubeconfigDeployer.')
    string(name: 'ROLLOUT_TIMEOUT', defaultValue: '300s', description: 'rollout status timeout for the web pod.')
  }
  environment {
    ENVIRONMENT = 'experiment'
  }
  stages {
    stage('Resolve profile') {
      steps {
        script {
          def p = oeProfile('experiment')          // single source of truth
          env.KUBECONFIG = p.kubeconfigDeployer     // server: https://127.0.0.1:16443 (the tunnel)
          env.NAMESPACE  = p.namespace
          echo "experiment deploy: ns=${env.NAMESPACE} kubeconfig=${env.KUBECONFIG}"
        }
      }
    }

    stage('Open .2 k8s tunnel') {
      steps {
        sh '''
          set -eu
          case "$SSH_TARGET"        in -*|*[!a-zA-Z0-9._@-]*|'') echo "invalid SSH_TARGET: '$SSH_TARGET'" >&2; exit 1 ;; esac
          case "$LOCAL_TUNNEL_PORT" in ''|*[!0-9]*)              echo "invalid LOCAL_TUNNEL_PORT: '$LOCAL_TUNNEL_PORT'" >&2; exit 1 ;; esac
          DOCKER_KUBECTL=/Applications/Docker.app/Contents/Resources/bin/kubectl
          # Docker-Desktop's kube API port on .2 is dynamic — discover the current one over ssh.
          api="$(ssh -o BatchMode=yes -o ConnectTimeout=15 "$SSH_TARGET" "$DOCKER_KUBECTL config view --minify -o jsonpath='{.clusters[0].cluster.server}'")"
          port="${api##*:}"
          case "$port" in ''|*[!0-9]*) echo "FATAL: could not parse .2 kube API port from '$api'" >&2; exit 1 ;; esac
          echo "discovered .2 kube API at $api -> tunneling 127.0.0.1:$LOCAL_TUNNEL_PORT"
          # Replace any stale tunnel on this local port, then open a fresh background one.
          pkill -f "ssh.*-L 127.0.0.1:$LOCAL_TUNNEL_PORT:127.0.0.1:" 2>/dev/null || true
          ssh -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -f -N \
            -L "127.0.0.1:$LOCAL_TUNNEL_PORT:127.0.0.1:$port" "$SSH_TARGET"
          for i in 1 2 3 4 5 6 7 8; do nc -z 127.0.0.1 "$LOCAL_TUNNEL_PORT" 2>/dev/null && break; sleep 1; done
          kubectl --kubeconfig "$KUBECONFIG" get nodes
        '''
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          set -eu
          # Apply the full experiment overlay (creates ns + all ~26 services from the :dev images the
          # build jobs pushed to .2's local registry). rollout restart forces a re-pull of :dev on redeploys
          # (imagePullPolicy: Always); on a first apply the pods pull :dev immediately and the restart is a no-op.
          kubectl --kubeconfig "$KUBECONFIG" apply -k k8s/overlays/experiment
          kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" rollout restart deploy
          echo "--- waiting for the web pod (the Option Chain page) ---"
          kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" rollout status deploy/options-edge-web --timeout="$ROLLOUT_TIMEOUT"
          echo "Experiment deploy applied to .2."
          kubectl --kubeconfig "$KUBECONFIG" -n "$NAMESPACE" get deploy
        '''
      }
    }
  }

  post {
    always {
      sh 'pkill -f "ssh.*-L 127.0.0.1:${LOCAL_TUNNEL_PORT:-16443}:127.0.0.1:" 2>/dev/null || true'
    }
  }
}
