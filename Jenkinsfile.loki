// Deploy Loki + Promtail to a cluster via the Ansible playbook (ansible/loki-stack.yml).
// Production changes go through THIS job (Jenkins + Ansible), never kubectl/helm by hand.
//
// CONFIRM_DEPLOY=false  -> validate + render + helm-template only (a dry plan, applies nothing)
// CONFIRM_DEPLOY=true   -> helm upgrade --install into the target cluster
pipeline {
  agent { label 'local-mac' }
  options { disableRestartFromStage(); disableConcurrentBuilds(); skipDefaultCheckout(false) }

  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before any effect unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`.')
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: 'a3d2b9492162a2a6c92914ab17e6df5514ae6ecaaa7988dbab61b57a36160275',
      description: 'DO NOT EDIT BY HAND — the sha256 of scripts/jenkins/permitted-sha-guard.sh this job enforces (Deployment Permission Rule). The guard refuses to run under any other value, so this default, once registered by a run of this definition, is evidence to callers that this job executes THIS guard; a caller refuses to trigger a job whose registered default differs from its own. Regenerate with scripts/jenkins/permitted-sha-guard-version.sh when the guard changes.')
    choice(name: 'DEPLOY_ENVIRONMENT', choices: ['prod', 'staging', 'dev'],
           description: 'Target cluster/environment.')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
           description: 'Path (on the agent) or credential to the TARGET cluster kubeconfig — the prod k3s on A/B for prod.')
    string(name: 'LOKI_NAMESPACE', defaultValue: 'loki',
           description: 'Namespace for Loki/Promtail (must differ from the live namespace).')
    string(name: 'LOKI_RETENTION_HOURS', defaultValue: '168', description: 'Log retention in hours (default 7d).')
    booleanParam(name: 'CONFIRM_DEPLOY', defaultValue: false,
           description: 'OFF = validate/plan only. ON = helm upgrade --install (actually deploys).')
  }

  stages {
    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    // PERMITTED_SHA is REQUIRED. scripts/jenkins/permitted-sha-guard.sh refuses, in this order: a checkout
    // that is not on origin/main (the environment-branch restriction, kept as its own condition); a
    // missing, empty, short or otherwise malformed PERMITTED_SHA (nothing is substituted for it); a
    // checked-out HEAD that is not exactly PERMITTED_SHA. It runs FIRST, in the workspace every later
    // stage uses, so nothing below can build, push, apply, roll, restart, create a topic or copy a file
    // under an unpermitted commit — including a build queued for one commit that checked out a newer one.
    // error(), never catchError: a refusal is a stop, not a coloured result. Both SHAs are in the log.
    stage('Permitted commit guard') {
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }
    stage('Validate tooling') {
      steps {
        sh '''
          set -euo pipefail
          ansible-playbook --version | head -1
          helm version --short
          kubectl version --client=true | head -1
        '''
      }
    }
    stage('Deploy Loki/Promtail (Ansible)') {
      steps {
        sh '''
          set -euo pipefail
          # Defaults so `set -u` is safe even if a parameter env var is missing.
          DEPLOY_ENVIRONMENT="${DEPLOY_ENVIRONMENT:-prod}"
          LOKI_NAMESPACE="${LOKI_NAMESPACE:-loki}"
          LOKI_RETENTION_HOURS="${LOKI_RETENTION_HOURS:-168}"
          CONFIRM_DEPLOY="${CONFIRM_DEPLOY:-false}"
          KUBECONFIG_FILE="${KUBECONFIG_FILE:-}"
          if [ -n "${KUBECONFIG_FILE}" ]; then export KUBECONFIG="${KUBECONFIG_FILE}"; fi
          echo "Target: env=${DEPLOY_ENVIRONMENT} ns=${LOKI_NAMESPACE} confirm=${CONFIRM_DEPLOY}"
          ansible-playbook ansible/loki-stack.yml \
            -e deploy_environment="${DEPLOY_ENVIRONMENT}" \
            -e loki_namespace="${LOKI_NAMESPACE}" \
            -e loki_retention_hours="${LOKI_RETENTION_HOURS}" \
            -e confirm_loki_deploy="${CONFIRM_DEPLOY}"
        '''
      }
    }
  }
  post {
    success { echo "Loki/Promtail: ${params.CONFIRM_DEPLOY ? 'deployed' : 'validated (plan only)'} to ${params.DEPLOY_ENVIRONMENT}." }
    failure { echo "Loki/Promtail deploy failed for ${params.DEPLOY_ENVIRONMENT} — see the Ansible output above." }
  }
}
