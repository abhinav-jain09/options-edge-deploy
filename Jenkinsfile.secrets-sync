@Library('oe') _

// SECRETS SYNC — apply ONLY the runtime secrets for one environment, from Jenkins credentials.
//
// Why this job exists: `options-edge-runtime-secrets` is written exclusively by the monolith
// `options-edge-deploy`, whose run also pauses the runtime, cleans Kafka, re-applies topics and
// redeploys every service. Adding ONE key to a secret therefore cost a full-estate deploy — the
// wrong tool, and on production a genuinely risky one. Direct kubectl is not an option either: the
// options-edge-jenkins-only-workloads admission policy (correctly) rejects anything that is not the
// Jenkins deployer ServiceAccount.
//
// So: same secret, same credential bindings, same deployer kubeconfig as the monolith — and nothing
// else. Idempotent (create --dry-run=client | apply), no workload is restarted. A pod only picks up
// a changed secret when it restarts, so follow with `service-rollout-restart` for the services that
// read the changed key (the log prints the exact command).
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    choice(name: 'ENVIRONMENT', choices: ['dev', 'production'],
      description: 'Target environment — selects the deployer kubeconfig (oeProfile).')
    booleanParam(name: 'DRY_RUN', defaultValue: false,
      description: 'Validate against the API server without changing anything (kubectl --dry-run=server).')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
    string(name: 'OE_WATCH_READER_PASSWORD_CREDENTIAL_ID', defaultValue: '',
      description: 'Secret-text credential with the oe_watch_reader password (System Status ledger read). Blank resolves per environment: oe-watch-reader-password-dev / oe-watch-reader-password.')
    string(name: 'SMOKE_AUTH_PASSWORD_CREDENTIAL_ID', defaultValue: 'options-edge-smoke-password',
      description: 'Secret-text credential with the smoke dummy-user password. Missing => the key is written empty.')
    string(name: 'ANTHROPIC_API_KEY_CREDENTIAL_ID', defaultValue: 'options-edge-anthropic-api-key',
      description: 'Secret-text credential with the Anthropic API key. Missing => the key is written empty.')
  }
  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 15, unit: 'MINUTES')
  }
  environment {
    NAMESPACE  = 'options-edge'
    KUBECONFIG = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
  }
  stages {
    stage('Sync runtime secrets') {
      steps {
        script {
          // Every credential is OPTIONAL and degrades to an empty value, exactly as the monolith
          // does: a missing credential must not break the whole secret (and therefore every service
          // that reads a different key from it). Each absence is logged loudly instead.
          def bindings = []
          def optional = [
            [param: params.OE_WATCH_READER_PASSWORD_CREDENTIAL_ID?.trim()
                      ?: (params.ENVIRONMENT == 'production' ? 'oe-watch-reader-password'
                                                             : 'oe-watch-reader-password-dev'),
             var: 'OE_WATCH_READER_PASSWORD',
             impact: 'the System Status page reports LEDGER UNAVAILABLE'],
            [param: params.SMOKE_AUTH_PASSWORD_CREDENTIAL_ID?.trim(),
             var: 'SMOKE_AUTH_PASSWORD',
             impact: 'the synthetic auth check fails'],
            [param: params.ANTHROPIC_API_KEY_CREDENTIAL_ID?.trim(),
             var: 'ANTHROPIC_API_KEY',
             impact: 'short-premium-agent (SP_BACKEND=sdk) fails auth'],
          ]
          for (c in optional) {
            if (!c.param) { continue }
            try {
              withCredentials([string(credentialsId: c.param, variable: c.var)]) { /* probe */ }
              bindings << string(credentialsId: c.param, variable: c.var)
            } catch (ignored) {
              echo "WARN: credential '${c.param}' not found; ${c.var} will be written EMPTY — ${c.impact}."
            }
          }
          withCredentials(bindings) {
            sh '''
              set -euo pipefail
              apply_args=""
              if [ "${DRY_RUN:-false}" = "true" ]; then
                apply_args="--dry-run=server"
                echo "DRY_RUN=true: validating against the API server without changing anything."
              fi
              echo "Syncing ${NAMESPACE}/options-edge-runtime-secrets in ${ENVIRONMENT}"
              kubectl -n "$NAMESPACE" create secret generic options-edge-runtime-secrets \
                --from-literal=POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-Options#100}" \
                --from-literal=SMOKE_AUTH_PASSWORD="${SMOKE_AUTH_PASSWORD:-}" \
                --from-literal=ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}" \
                --from-literal=OE_WATCH_READER_PASSWORD="${OE_WATCH_READER_PASSWORD:-}" \
                --dry-run=client -o yaml | kubectl apply $apply_args -f -
              echo "Keys now present (names only, never values):"
              kubectl -n "$NAMESPACE" get secret options-edge-runtime-secrets \
                -o go-template='{{range $k, $v := .data}}{{$k}}{{"\\n"}}{{end}}' | sort | sed 's/^/  /'
            '''
          }
          echo "A running pod keeps the OLD value until it restarts. To pick this up, run " +
               "service-rollout-restart for the affected service, e.g. SERVICE=feed-gateway " +
               "ENVIRONMENT=${params.ENVIRONMENT} (kubectl-free pod recycle)."
        }
      }
    }
  }
}
