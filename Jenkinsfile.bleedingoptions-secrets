@Library('oe') _

// BLEEDINGOPTIONS SECRET PROVISIONING — the sanctioned Jenkins path for `bo-keycloak-secrets`.
//
// WHY THIS JOB EXISTS
// -------------------
// The public tenant's Keycloak and its Postgres cannot start without that Secret, and creating a
// Kubernetes Secret is a DEPLOYMENT under the Absolute Jenkins-Only Deployment Rule — which lists
// Secrets explicitly. Until this job existed there was no sanctioned way to create it: the runbook
// said "out of band", which is precisely the hand-deploy the rule forbids. That is the
// "no Jenkins path exists for this target" case, and the rule's answer is to BUILD the path, not to
// make an exception. This is that path.
//
// WHAT IT DOES NOT DO
// -------------------
// It does not mint the values. Every credential comes from the Jenkins credential store, so the
// secret material lives where Jenkins already protects it and never appears in this repository, in a
// manifest, in a build log or in a job parameter. The job's whole job is to move already-stored
// values into the cluster.
//
// REQUIRED JENKINS CREDENTIALS (Secret text), created once by the operator:
//   bo-keycloak-postgres-password    shared by Postgres and Keycloak's JDBC — ONE value by contract,
//                                    so the two can never drift into a mismatch that stops Keycloak
//                                    booting after Postgres has initialised its account
//   bo-keycloak-admin-password       the BOOTSTRAP admin, disabled after first login (PGL-031C)
//   bo-keycloak-smtp-password        the Gmail app password for info@bleedingoptions.com
//   bo-app-postgres-password         the APPLICATION database (bo-app-postgres). Separate from the
//                                    Keycloak database's by design: one compromise must not read the
//                                    other, which is most of why they are two instances at all.
//
// The reconciler client secret is NOT here: that client does not exist until the realm does, so it is
// created after the first boot and added by a later run.
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    choice(name: 'ENVIRONMENT', choices: ['production'],
      description: 'Only production has a public tenant. Dev has nothing to expose to the internet.')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: true,
      description: 'true = report the CURRENT state only, writing nothing (DEFAULT). It does NOT diff against the credentials — comparing would mean materialising them. Set false to create or update the Secret.')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
    booleanParam(name: 'ALLOW_APP_DB_ROLE_MISMATCH', defaultValue: false,
      description: 'false (DEFAULT) = REFUSE to write the Secret if the live application database rejects the bo-app-postgres-password credential. POSTGRES_PASSWORD is consumed by initdb on FIRST BOOT ONLY, so writing a rotated value leaves the database role on the old password while the web tier is handed the new one — and the watchlist then degrades silently to an empty list, which reads as a broken feature rather than a credential fault. Set true ONLY for RECOVERY, per docs/bleedingoptions-app-db-rotation.md: a database that is up but unverifiable, or absent while the Secret already holds a password. A NORMAL rotation leaves this false — after the role is changed by hand the preflight simply passes, and enabling it there would skip the only check that catches typing a different value into Jenkins than the one set on the role. Every build with it enabled says so in its log.')
  }
  options {
    disableConcurrentBuilds()
    timeout(time: 15, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    NS         = 'bleedingoptions'
  }
  stages {
    stage('Report current state') {
      steps {
        sh '''
          set -euo pipefail
          echo "=== namespace ==="
          kubectl get ns "$NS" 2>&1 || echo "(absent — it is created by Jenkinsfile.common-infra, not here)"
          echo "=== secret ==="
          # KEY NAMES ONLY. An earlier version used `{range .data}{@}{end}`, which prints the whole
          # data map — every base64 VALUE — into a build log many people can read. `{$k}` iterates the
          # keys and emits nothing else. `-o yaml` and `{@}` are both banned here for the same reason.
          # It must be go-template, NOT jsonpath: kubectl's jsonpath has no `range k, v :=` form and
          # fails to parse it outright (verified against a live secret), so a jsonpath version of this
          # line would break the stage rather than redact it.
          kubectl -n "$NS" get secret bo-keycloak-secrets \\
            -o jsonpath='created {.metadata.creationTimestamp}{"\\n"}' 2>/dev/null || echo "(absent)"
          kubectl -n "$NS" get secret bo-keycloak-secrets \\
            -o go-template='{{range $k, $v := .data}}{{$k}}{{"\\n"}}{{end}}' 2>/dev/null || true
        '''
      }
    }
    stage('Preflight: does the application database accept the credential?') {
      when { expression { !params.DEPLOY_DRY_RUN } }
      steps {
        // BEFORE 'Apply', deliberately. An earlier version of this check ran after the write, which
        // meant a mismatched credential was already in the cluster by the time the job failed:
        // running pods kept working on the value they had captured at start, and the breakage
        // appeared later, at the next unrelated restart, detached from the change that caused it.
        // Checking first means the failure costs nothing and points at the right thing.
        //
        // Presence is not acceptance. The 'Verify' stage proves APP_POSTGRES_PASSWORD is a KEY in
        // the Secret; only this proves the DATABASE agrees with its VALUE. The gap between those is
        // exactly the silent-degrade described on the parameter above.
        withCredentials([string(credentialsId: 'bo-app-postgres-password', variable: 'APP_PG_PASSWORD')]) {
          sh '''
            set +x                 # FIRST. Jenkins runs `sh -xe`, so tracing is on before this line.
            set -euo pipefail

            # ANNOUNCE THE OVERRIDE UP FRONT, on every path. Previously it was only mentioned on the
            # branch that used it, so a build could skip the check for an unrelated reason, write
            # the Secret, and never record that the safety net had been switched off. An override
            # nobody can see in the log is indistinguishable from one nobody set.
            if [ "${ALLOW_APP_DB_ROLE_MISMATCH:-false}" = "true" ]; then
              echo "  *** ALLOW_APP_DB_ROLE_MISMATCH IS ENABLED for this build. ***"
              echo "  The preflight will not block the write. This is a RECOVERY setting"
              echo "  (docs/bleedingoptions-app-db-rotation.md). A normal rotation does NOT need it:"
              echo "  once the database role has been changed, the preflight passes on its own, and"
              echo "  enabling it there skips the only check that catches a credential typed into"
              echo "  Jenkins that differs from the one set on the role."
            fi

            # The SAME malformed-credential guard the Apply stage runs. It has to be repeated here
            # rather than relied on, because this stage now runs BEFORE Apply: a credential holding
            # a newline would otherwise be truncated by `read -r` below, the database would reject
            # the truncated value, and the job would report "the database rejects this credential"
            # — pointing at the database when the fault is a credential entered across two lines in
            # Jenkins. Naming the real fault is the difference between a two-minute fix and an hour
            # spent looking at Postgres.
            case $APP_PG_PASSWORD in
              *"
"*) echo "FATAL: bo-app-postgres-password contains a newline. Re-enter it in Jenkins as a single line." >&2
                  exit 1 ;;
              "") echo "FATAL: bo-app-postgres-password is empty." >&2; exit 1 ;;
            esac

            # DISTINGUISH "confirmed absent" FROM "could not tell", using kubectl's BEHAVIOUR rather
            # than the WORDING of its error. Two earlier versions got this wrong in different ways:
            #
            #   `if ! kubectl get sts`      collapsed every failure — Forbidden, expired kubeconfig,
            #                               API timeout, DNS blip — into "not deployed yet".
            #   matching *NotFound* on stderr
            #                               false-positives on errors that are not about this
            #                               resource at all: a missing NAMESPACE reports
            #                               `namespaces "bleedingoptions" not found`, which matches.
            #
            # `--ignore-not-found -o name` is machine-readable: rc 0 with EMPTY output means the
            # resource is genuinely absent, and any non-zero rc means the question was not answered.
            #
            # But it is not sufficient on its own, which is why the namespace is confirmed FIRST:
            # verified against the live cluster, `get sts -n no-such-namespace --ignore-not-found`
            # also returns rc 0 and empty output. Without the namespace check, a wrong or deleted
            # namespace would read as "the database is absent" and take the first-install path.
            ns_out="$(kubectl get ns "$NS" --ignore-not-found -o name 2>/dev/null)" && ns_rc=0 || ns_rc=$?
            if [ "$ns_rc" -ne 0 ]; then
              echo "FATAL: cannot query namespace $NS, so nothing here can be confirmed." >&2
              echo "  The Secret has NOT been written. Fix cluster access and re-run." >&2
              exit 1
            fi
            if [ -z "$ns_out" ]; then
              echo "FATAL: namespace $NS does not exist. Run Jenkinsfile.common-infra first." >&2
              exit 1
            fi

            sts_out="$(kubectl -n "$NS" get sts bo-app-postgres --ignore-not-found -o name 2>/dev/null)" \\
              && sts_rc=0 || sts_rc=$?
            if [ "$sts_rc" -ne 0 ]; then
              echo "FATAL: cannot determine whether bo-app-postgres exists." >&2
              echo "  kubectl did not answer, so the credential cannot be verified and the Secret" >&2
              echo "  has NOT been written. Fix access and re-run rather than writing blind." >&2
              exit 1
            fi
            [ -z "$sts_out" ] && sts_absent=true || sts_absent=false

            if [ "$sts_absent" = true ]; then
              # A confirmed-absent database is only a defensible skip on a FIRST INSTALL. If the
              # Secret already carries APP_POSTGRES_PASSWORD, then a database was provisioned from
              # it at some point, and its absence now means either someone deleted the StatefulSet
              # or this is a rebuild — in both cases writing a new unverified credential is exactly
              # what the preflight exists to prevent. Otherwise "delete the StatefulSet" would be a
              # one-step bypass of the whole check.
              # The Secret lookup is classified SEPARATELY into present / absent / error. As an `if`
              # condition it previously swallowed every failure into "the key is not there", so an
              # unreadable Secret looked identical to a first install — the same conflation as
              # above, one line further down, and it would have re-opened the bypass this block
              # exists to close.
              sec_out="$(kubectl -n "$NS" get secret bo-keycloak-secrets --ignore-not-found \\
                           -o go-template='{{range $k, $v := .data}}{{$k}}{{"\\n"}}{{end}}' 2>/dev/null)" \\
                && sec_rc=0 || sec_rc=$?
              if [ "$sec_rc" -ne 0 ]; then
                echo "FATAL: bo-app-postgres is absent AND bo-keycloak-secrets could not be read," >&2
                echo "  so this cannot be confirmed as a first install. Nothing was written." >&2
                exit 1
              fi
              if printf '%s\\n' "$sec_out" | grep -Fxq APP_POSTGRES_PASSWORD; then
                if [ "${ALLOW_APP_DB_ROLE_MISMATCH:-false}" = "true" ]; then
                  echo "  WARNING: bo-app-postgres is absent but the Secret already holds"
                  echo "           APP_POSTGRES_PASSWORD. Proceeding UNVERIFIED on the override."
                  exit 0
                fi
                echo "FATAL: bo-app-postgres does not exist, but bo-keycloak-secrets already holds" >&2
                echo "  APP_POSTGRES_PASSWORD — so this is not a first install. The credential" >&2
                echo "  cannot be verified against a database that is not there. The Secret has" >&2
                echo "  NOT been written. Restore or redeploy the database first." >&2
                exit 1
              fi
              echo "  skip: first install — bo-app-postgres is absent and the Secret has no"
              echo "        APP_POSTGRES_PASSWORD yet, so there is no role to disagree with."
              exit 0
            fi
            # An existing-but-unavailable database FAILS. It does not skip.
            #
            # The first version skipped here, reasoning that a down database cannot distinguish a
            # wrong password from no answer. True, but the conclusion was backwards: skipping means
            # a transient outage silently re-opens the exact mismatch path this stage exists to
            # close, and it does so at the least observable moment. Refusing to write is always
            # recoverable — re-run when the database is up — whereas writing an unverified
            # credential is the failure that hides.
            #
            # An ABSENT StatefulSet is different and still skips: there is no role to disagree with
            # on a first install, and the Secret must be written before the database can be created
            # at all.
            if ! kubectl -n "$NS" get pod bo-app-postgres-0 \\
                   -o jsonpath='{.status.phase}' 2>/dev/null | grep -q Running; then
              if [ "${ALLOW_APP_DB_ROLE_MISMATCH:-false}" = "true" ]; then
                echo "  WARNING: bo-app-postgres-0 is not Running and the credential could NOT be"
                echo "           verified. ALLOW_APP_DB_ROLE_MISMATCH is set, so the Secret will be"
                echo "           written UNVERIFIED. Confirm the role matches before trusting it."
                exit 0
              fi
              echo "FATAL: bo-app-postgres exists but bo-app-postgres-0 is not Running, so the" >&2
              echo "  credential cannot be verified. The Secret has NOT been written." >&2
              echo "  Bring the database up and re-run: an unverifiable credential written now" >&2
              echo "  would degrade the watchlist to an empty list with nothing to point at." >&2
              exit 1
            fi

            # CONNECT TO THE POD'S OWN IP. Not the socket, and not 127.0.0.1. The image ships:
            #
            #     local all all              trust
            #     host  all all 127.0.0.1/32 trust      <-- loopback is TRUST
            #     host  all all ::1/128      trust
            #     host  all all all          scram-sha-256
            #
            # so both the socket and loopback authenticate with NO password at all, and a probe using
            # either would report PASS for any value — including the stale one it exists to catch.
            # That is not a hypothesis: during development a throwaway role with a NULL password
            # logged in successfully over 127.0.0.1. Only a non-loopback address reaches the scram
            # line. Loopback is REJECTED rather than merely not preferred, because the defect being
            # guarded here is "a check that quietly stopped checking".
            #
            # PGPASSWORD is passed on STDIN and exported inside the remote shell, never in argv:
            # `set +x` and Jenkins masking cover the console, not `ps` or /proc on the agent or node.
            #
            # It is in the remote process's ENVIRONMENT, which is a deliberate, bounded trade rather
            # than an oversight: psql must receive the password somehow, and the alternatives are a
            # PGPASSFILE (a file to create, chmod and reliably delete inside a container — the
            # cleanup path that was itself a finding against the removed reconcile stage) or argv,
            # which is strictly worse because it is world-readable via `ps`. An environment variable
            # is readable through /proc/<pid>/environ only by the same uid or root inside that
            # container, for the ~1s the probe lives, in a pod that already holds the database
            # itself. Accepted knowingly, and recorded so it is not re-litigated as a discovery.
            #
            # `IFS= read -r`, not `read -r`. Plain `read` splits on IFS and therefore STRIPS leading
            # and trailing whitespace, which would silently alter a credential that legitimately has
            # any — and Gmail app passwords are issued as space-separated groups, so this is a real
            # shape here, not a contrived one. The result would be a correct credential reported as
            # rejected. `|| true` because the value is written with no trailing newline, so `read`
            # sets the variable and THEN returns non-zero at EOF; without it the probe would abort
            # before ever contacting the database.
            if printf '%s' "$APP_PG_PASSWORD" | kubectl -n "$NS" exec -i sts/bo-app-postgres -c postgres -- \\
                 sh -c 'IFS= read -r p || true; export PGPASSWORD="$p"
                        addr=$(hostname -i | tr " " "\\n" | grep -vE "^(127\\.|::1$)" | head -1)
                        [ -n "$addr" ] || { echo "no non-loopback address" >&2; exit 3; }
                        psql -h "$addr" -U bleedingoptions -d bleedingoptions -tAc "select 1"' \\
                 >/dev/null 2>&1; then
              echo "  ok: the application database accepts the credential over TCP (scram)."
              exit 0
            fi

            if [ "${ALLOW_APP_DB_ROLE_MISMATCH:-false}" = "true" ]; then
              echo "  WARNING: the database REJECTS this credential, and ALLOW_APP_DB_ROLE_MISMATCH"
              echo "           is set. Writing anyway."
              echo "           A NORMAL rotation should not reach this line: once the role has been"
              echo "           changed, the preflight passes on its own. Reaching it with the"
              echo "           override on usually means the value in Jenkins is not the value that"
              echo "           was set on the role — the mistake this check exists to catch."
              echo "           If the role is not changed to match, the watchlist will degrade to an"
              echo "           empty list: the page keeps working and simply stores nothing."
              exit 0
            fi

            echo "FATAL: bo-app-postgres REJECTS the bo-app-postgres-password credential." >&2
            echo "  The Secret has NOT been written, so nothing has changed." >&2
            echo "  This is the expected state after rotating the credential in Jenkins WITHOUT" >&2
            echo "  changing the database role: POSTGRES_PASSWORD applies only at initdb." >&2
            echo "  Follow docs/bleedingoptions-app-db-rotation.md — the role must be altered and" >&2
            echo "  the web tier rolled in a coordinated order. This job deliberately does not do" >&2
            echo "  that itself: altering a live role invalidates every running pod's credential" >&2
            echo "  immediately, and a secrets job with no rollout of its own would leave the public" >&2
            echo "  site authenticating with a password that no longer exists." >&2
            exit 1
          '''
        }
      }
    }
    stage('Approve production secret write') {
      when { expression { !params.DEPLOY_DRY_RUN } }
      steps {
        input message: 'Create or UPDATE bo-keycloak-secrets in production? Rotating POSTGRES_PASSWORD on an EXISTING database will stop Keycloak booting until Postgres\' own account is changed to match — see docs/bleedingoptions-keycloak.md.',
              ok: 'Write the secret'
      }
    }
    stage('Apply') {
      when { expression { !params.DEPLOY_DRY_RUN } }
      steps {
        withCredentials([
          string(credentialsId: 'bo-keycloak-postgres-password', variable: 'PG_PASSWORD'),
          string(credentialsId: 'bo-keycloak-admin-password',    variable: 'KC_ADMIN_PASSWORD'),
          string(credentialsId: 'bo-keycloak-smtp-password',     variable: 'SMTP_PASSWORD'),
          // PGL-095. The APPLICATION database's password — separate from the Keycloak database's on
          // purpose, so a compromise of one does not read the other. Its absence is why
          // bo-app-postgres cannot start yet, and nothing else is affected by that.
          string(credentialsId: 'bo-app-postgres-password',      variable: 'APP_PG_PASSWORD')
        ]) {
          sh '''
            # `set +x` FIRST, before any credential is expanded. Jenkins runs a script with no shebang
            # as `/bin/sh -xe`, so tracing is ON by default and `set -euo pipefail` does not turn it
            # off. Without this the `printf` lines below would echo each expanded credential straight
            # into the console output. Jenkins' own masking is a backstop, not a guarantee — it
            # replaces exact matches of the bound value and cannot be relied on for this.
            set +x
            set -euo pipefail
            # The namespace is owned by common-infra. Requiring it rather than creating it keeps one
            # owner per object: a namespace created here would carry none of the labels the
            # cross-namespace NetworkPolicy selects on, and the boundary would silently not apply.
            kubectl get ns "$NS" >/dev/null 2>&1 || {
              echo "FATAL: namespace $NS does not exist. Run Jenkinsfile.common-infra (ENVIRONMENT=production) first — it owns the namespace, its labels and the NetworkPolicies." >&2
              exit 1
            }

            # VALUES NEVER APPEAR ON A COMMAND LINE. `--from-literal=K=$V` puts every secret into
            # argv, where any user on the agent can read it out of `ps` for the life of the call. An
            # env-file created under umask 077 is readable only by this process, and the trap removes
            # it even if a later step fails.
            # An env-file is line-oriented, so a credential containing a NEWLINE would split into a
            # junk key and a truncated value — and the job would report success. Refuse instead. (A
            # value may contain spaces, `=` and quotes; those round-trip exactly, which matters
            # because Gmail app passwords are issued as four space-separated groups.)
            for v in "$PG_PASSWORD" "$KC_ADMIN_PASSWORD" "$SMTP_PASSWORD" "$APP_PG_PASSWORD"; do
              case $v in
                *"
"*) echo "FATAL: a credential contains a newline. Re-enter it in Jenkins as a single line." >&2
                    exit 1 ;;
                "") echo "FATAL: a credential is empty." >&2; exit 1 ;;
              esac
            done

            # ONE trapped directory rather than several trapped files: with separate mktemp calls a
            # failure of the second leaves the first behind, because the trap is not installed yet.
            umask 077
            TMPD="$(mktemp -d)"
            trap 'rm -rf "$TMPD"' EXIT
            ENVFILE="$TMPD/env"
            ERRFILE="$TMPD/err"
            {
              printf 'POSTGRES_PASSWORD=%s\\n' "$PG_PASSWORD"
              printf 'KC_BOOTSTRAP_ADMIN_PASSWORD=%s\\n' "$KC_ADMIN_PASSWORD"
              printf 'KC_SMTP_PASSWORD=%s\\n' "$SMTP_PASSWORD"
              # PGL-095. The application database's password. Its ABSENCE here was the bug: the
              # credential was bound, the newline guard checked it and the verify stage demanded it,
              # but nothing wrote it — so every run ended with "APP_POSTGRES_PASSWORD is missing"
              # after appearing to do the work.
              printf 'APP_POSTGRES_PASSWORD=%s\\n' "$APP_PG_PASSWORD"
            } > "$ENVFILE"


            # Server-side apply: create-or-update, never delete-then-recreate (deleting the Secret
            # under a running Keycloak would leave it unable to restart). Server-side also avoids the
            # last-applied-configuration annotation, which on a client-side apply stores a SECOND copy
            # of every base64 value in the object's own metadata.
            #
            # NO --force-conflicts, deliberately. It seizes ownership from whatever else manages a
            # field, silently. On a credential object the right response to "something else is
            # managing this" is to STOP and have a person look, not to overwrite it — a conflict here
            # means the Secret was created by a path that is not this job, which is exactly the
            # hand-deploy this job replaced. A named field manager makes ownership legible in
            # `managedFields` rather than attributing it to a generic `kubectl`.
            kubectl -n "$NS" create secret generic bo-keycloak-secrets \\
              --from-env-file="$ENVFILE" \\
              --dry-run=client -o yaml \\
              | kubectl apply --server-side --field-manager=bleedingoptions-secrets-deploy -f - \\
                    2> "$ERRFILE" || {
                  status=$?
                  # kubectl's stderr is NEVER printed from this stage, and redaction is not
                  # attempted. Line-based filtering cannot defend against a value split across
                  # lines: if an admission webhook wraps or breaks the base64 it echoes, no single
                  # line matches the value and both fragments would print. The submitted object
                  # carries all three credentials, so the only guarantee available here is to not
                  # emit the captured text at all.
                  #
                  # Instead the error is CLASSIFIED — grep reads the file without printing it — and
                  # only fixed, locally written strings reach the log. That costs some detail on an
                  # unrecognised failure; the trade is deliberate, because the alternative is a
                  # credential in a build log that many people can read and that is retained.
                  echo "" >&2
                  if grep -qi 'conflict' "$ERRFILE"; then
                    echo "FAILED: field conflict. Do NOT re-run with --force-conflicts." >&2
                    echo "bo-keycloak-secrets is owned by another field manager — most likely it was" >&2
                    echo "created by hand or by a client-side apply. Inspect ownership:" >&2
                    echo "  kubectl -n $NS get secret bo-keycloak-secrets --show-managed-fields \\\\" >&2
                    echo "    -o go-template='{{range .metadata.managedFields}}{{.manager}} {{.operation}}{{\\"\\\\n\\"}}{{end}}'" >&2
                    echo "(managers only — never \\`-o yaml\\` on this object, that prints every value)" >&2
                    echo "Then take ownership deliberately, once, in a reviewed step." >&2
                  elif grep -qi 'not found' "$ERRFILE"; then
                    echo "FAILED: the API rejected the target as not found (exit $status)." >&2
                    echo "Namespace $NS most likely does not exist — run common-infra first." >&2
                  elif grep -qiE 'unable to connect|connection refused|timeout|no route to host|EOF' "$ERRFILE"; then
                    echo "FAILED: could not reach the API server (exit $status)." >&2
                    echo "Check the kubeconfig and the cluster, then re-run." >&2
                  elif grep -qiE 'forbidden|unauthorized|cannot create|cannot patch' "$ERRFILE"; then
                    echo "FAILED: the deployer identity is not permitted to write this Secret (exit $status)." >&2
                    echo "Check the RBAC on the kubeconfig in use." >&2
                  else
                    echo "FAILED: apply did not succeed (exit $status)." >&2
                    echo "The error text is deliberately NOT printed — it can echo the submitted" >&2
                    echo "object, which contains all three credentials. To see it, reproduce the" >&2
                    echo "apply by hand against a NON-secret object, or inspect the API server log." >&2
                  fi
                  echo "The Secret was NOT written." >&2
                  exit "$status"
                }
            rm -rf "$TMPD"

            echo "=== keys now present (names only) ==="
            kubectl -n "$NS" get secret bo-keycloak-secrets -o go-template='{{range $k, $v := .data}}{{$k}}{{"\\n"}}{{end}}'
          '''
        }
      }
    }
    stage('Verify') {
      when { expression { !params.DEPLOY_DRY_RUN } }
      steps {
        sh '''
          set -euo pipefail
          # Presence of all three keys, by NAME. A missing one fails the workload at boot with a
          # message nobody reads until they wonder why Keycloak is CrashLooping.
          #
          # The key list is fetched ONCE and matched by name. The earlier form read each VALUE
          # (`-o jsonpath={.data.$key} | grep -q .`) and had two faults: it materialised secret
          # material to test mere existence, and `grep -q` exits at the first match, closing the pipe
          # under `pipefail` and killing kubectl with SIGPIPE — a spurious failure this repo has
          # already been bitten by once, in the backup CronJob.
          KEYS="$(kubectl -n "$NS" get secret bo-keycloak-secrets \\
                    -o go-template='{{range $k, $v := .data}}{{$k}}{{"\\n"}}{{end}}')"
          for key in POSTGRES_PASSWORD KC_BOOTSTRAP_ADMIN_PASSWORD KC_SMTP_PASSWORD APP_POSTGRES_PASSWORD; do
            printf '%s\\n' "$KEYS" | grep -Fxq "$key" \\
              || { echo "FATAL: $key is missing from bo-keycloak-secrets" >&2; exit 1; }
            echo "  ok: $key present"
          done
          echo "Secret is complete."
        '''
      }
    }
  }
}
