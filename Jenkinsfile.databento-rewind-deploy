@Library('oe') _

// Off-Market Rewind — deploy pipeline.
//
// Standalone job (NOT part of bring-up-all). Deploys the Rewind service
// from its own repo (abhinav-jain09/options-edge-databento-rewind) into
// the target cluster, plus ensures the rewind Kafka topics
// (options.rewind.journal, options.rewind.audit) exist.
//
// Why a standalone job: the Rewind service is operator-driven (humans
// trigger replays from the options-edge-databento-rewind job). It does
// NOT need to be part of every platform deploy. Keeping it out of
// bring-up-all means a Rewind issue can't block a routine deploy of
// the rest of the platform.
//
// Why this lives in options-edge-deploy: this repo owns Kafka topic
// configuration (topics.env) and Jenkins job registrations. The Rewind
// SERVICE manifests (Deployment, Service, RBAC, Lease) live in the
// rewind repo as the single source of truth; this pipeline clones that
// repo at a configurable git ref and kustomize-applies them.
//
// One-shot operator prerequisites (NOT created by this job):
//   1. Secret `databento-rewind-secrets` in the options-edge namespace
//      with key DATABENTO_API_KEY (the Databento historical API key).
//      Apply with kubectl create secret generic — never commit the key.
//   2. Jenkins credential `rewind-service-token` (Secret Text) holding
//      a Keycloak service-account bearer token. Used by the
//      operational rewind jobs (Jenkinsfile.rewind, .resume-live in
//      the rewind repo) to authenticate to /run/*. This deploy job
//      itself does NOT need the token (kubectl auth is what drives
//      the deploy).
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    choice(name: 'ENVIRONMENT', choices: ['dev', 'production'],
      description: 'Target environment. Drives registry + kubeconfig from oeProfile.')
    string(name: 'REWIND_GIT_REF', defaultValue: 'main',
      description: 'Git ref in the rewind repo to deploy. Defaults to main per rule.md "Jenkins Main-Branch Deployment Rule".')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
    booleanParam(name: 'APPLY_TOPICS', defaultValue: true,
      description: 'Apply Kafka topic config (options.rewind.journal, options.rewind.audit) before rolling the service. Idempotent.')
    booleanParam(name: 'SKIP_BUILD_TRIGGER', defaultValue: false,
      description: 'Skip triggering the upstream image-build job. Use this when you have ALREADY built and pushed the image you want to deploy (e.g. you just ran the build job manually and want to deploy that exact tag).')
    string(name: 'IMAGE_TAG', defaultValue: 'dev',
      description: 'Mutable image tag to deploy. The base manifests reference this tag.')
  }
  options {
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG       = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    REWIND_GIT_URL   = 'git@github.com:abhinav-jain09/options-edge-databento-rewind.git'
    REWIND_NAMESPACE = 'options-edge'
    REWIND_DEPLOY    = 'databento-rewind-service'
    JENKINS_WORK_DIR = "${WORKSPACE}/rewind-clone"
  }
  stages {
    stage('Branch lock (rule.md)') {
      steps {
        script {
          // rule.md "Jenkins Main-Branch Deployment Rule": deploys may
          // come only from main. Allow */main forms; refuse anything else.
          def ok = (params.REWIND_GIT_REF in ['main', 'origin/main', '*/main'])
          if (!ok) {
            error("REWIND_GIT_REF=${params.REWIND_GIT_REF} is not main. Per rule.md (Jenkins Main-Branch Deployment Rule), deploys may only come from main. Override is intentionally not provided.")
          }
        }
      }
    }
    stage('Resolve profile') {
      steps {
        script {
          def p = oeProfile(params.ENVIRONMENT)
          env.OE_REGISTRY = p.registry
          env.OE_KAFKA_BOOTSTRAP = p.kafkaBootstrap ?: ''
          env.OE_KUBECONFIG_FILE = params.KUBECONFIG_FILE?.trim() ?: p.kubeconfigDeployer
          echo "ENVIRONMENT=${params.ENVIRONMENT} registry=${env.OE_REGISTRY} kubeconfig=${env.OE_KUBECONFIG_FILE} kafka_bootstrap=${env.OE_KAFKA_BOOTSTRAP}"
          if (!env.OE_KUBECONFIG_FILE?.trim()) {
            error("Resolve profile: empty deployer kubeconfig — check deploy-profiles.yaml")
          }
        }
      }
    }
    stage('Trigger image-build (upstream)') {
      when { expression { params.SKIP_BUILD_TRIGGER != true } }
      steps {
        // Triggers the image-build job in the rewind repo (registered
        // separately). After this completes, host.docker.internal:5001
        // (dev) or 192.168.100.252:5000 (prod) has the new
        // options-edge-databento-rewind:${IMAGE_TAG} image.
        build(
          job: 'options-edge-databento-rewind-image-build',
          wait: true,
          parameters: [
            string(name: 'ENVIRONMENT', value: params.ENVIRONMENT),
            string(name: 'IMAGE_TAG', value: params.IMAGE_TAG),
            string(name: 'MUTABLE_TAG', value: params.IMAGE_TAG),
            booleanParam(name: 'PUSH_IMAGE', value: true),
          ],
        )
      }
    }
    stage('Apply Kafka topics') {
      when { expression { params.APPLY_TOPICS == true } }
      steps {
        // Idempotent: apply-topics.sh creates missing topics and warns
        // on existing-but-mismatched ones. Rewind needs:
        //   - options.rewind.journal (compact, single-partition) — added
        //     to topics.env in this PR
        //   - options.rewind.audit (delete, single-partition) — added
        //     to topics.env in this PR
        sh '''
          set -euo pipefail
          # load-kafka-settings.sh sets KAFKA_TOPIC_REPLICATION_FACTOR etc.
          # from the rendered per-environment configmap (single source of
          # truth) — apply-topics.sh fails closed if RF isn't set.
          source scripts/kafka/load-kafka-settings.sh "${ENVIRONMENT}"
          bash scripts/kafka/apply-topics.sh
          bash scripts/kafka/verify-topics.sh
        '''
      }
    }
    stage('Clone rewind repo') {
      steps {
        sh '''
          set -euo pipefail
          rm -rf "${JENKINS_WORK_DIR}"
          git clone --depth 1 --branch "${REWIND_GIT_REF}" "${REWIND_GIT_URL}" "${JENKINS_WORK_DIR}"
          ( cd "${JENKINS_WORK_DIR}" && git log -1 --oneline )
        '''
      }
    }
    stage('Verify operator prereqs') {
      steps {
        sh '''
          set -euo pipefail
          # Per the operator setup doc: this Secret must already exist.
          # We refuse to roll the Deployment if the Secret is missing
          # because the pod would CrashLoopBackOff with a confusing
          # "Required environment variable 'DATABENTO_API_KEY' is not
          # set" — much clearer to fail this stage with the recovery
          # action.
          if ! kubectl -n "${REWIND_NAMESPACE}" get secret databento-rewind-secrets >/dev/null 2>&1; then
            cat >&2 <<MSG
FAIL: Secret databento-rewind-secrets is missing in namespace ${REWIND_NAMESPACE}.

Operator one-shot setup (run on the deployer kubeconfig):
  kubectl --kubeconfig "${KUBECONFIG}" -n ${REWIND_NAMESPACE} create secret \\
    generic databento-rewind-secrets \\
    --from-literal=DATABENTO_API_KEY='<your-databento-historical-api-key>'

Re-run this deploy after the Secret is created.
MSG
            exit 1
          fi
          echo "operator prereq OK: databento-rewind-secrets exists"
        '''
      }
    }
    stage('Kustomize apply') {
      steps {
        sh '''
          set -euo pipefail
          # Render + apply via the rewind repo's per-env overlay.
          # The k8s/overlays/${ENVIRONMENT} kustomization includes:
          #   - lease.yaml (pre-creates the k8s Lease)
          #   - serviceaccount.yaml + RBAC (Lease management only)
          #   - service.yaml (ClusterIP :8095)
          #   - deployment.yaml (replicas:1, Recreate, non-root)
          #   - configmap (manifest + calendar from config/*.yaml)
          # Dev overlay overrides MISSION_AUTH_* to local Keycloak;
          # prod overlay keeps the base auth.fullfunding.nl URLs.
          OVERLAY_DIR="${JENKINS_WORK_DIR}/k8s/overlays/${ENVIRONMENT}"
          if [ ! -d "${OVERLAY_DIR}" ]; then
            echo "FAIL: overlay dir does not exist: ${OVERLAY_DIR}" >&2
            exit 1
          fi
          # Dry-run first (server-side validates RBAC + admission).
          kubectl kustomize "${OVERLAY_DIR}" \
            | kubectl apply --dry-run=server -f -
          # Real apply.
          kubectl kustomize "${OVERLAY_DIR}" \
            | kubectl apply -f -
        '''
      }
    }
    stage('Rollout + Ready check') {
      steps {
        sh '''
          set -euo pipefail
          # Rewind's deployment is Recreate + replicas:1, and the pod
          # blocks on Lease acquisition (up to 90s) before HTTP serves,
          # so allow 180s rollout window.
          kubectl -n "${REWIND_NAMESPACE}" rollout status \
            "deployment/${REWIND_DEPLOY}" --timeout=180s
          # Print pod for the operator. A Ready pod = readinessProbe
          # /health/ready returned 200 = Lease held + journal hydrated.
          kubectl -n "${REWIND_NAMESPACE}" get pods -l app.kubernetes.io/name=${REWIND_DEPLOY}
        '''
      }
    }
    stage('Smoke check') {
      steps {
        sh '''
          set -euo pipefail
          # Hit /run/current via an in-cluster ephemeral pod — the
          # service is ClusterIP-only. This proves auth-gated endpoints
          # are reachable on the Service port; auth itself will fail
          # without a token, which is the expected (401) response.
          POD="rewind-smoke-$(date +%s)"
          set +e
          kubectl -n "${REWIND_NAMESPACE}" run "${POD}" \
            --rm -i --restart=Never --quiet \
            --image=curlimages/curl:8.10.1 \
            --command -- /bin/sh -c \
            'curl -sS -o /dev/null -w "%{http_code}" --max-time 10 \
              http://databento-rewind-service.options-edge.svc.cluster.local:8095/run/current'
          rc=$?
          set -e
          # 401 = service reachable + auth-gated (correct).
          # 200 with body would mean no auth (would be a bug).
          # rc != 0 means kubectl run failed; the pod may have been
          # blocked by the admission policy. Log and continue — the
          # rollout-status above is the authoritative health proof.
          if [ $rc -ne 0 ]; then
            echo "smoke: kubectl run exited rc=$rc (admission may block one-shot pods; rollout status was authoritative)"
          fi
        '''
      }
    }
  }
  post {
    success {
      echo "OK — Rewind ${params.IMAGE_TAG} deployed to ${params.ENVIRONMENT}. Operational job: options-edge-databento-rewind (in the rewind repo)."
    }
    failure {
      echo "Deploy failed. Recent rewind pod logs:"
      sh '''
        set +e
        kubectl -n "${REWIND_NAMESPACE}" logs deploy/${REWIND_DEPLOY} --tail=50 || true
      '''
    }
  }
}
