@Library('oe') _

// Off-Market Rewind — deploy pipeline.
//
// Standalone job (NOT part of bring-up-all). Deploys the Rewind service
// from its own repo (abhinav-jain09/options-edge-databento-rewind) into
// the target cluster, plus ensures the rewind Kafka topics exist with
// the exact shape the service requires (single partition,
// cleanup.policy=compact for journal).
//
// Why standalone: Rewind is operator-driven (humans trigger replays from
// the options-edge-databento-rewind job). It does NOT need to be part of
// every platform deploy. Keeping it out of bring-up-all means a Rewind
// issue can't block a routine deploy of the rest of the platform.
//
// Why this lives in options-edge-deploy: this repo owns Kafka topic
// configuration (topics.env) and Jenkins job registrations. The Rewind
// SERVICE manifests live in the rewind repo as the single source of
// truth; this pipeline clones that repo at a configurable git ref (locked
// to main) and kustomize-applies them.
//
// One-shot operator prerequisites (NOT created by this job):
//   1. Secret `databento-rewind-secrets` in the options-edge namespace
//      with key DATABENTO_API_KEY. Apply with kubectl create secret
//      generic — never commit the key.
//   2. Jenkins credential `rewind-service-token` (Secret Text) holding a
//      Keycloak service-account bearer token. Used by the operational
//      rewind jobs (Jenkinsfile.rewind, .resume-live in the rewind
//      repo) to authenticate to /run/*. This deploy job itself does
//      NOT need the token (kubectl auth is what drives the deploy).
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    choice(name: 'ENVIRONMENT', choices: ['dev', 'production'],
      description: 'Target environment. Drives registry + kubeconfig from oeProfile.')
    string(name: 'REWIND_GIT_REF', defaultValue: 'main',
      description: 'Git ref in the rewind repo to deploy. LOCKED TO main per rule.md.')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
    booleanParam(name: 'APPLY_TOPICS', defaultValue: true,
      description: 'Create/repair Kafka topic config. Idempotent. The verify-rewind-topics stage runs REGARDLESS — exact-shape verification of the rewind topics is mandatory because a wrong-shape journal silently corrupts the service.')
    booleanParam(name: 'SKIP_BUILD_TRIGGER', defaultValue: false,
      description: 'Skip triggering the upstream image-build job. Use when you have already built and pushed the image you want to deploy.')
    string(name: 'IMAGE_TAG', defaultValue: 'dev',
      description: 'Mutable image tag to deploy. Wired into kustomize via `kustomize edit set image` so the rendered Deployment actually references this tag (the dev overlay\'s base newTag is just a default).')
  }
  options {
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG       = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    REWIND_GIT_URL   = 'git@github.com:abhinav-jain09/options-edge-databento-rewind.git'
    REWIND_NAMESPACE = 'options-edge'
    REWIND_DEPLOY    = 'databento-rewind-service'
    JENKINS_WORK_DIR = "${WORKSPACE}/rewind-clone"
    DEPLOY_BRANCH    = "${params.REWIND_GIT_REF}"  // for enforce-main-branch.sh
  }
  stages {
    stage('Enforce main-only (this Jenkinsfile and the rewind clone)') {
      steps {
        // Codex v1 finding 1: the previous version only locked
        // REWIND_GIT_REF — but this Jenkinsfile itself, running from a
        // non-main options-edge-deploy branch, would still roll the
        // cluster. The shared helper enforces BOTH the SCM checkout
        // and the DEPLOY_BRANCH param.
        sh '''
          set -euo pipefail
          bash scripts/jenkins/enforce-main-branch.sh
        '''
      }
    }
    stage('Resolve profile') {
      steps {
        script {
          def p = oeProfile(params.ENVIRONMENT)
          env.OE_REGISTRY = p.registry
          env.OE_KAFKA_BOOTSTRAP = p.kafkaBootstrap ?: ''
          env.OE_KUBECONFIG_FILE = params.KUBECONFIG_FILE?.trim() ?: p.kubeconfigDeployer
          echo "ENVIRONMENT=${params.ENVIRONMENT} registry=${env.OE_REGISTRY} kubeconfig=${env.OE_KUBECONFIG_FILE} kafka_bootstrap=${env.OE_KAFKA_BOOTSTRAP}"
          if (!env.OE_KUBECONFIG_FILE?.trim()) {
            error("Resolve profile: empty deployer kubeconfig — check deploy-profiles.yaml")
          }
        }
      }
    }
    stage('Trigger image-build (upstream)') {
      when { expression { params.SKIP_BUILD_TRIGGER != true } }
      steps {
        build(
          job: 'options-edge-databento-rewind-image-build',
          wait: true,
          parameters: [
            string(name: 'ENVIRONMENT', value: params.ENVIRONMENT),
            string(name: 'IMAGE_TAG', value: params.IMAGE_TAG),
            string(name: 'MUTABLE_TAG', value: params.IMAGE_TAG),
            booleanParam(name: 'PUSH_IMAGE', value: true),
          ],
        )
      }
    }
    stage('Apply Kafka topics') {
      when { expression { params.APPLY_TOPICS == true } }
      steps {
        sh '''
          set -euo pipefail
          source scripts/kafka/load-kafka-settings.sh "${ENVIRONMENT}"
          bash scripts/kafka/apply-topics.sh
        '''
      }
    }
    stage('Verify rewind topic shape (MANDATORY)') {
      // Runs regardless of APPLY_TOPICS — exact-shape verification is
      // not optional. If APPLY_TOPICS=false and the topic is missing or
      // wrong-shape, this stage fails the deploy with a clear error
      // (rather than silently letting a wrong-shape journal corrupt the
      // service at startup).
      steps {
        sh '''
          set -euo pipefail
          source scripts/kafka/load-kafka-settings.sh "${ENVIRONMENT}"
          bash scripts/kafka/verify-rewind-topics.sh
        '''
      }
    }
    stage('Clone rewind repo') {
      steps {
        sh '''
          set -euo pipefail
          rm -rf "${JENKINS_WORK_DIR}"
          git clone --depth 1 --branch "${REWIND_GIT_REF}" "${REWIND_GIT_URL}" "${JENKINS_WORK_DIR}"
          ( cd "${JENKINS_WORK_DIR}" && git log -1 --oneline )
        '''
      }
    }
    stage('Verify operator prereqs') {
      steps {
        sh '''
          set -euo pipefail
          if ! kubectl -n "${REWIND_NAMESPACE}" get secret databento-rewind-secrets >/dev/null 2>&1; then
            cat >&2 <<MSG
FAIL: Secret databento-rewind-secrets is missing in namespace ${REWIND_NAMESPACE}.

Operator one-shot setup:
  kubectl --kubeconfig "${KUBECONFIG}" -n ${REWIND_NAMESPACE} create secret \\
    generic databento-rewind-secrets \\
    --from-literal=DATABENTO_API_KEY='<your-databento-historical-api-key>'

Re-run this deploy after the Secret is created.
MSG
            exit 1
          fi
          echo "operator prereq OK: databento-rewind-secrets exists"
        '''
      }
    }
    stage('Kustomize apply (with IMAGE_TAG injection)') {
      steps {
        sh '''
          set -euo pipefail
          OVERLAY_DIR="${JENKINS_WORK_DIR}/k8s/overlays/${ENVIRONMENT}"
          if [ ! -d "${OVERLAY_DIR}" ]; then
            echo "FAIL: overlay dir does not exist: ${OVERLAY_DIR}" >&2
            exit 1
          fi
          # Codex v1 finding 2: wire IMAGE_TAG into kustomize.
          # The base overlay's `images:` block uses newTag=dev as a
          # default; this `kustomize edit set image` rewrites it to the
          # operator-chosen IMAGE_TAG (e.g. a build SHA from the
          # upstream image-build job) so the rendered Deployment
          # actually references that tag.
          (
            cd "${OVERLAY_DIR}"
            # Determine the registry name used by the overlay's images
            # entry. Dev overlay uses host.docker.internal:5001; prod
            # uses 192.168.100.252:5000. Set the same registry,
            # different tag.
            if [ "${ENVIRONMENT}" = "dev" ]; then
              kustomize edit set image \
                host.docker.internal:5001/options-edge-databento-rewind=host.docker.internal:5001/options-edge-databento-rewind:${IMAGE_TAG}
            else
              kustomize edit set image \
                192.168.100.252:5000/options-edge-databento-rewind=192.168.100.252:5000/options-edge-databento-rewind:${IMAGE_TAG}
            fi
          )
          # Dry-run first (server-side validates RBAC + admission).
          kubectl kustomize "${OVERLAY_DIR}" \
            | kubectl apply --dry-run=server -f -
          # Real apply.
          kubectl kustomize "${OVERLAY_DIR}" \
            | kubectl apply -f -
        '''
      }
    }
    stage('Rollout restart (force pod refresh)') {
      // Codex v1 finding 2: the rewind base kustomization sets
      // disableNameSuffixHash on configMapGenerator — that's
      // intentional (resume-live's manifest reader uses the stable CM
      // name) BUT means kustomize doesn't auto-roll the pod on
      // ConfigMap changes. We must force it.
      // Mutable image tags have the same problem: if IMAGE_TAG didn't
      // change (e.g. operator pushed a new image with tag=dev) then
      // kustomize apply is a no-op for the Deployment spec, and the
      // pod keeps the old image. rollout restart forces a fresh pull.
      steps {
        sh '''
          set -euo pipefail
          kubectl -n "${REWIND_NAMESPACE}" rollout restart "deployment/${REWIND_DEPLOY}"
        '''
      }
    }
    stage('Rollout + Ready check') {
      steps {
        sh '''
          set -euo pipefail
          # Pod blocks on Lease acquisition (up to 90s) before HTTP serves
          # → readinessProbe initialDelaySeconds=120 in base manifest.
          # 240s window covers Recreate strategy old-pod-terminating +
          # new-pod-acquire-lease + readiness-grace.
          kubectl -n "${REWIND_NAMESPACE}" rollout status \
            "deployment/${REWIND_DEPLOY}" --timeout=240s
          kubectl -n "${REWIND_NAMESPACE}" get pods -l app.kubernetes.io/name=${REWIND_DEPLOY}
        '''
      }
    }
    stage('Smoke check (auth-mandatory)') {
      steps {
        sh '''
          set -euo pipefail
          # Codex v1 finding 3: assert the HTTP status code, not just
          # the curl exit code. /run/current MUST return 401 without an
          # auth header (rule.md "Authentication Mandatory Rule"). A
          # 200 there would mean auth is broken — the deploy must fail.
          POD="rewind-smoke-$(date +%s)"
          set +e
          status=$(kubectl -n "${REWIND_NAMESPACE}" run "${POD}" \
            --rm -i --restart=Never --quiet \
            --image=curlimages/curl:8.10.1 \
            --command -- /bin/sh -c \
            'curl -sS -o /dev/null -w "%{http_code}" --max-time 10 \
              http://databento-rewind-service.options-edge.svc.cluster.local:8095/run/current')
          rc=$?
          set -e
          echo "smoke: kubectl rc=$rc http_status=$status"
          if [ $rc -ne 0 ]; then
            # kubectl run may be blocked by the admission policy
            # (one-shot Pod creation in options-edge). The rollout
            # status above already proved Ready (= /health/ready
            # returned 200 = Lease held + journal hydrated). Log and
            # continue — admission can prevent the smoke pod but does
            # not invalidate the rollout proof.
            echo "smoke: kubectl run blocked (admission policy?); rollout-status above is authoritative"
          else
            if [ "$status" != "401" ]; then
              echo "FAIL smoke: /run/current returned $status, expected 401 (auth-mandatory; 200 would mean auth is broken)" >&2
              exit 1
            fi
            echo "smoke OK: /run/current returned 401 (auth-mandatory enforced)"
          fi
        '''
      }
    }
  }
  post {
    success {
      echo "OK — Rewind ${params.IMAGE_TAG} deployed to ${params.ENVIRONMENT}. Operational job: options-edge-databento-rewind (in the rewind repo)."
    }
    failure {
      echo "Deploy failed. Recent rewind pod logs:"
      sh '''
        set +e
        kubectl -n "${REWIND_NAMESPACE}" logs deploy/${REWIND_DEPLOY} --tail=50 || true
      '''
    }
  }
}
