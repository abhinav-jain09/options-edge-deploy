@Library('oe') _

// GENERIC STANDALONE SERVICE DEPLOY — one job for every processing service
// (standalone-service-deployment design; web has its own job with the native web build).
//
// Deploys ONE service's workload to ONE environment in minutes:
//   render k8s/services/<SERVICE>/overlays/<env> (a GENERATED snapshot of the monolith's
//   render of just that service — mirror rule by construction) → blast-radius guard →
//   digest-pin → apply ONLY that workload → rollout each of its Deployments → health gate
//   → rollback command in the log.
//
// Image builds: BUILD_IMAGES=true builds+pushes ONLY the selected service's image first
// (options-edge-processing with BUILD_TARGET=<this service's image>, i.e. `mvn -pl <module> -am`
// then build just that image — a few minutes, not the whole ~25-image reactor). Leave false to
// deploy the image already in the env registry (the fastest path).
// EXCEPTION databento-feed: its image builds in its OWN job
// (options-edge-databento-feed-deploy) — run that first, then deploy here with
// BUILD_IMAGES=false (the processing reactor has no feed module).
// EXCEPTION web: same shape. options-edge-web-deploy BUILDS AND PUSHES the image but never
// touches Kubernetes — its Deploy stage is a docker build/push, there is no kubectl in it. Until
// 'web' was listed here the only thing that rolled it was the monolith options-edge-deploy
// (apply.sh: `kubectl set image deployment/options-edge-web`), so a green options-edge-web-deploy
// left the running pod on the old image and looked like a successful deploy. Build there first,
// then deploy here with BUILD_IMAGES=false.
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    string(name: 'INTENT_ID', defaultValue: '',
      description: 'Optional idempotency key (0DTE pipeline automation). Empty = normal manual build. With a value: at most ONE build per intent ever reaches the deploy stages — a second submission aborts as NOOP_DUPLICATE (intent-dedup.json artifact names the winner).')
    choice(name: 'SERVICE', choices: [
      'databento-feed', 'databento-sr3-feed', 'databento-vix-feed', 'databento-gex', 'databento-gex-history', 'gamma-migration', 'databento-maxpain', 'databento-mission-sandwich',
      'databento-volume-aggregator', 'dealer-ledger', 'dealer-ledger-calibration', 'delta-flow',
      'directional-pressure', 'es-open-direction', 'es-open-direction-postgres-writer', 'close-direction', 'spot-vol-regime', 'indicator-service', 'vix-option-inteligence', 'greek-move-authenticity', 'feed-gateway', 'gex-delta-redis-writer', 'hpsf-postgres-writer', 'option-price-behavior',
      'option-truth-engine', 'market-carry', 'pin-postgres-writer', 'pressure-postgres-writer', 'raw-postgres-writer', 'raw-to-display',
      'invasion-postgres-writer', 'reversal-confirmation', 'drop-classifier', 'reversal-postgres-writer', 'short-premium-agent', 'es-spx-align', 'spx-mission-control', 'strike-flow-avro-adapter', 'strike-flow-classifier', 'strike-intelligence', 'strike-invasion', 'strike-liquidity-heatmap',
      'oi-shadow', 'unified-sr', 'volume-pace', 'signal-follower', 'web', 'ibkr-feed', 'stock-gex', 'context-tape',
      // fullfunding tenant. Same job: the target namespace comes from services.yaml,
      // and the deploy refuses if the render disagrees with what is registered there.
      'fullfunding-app'
    ], description: 'Which service to deploy (dir under k8s/services; spread-skew and its writer are intentionally unavailable under the 2026-07-26 operator hold).')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'production'],
      description: 'Target environment — selects the overlay + deployer kubeconfig (oeProfile).')
    booleanParam(name: 'BUILD_IMAGES', defaultValue: false,
      description: 'Build+push ONLY the selected service\'s image first (options-edge-processing with BUILD_TARGET=<this service>, mvn -pl <module> -am — a few minutes, not the whole reactor). false = deploy the image already in the registry (fastest path).')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: false,
      description: 'true = render + digest-pin + server-side validate only; nothing changes.')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
  }
  options {
    disableConcurrentBuilds()
    // 120 min: a single-service BUILD_IMAGES build is only a few minutes, but the cap stays
    // generous to absorb queue/remote-build time (prod builds run on .252 over ssh). The old
    // 45-min cap killed builds mid-flight ("Cancelling nested steps due to timeout" — runs #5/#6).
    timeout(time: 120, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG           = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    ENVIRONMENT          = "${params.ENVIRONMENT}"
    SERVICE_PARAM        = "${params.SERVICE}"
    DEPLOY_DRY_RUN_PARAM = "${params.DEPLOY_DRY_RUN}"
  }
  stages {
    stage('Intent dedup') {
      when { expression { params.INTENT_ID?.trim() } }
      steps { script {
        def rc = sh(returnStatus: true, script: '''
        set -euo pipefail
        # Serialized by disableConcurrentBuilds(): at most one build EXECUTES at a time, so this
        # claim step cannot race another executor. Durable ledger outside the workspace (plan
        # rev 7): survives workspace wipes; cleanup jobs never touch ~/oe-ops.
        LEDGER=/Users/abhinav/oe-ops/zerodte-audit/jenkins-intents
        mkdir -p "$LEDGER"
        CLAIM="$LEDGER/${INTENT_ID}.json"
        if [ -f "$CLAIM" ]; then
          STATE=$(python3 -c "import json;print(json.load(open('$CLAIM')).get('state'))")
          BN=$(python3 -c "import json;print(json.load(open('$CLAIM')).get('buildNumber'))")
          if [ "$STATE" = "DEPLOYED" ]; then
            echo "{\"intentId\":\"$INTENT_ID\",\"winner\":$BN}" > intent-dedup.json
            echo "NOOP_DUPLICATE: intent already DEPLOYED by build $BN"; exit 42
          fi
          # CLAIMED or DEPLOY_STAGE_STARTED by another build: resolve via our own API record.
          RESULT=$(curl -sf -u "admin:Options#100" "$JENKINS_URL/job/service-deploy/$BN/api/json" | python3 -c "import sys,json;print(json.load(sys.stdin).get('result'))" || echo MISSING)
          if [ "$RESULT" = "None" ] || [ "$RESULT" = "null" ]; then
            echo "{\"intentId\":\"$INTENT_ID\",\"winner\":$BN}" > intent-dedup.json
            echo "NOOP_DUPLICATE: build $BN still running for this intent"; exit 42
          fi
          MARKER=$(python3 -c "import json;print(json.load(open('$CLAIM')).get('state'))")
          if [ "$MARKER" = "DEPLOY_STAGE_STARTED" ] || [ "$RESULT" = "MISSING" ]; then
            echo "HUMAN REQUIRED: prior build $BN reached the deploy stage (or its record is gone) without a receipt — a half-applied deploy may exist. Mark the claim FAILED after verifying the cluster digest, then resubmit."; exit 1
          fi
          if [ "$RESULT" = "SUCCESS" ]; then
            # Codex round 1: CLAIMED + terminal SUCCESS is INCONSISTENT — success without the
            # marker means the ledger writes are not being reached, and "provably pre-deploy"
            # cannot be claimed about a build that succeeded. Never supersede an inconsistency.
            echo "HUMAN REQUIRED: build $BN is SUCCESS but its claim never left CLAIMED — ledger and reality disagree; verify the cluster digest and repair the claim by hand."; exit 1
          fi
          # terminal FAILED/ABORTED, marker absent: provably died pre-deploy -> SUPERSEDE
          echo "superseding failed pre-deploy claim of build $BN"
        fi
        python3 - "$CLAIM" "$BUILD_NUMBER" <<'PYEOF'
import json,os,sys
path,bn=sys.argv[1],int(sys.argv[2])
tmp=path+".tmp"
prev=json.load(open(path)) if os.path.exists(path) else {}
rec={"intentId":os.environ["INTENT_ID"],"buildNumber":bn,"state":"CLAIMED",
     "version":prev.get("version",0)+1,"supersedes":prev.get("buildNumber")}
with open(tmp,"w") as f: json.dump(rec,f); f.flush(); os.fsync(f.fileno())
os.rename(tmp,path)
d=os.open(os.path.dirname(path),os.O_RDONLY); os.fsync(d); os.close(d)
PYEOF
        echo "intent $INTENT_ID claimed by build $BUILD_NUMBER"
      ''')
        if (rc == 42) {
          // NOOP_DUPLICATE: the machine-readable truth is intent-dedup.json (+ the durable
          // ledger, which the deployer reads exclusively); the Jenkins result is NOT_BUILT set
          // here, then the abort. The deployer never keys off build results for dedup decisions.
          if (fileExists('intent-dedup.json')) { archiveArtifacts artifacts: 'intent-dedup.json' }
          currentBuild.result = 'NOT_BUILT'
          error('NOOP_DUPLICATE — another build owns this intent (see intent-dedup.json)')
        } else if (rc != 0) {
          error("intent dedup failed rc=${rc} — human required (half-applied deploy possible)")
        }
      } }
    }
    stage('Validate service registry') {
      steps {
        sh '''
          set -euo pipefail
          bash scripts/ci/validate-services.sh
        '''
      }
    }
    stage('Build image (this service only)') {
      when { expression { params.BUILD_IMAGES && !params.DEPLOY_DRY_RUN } }
      steps {
        script {
          // Fail here, not three jobs downstream. These services build in their own repos' jobs,
          // so options-edge-processing rejects them during its own 'Resolve profile' -- safe, but
          // the operator only learns why after a queued downstream build starts and dies. Say it
          // immediately, and name the job that actually builds the image.
          def ownJob = [
            'databento-feed'    : 'options-edge-databento-feed-deploy',
            // databento-vix-feed REUSES the databento-feed image (VIX feed separation PR-2:
            // command override selects the vix role) — build that image's own job first.
            'databento-vix-feed': 'options-edge-databento-feed-deploy',
            'databento-sr3-feed': 'options-edge-databento-sr3-feed-deploy',
            'feed-gateway'      : 'feed-gateway-deploy',
            'web'               : 'options-edge-web-deploy',
            'ibkr-feed'         : 'options-edge-ibkr-feed',
            // stock-gex ships in the options-edge-databento-feed repo (Dockerfile.stockgex), the
            // same shape as the sr3 feed — it has no processing-reactor module.
            'stock-gex'         : 'options-edge-stock-gex-deploy'
          ]
          if (ownJob.containsKey(params.SERVICE)) {
            error("service-deploy: ${params.SERVICE} does not build in the processing reactor. " +
                  "Build it in ${ownJob[params.SERVICE]} first, then deploy here with BUILD_IMAGES=false.")
          }
          // Build ONLY the selected service's image (fast path), not the whole processing set.
          // Resolve the service's image name from services.yaml and pass it as BUILD_TARGET; the
          // processing job maps image->maven module and runs `mvn -pl <module> -am`, then builds+pushes
          // just that image. SERVICE_PARAM is read by the shell (env), never Groovy-interpolated into the
          // script text (injection-safe, matches the rest of these jobs).
          // NOTE: databento-feed, databento-sr3-feed and feed-gateway have no processing module (they build in their own
          // repos' jobs — options-edge-databento-feed-deploy and feed-gateway-deploy respectively);
          // selecting either with BUILD_IMAGES=true fails fast in the processing job with the valid
          // list. Build their image via the own-repo job first, then deploy here with BUILD_IMAGES=false.
          def image = sh(
            script: 'set -euo pipefail; yq -r ".services[] | select(.name == \\"$SERVICE_PARAM\\") | .image" services.yaml',
            returnStdout: true
          ).trim()
          if (!image || image == 'null') {
            error("service-deploy: could not resolve an image for SERVICE='${env.SERVICE_PARAM}' from services.yaml")
          }
          echo "Building ONLY ${env.SERVICE_PARAM} -> BUILD_TARGET=${image}"
          build job: 'options-edge-processing',
                parameters: [
                  string(name: 'ENVIRONMENT',        value: params.ENVIRONMENT),
                  string(name: 'BUILD_TARGET',       value: image),
                  string(name: 'PROCESSING_BRANCH',  value: 'main'),
                  string(name: 'CONTRACTS_BRANCH',   value: 'main'),
                  booleanParam(name: 'PUSH_IMAGES',  value: true)
                ],
                wait: true, propagate: true
        }
      }
    }
    stage('Reconcile feed-gateway expiry') {
      when { expression { params.SERVICE == 'feed-gateway' } }
      steps {
        // The standalone slice intentionally contains only this service's workload, not the shared
        // ConfigMap. Reconcile the one gateway-owned selection key before rolling the pod so envFrom
        // can never revive a blank literal expiry and drop the entire live option chain.
        sh '''
          set -euo pipefail
          current="$(kubectl -n options-edge get configmap options-edge-config \
            -o jsonpath='{.data.IB_EXPIRY}')"
          if [ "$current" = "AUTO" ]; then
            echo "options-edge-config IB_EXPIRY is already AUTO."
          elif [ "${DEPLOY_DRY_RUN_PARAM:-false}" = "true" ]; then
            echo "[dry-run] would change options-edge-config IB_EXPIRY from [$current] to AUTO."
          else
            kubectl -n options-edge patch configmap options-edge-config --type=merge \
              --patch '{"data":{"IB_EXPIRY":"AUTO"}}'
            observed="$(kubectl -n options-edge get configmap options-edge-config \
              -o jsonpath='{.data.IB_EXPIRY}')"
            [ "$observed" = "AUTO" ] || {
              echo "FATAL: IB_EXPIRY reconcile did not persist AUTO (observed [$observed])." >&2
              exit 1
            }
          fi
        '''
      }
    }
    stage('Verify OI anchor manifest topic') {
      // BEFORE the rollout, not after: the point is to stop a producer reaching a topic that does
      // not exist yet. apply-topics lives in a different job, and two manually sequenced jobs are
      // not an ordering guarantee -- skip it, run it against the wrong environment, or have it
      // fail quietly, and the broker auto-creates the topic with cluster defaults that drop each
      // session's record 24h later while still looking configured.
      when {
        expression { params.SERVICE == 'databento-gex' && !params.DEPLOY_DRY_RUN }
      }
      steps {
        sh '''
          set -euo pipefail
          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          scripts/kafka/ensure-oi-anchor-topic.sh
        '''
      }
    }
    stage('Verify indicator topics') {
      // BEFORE the rollout, same barrier and same reason as the OI anchor stage above. MEASURED
      // on 2026-08-11: prod's options.indicators.snapshot.current had NO dynamic config at all --
      // neither the declared compaction nor the declared 7-day retention -- because the broker had
      // auto-created it and apply-topics lives in a different job. es4's sat at cleanup.policy=
      // delete for a different reason (a glued topics.env token). snapshot.current is the
      // CURRENT-state topic the UI and gateway read; without compaction its latest value per key
      // is dropped once retention elapses and the board blanks while the topic looks healthy.
      // Reconciles policy/retention, FAILS CLOSED on a partition mismatch (Kafka cannot shrink a
      // topic and recreating one would destroy the accumulated bar history).
      when {
        expression { params.SERVICE == 'indicator-service' }
      }
      steps {
        sh '''
          set -euo pipefail
          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          export TOPIC_PREFIX
          export DEPLOY_DRY_RUN="${DEPLOY_DRY_RUN:-false}"
          # The Streams app id names the internal changelog the barrier checks. It is
          # NOT derivable from ENVIRONMENT: prod's ENVIRONMENT is "production" but its
          # app id is indicator-service-prod. The suffix comes from the SAME configmap
          # value the service itself reads, so the barrier can never check a topic the
          # service does not use.
          SUFFIX=$(kubectl -n options-edge get configmap options-edge-config \
            -o jsonpath='{.data.KAFKA_APPLICATION_ID_SUFFIX}' 2>/dev/null || true)
          : "${SUFFIX:?KAFKA_APPLICATION_ID_SUFFIX not readable — refusing to guess the app id}"
          export INDICATOR_APP_ID="indicator-service${SUFFIX}"
          scripts/kafka/ensure-indicator-topics.sh
        '''
      }
    }
    stage('Verify gamma-tilt evidence ledger') {
      // GMT Stage-1 (Codex code-review c1-6): the shadow evidence ledger must exist with the
      // right shape (1 partition, delete, retention.ms=-1) BEFORE strike-intelligence rolls out.
      // The service also refuses at boot; this stops the deploy before a crash-looping pod ships.
      when {
        expression { params.SERVICE == 'strike-intelligence' && !params.DEPLOY_DRY_RUN }
      }
      steps {
        sh '''
          set -euo pipefail
          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          scripts/kafka/ensure-gamma-tilt-ledger.sh
        '''
      }
    }
    stage('Reconcile VIX option intelligence current topic') {
      when {
        expression { params.SERVICE == 'vix-option-inteligence' && !params.DEPLOY_DRY_RUN }
      }
      steps {
        // Topic reconcile FIRST, while the service is still serving. Only the identity prune
        // needs the service down, so nothing else belongs inside the outage window.
        sh '''
          set -euo pipefail
          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          RECONCILE_PHASE=topic scripts/kafka/ensure-vix-option-inteligence-topic.sh
        '''
        // Then pause and prune. The monolith Jenkinsfile does the same thing for the other ~40
        // services ('Pause Runtime For Kafka Cleanup' before 'Kafka Cleanup'); this is that
        // pattern scoped to the single service this pipeline deploys. Retiring an identity a
        // live pod still holds can never converge -- the prune deletes the group and the
        // consumer rejoins in milliseconds.
        sh '''
          set -euo pipefail
          DEP=deployment/vix-option-inteligence-service
          SEL=app.kubernetes.io/name=vix-option-inteligence-service
          mkdir -p "$WORKSPACE/.jenkins-tmp"
          MARK="$WORKSPACE/.jenkins-tmp/vix-paused-replicas"

          # Counts live pods, or FAILS. Piping a failed 'kubectl get' into wc -l yields 0, which
          # reads as 'no pods running' -- an unknown state masquerading as a verified-empty one,
          # the same mistake as treating a failed lookup as 'deployment absent'. Callers must
          # check the return code, not just the number.
          live_pods() {
            # stderr goes to its own file, never into the value. kubectl prints
            # "No resources found in <ns> namespace." on STDERR for an empty selection: with
            # '2>&1' that sentence lands in the value, awk counts it as one running pod, and the
            # wait loop never sees zero -- observed doing exactly that in build #680, where the
            # pod was already Terminating and the pause still timed out.
            local out rc errf
            errf="$(mktemp)"
            out="$(kubectl -n options-edge get pods -l "$SEL" --no-headers 2>"$errf")"
            rc=$?
            if [ "$rc" -ne 0 ]; then
              echo "FATAL: could not list pods for $SEL: $(cat "$errf")" >&2
              rm -f "$errf"
              return 1
            fi
            rm -f "$errf"
            printf '%s\n' "$out" \
              | awk '$3 !~ /^(Completed|Succeeded|Error|Failed)$/ && NF { print }' | wc -l | tr -d ' '
          }

          # ABSENT and UNKNOWN are different answers. 'kubectl get' failing on RBAC, a timeout or
          # an API error is not proof the deployment is missing, and treating it as such would
          # skip the pause and prune against a service that is still consuming -- the exact bug
          # this stage exists to fix.
          #
          # The absence test is STRUCTURAL, not a substring search of stderr: '--ignore-not-found
          # -o name' exits 0 with empty stdout when the object is absent, 0 with its name when it
          # exists, and non-zero for any real failure. Grepping the combined output for 'NotFound'
          # would misread an RBAC or transport error that merely happens to carry that token.
          set +e
          probe="$(kubectl -n options-edge get "$DEP" --ignore-not-found -o name 2>/dev/null)"
          probe_rc=$?
          set -e
          if [ "$probe_rc" -ne 0 ]; then
            echo "FATAL: could not determine whether $DEP exists (kubectl exit $probe_rc)" >&2
            exit 1
          fi
          if [ -z "$probe" ]; then
            # A first deploy into an environment that has no workload yet: nothing holds the
            # retired identity, so there is nothing to pause.
            echo "no $DEP yet; nothing to pause."
          else
            PREV_ERR="$(mktemp)"
            PREV="$(kubectl -n options-edge get "$DEP" -o jsonpath='{.spec.replicas}' 2>"$PREV_ERR")"
            PREV_RC=$?
            # Refused, not defaulted to 1. This value is the ONLY record of what to restore to;
            # guessing it and then scaling to zero means the un-pause would bring the service
            # back at the wrong size -- or, if the deployment runs more than one replica, quietly
            # shrink it. If we cannot read it, we must not scale at all.
            case "$PREV" in
              ''|*[!0-9]*) PREV_RC=1 ;;
            esac
            if [ "$PREV_RC" -ne 0 ]; then
              echo "FATAL: could not read current replicas for $DEP: [$PREV] $(cat "$PREV_ERR")" >&2
              echo "Refusing to pause: without the current replica count the restore would guess." >&2
              rm -f "$PREV_ERR"
              exit 1
            fi
            rm -f "$PREV_ERR"

            # An EXISTING marker is never overwritten. It records the size from before an earlier
            # pause that was never undone, and it is the only surviving record of it. Overwriting
            # would be worst exactly where it matters most: a previous run pauses at 3, its
            # restore fails, the service sits at 0; this run reads PREV=0, stamps 0 over the 3,
            # "restores" to 0, and the correct size is gone for good.
            if [ -f "$MARK" ]; then
              STRANDED="$(cat "$MARK")"
              case "$STRANDED" in
                ''|*[!0-9]*)
                  echo "FATAL: recovery marker $MARK holds an unusable value [$STRANDED]." >&2
                  echo "Resolve it by hand -- the correct replica count cannot be guessed." >&2
                  exit 1 ;;
              esac
              echo "Recovery marker from an earlier run found (replicas=$STRANDED); keeping it rather than stamping the current $PREV over it."
              PREV="$STRANDED"
            else
              # Written BEFORE scaling: if the scale half-succeeds and the step then dies, post{}
              # must still know a restore is owed.
              printf '%s\n' "$PREV" > "$MARK"
            fi
            kubectl -n options-edge scale "$DEP" --replicas=0

            # Both conditions are read through explicit return codes: an unreadable desired-replica
            # count or an unreadable pod list must stop the pause, never satisfy it.
            desired_replicas() {
              # Same discipline as live_pods: stderr to its own file, never merged into the
              # value, and the result must be digits. A warning folded into the value would make
              # a genuine "0" compare unequal to "0" and the pause would never be satisfied.
              local out rc errf
              errf="$(mktemp)"
              out="$(kubectl -n options-edge get "$DEP" -o jsonpath='{.spec.replicas}' 2>"$errf")"
              rc=$?
              if [ "$rc" -ne 0 ]; then
                echo "FATAL: could not read desired replicas for $DEP: $(cat "$errf")" >&2
                rm -f "$errf"
                return 1
              fi
              rm -f "$errf"
              # NO '${out:-0}' default here. Defaulting empty to 0 would let an empty -- i.e.
              # unknown -- response satisfy the "desired replicas are zero" test, which is the
              # very unknown-as-zero class this function exists to stop. A Deployment always
              # carries a defaulted spec.replicas, so empty means something is wrong.
              case "$out" in
                ''|*[!0-9]*) echo "FATAL: unreadable desired replicas for $DEP: [$out]" >&2; return 1 ;;
              esac
              printf '%s' "$out"
            }

            for i in $(seq 1 60); do
              want="$(desired_replicas)" || exit 1
              pods="$(live_pods)"        || exit 1
              [ "$want" = "0" ] && [ "$pods" = "0" ] && break
              echo "Waiting for $DEP to stop; desired=$want pods=$pods"
              sleep 3
            done
            # Both conditions, deliberately: zero pods alone does not prove desired replicas are
            # zero -- a controller could be about to create one back.
            want="$(desired_replicas)" || exit 1
            pods="$(live_pods)"        || exit 1
            if [ "$want" != "0" ] || [ "$pods" != "0" ]; then
              echo "Timed out pausing $DEP before the identity prune; desired=$want pods=$pods" >&2
              kubectl -n options-edge get pods -l "$SEL" || true
              exit 1
            fi
            echo "$DEP paused (was $PREV); no consumer can hold the retired identity."
          fi

          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          RECONCILE_PHASE=prune scripts/kafka/ensure-vix-option-inteligence-topic.sh
        '''
      }
    }
    stage('Deploy (service-scoped)') {
      steps {
        script { if (params.INTENT_ID?.trim()) { sh '''
          # DEPLOY_STAGE_STARTED — the durable pre-deploy boundary (plan rev 8/9): fsync file,
          # rename, fsync DIRECTORY, and only then mutate the cluster. If this write cannot be
          # made durable the build FAILS here, before anything is applied.
          python3 - "/Users/abhinav/oe-ops/zerodte-audit/jenkins-intents/${INTENT_ID}.json" <<'PYEOF'
import json,os,sys
path=sys.argv[1]; rec=json.load(open(path))
rec["state"]="DEPLOY_STAGE_STARTED"; rec["version"]+=1
tmp=path+".tmp"
with open(tmp,"w") as f: json.dump(rec,f); f.flush(); os.fsync(f.fileno())
os.rename(tmp,path)
d=os.open(os.path.dirname(path),os.O_RDONLY); os.fsync(d); os.close(d)
PYEOF
        ''' } }
        sh '''
          set -euo pipefail
          export SERVICE="${SERVICE_PARAM:?}"
          export DEPLOY_DRY_RUN="${DEPLOY_DRY_RUN_PARAM:-false}"
          bash scripts/deploy/remove-retired-workloads.sh
          WORK_DIR="$WORKSPACE/.jenkins-tmp" bash scripts/deploy/service-deploy.sh
        '''
        script { if (params.INTENT_ID?.trim()) { sh '''
          # DEPLOYED — terminal claim state, written only after service-deploy.sh returned 0.
          python3 - "/Users/abhinav/oe-ops/zerodte-audit/jenkins-intents/${INTENT_ID}.json" <<'PYEOF'
import json,os,sys
path=sys.argv[1]; rec=json.load(open(path))
rec["state"]="DEPLOYED"; rec["version"]+=1
tmp=path+".tmp"
with open(tmp,"w") as f: json.dump(rec,f); f.flush(); os.fsync(f.fileno())
os.rename(tmp,path)
d=os.open(os.path.dirname(path),os.O_RDONLY); os.fsync(d); os.close(d)
PYEOF
        ''' } }
      }
    }
    stage('Verify web UI (post-rollout)') {
      when {
        expression { params.SERVICE == 'web' && !params.DEPLOY_DRY_RUN }
      }
      steps {
        // The web image is built by options-edge-web-deploy, whose Selenium smoke runs there --
        // i.e. BEFORE this job rolls the image. That smoke therefore exercises the PREVIOUSLY
        // deployed UI, never the one this job just deployed. Without this stage the recommended
        // build-then-deploy sequence could go green having verified nothing but a readiness probe.
        //
        // Same smoke the monolith runs in 'Verify OptionsEdge Web App', same URLs, so a
        // service-scoped web deploy is checked exactly as a full deploy is. The script is
        // auth-on/off portable: public "/" and "/option-chain" must be 200 while /api/** may
        // legitimately be 401 behind Keycloak.
        sh '''
          set -euo pipefail
          if [ "${ENVIRONMENT:-dev}" = "dev" ]; then
            WEB_PUBLIC_URL="${WEB_PUBLIC_URL:-http://localhost:8090}" \
              scripts/smoke/check-options-edge-web.sh
          else
            WEB_PUBLIC_URL="${PROD_WEB_PUBLIC_URL:-http://192.168.100.252:8094}" \
              scripts/smoke/check-options-edge-web.sh
          fi
        '''
      }
    }
  }
  post {
    always {
      // Guaranteed un-pause. The pause above is the only step in this pipeline that can leave a
      // service DOWN if a later step fails: if the prune or the deploy dies after scale-down,
      // nothing else would ever scale it back and the service stays at zero replicas
      // indefinitely. Restoring here costs nothing on success -- a successful Deploy has already
      // set replicas from the manifest, so the marker is simply cleared.
      sh '''
        set -uo pipefail
        bash scripts/deploy/vix-unpause.sh "$WORKSPACE/.jenkins-tmp/vix-paused-replicas"
      '''
      archiveArtifacts artifacts: '.jenkins-tmp/*-*.yaml', allowEmptyArchive: true
    }
  }
}
