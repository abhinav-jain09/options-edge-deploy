@Library('oe') _

// GENERIC STANDALONE SERVICE DEPLOY — one job for every processing service
// (standalone-service-deployment design; web has its own job with the native web build).
//
// Deploys ONE service's workload to ONE environment in minutes:
//   render k8s/services/<SERVICE>/overlays/<env> (a GENERATED snapshot of the monolith's
//   render of just that service — mirror rule by construction) → blast-radius guard →
//   digest-pin → apply ONLY that workload → rollout each of its Deployments → health gate
//   → rollback command in the log.
//
// Image builds: BUILD_IMAGES=true builds+pushes ONLY the selected service's image first, then deploys.
// Routing is by services.yaml `.buildJob`: most services build in the options-edge-processing Maven
// reactor (BUILD_TARGET=<image>, `mvn -pl <module> -am` — a few minutes, not the whole ~25-image reactor);
// feed-gateway and databento-feed build in their OWN repo jobs (option-edge-feed-gateway /
// options-edge-databento-feed-deploy) — the reactor has no module for them, so service-deploy routes to
// the buildJob (build+push only via DEPLOY_AND_VERIFY=false). Leave BUILD_IMAGES=false to deploy the image
// already in the env registry (the fastest path).
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    choice(name: 'SERVICE', choices: [
      'databento-feed', 'databento-gex', 'databento-gex-history', 'databento-maxpain', 'databento-mission-sandwich',
      'databento-volume-aggregator', 'dealer-ledger', 'dealer-ledger-calibration', 'delta-flow',
      'directional-pressure', 'es-open-direction', 'es-open-direction-postgres-writer', 'zero-dte-intelligence', 'feed-gateway', 'gex-delta-redis-writer', 'hpsf-postgres-writer', 'option-price-behavior',
      'pin-postgres-writer', 'pressure-postgres-writer', 'raw-postgres-writer', 'raw-to-display',
      'invasion-postgres-writer', 'reversal-confirmation', 'reversal-postgres-writer', 'short-premium-agent', 'spread-skew', 'spread-skew-postgres-writer', 'spx-mission-control', 'strike-flow-avro-adapter', 'strike-flow-classifier', 'strike-intelligence', 'strike-invasion', 'strike-liquidity-heatmap',
      'unified-sr', 'volume-pace', 'signal-follower'
    ], description: 'Which service to deploy (dir under k8s/services; kept in sync with services.yaml standalone entries — added dealer-ledger + feed-gateway + short-premium-agent + strike-invasion + invasion-postgres-writer + spread-skew + spread-skew-postgres-writer + es-open-direction + es-open-direction-postgres-writer + reversal-postgres-writer, dropped 14-disabled-service leftovers per #288).')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'production'],
      description: 'Target environment — selects the overlay + deployer kubeconfig (oeProfile).')
    booleanParam(name: 'BUILD_IMAGES', defaultValue: false,
      description: 'Build+push ONLY the selected service\'s image first, then deploy. Routes by services.yaml buildJob: the processing reactor (mvn -pl <module> -am) for most, or the service\'s own build job (feed-gateway, databento-feed). false = deploy the image already in the registry (fastest path).')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: false,
      description: 'true = render + digest-pin + server-side validate only; nothing changes.')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
  }
  options {
    disableConcurrentBuilds()
    // 120 min: a single-service BUILD_IMAGES build is only a few minutes, but the cap stays
    // generous to absorb queue/remote-build time (prod builds run on .252 over ssh). The old
    // 45-min cap killed builds mid-flight ("Cancelling nested steps due to timeout" — runs #5/#6).
    timeout(time: 120, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG           = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    ENVIRONMENT          = "${params.ENVIRONMENT}"
    SERVICE_PARAM        = "${params.SERVICE}"
    DEPLOY_DRY_RUN_PARAM = "${params.DEPLOY_DRY_RUN}"
  }
  stages {
    stage('Validate service registry') {
      steps {
        sh '''
          set -euo pipefail
          bash scripts/ci/validate-services.sh
        '''
      }
    }
    stage('Build image (this service only)') {
      when { expression { params.BUILD_IMAGES && !params.DEPLOY_DRY_RUN } }
      steps {
        script {
          // Build ONLY the selected service's image (fast path), not the whole processing set.
          // MOST services build in the options-edge-processing Maven reactor (image->module,
          // `mvn -pl <module> -am`, then build+push just that image). A few build in their OWN repo
          // job — services.yaml records that as `buildJob` (feed-gateway -> option-edge-feed-gateway,
          // databento-feed -> options-edge-databento-feed-deploy). The processing reactor has no module
          // for those, so passing BUILD_TARGET=<their image> fails with "Unknown BUILD_TARGET". Route by
          // the buildJob field. SERVICE_PARAM is read by the shell (env), never Groovy-interpolated
          // (injection-safe, matches the rest of these jobs).
          def buildJob = sh(
            script: 'set -euo pipefail; yq -r ".services[] | select(.name == \\"$SERVICE_PARAM\\") | .buildJob // \\"\\"" services.yaml',
            returnStdout: true
          ).trim()
          if (buildJob && buildJob != 'null') {
            // Own-repo build job. DEPLOY_AND_VERIFY=false = build+push ONLY — CRITICAL: with the default
            // (true) those jobs trigger service-deploy to roll+verify the dev pod, which would recurse
            // back into THIS job. The Deploy stage below does the rollout. The child derives its registry
            // + platform from ENVIRONMENT (oeProfile for the registry, arch per env) and defaults its
            // REMOTE_BUILD_* to .252, so only ENVIRONMENT + the two build-only knobs are passed — both
            // reachable buildJobs (option-edge-feed-gateway, options-edge-databento-feed-deploy) declare
            // all three. (Minor: the databento job still refreshes its dev replay venv — harmless.)
            echo "Building ${env.SERVICE_PARAM} via its own build job '${buildJob}' (build+push only)"
            build job: buildJob,
                  parameters: [
                    string(name: 'ENVIRONMENT',         value: params.ENVIRONMENT),
                    booleanParam(name: 'PUSH_IMAGE',        value: true),
                    booleanParam(name: 'DEPLOY_AND_VERIFY', value: false)
                  ],
                  wait: true, propagate: true
          } else {
            def image = sh(
              script: 'set -euo pipefail; yq -r ".services[] | select(.name == \\"$SERVICE_PARAM\\") | .image" services.yaml',
              returnStdout: true
            ).trim()
            if (!image || image == 'null') {
              error("service-deploy: could not resolve an image for SERVICE='${env.SERVICE_PARAM}' from services.yaml")
            }
            echo "Building ONLY ${env.SERVICE_PARAM} -> BUILD_TARGET=${image}"
            build job: 'options-edge-processing',
                  parameters: [
                    string(name: 'ENVIRONMENT',        value: params.ENVIRONMENT),
                    string(name: 'BUILD_TARGET',       value: image),
                    string(name: 'PROCESSING_BRANCH',  value: 'main'),
                    string(name: 'CONTRACTS_BRANCH',   value: 'main'),
                    booleanParam(name: 'PUSH_IMAGES',  value: true)
                  ],
                  wait: true, propagate: true
          }
        }
      }
    }
    stage('Reconcile 0DTE current topic') {
      when {
        expression { params.SERVICE == 'zero-dte-intelligence' && !params.DEPLOY_DRY_RUN }
      }
      steps {
        sh '''
          set -euo pipefail
          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          scripts/kafka/ensure-zero-dte-intelligence-topic.sh
        '''
      }
    }
    stage('Deploy (service-scoped)') {
      steps {
        sh '''
          set -euo pipefail
          export SERVICE="${SERVICE_PARAM:?}"
          export DEPLOY_DRY_RUN="${DEPLOY_DRY_RUN_PARAM:-false}"
          WORK_DIR="$WORKSPACE/.jenkins-tmp" bash scripts/deploy/service-deploy.sh
        '''
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: '.jenkins-tmp/*-*.yaml', allowEmptyArchive: true
    }
  }
}
