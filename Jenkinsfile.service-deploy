@Library('oe') _

// GENERIC STANDALONE SERVICE DEPLOY — one job for every processing service
// (standalone-service-deployment design; web has its own job with the native web build).
//
// Deploys ONE service's workload to ONE environment in minutes:
//   render k8s/services/<SERVICE>/overlays/<env> (a GENERATED snapshot of the monolith's
//   render of just that service — mirror rule by construction) → blast-radius guard →
//   digest-pin → apply ONLY that workload → rollout each of its Deployments → health gate
//   → rollback command in the log.
//
// Image builds: BUILD_IMAGES=true builds+pushes ONLY the selected service's image first
// (options-edge-processing with BUILD_TARGET=<this service's image>, i.e. `mvn -pl <module> -am`
// then build just that image — a few minutes, not the whole ~25-image reactor). Leave false to
// deploy the image already in the env registry (the fastest path).
// EXCEPTION databento-feed: its image builds in its OWN job
// (options-edge-databento-feed-deploy) — run that first, then deploy here with
// BUILD_IMAGES=false (the processing reactor has no feed module).
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    choice(name: 'SERVICE', choices: [
      'databento-feed', 'databento-sr3-feed', 'databento-gex', 'databento-gex-history', 'databento-maxpain', 'databento-mission-sandwich',
      'databento-volume-aggregator', 'dealer-ledger', 'dealer-ledger-calibration', 'delta-flow',
      'directional-pressure', 'es-open-direction', 'es-open-direction-postgres-writer', 'vix-option-inteligence', 'feed-gateway', 'gex-delta-redis-writer', 'hpsf-postgres-writer', 'option-price-behavior',
      'option-truth-engine', 'market-carry', 'pin-postgres-writer', 'pressure-postgres-writer', 'raw-postgres-writer', 'raw-to-display',
      'invasion-postgres-writer', 'reversal-confirmation', 'reversal-postgres-writer', 'short-premium-agent', 'spread-skew', 'es-gex-spx-align', 'spread-skew-postgres-writer', 'spx-mission-control', 'strike-flow-avro-adapter', 'strike-flow-classifier', 'strike-intelligence', 'strike-invasion', 'strike-liquidity-heatmap',
      'unified-sr', 'volume-pace', 'signal-follower', 'greek-move-authenticity'
    ], description: 'Which service to deploy (dir under k8s/services; kept in sync with services.yaml standalone entries — added dealer-ledger + feed-gateway + short-premium-agent + strike-invasion + invasion-postgres-writer + spread-skew + spread-skew-postgres-writer + es-open-direction + es-open-direction-postgres-writer + reversal-postgres-writer, dropped 14-disabled-service leftovers per #288).')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'production'],
      description: 'Target environment — selects the overlay + deployer kubeconfig (oeProfile).')
    booleanParam(name: 'BUILD_IMAGES', defaultValue: false,
      description: 'Build+push ONLY the selected service\'s image first (options-edge-processing with BUILD_TARGET=<this service>, mvn -pl <module> -am — a few minutes, not the whole reactor). false = deploy the image already in the registry (fastest path).')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: false,
      description: 'true = render + digest-pin + server-side validate only; nothing changes.')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
  }
  options {
    disableConcurrentBuilds()
    // 120 min: a single-service BUILD_IMAGES build is only a few minutes, but the cap stays
    // generous to absorb queue/remote-build time (prod builds run on .252 over ssh). The old
    // 45-min cap killed builds mid-flight ("Cancelling nested steps due to timeout" — runs #5/#6).
    timeout(time: 120, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG           = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    ENVIRONMENT          = "${params.ENVIRONMENT}"
    SERVICE_PARAM        = "${params.SERVICE}"
    DEPLOY_DRY_RUN_PARAM = "${params.DEPLOY_DRY_RUN}"
  }
  stages {
    stage('Validate service registry') {
      steps {
        sh '''
          set -euo pipefail
          bash scripts/ci/validate-services.sh
        '''
      }
    }
    stage('Build image (this service only)') {
      when { expression { params.BUILD_IMAGES && !params.DEPLOY_DRY_RUN } }
      steps {
        script {
          // Build ONLY the selected service's image (fast path), not the whole processing set.
          // Resolve the service's image name from services.yaml and pass it as BUILD_TARGET; the
          // processing job maps image->maven module and runs `mvn -pl <module> -am`, then builds+pushes
          // just that image. SERVICE_PARAM is read by the shell (env), never Groovy-interpolated into the
          // script text (injection-safe, matches the rest of these jobs).
          // NOTE: databento-feed, databento-sr3-feed and feed-gateway have no processing module (they build in their own
          // repos' jobs — options-edge-databento-feed-deploy and feed-gateway-deploy respectively);
          // selecting either with BUILD_IMAGES=true fails fast in the processing job with the valid
          // list. Build their image via the own-repo job first, then deploy here with BUILD_IMAGES=false.
          def image = sh(
            script: 'set -euo pipefail; yq -r ".services[] | select(.name == \\"$SERVICE_PARAM\\") | .image" services.yaml',
            returnStdout: true
          ).trim()
          if (!image || image == 'null') {
            error("service-deploy: could not resolve an image for SERVICE='${env.SERVICE_PARAM}' from services.yaml")
          }
          echo "Building ONLY ${env.SERVICE_PARAM} -> BUILD_TARGET=${image}"
          build job: 'options-edge-processing',
                parameters: [
                  string(name: 'ENVIRONMENT',        value: params.ENVIRONMENT),
                  string(name: 'BUILD_TARGET',       value: image),
                  string(name: 'PROCESSING_BRANCH',  value: 'main'),
                  string(name: 'CONTRACTS_BRANCH',   value: 'main'),
                  booleanParam(name: 'PUSH_IMAGES',  value: true)
                ],
                wait: true, propagate: true
        }
      }
    }
    stage('Reconcile VIX option intelligence current topic') {
      when {
        expression { params.SERVICE == 'vix-option-inteligence' && !params.DEPLOY_DRY_RUN }
      }
      steps {
        // Topic reconcile FIRST, while the service is still serving. Only the identity prune
        // needs the service down, so nothing else belongs inside the outage window.
        sh '''
          set -euo pipefail
          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          RECONCILE_PHASE=topic scripts/kafka/ensure-vix-option-inteligence-topic.sh
        '''
        // Then pause and prune. The monolith Jenkinsfile does the same thing for the other ~40
        // services ('Pause Runtime For Kafka Cleanup' before 'Kafka Cleanup'); this is that
        // pattern scoped to the single service this pipeline deploys. Retiring an identity a
        // live pod still holds can never converge -- the prune deletes the group and the
        // consumer rejoins in milliseconds.
        sh '''
          set -euo pipefail
          DEP=deployment/vix-option-inteligence-service
          SEL=app.kubernetes.io/name=vix-option-inteligence-service
          mkdir -p "$WORKSPACE/.jenkins-tmp"
          MARK="$WORKSPACE/.jenkins-tmp/vix-paused-replicas"

          # Counts live pods, or FAILS. Piping a failed 'kubectl get' into wc -l yields 0, which
          # reads as 'no pods running' -- an unknown state masquerading as a verified-empty one,
          # the same mistake as treating a failed lookup as 'deployment absent'. Callers must
          # check the return code, not just the number.
          live_pods() {
            # stderr goes to its own file, never into the value. kubectl prints
            # "No resources found in <ns> namespace." on STDERR for an empty selection: with
            # '2>&1' that sentence lands in the value, awk counts it as one running pod, and the
            # wait loop never sees zero -- observed doing exactly that in build #680, where the
            # pod was already Terminating and the pause still timed out.
            local out rc errf
            errf="$(mktemp)"
            out="$(kubectl -n options-edge get pods -l "$SEL" --no-headers 2>"$errf")"
            rc=$?
            if [ "$rc" -ne 0 ]; then
              echo "FATAL: could not list pods for $SEL: $(cat "$errf")" >&2
              rm -f "$errf"
              return 1
            fi
            rm -f "$errf"
            printf '%s\n' "$out" \
              | awk '$3 !~ /^(Completed|Succeeded|Error|Failed)$/ && NF { print }' | wc -l | tr -d ' '
          }

          # ABSENT and UNKNOWN are different answers. 'kubectl get' failing on RBAC, a timeout or
          # an API error is not proof the deployment is missing, and treating it as such would
          # skip the pause and prune against a service that is still consuming -- the exact bug
          # this stage exists to fix.
          #
          # The absence test is STRUCTURAL, not a substring search of stderr: '--ignore-not-found
          # -o name' exits 0 with empty stdout when the object is absent, 0 with its name when it
          # exists, and non-zero for any real failure. Grepping the combined output for 'NotFound'
          # would misread an RBAC or transport error that merely happens to carry that token.
          set +e
          probe="$(kubectl -n options-edge get "$DEP" --ignore-not-found -o name 2>/dev/null)"
          probe_rc=$?
          set -e
          if [ "$probe_rc" -ne 0 ]; then
            echo "FATAL: could not determine whether $DEP exists (kubectl exit $probe_rc)" >&2
            exit 1
          fi
          if [ -z "$probe" ]; then
            # A first deploy into an environment that has no workload yet: nothing holds the
            # retired identity, so there is nothing to pause.
            echo "no $DEP yet; nothing to pause."
          else
            PREV_ERR="$(mktemp)"
            PREV="$(kubectl -n options-edge get "$DEP" -o jsonpath='{.spec.replicas}' 2>"$PREV_ERR")"
            PREV_RC=$?
            # Refused, not defaulted to 1. This value is the ONLY record of what to restore to;
            # guessing it and then scaling to zero means the un-pause would bring the service
            # back at the wrong size -- or, if the deployment runs more than one replica, quietly
            # shrink it. If we cannot read it, we must not scale at all.
            case "$PREV" in
              ''|*[!0-9]*) PREV_RC=1 ;;
            esac
            if [ "$PREV_RC" -ne 0 ]; then
              echo "FATAL: could not read current replicas for $DEP: [$PREV] $(cat "$PREV_ERR")" >&2
              echo "Refusing to pause: without the current replica count the restore would guess." >&2
              rm -f "$PREV_ERR"
              exit 1
            fi
            rm -f "$PREV_ERR"

            # An EXISTING marker is never overwritten. It records the size from before an earlier
            # pause that was never undone, and it is the only surviving record of it. Overwriting
            # would be worst exactly where it matters most: a previous run pauses at 3, its
            # restore fails, the service sits at 0; this run reads PREV=0, stamps 0 over the 3,
            # "restores" to 0, and the correct size is gone for good.
            if [ -f "$MARK" ]; then
              STRANDED="$(cat "$MARK")"
              case "$STRANDED" in
                ''|*[!0-9]*)
                  echo "FATAL: recovery marker $MARK holds an unusable value [$STRANDED]." >&2
                  echo "Resolve it by hand -- the correct replica count cannot be guessed." >&2
                  exit 1 ;;
              esac
              echo "Recovery marker from an earlier run found (replicas=$STRANDED); keeping it rather than stamping the current $PREV over it."
              PREV="$STRANDED"
            else
              # Written BEFORE scaling: if the scale half-succeeds and the step then dies, post{}
              # must still know a restore is owed.
              printf '%s\n' "$PREV" > "$MARK"
            fi
            kubectl -n options-edge scale "$DEP" --replicas=0

            # Both conditions are read through explicit return codes: an unreadable desired-replica
            # count or an unreadable pod list must stop the pause, never satisfy it.
            desired_replicas() {
              # Same discipline as live_pods: stderr to its own file, never merged into the
              # value, and the result must be digits. A warning folded into the value would make
              # a genuine "0" compare unequal to "0" and the pause would never be satisfied.
              local out rc errf
              errf="$(mktemp)"
              out="$(kubectl -n options-edge get "$DEP" -o jsonpath='{.spec.replicas}' 2>"$errf")"
              rc=$?
              if [ "$rc" -ne 0 ]; then
                echo "FATAL: could not read desired replicas for $DEP: $(cat "$errf")" >&2
                rm -f "$errf"
                return 1
              fi
              rm -f "$errf"
              # NO '${out:-0}' default here. Defaulting empty to 0 would let an empty -- i.e.
              # unknown -- response satisfy the "desired replicas are zero" test, which is the
              # very unknown-as-zero class this function exists to stop. A Deployment always
              # carries a defaulted spec.replicas, so empty means something is wrong.
              case "$out" in
                ''|*[!0-9]*) echo "FATAL: unreadable desired replicas for $DEP: [$out]" >&2; return 1 ;;
              esac
              printf '%s' "$out"
            }

            for i in $(seq 1 60); do
              want="$(desired_replicas)" || exit 1
              pods="$(live_pods)"        || exit 1
              [ "$want" = "0" ] && [ "$pods" = "0" ] && break
              echo "Waiting for $DEP to stop; desired=$want pods=$pods"
              sleep 3
            done
            # Both conditions, deliberately: zero pods alone does not prove desired replicas are
            # zero -- a controller could be about to create one back.
            want="$(desired_replicas)" || exit 1
            pods="$(live_pods)"        || exit 1
            if [ "$want" != "0" ] || [ "$pods" != "0" ]; then
              echo "Timed out pausing $DEP before the identity prune; desired=$want pods=$pods" >&2
              kubectl -n options-edge get pods -l "$SEL" || true
              exit 1
            fi
            echo "$DEP paused (was $PREV); no consumer can hold the retired identity."
          fi

          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          RECONCILE_PHASE=prune scripts/kafka/ensure-vix-option-inteligence-topic.sh
        '''
      }
    }
    stage('Deploy (service-scoped)') {
      steps {
        sh '''
          set -euo pipefail
          export SERVICE="${SERVICE_PARAM:?}"
          export DEPLOY_DRY_RUN="${DEPLOY_DRY_RUN_PARAM:-false}"
          WORK_DIR="$WORKSPACE/.jenkins-tmp" bash scripts/deploy/service-deploy.sh
        '''
      }
    }
  }
  post {
    always {
      // Guaranteed un-pause. The pause above is the only step in this pipeline that can leave a
      // service DOWN if a later step fails: if the prune or the deploy dies after scale-down,
      // nothing else would ever scale it back and the service stays at zero replicas
      // indefinitely. Restoring here costs nothing on success -- a successful Deploy has already
      // set replicas from the manifest, so the marker is simply cleared.
      sh '''
        set -uo pipefail
        MARK="$WORKSPACE/.jenkins-tmp/vix-paused-replicas"
        [ -f "$MARK" ] || exit 0
        DEP=deployment/vix-option-inteligence-service

        # Validate the marker BEFORE touching the deployment. The stage refuses an unusable
        # marker; this block must too, or a corrupt, unreadable or half-written file becomes the
        # argument to 'kubectl scale --replicas=' -- the same unknown-as-a-value mistake, at the
        # one point that is supposed to be the safety net. The marker is KEPT on failure: it is
        # the only record that a restore is still owed, and deleting it would strand the service
        # silently.
        PREV="$(cat "$MARK" 2>/dev/null)"
        cat_rc=$?
        case "$PREV" in
          ''|*[!0-9]*) cat_rc=1 ;;
        esac
        if [ "$cat_rc" -ne 0 ]; then
          echo "FATAL: recovery marker $MARK is unreadable or holds an unusable value [$PREV]." >&2
          echo "$DEP may be paused at zero replicas. Resolve it by hand -- the correct replica count cannot be guessed. Marker kept at $MARK." >&2
          exit 1
        fi

        # An unreadable state is NOT a restored state. If this read fails, an empty NOW would
        # otherwise fall through to "no restore needed" and delete the marker -- turning a lost
        # answer into a silent, permanent outage. Read failure means: try the restore anyway,
        # and if that cannot be confirmed, keep the marker and fail loudly.
        # Structural absence test first, for the same reason as in the stage: a real failure whose
        # message merely contains 'NotFound' must not be read as "the workload is gone, nothing to
        # restore" -- that would delete the marker and leave the service down for good.
        # NOTE: this block deliberately runs WITHOUT 'set -e' (see 'set -uo pipefail' above).
        # Every kubectl here is expected to be able to fail; the whole point is to react to that
        # rather than abort. An earlier version paired 'set +e' with 'set -e', which switched -e
        # ON for the rest of the block -- so a failing replica read killed the script instantly
        # and the "attempt the restore anyway" branch below never ran. The guarantee this block
        # exists to provide was silently absent.
        exists="$(kubectl -n options-edge get "$DEP" --ignore-not-found -o name 2>/dev/null)"
        exists_rc=$?
        if [ "$exists_rc" -eq 0 ] && [ -z "$exists" ]; then
          echo "$DEP no longer exists; nothing to restore."
          rm -f "$MARK"
          exit 0
        fi

        # stderr is captured SEPARATELY, and the value must be digits. With '2>&1' a successful
        # read of "0" accompanied by any warning becomes "0\nWarning: ..." -- not equal to "0",
        # so it would fall through to "no restore needed", delete the marker, and leave the
        # service at zero replicas. A value that is not a plain number is an unreadable value,
        # not a non-zero one.
        ERRF="$(mktemp)"
        NOW="$(kubectl -n options-edge get "$DEP" -o jsonpath='{.spec.replicas}' 2>"$ERRF")"
        read_rc=$?
        NOW_ERR="$(cat "$ERRF")"; rm -f "$ERRF"
        case "$NOW" in
          ''|*[!0-9]*) read_rc=1; NOW_ERR="unreadable replica value [$NOW] stderr: $NOW_ERR" ;;
        esac

        if [ "$read_rc" -ne 0 ]; then
          echo "WARNING: could not read $DEP replicas ($NOW_ERR); attempting restore to $PREV regardless." >&2
          if kubectl -n options-edge scale "$DEP" --replicas="$PREV"; then
            echo "Restored $DEP to $PREV despite the unreadable state."
            rm -f "$MARK"
            exit 0
          fi
          echo "FATAL: $DEP state unreadable AND restore failed -- the service may be DOWN at zero replicas. Marker kept at $MARK for the next run." >&2
          exit 1
        fi

        if [ "$NOW" = "0" ]; then
          echo "Deploy did not restore $DEP; scaling back to $PREV so the pause cannot strand it."
          if ! kubectl -n options-edge scale "$DEP" --replicas="$PREV"; then
            echo "FATAL: could not restore $DEP to $PREV replicas -- it is STILL DOWN and needs manual attention. Marker kept at $MARK." >&2
            exit 1
          fi
        else
          echo "$DEP is at $NOW replicas; no restore needed."
        fi
        rm -f "$MARK"
      '''
      archiveArtifacts artifacts: '.jenkins-tmp/*-*.yaml', allowEmptyArchive: true
    }
  }
}
