// ES4 DEPLOY — the self-contained ES-0DTE environment on 192.168.100.4 ("es4").
//
// Deliberately SEPARATE from Jenkinsfile.service-deploy (Codex decision D3, 2026-07-12):
// zero changes to the SPX dev/production deploy path or its mirror-rule machinery.
// Manifests live in k8s/es4/ (generated from the production slices by
// scripts/es4/render_es4_manifests.py — reviewed + committed).
//
// ACTIONS:
//   infra-sync     rsync infra/es4 + scripts/es4 to the box and run bootstrap-es4.sh
//                  (k3s, registries.yaml, compose stack Kafka/SR/PG/Redis/MM2, topics,
//                  namespace + pg secret). Idempotent.
//   create-topics  run create-es-topics.sh on the box (idempotent).
//   clean-reset    Snapshot every es4 Deployment + application topic, stop all services/infra,
//                  wipe Kafka/SR, Streams state stores and service logs, recreate snapshotted
//                  topics, then start only the snapshotted services at captured replicas.
//                  DESTRUCTIVE (drops all es4 Kafka data); honors DEPLOY_DRY_RUN.
//   deploy-service apply ONE service from k8s/es4/services/<SERVICE>.yaml (digest-pinned).
//   deploy-all     apply es4-common-env + every manifest in k8s/es4/services (digest-pinned).
//   deploy-es-feed apply k8s/es4/prod/es-feed.yaml to the PROD cluster (the es-feed runs
//                  on .252 next to prod Kafka, producing to es4 — Gate-2 rev 10 wiring).
//
// Image policy: every apply digest-pins the :prod tag against 192.168.100.252:5000 at
// deploy time (Docker-Content-Digest) — a floating tag is never applied (Codex D4).
pipeline {
  agent { label 'local-mac' }
  parameters {
    choice(name: 'ACTION', choices: ['deploy-service', 'deploy-all', 'infra-sync', 'create-topics', 'deploy-es-feed', 'clean-reset', 'activate-es-feed', 'deactivate-es-feed'],
      description: 'What to do (see header).')
    choice(name: 'SERVICE', choices: [
      'close-direction',
      'databento-gex', 'databento-gex-history', 'databento-maxpain', 'databento-mission-sandwich',
      'databento-volume-aggregator', 'dealer-ledger', 'dealer-ledger-calibration', 'delta-flow',
      'directional-pressure', 'gex-delta-redis-writer', 'option-price-behavior', 'option-truth-engine', 'pin-postgres-writer',
      'pressure-postgres-writer', 'raw-to-display', 'strike-flow-avro-adapter', 'strike-flow-classifier',
      'strike-liquidity-heatmap', 'volume-pace', 'spread-skew', 'spread-skew-postgres-writer',
      'strike-intelligence', 'vix-option-inteligence', 'es-aggressor-flow', 'es-feed-gateway', 'es-web',
      'es-feed'
    ], description: 'Service (deploy-service only). NOTE: es-feed is the RELOCATED ES options feed now running on the es4 cluster; it always deploys at replicas 0 — starting it is a separate ACTION=activate-es-feed.')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: false,
      description: 'true = render + digest-pin + kubectl apply --dry-run=server only.')
    choice(name: 'ES_FEED_LOCATION', choices: ['none', 'prod', 'es4'],
      description: 'DECLARED desired location of the single live es-feed. It is a LOCATION, not a boolean, because exactly one may be live: one shared Databento API key cannot carry two concurrent ES option-chain sessions, and both locations share the es-feed-spot consumer group. none (default) = es-feed must be DOWN everywhere. prod = the legacy prod-cluster deployment is the live one (the 2026-07-17 "never leave a wanted feed down" protection applies to it). es4 = the relocated es4-cluster deployment is the live one. clean-reset, activate-es-feed and deactivate-es-feed all derive their behaviour from this single value.')
    booleanParam(name: 'ES_FEED_ACK_OI_AND_CAPACITY', defaultValue: false,
      description: 'activate-es-feed only. Explicit acknowledgement of the two preconditions the requirement will not let a deploy assume: (1) the ES-OI consequence of DATABENTO_USE_LIVE_REPLAY=false has been resolved (ESM-Q4 — either es4 GEX moved to direct OI fetch, or the bounded out-of-band OI request landed), and (2) real .4 headroom has been MEASURED with the full es4 fleet running (DBP-V10/ESM-V6). Activation refuses to proceed without this.')
    string(name: 'EXPECTED_FEED_DIGEST', defaultValue: '',
      description: 'deploy-es-feed only: the sha256 digest the feed :prod tag MUST resolve to (paste from the options-edge-databento-feed-deploy build that contains the es-feed code). Fail-closed on mismatch — an old feed image can never be deployed as es-feed by accident.')
  }
  options { disableConcurrentBuilds(); timeout(time: 60, unit: 'MINUTES') }
  environment {
    ES4_HOST       = 'abhinav@192.168.100.4'
    ES4_KUBECONFIG = '/Users/abhinav/.kube/es4.kubeconfig'
    PROD_KUBECONFIG = '/Users/abhinav/.kube/jenkins-deployer-prod.kubeconfig'
    REGISTRY       = '192.168.100.252:5000'
  }
  stages {
    stage('Infra sync + bootstrap') {
      when { expression { params.ACTION == 'infra-sync' } }
      steps {
        sh '''
          set -euo pipefail
          # /home is root-owned on the box — create the es4 home via passwordless sudo, owned by the deploy user
          ssh -o BatchMode=yes "$ES4_HOST" 'sudo install -d -o "$(id -un)" -g "$(id -gn)" /home/es4 /home/es4/repo /home/es4/repo/infra /home/es4/repo/scripts'
          rsync -az --delete infra/es4  "$ES4_HOST":/home/es4/repo/infra/
          # ES helpers call shared siblings under scripts/kafka. Sync the complete repo-owned
          # scripts tree so an on-box cleanup never runs with a partial dependency graph.
          rsync -az --delete scripts/ "$ES4_HOST":/home/es4/repo/scripts/
          ssh -o BatchMode=yes "$ES4_HOST" 'bash /home/es4/repo/scripts/es4/bootstrap-es4.sh'
        '''
      }
    }
    stage('Create topics') {
      when { expression { params.ACTION == 'create-topics' } }
      steps {
        sh '''
          set -euo pipefail
          rsync -az --delete scripts/ "$ES4_HOST":/home/es4/repo/scripts/
          ssh -o BatchMode=yes "$ES4_HOST" 'bash /home/es4/repo/scripts/es4/create-es-topics.sh'
        '''
      }
    }
    stage('Clean reset (atomic Kafka + Schema Registry wipe)') {
      // Wipe Kafka data (all topics + _schemas) TOGETHER so no message can outlive its schema
      // id — the fix for the dead-schema-id poison ("Malformed data. Length is negative") that
      // wedged the scorer. DESTRUCTIVE: drops all es4 Kafka data; honor DEPLOY_DRY_RUN to preview.
      //
      // The prod es-feed (options-edge/es-feed on .252) publishes to es4 Kafka+SR from OUTSIDE the
      // es4 cluster, so we MUST fence it here (with the prod kubeconfig) around the on-box wipe —
      // otherwise it reconnects and re-emits cached schema ids into the fresh cluster, recreating
      // the exact poison. Restored on exit even if the wipe fails, so the feed is never left down.
      when { expression { params.ACTION == 'clean-reset' } }
      steps {
        sh '''
          set -euo pipefail
          rsync -az --delete scripts/ "$ES4_HOST":/home/es4/repo/scripts/

          KP="KUBECONFIG=$PROD_KUBECONFIG kubectl -n options-edge"
          FEED_REP=$(eval "$KP get deploy es-feed -o jsonpath='{.spec.replicas}'" 2>/dev/null || echo 0)
          [ -n "$FEED_REP" ] || FEED_REP=0
          # Restore semantics derive from the DECLARED LOCATION (requirement DBP-R21/R28), never
          # from a blanket 0 -> 1 rewrite — that unconditional clamp is exactly what re-raised
          # es-feed into its SIGKILL loop as a deploy side effect on 2026-07-24.
          #   ES_FEED_LOCATION=prod -> prod is the wanted live location, so the original 2026-07-17
          #     protection applies: never leave it down behind a green build; a captured 0 -> 1.
          #   ES_FEED_LOCATION=es4|none -> prod must NOT be raised; the captured count is preserved
          #     verbatim, including 0, and a stray 1 is forced DOWN to 0 so a clean-reset can never
          #     leave two ES sessions live on the one shared key.
          if [ "${ES_FEED_LOCATION:-none}" = "prod" ]; then
            # ⚠️ Deliberately does NOT clamp 0 -> 1. The 2026-07-17 protection was "never leave a
            # RUNNING feed down behind a green build", which is satisfied by restoring the captured
            # count verbatim. Raising a feed that was already at 0 would make clean-reset an
            # activation path, which DBP-R22 forbids — that is precisely the class of side effect
            # that caused the 2026-07-24 incident. If prod should be live, run activate-es-feed.
            echo "es-feed declared location=prod -> prod will be restored to its captured count $FEED_REP (0 stays 0; use activate-es-feed to start it)"
          else
            if [ "$FEED_REP" != "0" ]; then
              echo "es-feed declared location=${ES_FEED_LOCATION:-none} but prod es-feed is at $FEED_REP — forcing prod restore target to 0"
              FEED_REP=0
            fi
            echo "es-feed declared location=${ES_FEED_LOCATION:-none} -> prod restore target 0"
          fi
          # ⚠️ The on-box wipe (scripts/es4/cleanup-es4.sh) independently restores es4 Deployments to
          # their CAPTURED replica counts, which is blind to this parameter. If es4 es-feed is live and
          # the declared location is not es4, that restore would bring it back and — combined with the
          # prod restore below — could put two ES sessions on one key. Fail closed BEFORE the wipe.
          if [ "${ES_FEED_LOCATION:-none}" != "es4" ]; then
            es4_rep=$(KUBECONFIG="$ES4_KUBECONFIG" kubectl -n options-edge get deploy es-feed -o jsonpath='{.spec.replicas}' 2>/dev/null || echo 0)
            if [ "${es4_rep:-0}" != "0" ]; then
              echo "CLEAN-RESET REFUSED: es4 es-feed is at replicas=$es4_rep but ES_FEED_LOCATION=${ES_FEED_LOCATION:-none}." >&2
              echo "  The on-box cleanup restores captured es4 replica counts and would bring it back," >&2
              echo "  which together with the prod restore can put two ES option-chain sessions on the" >&2
              echo "  single shared Databento key. Run ACTION=deactivate-es-feed first, or set" >&2
              echo "  ES_FEED_LOCATION=es4 if es4 is genuinely the wanted live location." >&2
              exit 1
            fi
          fi

          if [ "${DEPLOY_DRY_RUN}" = "true" ]; then
            echo "DRY: would scale prod es-feed ($FEED_REP -> 0), run on-box wipe, restore es-feed to $FEED_REP"
            ssh -o BatchMode=yes "$ES4_HOST" "DEPLOY_DRY_RUN=true ES4_FEED_FENCED=1 bash /home/es4/repo/scripts/es4/cleanup-es4.sh"
            exit 0
          fi

          # ALWAYS restore the feed, even if the wipe aborts (never leave prod es-feed down), and
          # VERIFY it: if the feed can't be scaled back to its captured count, fail the build (a
          # green run must never leave the prod es-feed at 0).
          restore_feed() {
            eval "$KP scale deploy/es-feed --replicas=$FEED_REP" || true
            got=$(eval "$KP get deploy es-feed -o jsonpath='{.spec.replicas}'" 2>/dev/null || echo ERR)
            [ "$got" = "$FEED_REP" ] || { echo "ERROR: prod es-feed NOT restored (want $FEED_REP got $got) — scale it back manually" >&2; exit 1; }
          }
          trap restore_feed EXIT

          echo "=== fencing prod es-feed (scale $FEED_REP -> 0, wait for pods DELETED) ==="
          eval "$KP scale deploy/es-feed --replicas=0"
          # wait for actual DELETION (a Terminating pod can still produce during its grace period);
          # awk count (not grep|wc) so an empty result is not a pipefail-fatal exit.
          eval "$KP wait --for=delete pod -l app.kubernetes.io/name=es-feed --timeout=150s" || true
          n=$(eval "$KP get pods -l app.kubernetes.io/name=es-feed --no-headers" 2>/dev/null | awk 'END{print NR+0}')
          [ "$n" = "0" ] || { echo "prod es-feed pods still present ($n) — aborting before wipe" >&2; exit 1; }

          echo "=== running on-box atomic wipe (feed fenced) ==="
          ssh -o BatchMode=yes "$ES4_HOST" "DEPLOY_DRY_RUN=false ES4_FEED_FENCED=1 bash /home/es4/repo/scripts/es4/cleanup-es4.sh"
          # trap restores the feed after the fresh Kafka+SR+topics are ready
        '''
      }
    }
    stage('Deploy to es4') {
      when { expression { params.ACTION == 'deploy-service' || params.ACTION == 'deploy-all' } }
      steps {
        sh '''
          set -euo pipefail
          export KUBECONFIG="$ES4_KUBECONFIG"
          DRY=""; [ "${DEPLOY_DRY_RUN:-false}" = "true" ] && DRY="--dry-run=server"
          kubectl apply $DRY -f k8s/es4/es4-base-env.yaml
          kubectl apply $DRY -f k8s/es4/es4-common-env.yaml
          # es-feed's OWN Databento configmap. Applied for every es4 deploy so the feed can
          # never run against inherited library defaults again (requirement DBP-R1/R2).
          kubectl apply $DRY -f k8s/es4/es4-feed-config.yaml
          mkdir -p .jenkins-tmp

          # ---- es-feed preflight: fail CLOSED before the DEPLOYMENT is applied -----------
          # (The three shared configmaps above are applied first; this is not "before all
          # mutation", it is before anything that could create or change the feed workload.)
          # Three independent hazards, each of which has already bitten us:
          #  (1) the shared Databento API key cannot carry two concurrent ES option-chain
          #      sessions, and both locations share the es-feed-spot consumer group;
          #  (2) the API-key secret does not exist in the es4 cluster yet — a missing or empty
          #      secret must be a loud failure, not a CrashLoop;
          #  (3) activation must never be a deploy side effect (requirement DBP-R22).
          if { [ "$ACTION" = "deploy-service" ] && [ "$SERVICE" = "es-feed" ]; } || [ "$ACTION" = "activate-es-feed" ]; then
            bash scripts/es4/assert-es-feed-exclusive.sh "$ES4_KUBECONFIG" "$PROD_KUBECONFIG" es4
          fi
          # es-feed is EXCLUDED from deploy-all on purpose: it owns a Databento live session on a
          # shared API key, so it must only ever be applied as a deliberate, individually preflighted
          # action (SERVICE=es-feed) — never swept in by a bulk deploy that bypasses the preflight
          # above. `|| true` because grep exits 1 when it filters nothing, which under
          # `set -euo pipefail` would abort the whole deploy.
          if [ "$ACTION" = "deploy-all" ]; then
            FILES=$(ls k8s/es4/services/*.yaml | { grep -v '/es-feed[.]yaml$' || true; })
            [ -n "$FILES" ] || { echo "deploy-all: no service manifests resolved" >&2; exit 1; }
            echo "deploy-all: es-feed intentionally EXCLUDED (apply it explicitly with SERVICE=es-feed)"
          else
            FILES="k8s/es4/services/${SERVICE}.yaml"
          fi
          for f in $FILES; do
            bash scripts/es4/pin-and-apply.sh "$f" "$REGISTRY" "$DRY"
          done
          if [ -z "$DRY" ] && { [ "$ACTION" = "deploy-all" ] || [ "$SERVICE" = "vix-option-inteligence" ]; }; then
            # Remove the legacy identity only after pin-and-apply has completed the replacement
            # rollout, avoiding duplicate consumers on the isolated ES broker.
            kubectl -n options-edge delete deployment zero-dte-intelligence-service --ignore-not-found
            kubectl -n options-edge delete service zero-dte-intelligence-service --ignore-not-found
          fi
          if [ -z "$DRY" ] && [ "$ACTION" = "deploy-all" ]; then
            # Reconcile-delete the retired greek-move-authenticity-service on es4. Same reason as the
            # dev/prod path in scripts/deploy/apply.sh: `kubectl apply -f` never prunes, and the es4
            # service manifest is removed in this same commit, so the pod would otherwise run forever
            # against the isolated ES broker. deploy-all only — there is no longer a per-SERVICE file.
            kubectl -n options-edge delete deployment greek-move-authenticity-service --ignore-not-found
            kubectl -n options-edge delete service greek-move-authenticity-service --ignore-not-found
          fi
          # es-feed is NEVER started by a deploy: the manifest always carries replicas 0 and this
          # path performs no scaling at all — activation is its own ACTION (requirement DBP-R22).
          if [ "$ACTION" = "deploy-service" ] && [ "$SERVICE" = "es-feed" ]; then
            echo "es-feed manifest applied at replicas 0. To start it: ACTION=activate-es-feed"
          fi
          [ -n "$DRY" ] || kubectl -n options-edge get pods -o wide
        '''
      }
    }
    stage('Activate es-feed (separate authorized action)') {
      when { expression { params.ACTION == 'activate-es-feed' } }
      steps {
        sh '''
          set -euo pipefail
          # Activation is deliberately NOT part of any deploy path (requirement DBP-R22).
          [ "${ES_FEED_LOCATION:-none}" = "es4" ] || [ "${ES_FEED_LOCATION:-none}" = "prod" ] || {
            echo "activate-es-feed requires ES_FEED_LOCATION=es4 or prod (got '${ES_FEED_LOCATION:-none}')" >&2; exit 1; }
          # The two preconditions a deploy must never assume on the operator's behalf.
          [ "${ES_FEED_ACK_OI_AND_CAPACITY:-false}" = "true" ] || {
            echo "REFUSING TO ACTIVATE: ES_FEED_ACK_OI_AND_CAPACITY is false." >&2
            echo "  (1) DATABENTO_USE_LIVE_REPLAY=false means a start after the daily OI publication" >&2
            echo "      yields NO ES open interest, and es4 GEX is fail-closed on OI (ESM-Q4)." >&2
            echo "  (2) Real .4 headroom must be MEASURED with the full es4 fleet running (DBP-V10)." >&2
            exit 1; }
          bash scripts/es4/assert-es-feed-exclusive.sh "$ES4_KUBECONFIG" "$PROD_KUBECONFIG" "$ES_FEED_LOCATION"
          if [ "$ES_FEED_LOCATION" = "es4" ]; then KC="$ES4_KUBECONFIG"; else KC="$PROD_KUBECONFIG"; fi
          if [ "${DEPLOY_DRY_RUN:-false}" = "true" ]; then
            echo "DRY: would scale $ES_FEED_LOCATION es-feed to 1"; exit 0
          fi
          KUBECONFIG="$KC" kubectl -n options-edge scale deploy/es-feed --replicas=1
          KUBECONFIG="$KC" kubectl -n options-edge rollout status deploy/es-feed --timeout=600s
          echo "es-feed ACTIVE at $ES_FEED_LOCATION. Watch source age, not 'no restarts' —"
          echo "the widened startup grace can mask a client that is hours behind (DBP-R12)."
        '''
      }
    }
    stage('Deactivate es-feed') {
      when { expression { params.ACTION == 'deactivate-es-feed' } }
      steps {
        sh '''
          set -euo pipefail
          # Scale BOTH locations to 0 and wait for pods to disappear. Deactivation is always safe
          # to over-apply, and doing both removes any ambiguity about which one was live.
          for pair in "es4:$ES4_KUBECONFIG" "prod:$PROD_KUBECONFIG"; do
            loc=${pair%%:*}; kc=${pair#*:}
            KUBECONFIG="$kc" kubectl -n options-edge get deploy >/dev/null 2>&1 || {
              echo "DEACTIVATE FAILED: cannot reach the $loc cluster" >&2; exit 1; }
            KUBECONFIG="$kc" kubectl -n options-edge get deploy es-feed >/dev/null 2>&1 || { echo "$loc: no es-feed deployment"; continue; }
            if [ "${DEPLOY_DRY_RUN:-false}" = "true" ]; then echo "DRY: would scale $loc es-feed to 0"; continue; fi
            KUBECONFIG="$kc" kubectl -n options-edge scale deploy/es-feed --replicas=0
            for _ in $(seq 1 60); do
              n=$(KUBECONFIG="$kc" kubectl -n options-edge get pods -l app.kubernetes.io/name=es-feed --no-headers 2>/dev/null | wc -l | tr -d ' ')
              [ "${n:-0}" = "0" ] && break
              sleep 5
            done
            n=$(KUBECONFIG="$kc" kubectl -n options-edge get pods -l app.kubernetes.io/name=es-feed --no-headers 2>/dev/null | wc -l | tr -d ' ')
            [ "${n:-0}" = "0" ] || { echo "DEACTIVATE FAILED: $loc still has $n es-feed pod(s) after 5m" >&2; exit 1; }
            echo "$loc: es-feed scaled to 0, pods gone"
          done
        '''
      }
    }
    stage('Deploy es-feed to prod (LEGACY location — rollback only)') {
      when { expression { params.ACTION == 'deploy-es-feed' } }
      steps {
        sh '''
          set -euo pipefail
          export KUBECONFIG="$PROD_KUBECONFIG"
          DRY=""; [ "${DEPLOY_DRY_RUN:-false}" = "true" ] && DRY="--dry-run=server"
          # enforceable prerequisite: the resolved feed digest must equal the one from
          # the feed build that contains the es-feed code (Codex #12)
          [ -n "${EXPECTED_FEED_DIGEST:-}" ] || { echo "EXPECTED_FEED_DIGEST is required for deploy-es-feed" >&2; exit 1; }
          actual=$(curl -sfI -H 'Accept: application/vnd.docker.distribution.manifest.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.oci.image.index.v1+json' \
            "http://$REGISTRY/v2/options-edge-databento-feed/manifests/prod" | tr -d '\r' | awk -F': ' 'tolower($1)=="docker-content-digest" {print $2}')
          [ "$actual" = "$EXPECTED_FEED_DIGEST" ] || { echo "FEED DIGEST MISMATCH: registry=$actual expected=$EXPECTED_FEED_DIGEST" >&2; exit 1; }
          # HARD GUARD (USER requirement): this stage must NEVER touch the SPX feed.
          # Capture the SPX feed deployment's generation+image before, verify unchanged after.
          # Rollback must NOT be a return to the incident configuration: the prod-cluster copy of
          # es-feed's explicit configmap is applied here too (Codex MUST-FIX: the rollback target
          # otherwise inherited USE_LIVE_REPLAY=true and PUBLISH_INTERVAL_MS=250).
          kubectl apply $DRY -f k8s/es4/prod/es-feed-config.yaml
          # SPX guard: capture BEFORE, and fail closed if either read fails — two failed reads used
          # to compare equal and silently pass.
          spx_before=$(kubectl -n options-edge get deploy options-edge-databento-feed -o jsonpath='{.metadata.generation}{" "}{.spec.template.spec.containers[0].image}') || {
            echo "SPX GUARD FAILED: cannot read options-edge-databento-feed before the apply" >&2; exit 1; }
          bash scripts/es4/pin-and-apply.sh k8s/es4/prod/es-feed.yaml "$REGISTRY" "$DRY"
          spx_after=$(kubectl -n options-edge get deploy options-edge-databento-feed -o jsonpath='{.metadata.generation}{" "}{.spec.template.spec.containers[0].image}') || {
            echo "SPX GUARD FAILED: cannot read options-edge-databento-feed after the apply" >&2; exit 1; }
          if [ "$spx_before" != "$spx_after" ]; then
            echo "SPX FEED GUARD TRIPPED: options-edge-databento-feed changed during es-feed deploy (before='$spx_before' after='$spx_after')" >&2
            exit 1
          fi
          echo "SPX feed guard: options-edge-databento-feed untouched ($spx_after)"
          # The prod manifest is now replicas: 0 (Phase 0 — this location is rollback-only), so a
          # rollout wait is only meaningful when something is actually expected to run.
          if [ -z "$DRY" ]; then
            want=$(kubectl -n options-edge get deploy es-feed -o jsonpath='{.spec.replicas}' 2>/dev/null || echo 0)
            if [ "${want:-0}" = "0" ]; then
              echo "prod es-feed applied at replicas 0 (rollback-only location) — no rollout to wait for"
            else
              kubectl -n options-edge rollout status deploy/es-feed --timeout=300s
            fi
          fi
        '''
      }
    }
  }
  post { always { archiveArtifacts artifacts: '.jenkins-tmp/*.yaml', allowEmptyArchive: true } }
}
