// ES4 DEPLOY — the self-contained ES-0DTE environment on 192.168.100.4 ("es4").
//
// Deliberately SEPARATE from Jenkinsfile.service-deploy (Codex decision D3, 2026-07-12):
// zero changes to the SPX dev/production deploy path or its mirror-rule machinery.
// Manifests live in k8s/es4/ (generated from the production slices by
// scripts/es4/render_es4_manifests.py — reviewed + committed).
//
// ACTIONS:
//   infra-sync     rsync infra/es4 + scripts/es4 to the box and run bootstrap-es4.sh
//                  (k3s, registries.yaml, compose stack Kafka/SR/PG/Redis/MM2, topics,
//                  namespace + pg secret). Idempotent.
//   create-topics  run create-es-topics.sh on the box (idempotent).
//   clean-reset    Snapshot every es4 Deployment + application topic, stop all services/infra,
//                  wipe Kafka/SR, Streams state stores and service logs, recreate snapshotted
//                  topics, then start only the snapshotted services at captured replicas.
//                  DESTRUCTIVE (drops all es4 Kafka data); honors DEPLOY_DRY_RUN.
//   deploy-service apply ONE service from k8s/es4/services/<SERVICE>.yaml (digest-pinned).
//   deploy-all     apply es4-common-env + every manifest in k8s/es4/services (digest-pinned).
//   deploy-es-feed apply k8s/es4/prod/es-feed.yaml to the PROD cluster (the es-feed runs
//                  on .252 next to prod Kafka, producing to es4 — Gate-2 rev 10 wiring).
//
// Image policy: every apply digest-pins the :prod tag against 192.168.100.252:5000 at
// deploy time (Docker-Content-Digest) — a floating tag is never applied (Codex D4).
pipeline {
  agent { label 'local-mac' }
  parameters {
    choice(name: 'ACTION', choices: ['deploy-service', 'deploy-all', 'infra-sync', 'create-topics', 'deploy-es-feed', 'clean-reset'],
      description: 'What to do (see header).')
    choice(name: 'SERVICE', choices: [
      'databento-gex', 'databento-gex-history', 'databento-maxpain', 'databento-mission-sandwich',
      'databento-volume-aggregator', 'dealer-ledger', 'dealer-ledger-calibration', 'delta-flow',
      'directional-pressure', 'gex-delta-redis-writer', 'option-price-behavior', 'option-truth-engine', 'pin-postgres-writer',
      'pressure-postgres-writer', 'raw-to-display', 'strike-flow-avro-adapter', 'strike-flow-classifier',
      'strike-liquidity-heatmap', 'volume-pace', 'spread-skew', 'spread-skew-postgres-writer',
      'strike-intelligence', 'vix-option-inteligence', 'es-feed-gateway', 'es-web'
    ], description: 'Service (deploy-service only).')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: false,
      description: 'true = render + digest-pin + kubectl apply --dry-run=server only.')
    string(name: 'EXPECTED_FEED_DIGEST', defaultValue: '',
      description: 'deploy-es-feed only: the sha256 digest the feed :prod tag MUST resolve to (paste from the options-edge-databento-feed-deploy build that contains the es-feed code). Fail-closed on mismatch — an old feed image can never be deployed as es-feed by accident.')
  }
  options { disableConcurrentBuilds(); timeout(time: 60, unit: 'MINUTES') }
  environment {
    ES4_HOST       = 'abhinav@192.168.100.4'
    ES4_KUBECONFIG = '/Users/abhinav/.kube/es4.kubeconfig'
    PROD_KUBECONFIG = '/Users/abhinav/.kube/jenkins-deployer-prod.kubeconfig'
    REGISTRY       = '192.168.100.252:5000'
  }
  stages {
    stage('Infra sync + bootstrap') {
      when { expression { params.ACTION == 'infra-sync' } }
      steps {
        sh '''
          set -euo pipefail
          # /home is root-owned on the box — create the es4 home via passwordless sudo, owned by the deploy user
          ssh -o BatchMode=yes "$ES4_HOST" 'sudo install -d -o "$(id -un)" -g "$(id -gn)" /home/es4 /home/es4/repo /home/es4/repo/infra /home/es4/repo/scripts'
          rsync -az --delete infra/es4  "$ES4_HOST":/home/es4/repo/infra/
          # ES helpers call shared siblings under scripts/kafka. Sync the complete repo-owned
          # scripts tree so an on-box cleanup never runs with a partial dependency graph.
          rsync -az --delete scripts/ "$ES4_HOST":/home/es4/repo/scripts/
          ssh -o BatchMode=yes "$ES4_HOST" 'bash /home/es4/repo/scripts/es4/bootstrap-es4.sh'
        '''
      }
    }
    stage('Create topics') {
      when { expression { params.ACTION == 'create-topics' } }
      steps {
        sh '''
          set -euo pipefail
          rsync -az --delete scripts/ "$ES4_HOST":/home/es4/repo/scripts/
          ssh -o BatchMode=yes "$ES4_HOST" 'bash /home/es4/repo/scripts/es4/create-es-topics.sh'
        '''
      }
    }
    stage('Clean reset (atomic Kafka + Schema Registry wipe)') {
      // Wipe Kafka data (all topics + _schemas) TOGETHER so no message can outlive its schema
      // id — the fix for the dead-schema-id poison ("Malformed data. Length is negative") that
      // wedged the scorer. DESTRUCTIVE: drops all es4 Kafka data; honor DEPLOY_DRY_RUN to preview.
      //
      // The prod es-feed (options-edge/es-feed on .252) publishes to es4 Kafka+SR from OUTSIDE the
      // es4 cluster, so we MUST fence it here (with the prod kubeconfig) around the on-box wipe —
      // otherwise it reconnects and re-emits cached schema ids into the fresh cluster, recreating
      // the exact poison. Restored on exit even if the wipe fails, so the feed is never left down.
      when { expression { params.ACTION == 'clean-reset' } }
      steps {
        sh '''
          set -euo pipefail
          rsync -az --delete scripts/ "$ES4_HOST":/home/es4/repo/scripts/

          KP="KUBECONFIG=$PROD_KUBECONFIG kubectl -n options-edge"
          FEED_REP=$(eval "$KP get deploy es-feed -o jsonpath='{.spec.replicas}'" 2>/dev/null || echo 1)
          [ -n "$FEED_REP" ] || FEED_REP=1
          # never "restore" to 0: if the feed is already fenced (e.g. a prior failed clean left it
          # down), restoring the captured count would leave prod es-feed dead behind a green build
          # — the 2026-07-17 overnight ES blackout. Same guard as the wrapper's RC_REP clamp.
          [ "$FEED_REP" = "0" ] && FEED_REP=1

          if [ "${DEPLOY_DRY_RUN}" = "true" ]; then
            echo "DRY: would scale prod es-feed ($FEED_REP -> 0), run on-box wipe, restore es-feed to $FEED_REP"
            ssh -o BatchMode=yes "$ES4_HOST" "DEPLOY_DRY_RUN=true ES4_FEED_FENCED=1 bash /home/es4/repo/scripts/es4/cleanup-es4.sh"
            exit 0
          fi

          # ALWAYS restore the feed, even if the wipe aborts (never leave prod es-feed down), and
          # VERIFY it: if the feed can't be scaled back to its captured count, fail the build (a
          # green run must never leave the prod es-feed at 0).
          restore_feed() {
            eval "$KP scale deploy/es-feed --replicas=$FEED_REP" || true
            got=$(eval "$KP get deploy es-feed -o jsonpath='{.spec.replicas}'" 2>/dev/null || echo ERR)
            [ "$got" = "$FEED_REP" ] || { echo "ERROR: prod es-feed NOT restored (want $FEED_REP got $got) — scale it back manually" >&2; exit 1; }
          }
          trap restore_feed EXIT

          echo "=== fencing prod es-feed (scale $FEED_REP -> 0, wait for pods DELETED) ==="
          eval "$KP scale deploy/es-feed --replicas=0"
          # wait for actual DELETION (a Terminating pod can still produce during its grace period);
          # awk count (not grep|wc) so an empty result is not a pipefail-fatal exit.
          eval "$KP wait --for=delete pod -l app.kubernetes.io/name=es-feed --timeout=150s" || true
          n=$(eval "$KP get pods -l app.kubernetes.io/name=es-feed --no-headers" 2>/dev/null | awk 'END{print NR+0}')
          [ "$n" = "0" ] || { echo "prod es-feed pods still present ($n) — aborting before wipe" >&2; exit 1; }

          echo "=== running on-box atomic wipe (feed fenced) ==="
          ssh -o BatchMode=yes "$ES4_HOST" "DEPLOY_DRY_RUN=false ES4_FEED_FENCED=1 bash /home/es4/repo/scripts/es4/cleanup-es4.sh"
          # trap restores the feed after the fresh Kafka+SR+topics are ready
        '''
      }
    }
    stage('Deploy to es4') {
      when { expression { params.ACTION == 'deploy-service' || params.ACTION == 'deploy-all' } }
      steps {
        sh '''
          set -euo pipefail
          export KUBECONFIG="$ES4_KUBECONFIG"
          DRY=""; [ "${DEPLOY_DRY_RUN:-false}" = "true" ] && DRY="--dry-run=server"
          kubectl apply $DRY -f k8s/es4/es4-base-env.yaml
          kubectl apply $DRY -f k8s/es4/es4-common-env.yaml
          mkdir -p .jenkins-tmp
          if [ "$ACTION" = "deploy-all" ]; then FILES=$(ls k8s/es4/services/*.yaml); else FILES="k8s/es4/services/${SERVICE}.yaml"; fi
          for f in $FILES; do
            bash scripts/es4/pin-and-apply.sh "$f" "$REGISTRY" "$DRY"
          done
          if [ -z "$DRY" ] && { [ "$ACTION" = "deploy-all" ] || [ "$SERVICE" = "vix-option-inteligence" ]; }; then
            # Remove the legacy identity only after pin-and-apply has completed the replacement
            # rollout, avoiding duplicate consumers on the isolated ES broker.
            kubectl -n options-edge delete deployment zero-dte-intelligence-service --ignore-not-found
            kubectl -n options-edge delete service zero-dte-intelligence-service --ignore-not-found
          fi
          if [ -z "$DRY" ] && [ "$ACTION" = "deploy-all" ]; then
            # Reconcile-delete the retired greek-move-authenticity-service on es4. Same reason as the
            # dev/prod path in scripts/deploy/apply.sh: `kubectl apply -f` never prunes, and the es4
            # service manifest is removed in this same commit, so the pod would otherwise run forever
            # against the isolated ES broker. deploy-all only — there is no longer a per-SERVICE file.
            kubectl -n options-edge delete deployment greek-move-authenticity-service --ignore-not-found
            kubectl -n options-edge delete service greek-move-authenticity-service --ignore-not-found
          fi
          [ -n "$DRY" ] || kubectl -n options-edge get pods -o wide
        '''
      }
    }
    stage('Deploy es-feed to prod') {
      when { expression { params.ACTION == 'deploy-es-feed' } }
      steps {
        sh '''
          set -euo pipefail
          export KUBECONFIG="$PROD_KUBECONFIG"
          DRY=""; [ "${DEPLOY_DRY_RUN:-false}" = "true" ] && DRY="--dry-run=server"
          # enforceable prerequisite: the resolved feed digest must equal the one from
          # the feed build that contains the es-feed code (Codex #12)
          [ -n "${EXPECTED_FEED_DIGEST:-}" ] || { echo "EXPECTED_FEED_DIGEST is required for deploy-es-feed" >&2; exit 1; }
          actual=$(curl -sfI -H 'Accept: application/vnd.docker.distribution.manifest.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.oci.image.index.v1+json' \
            "http://$REGISTRY/v2/options-edge-databento-feed/manifests/prod" | tr -d '\r' | awk -F': ' 'tolower($1)=="docker-content-digest" {print $2}')
          [ "$actual" = "$EXPECTED_FEED_DIGEST" ] || { echo "FEED DIGEST MISMATCH: registry=$actual expected=$EXPECTED_FEED_DIGEST" >&2; exit 1; }
          # HARD GUARD (USER requirement): this stage must NEVER touch the SPX feed.
          # Capture the SPX feed deployment's generation+image before, verify unchanged after.
          spx_before=$(kubectl -n options-edge get deploy options-edge-databento-feed -o jsonpath='{.metadata.generation}{" "}{.spec.template.spec.containers[0].image}' 2>/dev/null || echo absent)
          bash scripts/es4/pin-and-apply.sh k8s/es4/prod/es-feed.yaml "$REGISTRY" "$DRY"
          spx_after=$(kubectl -n options-edge get deploy options-edge-databento-feed -o jsonpath='{.metadata.generation}{" "}{.spec.template.spec.containers[0].image}' 2>/dev/null || echo absent)
          if [ "$spx_before" != "$spx_after" ]; then
            echo "SPX FEED GUARD TRIPPED: options-edge-databento-feed changed during es-feed deploy (before='$spx_before' after='$spx_after')" >&2
            exit 1
          fi
          echo "SPX feed guard: options-edge-databento-feed untouched ($spx_after)"
          [ -n "$DRY" ] || kubectl -n options-edge rollout status deploy/es-feed --timeout=300s
        '''
      }
    }
  }
  post { always { archiveArtifacts artifacts: '.jenkins-tmp/*.yaml', allowEmptyArchive: true } }
}
