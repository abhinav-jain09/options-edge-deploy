// Jenkinsfile.replay — standalone, ON-DEMAND replay deploy (job: replay-deploy).
//
// Deploys ONLY the k8s/replay/<env> slice: the databento timewarp replay Job. (The
// snapshot-replay seeder Deployment was removed from the deployable set.) This is
// deliberately SEPARATE from the monolithic dev/prod bring-up (options-edge-deploy) because:
//   * a Kubernetes Job's spec.template is IMMUTABLE — re-applying it inside the monolith
//     aborts the WHOLE deploy the moment the image/config changes ("field is immutable");
//   * re-running a historical replay on every deploy risks injecting stale data into live
//     topics. Replay must be a deliberate, explicit action.
//
// Auth: the cluster enforces a jenkins-only admission policy, so this uses the
// jenkins-deployer identity via oeProfile(ENVIRONMENT).kubeconfigDeployer (same single
// source of truth as options-edge-deploy / web-service-deploy). The namespace and the
// shared options-edge-config ConfigMap the replay consumes are created by the monolith /
// common-infra; this job only (re)creates the replay workloads.
pipeline {
  agent { label 'hpsf-replay-mac' }   // the dev-Mac Jenkins agent (same as options-edge-deploy)

  options {
    disableRestartFromStage()   // Deployment Permission Rule: no "Restart from Stage" past the permitted-commit guard
    disableConcurrentBuilds()          // plugin-free lock: never two replays at once
    timeout(time: 30, unit: 'MINUTES')
  }

  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before any effect unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`.')
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: 'a3d2b9492162a2a6c92914ab17e6df5514ae6ecaaa7988dbab61b57a36160275',
      description: 'DO NOT EDIT BY HAND — the sha256 of scripts/jenkins/permitted-sha-guard.sh this job enforces (Deployment Permission Rule). The guard refuses to run under any other value, so this default, once registered by a run of this definition, is evidence to callers that this job executes THIS guard; a caller refuses to trigger a job whose registered default differs from its own. Regenerate with scripts/jenkins/permitted-sha-guard-version.sh when the guard changes.')
    // Only dev has a replay slice today; keep it a choice so adding prod/experiment later
    // is a one-line change plus a k8s/replay/<env> dir.
    choice(name: 'ENVIRONMENT', choices: ['dev'],
      description: 'Target environment — selects k8s/replay/<env> and the deployer kubeconfig (oeProfile).')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: false,
      description: 'true = render + server-side validate only; changes nothing.')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
  }

  environment {
    KUBECONFIG  = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    ENVIRONMENT = "${params.ENVIRONMENT}"
  }

  stages {
    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    // PERMITTED_SHA is REQUIRED. scripts/jenkins/permitted-sha-guard.sh refuses, in this order: a checkout
    // that is not on origin/main (the environment-branch restriction, kept as its own condition); a
    // missing, empty, short or otherwise malformed PERMITTED_SHA (nothing is substituted for it); a
    // checked-out HEAD that is not exactly PERMITTED_SHA. It runs FIRST, in the workspace every later
    // stage uses, so nothing below can build, push, apply, roll, restart, create a topic or copy a file
    // under an unpermitted commit — including a build queued for one commit that checked out a newer one.
    // error(), never catchError: a refusal is a stop, not a coloured result. Both SHAs are in the log.
    stage('Permitted commit guard') {
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }
    stage('Resolve profile') {
      steps {
        script {
          echo "replay-deploy: env=${env.ENVIRONMENT} kubeconfig=${env.KUBECONFIG} dryRun=${params.DEPLOY_DRY_RUN}"
        }
      }
    }

    stage('Deploy replay') {
      steps {
        sh '''
          set -euo pipefail
          test -n "${KUBECONFIG:-}" || { echo "FATAL: KUBECONFIG unset (empty oeProfile deployer?)" >&2; exit 1; }
          test -f "$KUBECONFIG"     || { echo "FATAL: deployer kubeconfig $KUBECONFIG not found on agent" >&2; exit 1; }
          overlay="k8s/replay/${ENVIRONMENT}"
          test -d "$overlay"        || { echo "FATAL: no replay slice at $overlay" >&2; exit 1; }

          echo "=== rendered replay workloads ==="
          kubectl --kubeconfig "$KUBECONFIG" kustomize "$overlay" \
            | { grep -E '^(kind|  name|          image):' || true; }

          if [ "${DEPLOY_DRY_RUN:-false}" = "true" ]; then
            echo "DEPLOY_DRY_RUN=true: server-side validate only, no changes."
            kubectl --kubeconfig "$KUBECONFIG" apply -k "$overlay" --dry-run=server
            exit 0
          fi

          # A Job's pod template is immutable: delete any prior run so a changed image/config
          # is honored. This is the whole reason replay can't live in the monolith. Recreating
          # the Job re-runs the replay — which is the intended, deliberate action here.
          kubectl --kubeconfig "$KUBECONFIG" -n options-edge \
            delete job/databento-timewarp-replay --ignore-not-found=true

          kubectl --kubeconfig "$KUBECONFIG" apply -k "$overlay"

          echo "=== replay workloads after apply ==="
          kubectl --kubeconfig "$KUBECONFIG" -n options-edge get \
            job/databento-timewarp-replay
        '''
      }
    }
  }

  post {
    success { echo "replay-deploy (${params.ENVIRONMENT}) OK — timewarp replay Job (re)created." }
    failure { echo "replay-deploy (${params.ENVIRONMENT}) FAILED — see the stage log above." }
  }
}
