{
  "type": "record",
  "name": "EsUnderlyingPrice",
  "namespace": "com.optionsedge.contracts.hpsf",
  "doc": "One es.underlying.es.price (es4) / underlying.es.price (prod) tick, published by options-edge-databento-feed. Until the 2026-11-02 cutover these topics carried hand-built JSON; each was wiped and recreated under its own name carrying Avro. The first twelve fields are UnderlyingPrice field for field and type for type (symbol ES, source NATIVE_ES_FUTURE, quality LIVE), so every reader of an underlying price tick decodes this record unchanged; the seven optional spxBasis* fields carry the ES->SPX basis mapping the feed stamps (absent when the feed has none). The registry subject is this record's FULL NAME (RecordNameStrategy), one subject for every environment whatever its TOPIC_PREFIX.",
  "fields": [
    {"name": "schemaVersion", "type": "int", "doc": "Wire revision of the tick; 1 today."},
    {"name": "symbol", "type": "string", "doc": "ES. Also the Kafka record key."},
    {"name": "eventTime", "type": "string", "doc": "ISO-8601 UTC event time exactly as the feed stamped it (parsed with Instant.parse by every reader)."},
    {"name": "price", "type": {"type": "bytes", "logicalType": "decimal", "precision": 38, "scale": 18}, "doc": "The ES future price. The feed's double is written as the decimal of its shortest round-trip text, so BigDecimal.doubleValue() returns the identical double (exact, no rounding)."},
    {"name": "size", "type": ["null", "long"], "default": null, "doc": "Trade size; null (always null on this topic today)."},
    {"name": "source", "type": "string", "doc": "Provenance token: NATIVE_ES_FUTURE."},
    {"name": "quality", "type": "string", "doc": "LIVE."},
    {"name": "canonicalSpot", "type": {"type": "bytes", "logicalType": "decimal", "precision": 38, "scale": 18}, "doc": "The canonical spot; equals price on this stream."},
    {"name": "spotEventTimeNs", "type": "long", "doc": "Canonical spot event clock, epoch nanoseconds."},
    {"name": "feedEpochId", "type": "string", "doc": "Feed epoch identity."},
    {"name": "epochSeq", "type": "long", "doc": "Monotonic sequence within the feed epoch."},
    {"name": "spotQuality", "type": "string", "doc": "Same token as quality."},
    {"name": "spxEquivalent", "type": ["null", "double"], "default": null, "doc": "ES price minus spxBasis, rounded half-even to 2 places; absent when no usable basis."},
    {"name": "spxBasis", "type": ["null", "double"], "default": null, "doc": "ES->SPX basis in index points, rounded half-even to 2 places; absent when UNAVAILABLE."},
    {"name": "spxBasisState", "type": ["null", "string"], "default": null, "doc": "MEASURED, ANCHORED, QUARANTINED, UNAVAILABLE ...; the basis engine's verdict. Absent when the feed stamped no basis."},
    {"name": "spxBasisMeasuredAtMs", "type": ["null", "long"], "default": null, "doc": "Epoch milliseconds of the basis reference measurement; absent when none."},
    {"name": "spxBasisAgeMs", "type": ["null", "long"], "default": null, "doc": "Age of the basis at publish, milliseconds, never negative."},
    {"name": "spxBasisUnavailableReason", "type": ["null", "string"], "default": null, "doc": "Why the basis is UNAVAILABLE (COLD_START, ...); present only with state UNAVAILABLE."},
    {"name": "spxBasisMadPts", "type": ["null", "double"], "default": null, "doc": "Median absolute deviation of the basis samples in points; present only for a MEASURED basis."}
  ]
}
