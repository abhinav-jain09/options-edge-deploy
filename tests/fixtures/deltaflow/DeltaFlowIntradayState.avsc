      "type": "double"
    },
    {
      "name": "putBoughtDeltaFlow",
      "type": "double"
    },
    {
      "name": "putSoldDeltaFlow",
      "type": "double"
    },
    {
      "name": "weightedExposed",
      "type": "boolean"
    },
    {
      "name": "calibrationEpoch",
      "type": "int"
    }
  ]
}
