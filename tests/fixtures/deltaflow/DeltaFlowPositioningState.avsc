{
  "type": "record",
  "name": "DeltaFlowPositioningState",
  "namespace": "com.optionsedge.contracts.deltaflow",
  "doc": "A PRIVATE image of delta-flow-service (a Kafka Streams state-store value / its compacted changelog, or an internal repartition topic), not a topic contract: it exists as a released .avsc only so the serde has a registered schema (RecordNameStrategy, auto.register.schemas=false), FULL compatibility. Until the Avro cutover these values were hand-built JSON text; the changelogs and repartition topics are DELETED at the cutover (retained JSON is never read). Prices (strike, trade price, bid, ask, spot) are decimal(38,18); every derived statistic keeps its double. Per-(contract, session) positioning accumulator (positioning-store value).",
  "fields": [
    {
      "name": "symbol",
      "type": "string"
    },
    {
      "name": "expiry",
      "type": "string"
    },
    {
      "name": "tradingDate",
      "type": "string"
    },
    {
      "name": "strike",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 38,
        "scale": 18
      }
    },
    {
      "name": "optionType",
      "type": "string"
    },
    {
      "name": "asOfEventTimeMs",
      "type": "long"
    },
    {
      "name": "sessionVolumeContracts",
      "type": "double"
    },
    {
      "name": "sessionNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "lastEmitEventTimeMs",
      "type": "long"
    }
  ]
}
