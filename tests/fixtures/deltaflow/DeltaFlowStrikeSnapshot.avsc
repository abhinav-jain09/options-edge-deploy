{
  "type": "record",
  "name": "DeltaFlowStrikeSnapshot",
  "namespace": "com.optionsedge.contracts.deltaflow",
  "doc": "One per-strike delta-flow snapshot, published by delta-flow-service on delta-flow-by-strike. Kafka key = symbol|tradingDate|expiry|strike. The JSON era wrote this record with Jackson from the contracts record of the same name; this schema reproduces that JSON FIELD FOR FIELD, NAME FOR NAME, IN THE SAME ORDER (DeltaFlowJson renders it back byte-for-byte). Prices (strike, trade price, bid, ask) are decimal(38,18) = the shortest round-trip text of the engine double; a value needing more than 18 fractional digits, non-finite, -0.0 or out of range is REFUSED, never rounded. Every derived statistic (share-delta flow, delta, gamma, iv, ages) keeps the double the JSON carried. Enumerations are written as their constant names (strings) so a new constant is not a schema change. Registry subject = the record full name (RecordNameStrategy), compatibility FULL.",
  "fields": [
    {
      "name": "symbol",
      "type": "string"
    },
    {
      "name": "tradingDate",
      "type": "string"
    },
    {
      "name": "expiry",
      "type": "string"
    },
    {
      "name": "strike",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 38,
        "scale": 18
      },
      "doc": "Strike, a price: decimal(38,18)."
    },
    {
      "name": "asOfEventTimeMs",
      "type": "long"
    },
    {
      "name": "sessionNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "rolling10sNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "rolling30sNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "rolling1mNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "rolling5mNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "rolling15mNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "cumulativeIntradayNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "buyerContracts",
      "type": "long"
    },
    {
      "name": "sellerContracts",
      "type": "long"
    },
    {
      "name": "highConfidenceTradeCount",
      "type": "long"
    },
    {
      "name": "mediumConfidenceTradeCount",
      "type": "long"
    },
    {
      "name": "lowConfidenceTradeCount",
      "type": "long"
    },
    {
      "name": "noConfidenceTradeCount",
      "type": "long"
    },
    {
      "name": "strikeNetCallDeltaFlow",
      "type": "double"
    },
    {
      "name": "strikeNetPutDeltaFlow",
      "type": "double"
    },
    {
      "name": "strikeCallBuyDeltaFlow",
      "type": "double"
    },
    {
      "name": "strikeCallSellDeltaFlow",
      "type": "double"
    },
    {
      "name": "strikePutBuyDeltaFlow",
      "type": "double"
    },
    {
      "name": "strikePutSellDeltaFlow",
      "type": "double"
    },
    {
      "name": "highConfidenceNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "confidenceWeightedNetDeltaFlow",
      "type": "double"
    },
    {
      "name": "confidenceWeightQuality",
      "type": "string"
    },
    {
      "name": "outputMeta",
      "type": {
        "type": "record",
        "name": "DeltaFlowOutputMeta",
        "namespace": "com.optionsedge.contracts.deltaflow",
        "doc": "R10 per-output provenance: quality (FULL, DEGRADED, UNKNOWN, BROKEN), reconciliationStatus (RECONCILED, FAILED, PENDING, UNRECONCILED), the fraction of required inputs present (RATIO, 0..1), the calibration dataset id (none when uncalibrated), the model version and the threshold set id in force.",
        "fields": [
          {
            "name": "quality",
            "type": "string"
          },
          {
            "name": "reconciliationStatus",
            "type": "string"
          },
          {
            "name": "sourceCompleteness",
            "type": "double"
          },
          {
            "name": "calibrationDatasetId",
            "type": "string"
          },
          {
            "name": "modelVersion",
            "type": "string"
          },
          {
            "name": "thresholdSetId",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "sessionObservedFromMs",
      "type": [
        "null",
        "long"
      ],
      "doc": "Earliest event time the session has observed (appended last by the JSON era when positive); absent otherwise.",
      "default": null,
      "jsonOmitWhenNull": "true"
    }
  ]
}
