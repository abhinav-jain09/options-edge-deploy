pipeline {
  agent any
  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }
  environment {
    PATH = "/home/confluent/confluent-8.2.1/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh '''
          set -euo pipefail
          scripts/jenkins/enforce-main-branch.sh
          git rev-parse --short HEAD
        '''
      }
    }
    stage('Validate Scripts') {
      steps {
        sh '''
          set -euo pipefail
          . scripts/kafka/load-kafka-settings.sh
          bash -n scripts/kafka/create-hpsf-topics.sh
          bash -n scripts/kafka/verify-hpsf-topics.sh
          scripts/kafka/create-hpsf-topics.sh --dry-run >/tmp/hpsf-topics-dry-run.txt
          grep -F 'options.hpsf.writer-dlq' /tmp/hpsf-topics-dry-run.txt
          grep -F "replication.factor=${KAFKA_TOPIC_REPLICATION_FACTOR}" /tmp/hpsf-topics-dry-run.txt
          grep -F "min.insync.replicas=${KAFKA_TOPIC_MIN_IN_SYNC_REPLICAS}" /tmp/hpsf-topics-dry-run.txt
          grep -F 'compression.type=lz4' /tmp/hpsf-topics-dry-run.txt
          # Guard against over-durability that would block writes on the two-node cluster.
          if grep -E 'replication-factor[ =]3|min.insync.replicas=2|num.standby.replicas=1' /tmp/hpsf-topics-dry-run.txt; then
            echo 'Forbidden Kafka durability config found in HPSF topic dry run.' >&2
            exit 1
          fi
        '''
      }
    }
    stage('Apply HPSF Topics') {
      steps {
        sh '''
          set -euo pipefail
          . scripts/kafka/load-kafka-settings.sh
          scripts/kafka/create-hpsf-topics.sh
        '''
      }
    }
    stage('Verify HPSF Topics') {
      steps {
        sh '''
          set -euo pipefail
          . scripts/kafka/load-kafka-settings.sh
          scripts/kafka/verify-hpsf-topics.sh
        '''
      }
    }
  }
}
