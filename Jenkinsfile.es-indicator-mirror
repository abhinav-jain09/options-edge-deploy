// ES-INDICATOR MIRROR — stand up a clean SINGLE-TOPIC .4->target mirror as a managed launchd service.
// MIRROR-DIRECTION: es4->default
// (the source is .4, the target is the dev/prod broker; validate-mirrored-topic-contracts.sh
//  reads this to decide which cluster's declarations govern each end)
//
// Requirement (0DTE-INDICATOR-SERVICE rev 14 §7.3, compute-once + mirror): es4 is the SOLE ES
// indicator producer; its two output topics are mirrored VERBATIM (record-copy, identity name,
// ES-keyed records only) to dev and prod so all three envs share one uniform ES view. NO local
// ES fallback on the targets — a broken mirror means ES goes STALE there, never different.
//
// WHY MM1 (kafka-mirror-maker), NOT MM2 (connect-mirror-maker): MM2's Heartbeat/Checkpoint
// connectors replicate .4's runaway `es.es.es...heartbeats` junk (its own broken es4 MM2) and
// create es4.* / mm2-*.internal topics on the target -> pollution. MM1 --whitelist mirrors ONLY
// the one topic, byte-copy, identity name, no heartbeat/checkpoint machinery. (Verified 2026-07-19.)
//
// The Verify stage enforces that as a DELTA, not an absolute: Preflight snapshots the target's
// topic list before install and Verify fails only on pattern matches that appear AFTER it. Prod
// permanently carries four dead-MM2 leftovers (heartbeats, mm2-{configs,offsets,status}.es4.internal)
// that an absolute check read as this mirror's pollution, failing every prod install (2026-08-06).
//
// Unlike the strike-intel/futures-flow mirrors (one topic family each, target-only slug), this
// job serves BOTH indicator topics, so the launchd identity includes the TOPIC: one unit per
// (target, topic) — dev+prod x snapshot+bars = four coexisting units, none overwriting another.
//
// The job runs on the 'local-mac' agent (the dev Mac, which IS the target for dev). It generates
// the config + installs a KeepAlive launchd unit; NOTHING is hand-edited.
pipeline {
  agent { label 'local-mac' }
  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before any effect unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`.')
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: '2f6fc2ab7aa51eb8a9e8aa350f2d774cd2fb7a253de2591e43645a19a9886b24',
      description: 'DO NOT EDIT BY HAND — the sha256 of scripts/jenkins/permitted-sha-guard.sh this definition runs (Deployment Permission Rule). The guard refuses to run under any other value. It is a DECLARATION, not proof that this job enforces the guard: a caller that triggers this job judges its SCM definition and its Jenkinsfile at the forwarded commit (scripts/jenkins/require-guarded-downstream.sh). Regenerate with scripts/jenkins/permitted-sha-guard-version.sh when the guard changes.')
    string(name: 'SOURCE_ES_CLUSTER_IP', defaultValue: '192.168.100.4', description: 'ES source-of-truth broker IP (.4).')
    string(name: 'SOURCE_PORT',          defaultValue: '9092',          description: 'Source Kafka port.')
    string(name: 'TARGET_SPX_CLUSTER_IP',defaultValue: '127.0.0.1',     description: 'Target env broker IP (dev = 127.0.0.1, prod = 192.168.100.252).')
    string(name: 'TARGET_PORT',          defaultValue: '19092',         description: 'Target Kafka port (dev = 19092, prod = 9092).')
    choice(name: 'TOPIC', choices: ['es.options.indicators.snapshot.current', 'es.options.indicators.bars', 'es.options.indicators.signals.current', 'es.options.indicators.signals.events'], description: 'Indicator topic to mirror (frozen allow-list — the shape contract below is per-topic).')
    choice(name: 'ACTION', choices: ['install', 'teardown'], description: 'install = create+run the mirror; teardown = stop+remove it.')
  }
  // 45 minutes, not 15: every shape assertion is a kafka-topics/kafka-configs round trip, and on the
  // PRODUCTION broker (318 topics on 2026-10-06) one such call takes ~16 s, so a single install can
  // spend ten minutes in metadata alone — 15 minutes aborted three real installs mid-flight.
  options { disableRestartFromStage(); disableConcurrentBuilds(); timeout(time: 45, unit: 'MINUTES') }
  environment {
    KBIN  = '/Users/abhinav/development/confluent-7.3.1/bin'
    // Per-(TARGET,TOPIC) identity: dev/prod each mirror BOTH indicator topics from .4, so every
    // (env, topic) pair must be an independent launchd unit instead of one shared label/dir.
    SLUG  = "${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT + '-' + params.TOPIC).replaceAll('[^A-Za-z0-9-]', '-')}"
    MDIR  = "/Users/abhinav/oe-ops/es-indicator-mirror-${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT + '-' + params.TOPIC).replaceAll('[^A-Za-z0-9-]', '-')}"
    LABEL = "com.optionsedge.es-indicator-mirror-${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT + '-' + params.TOPIC).replaceAll('[^A-Za-z0-9-]', '-')}"
    PLIST = "/Users/abhinav/Library/LaunchAgents/com.optionsedge.es-indicator-mirror-${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT + '-' + params.TOPIC).replaceAll('[^A-Za-z0-9-]', '-')}.plist"
    SRC   = "${params.SOURCE_ES_CLUSTER_IP}:${params.SOURCE_PORT}"
    TGT   = "${params.TARGET_SPX_CLUSTER_IP}:${params.TARGET_PORT}"
    // The registries beside the brokers (INDICATOR-AVRO-CONVERSION-PLAN.md section 4): es4's on 8081, the dev and prod
    // registries on 8082 — dev's is this Jenkins host's own (its pods reach it as host.docker.internal).
    SRC_REGISTRY = "http://${params.SOURCE_ES_CLUSTER_IP}:8081"
    TGT_REGISTRY = "http://${params.TARGET_SPX_CLUSTER_IP == 'host.docker.internal' ? 'localhost' : params.TARGET_SPX_CLUSTER_IP}:8082"
    // Target-only slug (no topic): the approved-legacy-topics allow-list is a property of the
    // BROKER, shared by both indicator topics mirrored to it.
    TSLUG = "${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT).replaceAll('[^A-Za-z0-9-]', '-')}"
    // Single definition of the MM2-pollution pattern, shared by the Preflight baseline capture and
    // the Verify guard. It MUST be one string: if the two stages ever matched different patterns,
    // a pre-existing topic could be missing from the baseline and fail the build as "new".
    JUNK_RE = '^es4\\.|es\\.es\\.es|heartbeat|mm2-.*\\.internal'
  }
  stages {
    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    // PERMITTED_SHA is REQUIRED. scripts/jenkins/permitted-sha-guard.sh refuses, in this order: a checkout
    // that is not on origin/main (the environment-branch restriction, kept as its own condition); a
    // missing, empty, short or otherwise malformed PERMITTED_SHA (nothing is substituted for it); a
    // checked-out HEAD that is not exactly PERMITTED_SHA. It runs FIRST, in the workspace every later
    // stage uses, so nothing below can build, push, apply, roll, restart, create a topic or copy a file
    // under an unpermitted commit — including a build queued for one commit that checked out a newer one.
    // error(), never catchError: a refusal is a stop, not a coloured result. Both SHAs are in the log.
    stage('Permitted commit guard') {
      options { timeout(time: 10, unit: 'MINUTES') }
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }

    stage('Teardown') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'teardown') } }
      steps {
        sh '''
          set -euo pipefail
          launchctl unload "$PLIST" 2>/dev/null || true
          rm -f "$PLIST"
          # unit-specific: kill ONLY this (target, topic) mirror via its own run script, never a sibling
          pkill -f "$MDIR/run-mirror.sh" 2>/dev/null || true
          pkill -f "kafka-mirror-maker.*$MDIR" 2>/dev/null || true
          echo "mirror service removed (topic + data left intact)"
        '''
      }
    }

    stage('Preflight (fail-closed)') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'install') } }
      steps {
        sh '''
          set -euo pipefail
          echo "SOURCE=$SRC  TARGET=$TGT  TOPIC=$TOPIC"
          # SAFETY: source and target must be different clusters
          [ "$SOURCE_ES_CLUSTER_IP:$SOURCE_PORT" != "$TARGET_SPX_CLUSTER_IP:$TARGET_PORT" ] || { echo "FAIL: source==target"; exit 1; }
          # source broker reachable
          nc -z -w5 "$SOURCE_ES_CLUSTER_IP" "$SOURCE_PORT" || { echo "FAIL: source $SRC unreachable"; exit 1; }
          # target broker reachable + usable — and CAPTURE ITS PRE-INSTALL TOPIC LIST.
          # The Verify pollution guard diffs against this baseline so it fails only on junk THIS
          # install introduced. Prod (192.168.100.252:9092) permanently carries four legacy topics
          # from the old, stopped es4 MM2 setup (heartbeats, mm2-{configs,offsets,status}.es4.internal)
          # that match JUNK_RE; the previous absolute match-count check therefore failed every prod
          # install (builds #6/#7/#8, 2026-08-06) even though the mirror was clean.
          mkdir -p "$MDIR"
          BASE="$MDIR/target-topics-preinstall.txt"
          rm -f "$BASE" "$BASE.tmp"
          "$KBIN/kafka-topics" --bootstrap-server "$TGT" --list > "$BASE.tmp" || { echo "FAIL: target $TGT unusable"; exit 1; }
          # Header stamps build+target so Verify can never grandfather from a stale file, and keeps
          # the file non-empty (an empty broker is a legitimate baseline). No Kafka topic name can
          # ever collide with it: '#' and ' ' are not legal topic-name characters.
          { echo "#BASELINE build=$BUILD_NUMBER target=$TGT"; cat "$BASE.tmp"; } > "$BASE"
          rm -f "$BASE.tmp"
          echo "baseline: $(grep -vc '^#' "$BASE" || true) topic(s) on $TGT before install"

          # GROWTH GATE (fail-closed). A delta guard ALONE would launder pollution: junk created by
          # an earlier failed/aborted build lands in the next build's baseline and gets grandfathered
          # forever. So the pre-install junk set must be a SUBSET of this target's durable,
          # code-reviewed allow-list. Approving prod's four dead-MM2 leftovers is a reviewed commit
          # to that file — never something this job grants itself. No file = nothing approved = any
          # junk-pattern topic blocks the install (which is why dev, being clean, needs no file).
          APPROVED="$WORKSPACE/config/es-mirror-approved-legacy-topics/$TSLUG.txt"
          # Every grep below handles status EXPLICITLY: 1 = "no lines matched" (a legitimate result),
          # anything >1 is a real grep/read error. A blanket `|| true` would convert an unreadable
          # file into "no junk found" and pass the gate vacuously.
          PRE=$(grep -E "$JUNK_RE" "$BASE") || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: junk scan of $BASE errored (grep rc=$rc)"; exit 1; }; PRE=""; }
          if [ -n "$PRE" ]; then
            [ -f "$APPROVED" ] || { echo "FAIL: $TGT already carries junk-pattern topic(s), but config/es-mirror-approved-legacy-topics/$TSLUG.txt does not exist to approve them:"; printf '%s\\n' "$PRE" | sed 's/^/  /'; exit 1; }
            CLEAN="$MDIR/approved-legacy.clean.txt"
            grep -vE '^[[:space:]]*(#|$)' "$APPROVED" > "$CLEAN" || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: cannot read $APPROVED (grep rc=$rc)"; exit 1; }; : > "$CLEAN"; }
            UNAPPROVED=$(printf '%s\\n' "$PRE" | grep -vxFf "$CLEAN") || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: allow-list subtraction errored (grep rc=$rc)"; exit 1; }; UNAPPROVED=""; }
            [ -z "$UNAPPROVED" ] || { echo "FAIL: $TGT carries junk-pattern topic(s) NOT approved in config/es-mirror-approved-legacy-topics/$TSLUG.txt — clean the target, or get the allow-list extended by review:"; printf '%s\\n' "$UNAPPROVED" | sed 's/^/  /'; exit 1; }
            echo "pre-existing junk topics on $TGT (all approved; Verify will grandfather them):"
            printf '%s\\n' "$PRE" | sed 's/^/  /'
          else
            echo "pre-existing junk topics on $TGT: <none>"
          fi
          # source topic exists (nothing to mirror otherwise)
          "$KBIN/kafka-topics" --bootstrap-server "$SRC" --describe --topic "$TOPIC" >/dev/null 2>&1 || { echo "FAIL: source topic $TOPIC missing"; exit 1; }
          # MM1 binary present
          [ -x "$KBIN/kafka-mirror-maker" ] || { echo "FAIL: kafka-mirror-maker missing"; exit 1; }
          echo "preflight OK"
        '''
      }
    }

    stage('Generate config + match target topic') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'install') } }
      steps {
        sh '''
          set -euo pipefail

          # FROZEN per-topic shape contract (rev 14 §7.1 + SIGNALS_V1 §3 + scripts/kafka/topics.env — keep in sync):
          #   snapshot.current : 1 partition,  compact,delete, retention 7 d  (last-value live view)
          #   bars             : 8 partitions, delete,         retention 45 d (append-only history)
          #   signals.current  : 1 partition,  delete,         retention 7 d  (SIGNALS_V1 last-value view, key = symbol;
          #                      compact,delete on DEV only — on prod/es4 and on every mirror target it is plain delete,
          #                      like snapshot.current: "Nothing SERVED is compacted" in topics.env, prod is the archive
          #                      of record and the daily archiver needs every record, so the consumer reads the LATEST
          #                      record per key within the 7 d window, never a compacted tail)
          #   signals.events   : 1 partition,  delete,         retention 45 d (SIGNALS_V1 lifecycle events; 20 sessions)
          # The TOPIC parameter is a choice list, but re-assert here fail-closed so a job-config
          # drift can never mirror an unknown topic with a guessed shape.
          case "$TOPIC" in
            es.options.indicators.snapshot.current) PARTS=1; POLICY=delete; RET=604800000 ;;
            es.options.indicators.bars)             PARTS=8; POLICY=delete;         RET=3888000000 ;;
            es.options.indicators.signals.current)  PARTS=1; POLICY=delete; RET=604800000 ;;
            es.options.indicators.signals.events)   PARTS=1; POLICY=delete;         RET=3888000000 ;;
            *) echo "FAIL: topic $TOPIC not in the indicator-mirror allow-list"; exit 1 ;;
          esac

          # Kafka Serialization Rule / plan section 4: the four mirrored topics carry Confluent-framed Avro whose
          # schema ids must resolve to the SAME schema on the target registry. Assert ids 2001-2007 are identical
          # on source and target BEFORE any byte is copied; a differing or absent id fails the install.
          bash scripts/kafka/assert-indicator-schema-parity.sh "$SRC_REGISTRY" "$TGT_REGISTRY"

          mkdir -p "$MDIR"
          # Plan section 6 step 8: the target topic was recreated EMPTY by the cutover and the source topic holds
          # only Avro records from its own recreate, so the copy starts at the source's offset 0 — the group is
          # deleted (a resumed committed offset would skip the records written since the teardown) and the
          # consumer resets to earliest. Before the cutover this was `latest` to spare the target the JSON history.
          GROUP="es-indicator-mirror-${TARGET_SPX_CLUSTER_IP}-${TOPIC}"
          set +e
          DEL=$("$KBIN/kafka-consumer-groups" --bootstrap-server "$SRC" --delete --group "$GROUP" 2>&1); DRC=$?
          set -e
          # only two answers are accepted: a successful delete, or "does not exist"; anything else (broker
          # unreachable, a still-active group) fails the install instead of starting MM1 on retained offsets
          if [ "$DRC" -ne 0 ] && ! printf '%s' "$DEL" | grep -q 'does not exist'; then
            echo "FAIL: could not delete the mirror's source group $GROUP (rc=$DRC): $DEL"; exit 1
          fi
          for i in $(seq 1 30); do
            "$KBIN/kafka-consumer-groups" --bootstrap-server "$SRC" --list 2>/dev/null | grep -qxF "$GROUP" || break
            sleep 2
          done
          if "$KBIN/kafka-consumer-groups" --bootstrap-server "$SRC" --list 2>/dev/null | grep -qxF "$GROUP"; then
            echo "FAIL: source group $GROUP is still listed 60s after its delete"; exit 1
          fi
          echo "source group $GROUP absent"
          cat > "$MDIR/consumer.properties" <<C
bootstrap.servers=$SRC
group.id=es-indicator-mirror-${TARGET_SPX_CLUSTER_IP}-${TOPIC}
auto.offset.reset=earliest
key.deserializer=org.apache.kafka.common.serialization.ByteArrayDeserializer
value.deserializer=org.apache.kafka.common.serialization.ByteArrayDeserializer
C
          cat > "$MDIR/producer.properties" <<P
bootstrap.servers=$TGT
key.serializer=org.apache.kafka.common.serialization.ByteArraySerializer
value.serializer=org.apache.kafka.common.serialization.ByteArraySerializer
# acks=all + explicit idempotence. On these RF=1 targets this buys NO extra durability over
# acks=1: both wait for the one in-sync replica (the leader) to write its own log, and NEITHER
# survives losing that sole broker — a power cut can still take records the leader had written
# but not fsynced. Only RF>=2 with min.insync.replicas>=2 would. It is set because it is the
# right setting the day a target has replicas, and because acks=all is what the idempotent
# producer requires; idempotence is pinned rather than left to the client default so a client
# upgrade cannot silently turn it off. What it covers is NARROW: duplicates and reordering a
# producer's OWN retries would cause inside one request stream. It does nothing about MM1's
# flush-then-commit: a crash after the flush and before the source offset is committed resends
# those records as a new producer, so this mirror is at-least-once and CAN write a duplicate.
acks=all
enable.idempotence=true
P
          cat > "$MDIR/log4j.properties" <<L
log4j.rootLogger=INFO, stdout
log4j.appender.stdout=org.apache.log4j.ConsoleAppender
log4j.appender.stdout.layout=org.apache.log4j.PatternLayout
log4j.appender.stdout.layout.ConversionPattern=%d{ISO8601} %-5p %c{1} - %m%n
L
          # escape dots for the MM1 whitelist regex (exact single topic)
          RE=$(printf '%s' "$TOPIC" | sed 's/\\./\\\\./g')
          cat > "$MDIR/run-mirror.sh" <<S
#!/usr/bin/env bash
set -euo pipefail
export KAFKA_LOG4J_OPTS="-Dlog4j.configuration=file:$MDIR/log4j.properties"
exec "$KBIN/kafka-mirror-maker" \\
  --consumer.config "$MDIR/consumer.properties" \\
  --producer.config "$MDIR/producer.properties" \\
  --whitelist '$RE' --num.streams 1
S
          chmod +x "$MDIR/run-mirror.sh"

          # pre-create target topic to the FROZEN contract (idempotent; §7.3 forbids ever
          # recreating/truncating an existing target)...
          "$KBIN/kafka-topics" --bootstrap-server "$TGT" --create --if-not-exists --topic "$TOPIC" \
            --partitions "$PARTS" --replication-factor 1 \
            --config cleanup.policy="$POLICY" --config retention.ms="$RET" 2>&1 | tail -1
          # ...and because --if-not-exists silently keeps an EXISTING malformed topic, assert the
          # target's ACTUAL shape now. A partition-count mismatch would silently re-shard the
          # key->partition mapping mid-stream; a policy mismatch would truncate the live view.
          TD=$("$KBIN/kafka-topics" --bootstrap-server "$TGT" --describe --topic "$TOPIC" 2>/dev/null)
          printf '%s\\n' "$TD" | grep -q "PartitionCount: $PARTS" || { echo "FAIL: target $TOPIC exists with wrong partition count (want $PARTS): $TD"; exit 1; }
          TC=$("$KBIN/kafka-configs" --bootstrap-server "$TGT" --describe --topic "$TOPIC" 2>/dev/null || true)
          case "$POLICY" in
            compact,delete) printf '%s\\n' "$TC" | grep -q "cleanup.policy=compact,delete" || { echo "FAIL: target $TOPIC not compact,delete: $TC"; exit 1; } ;;
            delete)         printf '%s\\n' "$TC" | grep -q "cleanup.policy=compact" && { echo "FAIL: target $TOPIC unexpectedly compacted: $TC"; exit 1; } || true ;;
          esac
          # The copy restarts at the source's EARLIEST offset (the source group was deleted above), so a target that
          # already holds records would receive every record a second time (2026-10-18 build #45: a prod target
          # re-installed over a previous install's copy reached twice the source's committed count). Fail closed:
          # the target must be empty on every partition; plan section 5 recreates it, this job never empties it.
          # --- empty-target precondition begin (tests/test_indicator_mirror_parity_gate.py executes this block) ---
          TPRE=$("$KBIN/kafka-get-offsets" --bootstrap-server "$TGT" --topic "$TOPIC" 2>/dev/null | sort)
          [ -n "$TPRE" ] || { echo "FAIL: cannot read the target end offsets of $TOPIC on $TGT"; exit 1; }
          # exactly one numeric end-offset row for every partition 0..PARTS-1 — a partial, duplicated or malformed
          # answer is a failure (it could hide a non-empty partition), never "looks empty"
          TROWS=$(printf '%s\\n' "$TPRE" | awk -F: -v t="$TOPIC" '$1 == t && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {print $2}' | sort -n | tr '\\n' ' ')
          TWANT=$(for ((i = 0; i < PARTS; i++)); do printf '%s ' "$i"; done)
          [ "$TROWS" = "$TWANT" ] || { echo "FAIL: target $TOPIC on $TGT has $PARTS partition(s) but kafka-get-offsets answered for [${TROWS% }] — every partition must be proven empty"; exit 1; }
          NONEMPTY=$(printf '%s\\n' "$TPRE" | awk -F: -v t="$TOPIC" '$1 == t && $3 != 0 {print $2"="$3}' | tr '\\n' ' ')
          [ -z "$NONEMPTY" ] || { echo "FAIL: target $TOPIC on $TGT is not empty (partition=endOffset: ${NONEMPTY% }) — the copy would duplicate every record; recreate the target empty (plan section 5, step 8) before installing"; exit 1; }
          echo "target $TOPIC on $TGT is empty on every partition (end offsets: $(printf '%s' "$TPRE" | tr '\\n' ' '))"
          # --- empty-target precondition end ---
          echo "config generated; target $TOPIC verified: $PARTS partition(s), $POLICY"
        '''
      }
    }

    stage('Install launchd service') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'install') } }
      steps {
        sh '''
          set -euo pipefail
          cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$MDIR/run-mirror.sh</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>$MDIR/mirror.out.log</string>
  <key>StandardErrorPath</key><string>$MDIR/mirror.err.log</string>
</dict></plist>
PL
          launchctl unload "$PLIST" 2>/dev/null || true
          launchctl load "$PLIST"
          echo "launchd unit $LABEL loaded"
        '''
      }
    }

    stage('Verify (running + zero pollution)') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'install') } }
      steps {
        sh '''
          set -euo pipefail
          sleep 8
          launchctl list | grep "$LABEL" || { echo "FAIL: service not running"; exit 1; }
          # pollution guard: MM1 must NOT ADD es4.* / es.es.es / heartbeat / mm2 topics to the target.
          # Judged as a DELTA against the pre-install baseline captured in Preflight: topics that were
          # already there (prod's dead-MM2 leftovers) are grandfathered, anything new fails the build.
          # Fail-closed: no baseline from THIS build, or an unreadable topic list, is a FAIL — never a
          # silent pass, because either one would make the delta vacuously empty.
          BASE="$MDIR/target-topics-preinstall.txt"
          [ -f "$BASE" ] || { echo "FAIL: pre-install topic baseline $BASE missing — cannot distinguish new pollution from legacy topics"; exit 1; }
          head -1 "$BASE" | grep -qxF "#BASELINE build=$BUILD_NUMBER target=$TGT" \
            || { echo "FAIL: baseline $BASE is not from this build/target (got: $(head -1 "$BASE"))"; exit 1; }
          # Everything the delta grandfathers was already proved approved by Preflight's growth gate,
          # so this is a report, not a decision — but print it every build so the approved set stays
          # visible in the log next to the result it licensed.
          GRAND=$(grep -E "$JUNK_RE" "$BASE" | tr '\\n' ' ') || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: junk scan of $BASE errored (grep rc=$rc)"; exit 1; }; GRAND=""; }
          echo "grandfathered pre-existing junk topics on $TGT: ${GRAND:-<none>}"
          # Plan section 6 step 8 gate, EOS-aware. The es4 producer (indicator-service, exactly-once v2) is
          # transactional, so the SOURCE log end offset counts one commit marker per transaction beside each data
          # record; MM1 copies committed data records only (a marker is not a record), so source and target END
          # OFFSETS can never be equal on a live topic (observed 2026-10-18 build #35: source 620 / target 342,
          # one record + one marker every 5 s — the old equality gate failed every install of a live topic).
          # Parity is therefore measured on RECORDS, per partition: the target's end offset TE (every copied
          # record is one offset — MM1's producer is not transactional and the target was recreated empty) must
          # equal the number N of COMMITTED source records below the source's end offset. N comes from a
          # read_committed console consumer that reads from the partition's earliest offset (re-read on every
          # attempt, right before the consume — retention may advance while we retry), prints offsets only and
          # stops ON ITS OWN at TE+1 records or after 30 s without a record (a quiet topic) — never on a closed
          # pipe, which a Java process would not notice. TE is read BEFORE the source end, so N < TE can only
          # mean the target holds records the source never committed (a duplicating second writer: the
          # 2026-10-18 laptop-clone incident) — an immediate FAIL; N = TE+1 means at least one committed record is
          # not on the target yet (the copy trails, or a record landed between the two reads) — re-measured for
          # up to five minutes; N = TE is parity. (A TE+1 bound rather than a tolerance: waiting for extra live
          # records beyond the source end would cost one producer interval per record, 30 s on bars.)
          # Fail-closed on the consumer itself: kafka-console-consumer exits 0 even when it terminates on an
          # error (measured 2026-10-18: idle timeout, out-of-range offset and max-messages all exit 0), so its
          # exit status proves nothing. The count is accepted only when (1) its stderr carries the consumer's own
          # "Processed a total of N messages" line and N equals the offsets it printed, (2) no ERROR other than
          # the single idle-timeout TimeoutException event appears, and (3) auto.offset.reset=none, so a start offset the
          # broker no longer holds is an OffsetOutOfRange ERROR instead of a silent reset to the live edge.
          # --- parity gate begin (tests/test_indicator_mirror_parity_gate.py executes this block) ---
          SEND=$("$KBIN/kafka-get-offsets" --bootstrap-server "$SRC" --topic "$TOPIC" 2>/dev/null | sort)
          [ -n "$SEND" ] || { echo "FAIL: cannot read source offsets for $TOPIC on $SRC"; exit 1; }
          echo "source end offsets at gate start: [$SEND]"
          PARTS=$(printf '%s\\n' "$SEND" | awk -F: '{print $2}')
          PASS=0; REPORT=""
          for attempt in $(seq 1 20); do
            OK=1; REPORT=""
            for p in $PARTS; do
              TE=$("$KBIN/kafka-get-offsets" --bootstrap-server "$TGT" --topic "$TOPIC" --partitions "$p" 2>/dev/null | awk -F: '{print $3}')
              [ -n "$TE" ] || { echo "FAIL: cannot read the target end offset of partition $p"; exit 1; }
              SB=$("$KBIN/kafka-get-offsets" --bootstrap-server "$SRC" --topic "$TOPIC" --partitions "$p" --time -2 2>/dev/null | awk -F: '{print $3}')
              SE=$("$KBIN/kafka-get-offsets" --bootstrap-server "$SRC" --topic "$TOPIC" --partitions "$p" 2>/dev/null | awk -F: '{print $3}')
              [ -n "$SE" ] && [ -n "$SB" ] || { echo "FAIL: cannot read the source offsets of partition $p"; exit 1; }
              if [ "$SE" -le "$SB" ]; then
                N=0
              else
                OUT="$MDIR/parity-p$p.offsets"; ERR="$MDIR/parity-p$p.err"
                # Wall-time bound: when the target holds MORE records than the source committed (a duplicate copy),
                # TE+1 exceeds the committed count and the consumer would wait for live records one producer
                # interval at a time (build #45 waited 43 minutes). After the bound the count is still conclusive
                # when the consumer has read past the source end offset SE captured above: every committed record
                # below SE is then in the file. Killed before reaching SE, the count is inconclusive and fails.
                CRC=0
                timeout "${PARITY_CONSUMER_TIMEOUT_S:-120}" "$KBIN/kafka-console-consumer" --bootstrap-server "$SRC" --topic "$TOPIC" --partition "$p" --offset "$SB" \
                  --isolation-level read_committed --consumer-property auto.offset.reset=none \
                  --timeout-ms 30000 --max-messages "$((TE + 1))" \
                  --property print.offset=true --property print.key=false --property print.value=false \
                  > "$OUT" 2> "$ERR" || CRC=$?
                CLINES=$(grep -c '^Offset:' "$OUT" || true)
                CLAST=$(awk -F'[:\\t]' '$1 == "Offset" && $2 ~ /^[0-9]+$/ {o = $2} END {print o}' "$OUT")
                if [ "$CRC" = 124 ]; then
                  if [ -z "$CLAST" ] || [ "$CLAST" -lt "$SE" ]; then
                    echo "FAIL: the committed-record count of partition $p did not reach the source end offset $SE within ${PARITY_CONSUMER_TIMEOUT_S:-120} s (last offset read: '${CLAST:-none}')"; exit 1
                  fi
                  echo "partition $p: consumer stopped at the wall-time bound after reading past the source end ($CLAST >= $SE); the count below $SE is complete"
                elif [ "$CRC" != 0 ]; then
                  echo "FAIL: the committed-record count of partition $p failed (consumer exit status $CRC)"; tail -5 "$ERR"; exit 1
                else
                  CTOTAL=$(sed -n 's/^Processed a total of \\([0-9][0-9]*\\) messages.*/\\1/p' "$ERR" | tail -1)
                  if [ -z "$CTOTAL" ] || [ "$CTOTAL" != "$CLINES" ]; then
                    echo "FAIL: the committed-record count of partition $p is not trustworthy: the consumer reported total '$CTOTAL' but printed $CLINES offsets"; tail -5 "$ERR"; exit 1
                  fi
                fi
                if grep -q 'OffsetOutOfRange' "$ERR"; then
                  echo "FAIL: partition $p — the broker no longer holds the earliest offset $SB the gate asked for"; exit 1
                fi
                # Event-aware: the consumer reports a termination as an ERROR line followed by the exception's class.
                # Exactly one such event is permitted, and only when its exception is exactly the idle-timeout
                # org.apache.kafka.common.errors.TimeoutException (the signature measured on 2026-10-18); a second
                # event, or any other exception — even one whose text also mentions a timeout — fails the gate.
                CERRS=$(grep -c 'ERROR' "$ERR" || true)
                if [ "$CERRS" -gt 1 ]; then
                  echo "FAIL: the committed-record count of partition $p reported $CERRS error events:"; grep -A1 'ERROR' "$ERR" | head -6; exit 1
                fi
                if [ "$CERRS" -eq 1 ] && [ "$(grep -A1 'ERROR' "$ERR" | sed -n '2p')" != "org.apache.kafka.common.errors.TimeoutException" ]; then
                  echo "FAIL: the committed-record count of partition $p terminated on an error other than the idle timeout:"; grep -A1 'ERROR' "$ERR" | head -2; exit 1
                fi
                N=$(awk -F'[:\\t]' -v se="$SE" '$1 == "Offset" && ($2 + 0) < se { n++ } END { print n + 0 }' "$OUT")
              fi
              REPORT="$REPORT p$p:targetEnd=$TE sourceRecordsBelowEnd=$N (earliest=$SB end=$SE);"
              if [ "$N" -lt "$TE" ]; then
                echo "FAIL: partition $p — the target holds $TE records but the source has only $N committed records below its end offset $SE: a duplicate copy or a second writer"
                exit 1
              fi
              [ "$N" -eq "$TE" ] || OK=0
            done
            echo "parity attempt $attempt:$REPORT"
            if [ "$OK" = 1 ]; then PASS=1; break; fi
            sleep 15
          done
          [ "$PASS" = 1 ] || { echo "FAIL: the target has not caught up with the source's committed records after 20 attempts:$REPORT"; exit 1; }
          echo "offsets: target end offsets equal the source's committed record count (markers excluded):$REPORT"
          # --- parity gate end ---
          # Decode gate on EVERY partition of the target: the newest committed record is framed Avro whose fixed id
          # resolves on the TARGET registry and deserializes there. A target partition may be empty only when the
          # parity gate just measured zero committed records on its source partition — those are passed to the
          # script as DECODE_EMPTY_OK; any other empty partition fails the install.
          EMPTY_OK=$(printf '%s\n' "$REPORT" | tr ';' '\n' | sed -n 's/^ *p\([0-9][0-9]*\):targetEnd=0 sourceRecordsBelowEnd=0 .*/\1/p' | tr '\n' ' ')
          echo "decode gate: partitions whose source holds no committed record: [${EMPTY_OK% }]"
          DECODE_EMPTY_OK="$EMPTY_OK" bash scripts/kafka/decode-newest-indicator-record.sh "$TGT" "$TGT_REGISTRY" "$TOPIC" "$KBIN"
          # (read twice — kafka-topics --list gives flaky counts during MM startup)
          for i in 1 2; do
            L=$("$KBIN/kafka-topics" --bootstrap-server "$TGT" --list 2>/dev/null) \
              || { echo "FAIL: cannot list topics on $TGT"; exit 1; }
            # Both greps handle status EXPLICITLY (1 = no match, >1 = real error). This is the
            # decisive guard: a blanket `|| true` here would turn an unreadable baseline file into
            # an empty delta and PASS a genuinely polluted target.
            JUNK=$(printf '%s\\n' "$L" | grep -E "$JUNK_RE") || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: junk scan of $TGT errored (grep rc=$rc)"; exit 1; }; JUNK=""; }
            NEW=""
            if [ -n "$JUNK" ]; then
              NEW=$(printf '%s\\n' "$JUNK" | grep -vxFf "$BASE") || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: baseline subtraction errored (grep rc=$rc)"; exit 1; }; NEW=""; }
            fi
            if [ -n "$NEW" ]; then J=$(printf '%s\\n' "$NEW" | wc -l | tr -d ' '); else J=0; fi
            echo "read $i: new-junk-topics=$J  target-topic-present=$(printf '%s\\n' "$L" | grep -c "^$TOPIC$")"
            [ "$J" = "0" ] || { echo "FAIL: mirror polluted the target with $J NEW junk topic(s):"; printf '%s\\n' "$NEW" | sed 's/^/  /'; exit 1; }
            sleep 2
          done
          echo "VERIFIED: $LABEL running, only $TOPIC mirrored, no NEW pollution on $TGT."
        '''
      }
    }
  }
}
