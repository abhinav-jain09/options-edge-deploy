{"type":"record","name":"ZeroDteIntelligenceSnapshot","namespace":"com.optionsedge.contracts.zerodte","doc":"options.spx.vix-option-inteligence-service.current: the 0DTE option-flow direction snapshot, compacted, keyed SYMBOL|sessionDate. A measured-nothing value is null, never a sentinel; every string vocabulary is a string (an enum addition would break FULL compatibility).","fields":[{"name":"schemaVersion","type":"int"},{"name":"snapshotId","type":"string"},{"name":"symbol","type":"string"},{"name":"sessionDate","type":"string"},{"name":"asOfEventTime","type":["null","string"],"doc":"ISO-8601 instant of the newest accepted input; null when no input was accepted (never a 1970 clock).","default":null},{"name":"asOfEventTimeMs","type":["null","long"],"doc":"Epoch ms of the newest accepted input; null when no input was accepted.","default":null},{"name":"producedAt","type":"string"},{"name":"askSideCallPremium","type":["null","double"],"default":null},{"name":"askSidePutPremium","type":["null","double"],"default":null},{"name":"minutesToExpiry","type":["null","double"],"default":null},{"name":"atmIv","type":["null","double"],"default":null},{"name":"putSkew25","type":["null","double"],"default":null},{"name":"riskReversal25","type":["null","double"],"default":null},{"name":"remainingSessionVol","type":["null","double"],"default":null},{"name":"constantOneDayVol","type":["null","double"],"default":null},{"name":"surfaceStatus","type":"string"},{"name":"surfaceActionable","type":"boolean"},{"name":"rateSource","type":["null","string"],"default":null},{"name":"rateEventTime","type":["null","string"],"default":null},{"name":"rateAgeMs","type":["null","long"],"default":null},{"name":"carryQuality","type":["null","string"],"default":null},{"name":"riskFreeRateNear","type":["null","double"],"default":null},{"name":"nextExpiry","type":["null","string"],"default":null},{"name":"riskFreeRateNext","type":["null","double"],"default":null},{"name":"nextRateEventTime","type":["null","string"],"default":null},{"name":"rateMethod","type":["null","string"],"default":null},{"name":"nextRateSource","type":["null","string"],"default":null},{"name":"nextRateMethod","type":["null","string"],"default":null},{"name":"frameAgeMs","type":["null","long"],"default":null},{"name":"marketDirection","type":["null","string"],"doc":"BULLISH or BEARISH, or null when the engine holds no direction.","default":null},{"name":"directionalIntensity","type":"string"},{"name":"directionalTriggers","type":{"type":"array","items":"string"}},{"name":"directionExpiresAt","type":"string"},{"name":"marketDirectionHorizon","type":["null","string"],"doc":"Always null: this service declares no named forecast horizon (the lifetime is directionLifetimeMs).","default":null},{"name":"directionLifetimeMs","type":"long"},{"name":"directionalFlow","type":"string"},{"name":"qualityStatus","type":"string"},{"name":"actionable","type":"boolean"},{"name":"evidenceStrengthType","type":"string"},{"name":"directionalScore","type":["null","double"],"default":null},{"name":"optionFlowScore","type":["null","double"],"default":null},{"name":"vixMarketScore","type":["null","double"],"default":null},{"name":"classifiedPremium","type":["null","long"],"default":null},{"name":"uniqueStrikes","type":"int"},{"name":"reasonCodes","type":{"type":"array","items":"string"}},{"name":"featureVersion","type":"string"},{"name":"modelVersion","type":"string"},{"name":"runId","type":"string"},{"name":"epochSeq","type":"long"},{"name":"prediction","type":["null",{"type":"record","name":"ZeroDtePrediction","doc":"Live flow-model prediction, attached all-or-nothing (null when the calibration is missing or any probability is not a distribution).","fields":[{"name":"modelVersion","type":"string"},{"name":"byHorizon","type":{"type":"record","name":"ZeroDteByHorizon","doc":"The three horizons the live model predicts; all three are present or the whole prediction block is absent.","fields":[{"name":"H5","type":{"type":"record","name":"ZeroDteHorizonPrediction","doc":"One horizon of the live prediction: the stated state and the three class probabilities (a distribution that sums to 1 within 0.01, each in [0,1]; the producer refuses anything else).","fields":[{"name":"state","type":"string"},{"name":"pExpansion","type":"double"},{"name":"pContraction","type":"double"},{"name":"pBalanced","type":"double"}]}},{"name":"H10","type":"ZeroDteHorizonPrediction"},{"name":"H15","type":"ZeroDteHorizonPrediction"}]}}]}],"doc":"Absent-by-design is null: the block is attached all-or-nothing.","default":null}]}