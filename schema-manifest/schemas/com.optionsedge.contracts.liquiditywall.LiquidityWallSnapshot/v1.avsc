{"type":"record","name":"LiquidityWallSnapshot","namespace":"com.optionsedge.contracts.liquiditywall","doc":"document D section 11: the whole engine state needed to continue exactly after a restart","fields":[{"name":"schemaVersion","type":"int","doc":"1 for this revision"},{"name":"depthEnvironment","type":"string","doc":"the environment literal of the admitted depth frames, e.g. Rithmic Test, or the live literal"},{"name":"contract","type":"string","doc":"the contract table's row for the trade date, e.g. ESZ6"},{"name":"bucketEnd","type":"long","doc":"bucket end on the collector clock, epoch ms"},{"name":"configFingerprint","type":"string","doc":"SHA-256 over the sorted name=value configuration lines plus the detector's logic version"},{"name":"depthOffset","type":"long"},{"name":"tapeOffset","type":"long"},{"name":"bookStreamId","type":["null","string"],"default":null},{"name":"bookReceivedAtMs","type":["null","long"],"default":null},{"name":"bookSequence","type":["null","long"],"default":null},{"name":"bookSourceOffset","type":["null","long"],"default":null},{"name":"bookReady","type":"boolean"},{"name":"bids","type":{"type":"array","items":{"type":"record","name":"LiquidityWallSnapshotLevel","doc":"one price level","fields":[{"name":"tick","type":"long"},{"name":"quantity","type":"long"}]}}},{"name":"asks","type":{"type":"array","items":"LiquidityWallSnapshotLevel"}},{"name":"admissionLastReceivedAtMs","type":["null","long"],"default":null},{"name":"admissionLastSequence","type":["null","long"],"default":null},{"name":"admissionStreamId","type":["null","string"],"default":null},{"name":"supersededStreamIds","type":{"type":"array","items":"string"},"doc":"streams a later stream replaced; a frame of one is STALE_STREAM"},{"name":"lastPrint","type":["null",{"type":"record","name":"LiquidityWallSnapshotPrint","doc":"one print (tape order: exchange ms, sequence, source offset)","fields":[{"name":"exchangeTimeMs","type":"long"},{"name":"sequence","type":"long"},{"name":"sourceOffset","type":"long"},{"name":"tick","type":"long"},{"name":"size","type":"long"},{"name":"side","type":"string","doc":"B, A or N"}]}],"default":null,"doc":"the last print read"},{"name":"spotPrint","type":["null","LiquidityWallSnapshotPrint"],"default":null,"doc":"the last print at or before the last closed bucket's end"},{"name":"recentPrintMs","type":{"type":"array","items":"long"},"doc":"exchange milliseconds of the prints of the last 60 seconds, the skew samples' history"},{"name":"levelHistories","type":{"type":"array","items":{"type":"record","name":"LiquidityWallSnapshotLevelHistory","doc":"a band level's last S sizes (oldest first) and baseline flag","fields":[{"name":"side","type":"string"},{"name":"tick","type":"long"},{"name":"lastSizes","type":{"type":"array","items":"long"}},{"name":"baseline","type":"boolean"}]}}},{"name":"window","type":{"type":"array","items":{"type":"record","name":"LiquidityWallSnapshotWindowBucket","doc":"one closed bucket of the trailing classification window","fields":[{"name":"bucketEnd","type":"long"},{"name":"quality","type":"string"},{"name":"streamId","type":["null","string"],"default":null},{"name":"levels","type":{"type":"array","items":{"type":"record","name":"LiquidityWallSnapshotWindowLevel","doc":"one level's frame-pair facts and prints of one closed bucket (the classification window's input)","fields":[{"name":"side","type":"string"},{"name":"tick","type":"long"},{"name":"openSize","type":"long"},{"name":"maxSize","type":"long"},{"name":"minSize","type":"long"},{"name":"added","type":"long"},{"name":"decrease","type":"long"},{"name":"pullCount","type":"int"},{"name":"refillCount","type":"int"},{"name":"traded","type":"long"}]}}}]}},"doc":"the trailing classification window's closed buckets, oldest first"},{"name":"clusters","type":{"type":"array","items":{"type":"record","name":"LiquidityWallSnapshotCluster","doc":"a current cluster with its identity and persistence run","fields":[{"name":"clusterId","type":"string"},{"name":"side","type":"string"},{"name":"loTick","type":"long"},{"name":"hiTick","type":"long"},{"name":"persistenceRun","type":"int"},{"name":"firstBucketEnd","type":"long"}]}}},{"name":"walls","type":{"type":"array","items":{"type":"record","name":"LiquidityWallSnapshotWall","doc":"one live wall as published (document D section 7)","fields":[{"name":"clusterId","type":"string"},{"name":"lane","type":"string","doc":"RESISTANCE or SUPPORT"},{"name":"loTick","type":"long"},{"name":"hiTick","type":"long"},{"name":"frozenTicks","type":{"type":"array","items":"long"},"doc":"every tick from loTick to hiTick inclusive"},{"name":"birthBucketEnd","type":"long"},{"name":"peakSizeAtBirth","type":"long"},{"name":"totalSizeAtBirth","type":"long"},{"name":"ladderMedianAtBirth","type":"long"},{"name":"levelCountAtBirth","type":"int"},{"name":"heldBuckets","type":"int"},{"name":"defendedBuckets","type":"int"},{"name":"brokenBuckets","type":"int"},{"name":"brokenBucketsFrozen","type":["null","int"],"default":null,"doc":"the break term's count frozen at the settle; null before it"},{"name":"termHold","type":"int","doc":"the capped score terms of section 7: hold"},{"name":"termDefense","type":"int"},{"name":"termPeak","type":"int"},{"name":"termLevels","type":"int"},{"name":"termBreaks","type":"int","doc":"the break term as published (frozen after the settle)"},{"name":"scoreRaw","type":"int"},{"name":"scorePublished","type":"int"},{"name":"scoreSettled","type":"boolean"},{"name":"grade","type":"string","doc":"STRONG, MODERATE or WEAK"},{"name":"defendedState","type":"boolean"},{"name":"brokenState","type":"boolean"},{"name":"lastEvidenceBucketEnd","type":["null","long"],"default":null,"doc":"the last LIVE bucket on which evidence was read"},{"name":"breachOpen","type":"boolean","doc":"a breach episode is open"},{"name":"breachT0","type":["null","long"],"default":null,"doc":"exchange timestamp of the open breach episode's first print, or null"},{"name":"breachTickReached","type":["null","long"],"default":null}]}}},{"name":"pendingPrints","type":{"type":"array","items":"LiquidityWallSnapshotPrint"}},{"name":"flipReads","type":{"type":"array","items":"string"},"doc":"the last N side reads, oldest first"},{"name":"flipHistory","type":{"type":"array","items":{"type":"record","name":"LiquidityWallSnapshotFlipRead","doc":"one bucket's flip read kept for the window arithmetic (section 7b)","fields":[{"name":"bucketEnd","type":"long"},{"name":"sideRead","type":"string"},{"name":"above","type":["null","long"],"default":null},{"name":"below","type":["null","long"],"default":null},{"name":"spotTick","type":["null","long"],"default":null},{"name":"leanThousandths","type":["null","int"],"default":null}]}}},{"name":"flipLastConfirmedSide","type":["null","string"],"default":null},{"name":"flipLastConfirmedBucketEnd","type":["null","long"],"default":null},{"name":"flipLastPublishedDirection","type":["null","string"],"default":null},{"name":"flipLastPublishedBucketEnd","type":["null","long"],"default":null},{"name":"openBuckets","type":{"type":"array","items":{"type":"record","name":"LiquidityWallSnapshotOpenBucket","doc":"an open bucket at the decision: everything it had consumed, so that a restart resuming from the snapshot's offsets loses nothing","fields":[{"name":"bucketEnd","type":"long"},{"name":"ownFrames","type":"int"},{"name":"lastFrameReceivedAtMs","type":["null","long"],"default":null},{"name":"lastFrameStreamId","type":["null","string"],"default":null},{"name":"closingSnapshotted","type":"boolean"},{"name":"closingPresent","type":"boolean"},{"name":"closingReady","type":"boolean"},{"name":"closingReceivedAtMs","type":["null","long"],"default":null},{"name":"closingStreamId","type":["null","string"],"default":null},{"name":"closingBids","type":{"type":"array","items":"LiquidityWallSnapshotLevel"}},{"name":"closingAsks","type":{"type":"array","items":"LiquidityWallSnapshotLevel"}},{"name":"readyFrameInstants","type":{"type":"array","item