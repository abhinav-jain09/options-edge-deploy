{"type":"record","name":"LiquidityWallOutcome","namespace":"com.optionsedge.contracts.liquiditywall","doc":"liq-AA: ONE decided outcome of one displayed target at one horizon, published by es-liquidity-wall-service itself on futures.liquidity-wall.outcomes (key '<tradeDate>|<targetId>|M<seconds>'), computed in the service's own bucket loop from its own book and tape in data time only. DESCRIPTIVE and UNVALIDATED. Two record types: TARGET_HORIZON (reach and fate at 600 s and 1800 s) and ROLE_FLIP (one record per block when its role-flip tracking closes).","fields":[{"name":"schemaVersion","type":"int","doc":"1","default":1},{"name":"outcomeRuleVersion","type":"string","doc":"liq-AA-v1"},{"name":"service","type":"string","doc":"es-liquidity-wall-service"},{"name":"depthEnvironment","type":"string","doc":"depth environment literal"},{"name":"contract","type":"string","doc":"contract"},{"name":"configFingerprint","type":"string","doc":"identity of the wall engine configuration, copied from the engine"},{"name":"tradeDate","type":"string","doc":"yyyy-MM-dd of the SPX cash close that ends the tracking session"},{"name":"stratum","type":"string","doc":"RTH or GLOBEX_PRE, from the instant the target was first shown"},{"name":"targetId","type":"string","doc":"side|tick|firstShownBucketEnd"},{"name":"side","type":"string","doc":"ABOVE or BELOW"},{"name":"tick","type":"long","doc":"ES tick of the block"},{"name":"distanceTicksAtShown","type":"long","doc":"ticks from the spot when first shown"},{"name":"sizeAtShown","type":"long","doc":"contracts when first shown"},{"name":"multipleThousandthsAtShown","type":"long","doc":"size over the typical size, thousandths, when first shown"},{"name":"t0Ms","type":"long","doc":"bucket end at which it was first shown"},{"name":"horizonSeconds","type":"int","doc":"600 or 1800 for a TARGET_HORIZON record; 0 for a ROLE_FLIP record"},{"name":"windowEndMs","type":"long","doc":"t0Ms + horizonSeconds * 1000"},{"name":"bucketEnd","type":"long","doc":"the bucket end at which the record was made (data time, never a clock)"},{"name":"reached","type":["null","boolean"],"doc":"a print came within the tolerance of the block's price inside the window; null when excluded","default":null},{"name":"reachedAfterMs","type":["null","long"],"doc":"ms from t0 to the first such print","default":null},{"name":"toleranceTicks","type":"int","doc":"1"},{"name":"fate","type":["null","string"],"doc":"CONSUMED (the block lost half its size while prints traded at its price), PULLED (it lost half its size with few prints), HELD_SIZE (it did not), or UNKNOWN","default":null},{"name":"fateAtMs","type":["null","long"],"doc":"bucket end at which the fate was found","default":null},{"name":"tradedAtPriceSinceShown","type":["null","long"],"doc":"contracts printed at the block's price since it was shown, to the decision","default":null},{"name":"sizeAtDecision","type":["null","long"],"doc":"contracts at the block's price at the decision, null when the book was not read","default":null},{"name":"pastTicks","type":["null","long"],"doc":"furthest ticks past the block's price before the first move back, or to the decision if there was none; 0 when not reached","default":null},{"name":"reversed","type":["null","boolean"],"doc":"true when a move back of reversalTicks from that furthest price happened inside the window","default":null},{"name":"reversalTicks","type":"int","doc":"8"},{"name":"liveBuckets","type":"int","doc":"buckets of the window with quality LIVE"},{"name":"totalBuckets","type":"int","doc":"buckets of the window read"},{"name":"excludedReason","type":["null","string"],"doc":"null, or SESSION_ENDED, BUCKET_GAP, CONTRACT_ROLL","default":null},{"name":"label","type":"string","doc":"DESCRIPTIVE_UNVALIDATED","default":"DESCRIPTIVE_UNVALIDATED"},{"name":"recordType","type":"string","default":"TARGET_HORIZON","doc":"TARGET_HORIZON or ROLE_FLIP"},{"name":"flipOutcome","type":["null","string"],"default":null,"doc":"ROLE_FLIP: NEVER_INVADED, NO_RETEST, RETEST_HELD, RETEST_FAILED or RETEST_UNRESOLVED"},{"name":"flipKind","type":["null","string"],"default":null,"doc":"R_TO_S or S_TO_R, set when invaded"},{"name":"touchCount","type":["null","int"],"default":null,"doc":"touches before the invasion (or in all, when never invaded)"},{"name":"firstTouchAtMs","type":["null","long"],"default":null,"doc":"bucket end of the first touch"},{"name":"touchLog","type":["null","string"],"default":null,"doc":"the first 8 touches as 'startOffsetMs:pushTicks:bounceTicks' joined by ';' (offset from t0; push = furthest ticks past the block's price toward and through it, negative when it stopped short; bounce = ticks the price travelled back before the next touch or the invasion)"},{"name":"invadedAtMs","type":["null","long"],"default":null,"doc":"bucket end of the INVADED decision"},{"name":"msSinceFirstTouchAtInvasion","type":["null","long"],"default":null,"doc":"time from the first touch to the invasion"},{"name":"volumeThroughBlock","type":["null","long"],"default":null,"doc":"contracts printed at or beyond the block's price (on the invaded side) from the first print beyond it to the decision"},{"name":"aggressorDeltaDuringPush","type":["null","long"],"default":null,"doc":"buy minus sell contracts printed in that same span"},{"name":"consumedAtInvasion","type":["null","string"],"default":null,"doc":"CONSUMED, PULLED, HELD_SIZE or UNKNOWN: the fate found for the block by the invasion (a consumed block lost half its size while prints traded at its price; pulled: without them)"},{"name":"sizeBehindAtInvasion","type":["null","long"],"default":null,"doc":"resting contracts on the ORIGINAL side beyond the block within 8 ticks at the decision (the liquidity behind it)"},{"name":"sizeBeyondAtInvasion","type":["null","long"],"default":null,"doc":"resting contracts on the NEW side within 8 ticks of the block at the decision"},{"name":"refilled","type":["null","boolean"],"default":null,"doc":"true when resting size on the new side at the block's own price reached half of the block's first size at any bucket after the invasion"},{"name":"refillMaxSize","type":["null","long"],"default":null,"doc":"the largest such size"},{"name":"retestAtMs","type":["null","long"],"default":null,"doc":"bucket end of the first retest print"},{"name":"retestDepthTicks","type":["null","long"],"default":null,"doc":"furthest ticks the retest went toward and through the block's price"},{"name":"retestAwayTicks","type":["null","long"],"default":null,"doc":"furthest ticks away from the block on the new side after the retest began"}]}