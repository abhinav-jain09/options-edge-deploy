{"type":"record","name":"LiquidityWallOutcome","namespace":"com.optionsedge.contracts.liquiditywall","doc":"liq-AA: ONE decided outcome of one displayed target at one horizon, published by es-liquidity-wall-service itself on futures.liquidity-wall.outcomes (key '<tradeDate>|<targetId>|M<seconds>'), computed in the service's own bucket loop from its own book and tape in data time only. DESCRIPTIVE and UNVALIDATED.","fields":[{"name":"schemaVersion","type":"int","doc":"1","default":1},{"name":"outcomeRuleVersion","type":"string","doc":"liq-AA-v1"},{"name":"service","type":"string","doc":"es-liquidity-wall-service"},{"name":"depthEnvironment","type":"string","doc":"depth environment literal"},{"name":"contract","type":"string","doc":"contract"},{"name":"configFingerprint","type":"string","doc":"identity of the wall engine configuration, copied from the engine"},{"name":"tradeDate","type":"string","doc":"yyyy-MM-dd of the SPX cash close that ends the tracking session"},{"name":"stratum","type":"string","doc":"RTH or GLOBEX_PRE, from the instant the target was first shown"},{"name":"targetId","type":"string","doc":"side|tick|firstShownBucketEnd"},{"name":"side","type":"string","doc":"ABOVE or BELOW"},{"name":"tick","type":"long","doc":"ES tick of the block"},{"name":"distanceTicksAtShown","type":"long","doc":"ticks from the spot when first shown"},{"name":"sizeAtShown","type":"long","doc":"contracts when first shown"},{"name":"multipleThousandthsAtShown","type":"long","doc":"size over the typical size, thousandths, when first shown"},{"name":"t0Ms","type":"long","doc":"bucket end at which it was first shown"},{"name":"horizonSeconds","type":"int","doc":"600 or 1800"},{"name":"windowEndMs","type":"long","doc":"t0Ms + horizonSeconds * 1000"},{"name":"bucketEnd","type":"long","doc":"the bucket end at which the record was made (data time, never a clock)"},{"name":"reached","type":["null","boolean"],"doc":"a print came within the tolerance of the block's price inside the window; null when excluded","default":null},{"name":"reachedAfterMs","type":["null","long"],"doc":"ms from t0 to the first such print","default":null},{"name":"toleranceTicks","type":"int","doc":"1"},{"name":"fate","type":["null","string"],"doc":"CONSUMED (the block lost half its size while prints traded at its price), PULLED (it lost half its size with few prints), HELD_SIZE (it did not), or UNKNOWN","default":null},{"name":"fateAtMs","type":["null","long"],"doc":"bucket end at which the fate was found","default":null},{"name":"tradedAtPriceSinceShown","type":["null","long"],"doc":"contracts printed at the block's price since it was shown, to the decision","default":null},{"name":"sizeAtDecision","type":["null","long"],"doc":"contracts at the block's price at the decision, null when the book was not read","default":null},{"name":"pastTicks","type":["null","long"],"doc":"furthest ticks past the block's price before the first move back, or to the decision if there was none; 0 when not reached","default":null},{"name":"reversed","type":["null","boolean"],"doc":"true when a move back of reversalTicks from that furthest price happened inside the window","default":null},{"name":"reversalTicks","type":"int","doc":"8"},{"name":"liveBuckets","type":"int","doc":"buckets of the window with quality LIVE"},{"name":"totalBuckets","type":"int","doc":"buckets of the window read"},{"name":"excludedReason","type":["null","string"],"doc":"null, or SESSION_ENDED, BUCKET_GAP, CONTRACT_ROLL","default":null},{"name":"label","type":"string","doc":"DESCRIPTIVE_UNVALIDATED","default":"DESCRIPTIVE_UNVALIDATED"}]}