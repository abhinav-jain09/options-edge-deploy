{"type":"record","name":"L1Contribution","namespace":"com.optionsedge.contracts.optionpressure","doc":"One accepted or rejected option print as option-price-behavior's L1 stage emits it, carrying the surface residual and the exposure weight the pressure register aggregates. Field nullability here is exactly the producing record's own invariant: an EXCLUDED contribution carries null residualZScore, directionalZ and exposureWeight, and an INCLUDED one carries all three finite, so the union is the contract and not a convenience.","fields":[{"name":"schemaVersion","type":"int","doc":"Body version of this record; 1 is the only accepted value."},{"name":"recordType","type":"string","doc":"L1RecordType; CONTRIBUTION is the only value the producer emits."},{"name":"optionKey","type":"string"},{"name":"symbol","type":"string"},{"name":"expiry","type":"string"},{"name":"strike","type":"string"},{"name":"call","type":"boolean"},{"name":"opbTaskId","type":"string","doc":"The producing Streams task, which is what makes contributionPartitionSequence orderable."},{"name":"contributionPartitionSequence","type":"long"},{"name":"residualZScore","type":["null","double"],"doc":"Null exactly when the contribution is excluded.","default":null},{"name":"directionalZ","type":["null","double"],"doc":"residualZScore signed by call/put. Null exactly when excluded.","default":null},{"name":"exposureWeight","type":["null","double"],"doc":"Non-negative when present. Null exactly when excluded.","default":null},{"name":"eventTimeMs","type":"long"},{"name":"included","type":"boolean","doc":"Agrees with behaviorLabel by the producer's invariant; carried so a reader need not re-derive it."},{"name":"behaviorLabel","type":"string"},{"name":"quoteAsOfEventTimeMs","type":["null","long"],"default":null},{"name":"quoteAgeMs","type":["null","long"],"default":null},{"name":"surfaceAsOfEventTimeMs","type":["null","long"],"default":null},{"name":"currentSurfaceAgeMs","type":["null","long"],"default":null},{"name":"forwardAgeMs","type":["null","long"],"default":null},{"name":"aggressorSide","type":"string"},{"name":"aggressorQuality","type":"string"},{"name":"aggressorConfidence","type":"string"},{"name":"aggressorReason","type":"string"},{"name":"modelVersion","type":"string"},{"name":"opbConfigHash","type":"string","doc":"Identity of the upstream residual configuration this contribution was produced under; a consumer rotates state when it changes."},{"name":"stateEpochId","type":"string"},{"name":"segmentId","type":["null","string"],"doc":"Nullable: the producing record requires text for every other identity field but not for this one.","default":null},{"name":"segmentVarianceSampleCount","type":"long"},{"name":"varianceWarmupReady","type":"boolean"},{"name":"sessionId","type":"string"}]}