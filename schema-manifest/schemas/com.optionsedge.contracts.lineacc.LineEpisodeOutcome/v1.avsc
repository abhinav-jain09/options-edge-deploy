{"type":"record","name":"LineEpisodeOutcome","namespace":"com.optionsedge.contracts.lineacc","doc":"S1 appendage of an ACCEPTED episode (FAILED / HELD / HELD_CENSORED), versioned and append-only. Key: episodeId.","fields":[{"name":"schemaVersion","type":"int"},{"name":"recordType","type":{"type":"enum","name":"RecordType","symbols":["UNKNOWN","EPISODE_CORE","EPISODE_EVIDENCE","EPISODE_OUTCOME","EPISODE_INTEGRITY","LEAN_EVENT","SESSION_COVERAGE","MONITOR_STATUS"],"default":"UNKNOWN"}},{"name":"sessionDate","type":"string"},{"name":"sessionSegment","type":{"type":"enum","name":"SessionSegment","symbols":["UNKNOWN","RTH","GLOBEX"],"default":"UNKNOWN"}},{"name":"timeframe","type":{"type":"enum","name":"Timeframe","symbols":["UNKNOWN","M1","M5","M15"],"default":"UNKNOWN"}},{"name":"asOfMs","type":"long"},{"name":"publishSeq","type":"long"},{"name":"episodeId","type":"string"},{"name":"s1Version","type":"int"},{"name":"s1Outcome","type":{"type":"enum","name":"S1Outcome","symbols":["UNKNOWN","PENDING","FAILED","HELD","HELD_CENSORED","NOT_APPLICABLE"],"default":"UNKNOWN"}},{"name":"s1LineBasisStates","type":{"type":"array","items":{"type":"record","name":"S1LineBasisState","fields":[{"name":"basisState","type":{"type":"enum","name":"BasisState","symbols":["UNKNOWN","MEASURED","PROJECTED","ESTIMATED","UNAVAILABLE"],"default":"UNKNOWN"}},{"name":"basisSourceVersion","type":"string"},{"name":"displayed","type":"boolean"},{"name":"segmentId","type":"string"}]}},"default":[]},{"name":"reclaimDirection","type":["null",{"type":"enum","name":"ApproachDirection","symbols":["UNKNOWN","FROM_ABOVE","FROM_BELOW"],"default":"UNKNOWN"}],"default":null},{"name":"reclaimOrdinal","type":["null","int"],"default":null},{"name":"holdOrdinal","type":["null","int"],"default":null},{"name":"retestedOrdinal","type":["null","int"],"default":null},{"name":"candleLifecycleUpdates","type":{"type":"array","items":{"type":"record","name":"CandleLifecycleUpdate","fields":[{"name":"patternId","type":"strin