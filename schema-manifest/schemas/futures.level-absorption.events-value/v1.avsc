ing"],"doc":"A RETEST's parent site.","default":null,"optionsedge.api-omit-null":"true"},{"name":"parentSiteKind","type":["null","string"],"doc":"A RETEST's parent kind (the publication cell's key).","default":null,"optionsedge.api-omit-null":"true"},{"name":"boundaryRole","type":["null","string"],"doc":"The site's boundary role.","default":null,"optionsedge.api-omit-null":"true"},{"name":"sourceObjectId","type":["null","string"],"doc":"The producer's object the site is a boundary of.","default":null,"optionsedge.api-omit-null":"true"},{"name":"sourceRevision","type":["null","string"],"doc":"The producer's revision of the site at the last applied record.","default":null,"optionsedge.api-omit-null":"true"},{"name":"hostTimeframe","type":["null","string"],"doc":"The host timeframe for a host site.","default":null,"optionsedge.api-omit-null":"true"},{"name":"evidenceTimeframe","type":["null","string"],"doc":"The candlestick evidence timeframe (LAG-R7.3).","default":null,"optionsedge.api-omit-null":"true"},{"name":"siteGeometryProtectedSide","type":["null","string"],"doc":"SUPPORT, RESISTANCE or NONE.","default":null,"optionsedge.api-omit-null":"true"},{"name":"siteIsDesk","type":["null","boolean"],"doc":"Whether the site is one of the desk's (section 6.1).","default":null,"optionsedge.api-omit-null":"true"},{"name":"coincidentSites","type":["null","int"],"doc":"LAG-R3.8: open episodes within the arm distance at the verdict.","default":null,"optionsedge.api-omit-null":"true"},{"name":"coincidentSiteIds","type":["null",{"type":"array","items":"string"}],"doc":"The coincident sites' ids, bounded, sorted.","default":null,"optionsedge.api-omit-null":"true"},{"name":"confluenceOverlapIds","type":["null",{"type":"array","items":"string"}],"doc":"SAME_ROLE_OVERLAP: coincident sites of the same protected side from the other producer class.","default":null,"optionsedge.api-omit-null":"true"},{"name":"timeGates","type":["null",{"type":"array","items":"string"}],"doc":"LAG-R4.5 labels this build decides.","default":null,"optionsedge.api-omit-null":"true"},{"name":"timeGatesUnavailable","type":["null",{"type":"array","items":"string"}],"doc":"LAG-R4.5 labels this build cannot decide.","default":null,"optionsedge.api-omit-null":"true"},{"name":"direction","type":["null","string"],"doc":"UP or DOWN: the direction the verdict protects (LAG-R7.1).","default":null,"optionsedge.api-omit-null":"true"},{"name":"entryPriceEs","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"doc":"The verdict bar's close in E-mini index points.","default":null,"optionsedge.api-omit-null":"true"},{"name":"entryPriceSpx","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"doc":"The verdict bar's close converted to the index domain.","default":null,"optionsedge.api-omit-null":"true"},{"name":"candleEvidence","type":["null","string"],"doc":"AVAILABLE or UNAVAILABLE: whether the candlestick lists were readable at that bar (LAG-R7.3).","default":null,"optionsedge.api-omit-null":"true"},{"name":"candleAgrees","type":["null",{"type":"array","items":{"type":"record","name":"LevelAbsorptionCandleEntry","doc":"One candlestick annotation listed as evidence (version 2 LAG-R7.3).","fields":[{"name":"annotationId","type":"string"},{"name":"patternId","type":"string"},{"name":"strength","type":"string"},{"name":"confirmationState","type":"string"}]}}],"doc":"Agreeing candlestick annotations.","default":null,"optionsedge.api-omit-null":"true"},{"name":"candleDisagrees","type":["null",{"type":"array","items":"LevelAbsorptionCandleEntry"}],"doc":"Disagreeing candlestick annotations.","default":null,"optionsedge.api-omit-null":"true"},{"name":"nextLevelEs","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"doc":"LAG-R8.2: the next live site's level in E-mini index points.","default":null,"optionsedge.api-omit-null":"true"},{"name":"nextLevelSpx","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"doc":"The next level in the index domain.","default":null,"optionsedge.api-omit-null":"true"},{"name":"nextLevelSiteId","type":["null","string"],"doc":"The next level's site id.","default":null,"optionsedge.api-omit-null":"true"},{"name":"nextLevelSourceRevision","type":["null","string"],"doc":"The next level's producer revision.","default":null,"optionsedge.api-omit-null":"true"},{"name":"cellIds","type":["null",{"type":"array","items":"string"}],"doc":"LAG-R12.2 cells the verdict is eligible for.","default":null,"optionsedge.api-omit-null":"true"},{"name":"governingCellId","type":["null","string"],"doc":"The cell whose exit rule the verdict publishes on; absent in the eyeball phase.","default":null,"optionsedge.api-omit-null":"true"},{"name":"pokeExtremeEs","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"doc":"LAG-R9.1: the failed poke's extreme in E-mini index points.","default":null,"optionsedge.api-omit-null":"true"},{"name":"pokeBarStartEpochMillis","type":["null","long"],"doc":"The bar containing the failed poke.","default":null,"optionsedge.api-omit-null":"true"},{"name":"candlePoke","type":["null","string"],"doc":"The candlestick annotation naming the poke, when one does.","default":null,"optionsedge.api-omit-null":"true"},{"name":"raceClosedBy","type":["null","string"],"doc":"VERDICT_RACE: the terminal reason that closed the race.","default":null,"optionsedge.api-omit-null":"true"},{"name":"exitRace","type":["null",{"type":"array","items":{"type":"record","name":"LevelAbsorptionExitRaceEntry","doc":"One candidate reason of a verdict's exit race and the first instant its predicate held; the fields after the reason are null when it never occurred (version 2 LAG-R8.1).","fields":[{"name":"reason","type":"string"},{"name":"epochMillis","type":["null","long"],"default":null},{"name":"priceEs","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"priceSpx","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"priceSource","type":["null","string"],"default":null},{"name":"withdrawalSubtype","type":["null","string"],"default":null}]}}],"doc":"VERDICT_RACE: every candidate reason with its first instant.","default":null,"optionsedge.api-omit-null":"true"},{"name":"exitResultPointsByRule","type":["null",{"type":"record","name":"LevelAbsorptionExitResultByRule","doc":"The signed result in index points under each registered exit rule (version 2 LAG-R8.5). Every registered rule contains every terminal reason, so the service sets all four when the race closes; null is admitted for a future rule that may have no end.","fields":[{"name":"E1","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"E2","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"E3","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"E4","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null}]}],"doc":"VERDICT_RACE: the result under each exit rule.","default":null,"optionsedge.api-omit-null":"true"},{"name":"endReason","type":["null","string"],"doc":"VERDICT_END: the reason the published rule ended on.","default":null,"optionsedge.api-omit-null":"true"},{"name":"withdrawalSubtype","type":["null","string"],"doc":"VERDICT_END: present exactly when endReason is WITHDRAWN (LAG-R16.3a).","default":null,"optionsedge.api-omit-null":"true"},{"name":"endPriceEs","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"doc":"VERDICT_END: the end price in E-mini index points.","default":null,"optionsedge.api-omit-null":"true"},{"name":"endPriceSpx","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"doc":"VERDICT_END: the end price in the index domain.","default":null,"optionsedge.api-omit-null":"true"},{"name":"endEpochMillis","type":["null","long"],"doc":"VERDICT_END: the end instant.","default":null,"optionsedge.api-omit-null":"true"},{"name":"endPriceSource","type":["null","string"],"doc":"PRINT or VERDICT_BAR_CLOSE.","default":null,"optionsedge.api-omit-null":"true"},{"name":"exitResultPoints","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"doc":"VERDICT_END: the signed result from the entry to the end price.","default":null,"optionsedge.api-omit-null":"true"},{"name":"candleAnnotationId","type":["null","string"],"doc":"VERDICT_END: the reversal annotation when the end reason is CANDLE_REVERSAL.","default":null,"optionsedge.api-omit-null":"true"},{"name":"statusReasonCode","type":["null","string"],"doc":"A withdrawal status: the reason code the site was withdrawn with.","default":null,"optionsedge.api-omit-null":"true"},{"name":"producerState","type":["null","string"],"doc":"A withdrawal status: the producer's own word for the site's state.","default":null,"optionsedge.api-omit-null":"true"},{"name":"lateSourceApplied","type":["null","boolean"],"doc":"Version 2 LAG-R3.10: true on every event of a site whose held tuple came from a source record applied late (admitted after the processing step of the first bar close at or after its effective instant); a label, never a suppression. Absent otherwise. When present it is always true, and the pair is present together; Avro cannot state that, so the producer (level-absorption-service SiteFields) refuses to build one without the other.","default":null,"optionsedge.api-omit-null":"true"},{"name":"sourceLagBars","type":["null","int"],"doc":"Version 2 LAG-R3.10: with lateSourceApplied, the lag in 30-second bars between the first close at or after the record's effective instant and the close at which it was applied (at least 1). Present exactly with lateSourceApplied; the producer refuses a lag below 1 and a lateSourceApplied of false.","default":null,"optionsedge.api-omit-null":"true"}]}