ge.api-number-type":"double"}],"default":null,"doc":"LAG-R8.2: the next live site's level in E-mini index points.","optionsedge.api-omit-null":"true"},{"name":"nextLevelSpx","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null,"doc":"The next level in the index domain.","optionsedge.api-omit-null":"true"},{"name":"nextLevelSiteId","type":["null","string"],"default":null,"doc":"The next level's site id.","optionsedge.api-omit-null":"true"},{"name":"nextLevelSourceRevision","type":["null","string"],"default":null,"doc":"The next level's producer revision.","optionsedge.api-omit-null":"true"},{"name":"cellIds","type":["null",{"type":"array","items":"string"}],"default":null,"doc":"LAG-R12.2 cells the verdict is eligible for.","optionsedge.api-omit-null":"true"},{"name":"governingCellId","type":["null","string"],"default":null,"doc":"The cell whose exit rule the verdict publishes on; absent in the eyeball phase.","optionsedge.api-omit-null":"true"},{"name":"pokeExtremeEs","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null,"doc":"LAG-R9.1: the failed poke's extreme in E-mini index points.","optionsedge.api-omit-null":"true"},{"name":"pokeBarStartEpochMillis","type":["null","long"],"default":null,"doc":"The bar containing the failed poke.","optionsedge.api-omit-null":"true"},{"name":"candlePoke","type":["null","string"],"default":null,"doc":"The candlestick annotation naming the poke, when one does.","optionsedge.api-omit-null":"true"},{"name":"raceClosedBy","type":["null","string"],"default":null,"doc":"VERDICT_RACE: the terminal reason that closed the race.","optionsedge.api-omit-null":"true"},{"name":"exitRace","type":["null",{"type":"array","items":{"type":"record","name":"LevelAbsorptionExitRaceEntry","namespace":"com.optionsedge.contracts.cvdrelated","doc":"One candidate reason of a verdict's exit race and the first instant its predicate held; the fields after the reason are null when it never occurred (version 2 LAG-R8.1).","fields":[{"name":"reason","type":"string"},{"name":"epochMillis","type":["null","long"],"default":null},{"name":"priceEs","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"priceSpx","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"priceSource","type":["null","string"],"default":null},{"name":"withdrawalSubtype","type":["null","string"],"default":null}]}}],"default":null,"doc":"VERDICT_RACE: every candidate reason with its first instant.","optionsedge.api-omit-null":"true"},{"name":"exitResultPointsByRule","type":["null",{"type":"record","name":"LevelAbsorptionExitResultByRule","namespace":"com.optionsedge.contracts.cvdrelated","doc":"The signed result in index points under each registered exit rule (version 2 LAG-R8.5). Every registered rule contains every terminal reason, so the service sets all four when the race closes; null is admitted for a future rule that may have no end.","fields":[{"name":"E1","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"E2","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"E3","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"E4","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null}]}],"default":null,"doc":"VERDICT_RACE: the result under each exit rule.","optionsedge.api-omit-null":"true"},{"name":"endReason","type":["null","string"],"default":null,"doc":"VERDICT_END: the reason the published rule ended on.","optionsedge.api-omit-null":"true"},{"name":"withdrawalSubtype","type":["null","string"],"default":null,"doc":"VERDICT_END: present exactly when endReason is WITHDRAWN (LAG-R16.3a).","optionsedge.api-omit-null":"true"},{"name":"endPriceEs","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null,"doc":"VERDICT_END: the end price in E-mini index points.","optionsedge.api-omit-null":"true"},{"name":"endPriceSpx","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null,"doc":"VERDICT_END: the end price in the index domain.","optionsedge.api-omit-null":"true"},{"name":"endEpochMillis","type":["null","long"],"default":null,"doc":"VERDICT_END: the end instant.","optionsedge.api-omit-null":"true"},{"name":"endPriceSource","type":["null","string"],"default":null,"doc":"PRINT or VERDICT_BAR_CLOSE.","optionsedge.api-omit-null":"true"},{"name":"exitResultPoints","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null,"doc":"VERDICT_END: the signed result from the entry to the end price.","optionsedge.api-omit-null":"true"},{"name":"candleAnnotationId","type":["null","string"],"default":null,"doc":"VERDICT_END: the reversal annotation when the end reason is CANDLE_REVERSAL.","optionsedge.api-omit-null":"true"},{"name":"statusReasonCode","type":["null","string"],"default":null,"doc":"A withdrawal status: the reason code the site was withdrawn with.","optionsedge.api-omit-null":"true"},{"name":"producerState","type":["null","string"],"default":null,"doc":"A withdrawal status: the producer's own word for the site's state.","optionsedge.api-omit-null":"true"},{"name":"lateSourceApplied","type":["null","boolean"],"default":null,"doc":"Version 2 LAG-R3.10: true on every event of a site whose held tuple came from a source record applied late (admitted after the processing step of the first bar close at or after its effective instant); a label, never a suppression. Absent otherwise. When present it is always true, and the pair is present together; Avro cannot state that, so the producer (level-absorption-service SiteFields) refuses to build one without the other.","optionsedge.api-omit-null":"true"},{"name":"sourceLagBars","type":["null","int"],"default":null,"doc":"Version 2 LAG-R3.10: with lateSourceApplied, the lag in 30-second bars between the first close at or after the record's effective instant and the close at which it was applied (at least 1). Present exactly with lateSourceApplied; the producer refuses a lag below 1 and a lateSourceApplied of false.","optionsedge.api-omit-null":"true"},{"name":"bookRead","type":["null","string"],"default":null,"doc":"Version 2 (requirement A rev 12 section 8): this bar's book read, layer one of section 7: ABSORBING_BOOK, THINNING_BOOK, NEUTRAL_BOOK or NO_BOOK. A string, not an enum (the canonical bridge carries no enums).","optionsedge.api-omit-null":"true"},{"name":"bookState","type":["null","string"],"default":null,"doc":"Layer two: BOOK_BUILDING, NO_BOOK or a confirmed read (ABSORBING_BOOK, THINNING_BOOK, NEUTRAL_BOOK).","optionsedge.api-omit-null":"true"},{"name":"bookBarsConfirming","type":["null","int"],"default":null,"doc":"The K_b count of consecutive bars that confirm the book read.","optionsedge.api-omit-null":"true"},{"name":"bookAgreement","type":["null","string"],"default":null,"doc":"CONFIRMS, CONTRADICTS or SILENT (SILENT on a NO_BOOK bar).","optionsedge.api-omit-null":"true"},{"name":"bookReadBy","type":["null","string"],"default":null,"doc":"RESTORE, HIDDEN or BOTH on an ABSORBING_BOOK bar; null otherwise.","optionsedge.api-omit-null":"true"},{"name":"bookBandLowTicks","type":["null","long"],"default":null,"doc":"The low bound of the band B in ES ticks; set once the level is armed.","optionsedge.api-omit-null":"true"},{"name":"bookBandHighTicks","type":["null","long"],"default":null,"doc":"The high bound of the band B in ES ticks; set once the level is armed.","optionsedge.api-omit-null":"true"},{"name":"bookAdded","type":["null","long"],"default":null,"doc":"Contracts added in the band B over the bar (section 6). Null (omitted) wherever section 8 of the requirement says null: on a NO_BOOK bar every numeric book field is null, not zero, except the counts, the coverage and the band.","optionsedge.api-omit-null":"true"},{"name":"bookDecrease","type":["null","long"],"default":null,"doc":"Contracts of decrease in the band B over the bar (section 6). Null (omitted) wherever section 8 of the requirement says null: on a NO_BOOK bar every numeric book field is null, not zero, except the counts, the coverage and the band.","optionsedge.api-omit-null":"true"},{"name":"bookAccounted","type":["null","long"],"default":null,"doc":"Contracts of the decrease accounted for (section 6). Null (omitted) wherever section 8 of the requirement says null: on a NO_BOOK bar every numeric book field is null, not zero, except the counts, the coverage and the band.","optionsedge.api-omit-null":"true"},{"name":"bookUnaccounted","type":["null","long"],"default":null,"doc":"Contracts of the decrease not accounted for (section 6). Null (omitted) wherever section 8 of the requirement says null: on a NO_BOOK bar every numeric book field is null, not zero, except the counts, the coverage and the band.","optionsedge.api-omit-null":"true"},{"name":"bookUnclassified","type":["null","long"],"default":null,"doc":"Contracts of the decrease left unclassified (section 6). Null (omitted) wherever section 8 of the requirement says null: on a NO_BOOK bar every numeric book field is null, not zero, except the counts, the coverage and the band.","optionsedge.api-omit-null":"true"},{"name":"bookHidden","type":["null","long"],"default":null,"doc":"Hidden contracts over the bar (section 6); null while Hidden is unavailable, and on a NO_BOOK bar.","optionsedge.api-omit-null":"true"},{"name":"bookRestoreRatio","type":["null","double"],"default":null,"doc":"Restore ratio (section 6); null when its denominator is below minimum, and on a NO_BOOK bar.","optionsedge.api-omit-null":"true"},{"name":"bookUnaccountedShare","type":["null","double"],"default":null,"doc":"Unaccounted share (section 6); null when its denominator is below minimum, and on a NO_BOOK bar.","optionsedge.api-omit-null":"true"},{"name":"bookHiddenShare","type":["null","double"],"default":null,"doc":"Hidden share (section 6); null when its denominator is below minimum, when Hidden is unavailable, and on a NO_BOOK bar.","optionsedge.api-omit-null":"true"},{"name":"bookAttributedShare","type":["null","double"],"default":null,"doc":"Attributed share (section 6); null when it has no reduction in the band, and on a NO_BOOK bar.","optionsedge.api-omit-null":"true"},{"name":"bookResting","type":["null","long"],"default":null,"doc":"Resting figure, reported only (section 6); null as section 6 says, and on a NO_BOOK bar.","optionsedge.api-omit-null":"true"},{"name":"bookRestingOpen","type":["null","long"],"default":null,"doc":"Resting-open figure, reported only (section 6); null as section 6 says, and on a NO_BOOK bar.","optionsedge.api-omit-null":"true"},{"name":"bookNearImbalance","type":["null","double"],"default":null,"doc":"Near-book imbalance, reported only (section 6); null as section 6 says, and on a NO_BOOK bar.","optionsedge.api-omit-null":"true"},{"name":"bookCoverage","type":["null","double"],"default":null,"doc":"Usable buckets over the bar's buckets; its measured value is set even on a NO_BOOK bar.","optionsedge.api-omit-null":"true"},{"name":"bookBuckets","type":["null","int"],"default":null,"doc":"The number of the bar's buckets; set on every bar.","optionsedge.api-omit-null":"true"},{"name":"bookBucketsUsed","type":["null","int"],"default":null,"doc":"The number of buckets used; set on every bar.","optionsedge.api-omit-null":"true"},{"name":"bookExcludedCounts","type":["null",{"type":"map","values":"int"}],"default":null,"doc":"Excluded buckets by reason, a JSON object of reason to count such as {\"SOURCE_LAG\":1}; set on every bar.","optionsedge.api-omit-null":"true"},{"name":"bookRefusedCounts","type":["null",{"type":"map","values":"int"}],"default":null,"doc":"Refused records by reason over the bar, a JSON object of reason to count such as {\"ENVIRONMENT\":0,\"SCHEMA_ID\":0}; set on every bar.","optionsedge.api-omit-null":"true"},{"name":"bookNoBookReason","type":["null","string"],"default":null,"doc":"The reason of section 7 on a NO_BOOK bar; null otherwise.","optionsedge.api-omit-null":"true"},{"name":"bookSourceLagStatus","type":["null","string"],"default":null,"doc":"The worst source-lag status over the bar's buckets in the order LAGGING, SILENT, UNKNOWN, FRESH.","optionsedge.api-omit-null":"true"},{"name":"bookSourceLagMs","type":["null","long"],"default":null,"doc":"The largest absolute sourceLagMs over the usable buckets.","optionsedge.api-omit-null":"true"},{"name":"bookCompletedBy","type":["null","string"],"default":null,"doc":"BOOK_WATERMARK or BOOK_MISSING: how the bar was completed.","optionsedge.api-omit-null":"true"},{"name":"bookCompletedAtMs","type":["null","long"],"default":null,"doc":"Epoch milliseconds the bar completed: source-derived or recorded, never a reading of the runner's clock.","optionsedge.api-omit-null":"true"},{"name":"bookEpochId","type":["null","long"],"default":null,"doc":"Engine epoch of the last bucket used.","optionsedge.api-omit-null":"true"},{"name":"bookFirstBucketEnd","type":["null","long"],"default":null,"doc":"End of the first bucket used (epoch milliseconds).","optionsedge.api-omit-null":"true"},{"name":"bookLastBucketEnd","type":["null","long"],"default":null,"doc":"End of the last bucket used (epoch milliseconds).","optionsedge.api-omit-null":"true"},{"name":"bookHealthOffset","type":["null","long"],"default":null,"doc":"Offset of the last health record used.","optionsedge.api-omit-null":"true"},{"name":"bookFinalClosureOffset","type":["null","long"],"default":null,"doc":"Offset of the last FINAL closure used.","optionsedge.api-omit-null":"true"},{"name":"bookConfigFingerprint","type":["null","string"],"default":null,"doc":"The engine's configuration fingerprint on the last bucket used.","optionsedge.api-omit-null":"true"},{"name":"bookEnvironment","type":["null","string"],"default":null,"doc":"The environment string the book records carried; set once any record of the episode was read.","optionsedge.api-omit-null":"true"},{"name":"contractTableDigest","type":["null","string"],"default":null,"doc":"SHA-256 of the committed contract table.","optionsedge.api-omit-null":"true"},{"name":"bookHiddenPublished","type":["null","boolean"],"default":null,"doc":"True when the engine's final rows are version 2 (Hidden published).","optionsedge.api-omit-null":"true"},{"name":"bookAttributionAccepted","type":["null","boolean"],"default":null,"doc":"False until document J section 2 has an accepted result.","optionsedge.api-omit-null":"true"},{"name":"bookProvisional","type":["null","boolean"],"default":null,"doc":"True until the five closed values are frozen (section 9).","optionsedge.api-omit-null":"true"},{"name":"bookSource","type":["null","string"],"default":null,"doc":"The source of the book, such as MBO_ENGINE.","optionsedge.api-omit-null":"true"}]}