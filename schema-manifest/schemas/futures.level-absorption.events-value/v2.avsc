{"type":"record","name":"LevelAbsorptionEvent","namespace":"com.optionsedge.contracts.cvdrelated","fields":[{"name":"eventType","type":"string"},{"name":"timestamp","type":"long"},{"name":"episodeId","type":["null","string"],"default":null},{"name":"level","type":"string"},{"name":"levelPriceEs","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"levelPriceSpx","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"basisAtBar","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"approachSide","type":["null","string"],"default":null},{"name":"state","type":["null","string"],"default":null},{"name":"barsConfirming","type":["null","int"],"default":null},{"name":"windowBars","type":["null","int"],"default":null},{"name":"windowDelta","type":["null","long"],"default":null},{"name":"resultPoints","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"ratio","type":["null","double"],"default":null},{"name":"verdict","type":"string"},{"name":"protectedSide","type":"string"},{"name":"barIds","type":["null",{"type":"array","items":"long"}],"default":null},{"name":"verdictId","type":["null","string"],"default":null},{"name":"lean","type":["null","string"],"default":null},{"name":"episodeState","type":"string"},{"name":"unknownShare","type":["null","double"],"default":null},{"name":"reason","type":["null",{"type":"record","name":"LevelAbsorptionReason","namespace":"com.optionsedge.contracts.cvdrelated","fields":[{"name":"_present","type":{"type":"array","items":"int"}},{"name":"code","type":"string","optionsedge.api-required":"true"},{"name":"basisState","type":["null","string"],"default":null},{"name":"barStartEpochMillis","type":["null","long"],"default":null},{"name":"deadlineEpochMillis","type":["null","long"],"default":null},{"name":"fieldPath","type":["null","string"],"default":null},{"name":"failure","type":["null","string"],"default":null},{"name":"maxGapMillis","type":["null","long"],"default":null},{"name":"thresholdMillis","type":["null","long"],"default":null},{"name":"unknownShare","type":["null","double"],"default":null},{"name":"maximum","type":["null","double"],"default":null},{"name":"printPrice","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"boundary","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"closeOne","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"closeTwo","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18,"optionsedge.api-number-type":"double"}],"default":null},{"name":"producerState","type":["null","string"],"default":null},{"name":"cause","type":["null","string"],"default":null},{"name":"lineId","type":["null","string"],"default":null},{"name":"commandEpochMillis","type":["null","long"],"default":null},{"name":"scheduledCloseEpochMillis","type":["null","long"],"default":null}],"optionsedge.api-presence-field":"_present"}],"default":null},{"name":"lateSession","type":["null","boolean"],"default":null},{"name":"siteId","type":["null","string"],"default":null,"doc":"Version 2 LAG-R3.6: <kind>|<boundaryRole>|<sourceObjectId>; absent on a version-1 event.","optionsedge.api-omit-null":"true"},{"name":"family","type":["null","string"],"default":null,"doc":"EDGE, LINE, MIDDLE or RETEST.","optionsedge.api-omit-null":"true"},{"name":"moment","type":["null","string"],"default":null,"doc":"TEST or RETEST.","optionsedge.api-omit-null":"true"},{"name":"parentSiteId","type":["null","string"],"default":null,"doc":"A RETEST's parent site.","optionsedge.api-omit-null":"true"},{"name":"parentSiteKind","type":["null","string"],"default":null,"doc":"A RETEST's parent kind (the publication cell's key).","optionsedge.api-omit-null":"true"},{"name":"boundaryRole","type":["null","string"],"default":null,"doc":"The site's boundary role.","optionsedge.api-omit-null":"true"},{"name":"sourceObjectId","type":["null","string"],"default":null,"doc":"The producer's object the site is a boundary of.","optionsedge.api-omit-null":"true"},{"name":"sourceRevision","type":["null","string"],"default":null,"doc":"The producer's revision of the site at the last applied record.","optionsedge.api-omit-null":"true"},{"name":"hostTimeframe","type":["null","string"],"default":null,"doc":"The host timeframe for a host site.","optionsedge.api-omit-null":"true"},{"name":"evidenceTimeframe","type":["null","string"],"default":null,"doc":"The candlestick evidence timeframe (LAG-R7.3).","optionsedge.api-omit-null":"true"},{"name":"siteGeometryProtectedSide","type":["null","string"],"default":null,"doc":"SUPPORT, RESISTANCE or NONE.","optionsedge.api-omit-null":"true"},{"name":"siteIsDesk","type":["null","boolean"],"default":null,"doc":"Whether the site is one of the desk's (section 6.1).","optionsedge.api-omit-null":"true"},{"name":"coincidentSites","type":["null","int"],"default":null,"doc":"LAG-R3.8: open episodes within the arm distance at the verdict.","optionsedge.api-omit-null":"true"},{"name":"coincidentSiteIds","type":["null",{"type":"array","items":"string"}],"default":null,"doc":"The coincident sites' ids, bounded, sorted.","optionsedge.api-omit-null":"true"},{"name":"confluenceOverlapIds","type":["null",{"type":"array","items":"string"}],"default":null,"doc":"SAME_ROLE_OVERLAP: coincident sites of the same protected side from the other producer class.","optionsedge.api-omit-null":"true"},{"name":"timeGates","type":["null",{"