{"type":"record","name":"LiquidityWallTargets","namespace":"com.optionsedge.contracts.liquiditywall","doc":"liq-AA liquidity targets (es-liquidity-wall-service): the nearest sizeable resting blocks above and below the spot, once per closed bucket, on the compacted topic futures.liquidity-wall.targets under the single key CME|<contract>. A DISPLAY of where size rests, chosen from one Friday; not a finding and no claim that price travels to a block. Every ratio is an integer in thousandths; every closed vocabulary is a string.","fields":[{"name":"schemaVersion","type":"int","doc":"1","default":1},{"name":"depthEnvironment","type":"string","doc":"environment literal of the admitted depth frames"},{"name":"contract","type":"string","doc":"the contract table's row"},{"name":"configFingerprint","type":"string","doc":"the wall engine's configuration fingerprint"},{"name":"bucketEnd","type":"long","doc":"bucket end, epoch ms"},{"name":"quality","type":"string","doc":"the bucket's quality"},{"name":"state","type":"string","doc":"READY, WARMING_UP, OUT_OF_SESSION, NO_SPOT, NO_BOOK or CALENDAR_UNKNOWN"},{"name":"sessionDate","type":["null","string"],"doc":"trade date of the tracking session (the SPX cash close that ends it), null out of session","default":null},{"name":"spotTick","type":["null","long"],"doc":"the spot print's tick","default":null},{"name":"thresholdThousandths","type":"int","doc":"display multiple of the typical size a block must reach (3000 = 3.0x); a DISPLAY setting, not a finding"},{"name":"maxPerSide","type":"int","doc":"largest number of targets shown per side"},{"name":"reachTicksWanted","type":"int","doc":"how far from the spot the search goes (200 = 50 points)"},{"name":"typicalAbove","type":["null","long"],"doc":"median size per occupied price on the ask side over the trailing hour of samples, null while warming up","default":null},{"name":"typicalBelow","type":["null","long"],"doc":"same for the bid side","default":null},{"name":"reachAboveTicks","type":["null","long"],"doc":"how far above the spot the book actually extends, at most reachTicksWanted","default":null},{"name":"reachBelowTicks","type":["null","long"],"doc":"how far below the spot the book actually extends, at most reachTicksWanted","default":null},{"name":"nearContractsAbove","type":["null","long"],"doc":"contracts over the nearest nearPrices occupied ask prices above the spot","default":null},{"name":"nearContractsBelow","type":["null","long"],"doc":"contracts over the nearest nearPrices occupied bid prices below the spot","default":null},{"name":"nearPrices","type":"int","doc":"8","default":8},{"name":"targets","type":{"type":"array","items":{"type":"record","name":"LiquidityWallTarget","namespace":"com.optionsedge.contracts.liquiditywall","doc":"one displayed liquidity target: a sizeable resting block above or below the spot. A display object, not a finding.","fields":[{"name":"targetId","type":"string","doc":"side|tick|firstShownBucketEnd, unique within a trade date"},{"name":"side","type":"string","doc":"ABOVE (an ask block above the spot) or BELOW (a bid block below the spot)"},{"name":"tick","type":"long","doc":"ES quarter-point tick of the block's price (price = tick / 4)"},{"name":"distanceTicks","type":"long","doc":"ticks from the spot print at this bucket to the block (positive both sides)"},{"name":"size","type":"long","doc":"contracts resting at that single price at this bucket's close"},{"name":"multipleThousandths","type":"long","doc":"size over the trailing-hour typical per-price size of its side, in thousandths"},{"name":"firstShownBucketEnd","type":"long","doc":"bucket end at which the block was first shown (t0 of its record)"},{"name":"status","type":"string","doc":"WAITING, REACHED, PASSED, CONSUMED or PULLED, from the in-service tracker"},{"name":"reachedAfterMs","type":["null","long"],"doc":"ms from t0 to the first print within the tolerance, null while waiting","default":null},{"name":"pastTicks","type":"long","doc":"furthest ticks past the block so far (0 before it is reached)"},{"name":"resolvedAtBucketEnd","type":["null","long"],"doc":"bucket end at which the block was found consumed or pulled, null otherwise","default":null},{"name":"live","type":"boolean","doc":"true when the block still qualifies at this bucket, false for a resolved one kept on view for a short time"}]}},"default":[],"doc":"the targets, above then below, nearest first within a side"},{"name":"label","type":"string","doc":"the constant DISPLAY_NOT_A_FINDING","default":"DISPLAY_NOT_A_FINDING"}]}