{"type":"record","name":"LiquidityWallTargets","namespace":"com.optionsedge.contracts.liquiditywall","doc":"liq-AA liquidity targets (es-liquidity-wall-service): the nearest sizeable resting blocks above and below the spot, once per closed bucket, on the compacted topic futures.liquidity-wall.targets under the single key CME|<contract>. A DISPLAY of where size rests, chosen from one Friday; not a finding and no claim that price travels to a block. Every ratio is an integer in thousandths; every closed vocabulary is a string.","fields":[{"name":"schemaVersion","type":"int","doc":"1","default":1},{"name":"depthEnvironment","type":"string","doc":"environment literal of the admitted depth frames"},{"name":"contract","type":"string","doc":"the contract table's row"},{"name":"configFingerprint","type":"string","doc":"the wall engine's configuration fingerprint"},{"name":"bucketEnd","type":"long","doc":"bucket end, epoch ms"},{"name":"quality","type":"string","doc":"the bucket's quality"},{"name":"state","type":"string","doc":"READY, WARMING_UP, OUT_OF_SESSION, NO_SPOT, NO_BOOK or CALENDAR_UNKNOWN"},{"name":"sessionDate","type":["null","string"],"doc":"trade date of the tracking session (the SPX cash close that ends it), null out of session","default":null},{"name":"spotTick","type":["null","long"],"doc":"the spot print's tick","default":null},{"name":"thresholdThousandths","type":"int","doc":"display multiple of the typical size a block must reach (3000 = 3.0x); a DISPLAY setting, not a finding"},{"name":"maxPerSide","type":"int","doc":"largest number of targets shown per side"},{"name":"reachTicksWanted","type":"int","doc":"how far from the spot the search goes (200 = 50 points)"},{"name":"typicalAbove","type":["null","long"],"doc":"median size per occupied price on the ask side over the trailing hour of samples, null while warming up","default":null},{"name":"typicalBelow","type":["null","long"],"doc":"same for the bid side","default":null},{"name":"reachAboveTicks","type":["null","long"],"doc":"how far above the spot the book actually extends, at most reachTicksWanted","default":null},{"name":"reachBelowTicks","type":["null","long"],"doc":"how far below the spot the book actually extends, at most reachTicksWanted","default":null},{"name":"nearContractsAbove","type":["null","long"],"doc":"contracts over the nearest nearPrices occupied ask prices above the spot","default":null},{"name":"nearContractsBelow","type":["null","long"],"doc":"contracts over the nearest nearPrices occupied bid prices below the spot","default":null},{"name":"nearPrices","type":"int","doc":"8","default":8},{"name":"targets","type":{"type":"array","items":{"type":"record","name":"LiquidityWallTarget","namespace":"com.optionsedge.contracts.liquiditywall","doc":"one displayed liquidity target: a sizeable resting block above or below the spot. A display object, not a finding.","fields":[{"name":"targetId","type":"string","doc":"side|tick|firstShownBucketEnd, unique within a trade date"},{"name":"side","type":"string","doc":"ABOVE (an ask block above the spot) or BELOW (a bid block below the spot)"},{"name":"tick","type":"long","doc":"ES quarter-point tick of the block's price (price = tick / 4)"},{"name":"distanceTicks","type":"long","doc":"ticks from the spot print at this bucket to the block (positive both sides)"},{"name":"size","type":"long","doc":"contracts resting at that single price at this bucket's close"},{"name":"multipleThousandths","type":"long","doc":"size over the trailing-hour typical per-price size of its side, in thousandths"},{"name":"firstShownBucketEnd","type":"long","doc":"bucket end at which the block was first shown (t0 of its record)"},{"name":"status","type":"string","doc":"WAITING, REACHED, PASSED, CONSUMED or PULLED, from the in-service tracker"},{"name":"reachedAfterMs","type":["null","long"],"doc":"ms from t0 to the first print within the tolerance, null while waiting","default":null},{"name":"pastTicks","type":"long","doc":"furthest ticks past the block so far (0 before it is reached)"},{"name":"resolvedAtBucketEnd","type":["null","long"],"doc":"bucket end at which the block was found consumed or pulled, null otherwise","default":null},{"name":"live","type":"boolean","doc":"true when the block still qualifies at this bucket, false for a resolved one kept on view for a short time"},{"name":"wallClusterId","type":["null","string"],"default":null,"doc":"clusterId of the live wall (Layer B) whose ticks contain this block on the same side, null when no wall shows it; the page draws ONE bar for the block and adds the multiple and the chip to the wall bar"},{"name":"touches","type":"int","default":0,"doc":"role-flip tracker: touches counted so far (a touch = a print within the tolerance of the block's price from its original side, after price was at least the reset distance away)"},{"name":"flipState","type":"string","default":"TESTING","doc":"role-flip tracker: TESTING, INVADED, RETEST_HELD, RETEST_FAILED, RETEST_UNRESOLVED or NO_RETEST. The page draws the tilted line, the colour and the chip ONLY from INVADED onward"},{"name":"flipKind","type":["null","string"],"default":null,"doc":"R_TO_S (a resistance block invaded upward, now acting below price) or S_TO_R (a support block invaded downward), set at INVADED"},{"name":"invadedAtMs","type":["null","long"],"default":null,"doc":"bucket end at which the invasion was recorded"},{"name":"sizeHistory","type":{"type":"array","items":["null","long"]},"default":[],"doc":"the block's price's resting size at -30, -25, -20, -15, -10, -5 and 0 minutes (seven entries, oldest first, the last is the size now); an entry is null when the book was not read at that time or the price was outside the search distance then. Aligned to the five-minute marks of data time. Empty before the first mark."},{"name":"highestSize","type":["null","long"],"default":null,"doc":"the largest size seen at that price over the history and since the block was first shown"},{"name":"highestAtMs","type":["null","long"],"default":null,"doc":"bucket end (or five-minute mark) of that largest size"},{"name":"eatenContracts","type":"long","default":0,"doc":"since first shown: contracts the size lost between buckets that were matched by contracts printed at the price"},{"name":"pulledContracts","type":"long","default":0,"doc":"since first shown: contracts the size lost without prints at the price"},{"name":"addedContracts","type":"long","default":0,"doc":"since first shown: contracts the size gained between buckets"},{"name":"eatenTape","type":{"type":"array","items":["null","long"]},"default":[],"doc":"contracts EATEN by trades in the five minutes ending at each of the seven marks of sizeHistory (the last = since the latest mark); null before the block was tracked. Eaten = executions at the block's price against the block, capped at the size lost in that bucket; see the requirement LT-R-14"},{"name":"pulledTape","type":{"type":"array","items":["null","long"]},"default":[],"doc":"contracts PULLED (lost without executions, after moves are taken out) in the same windows"},{"name":"movedTape","type":{"type":"array","items":["null","long"]},"default":[],"doc":"contracts that left the block and reappeared within 2 ticks on the same side in the same bucket (a move, not a pull) in the same windows"},{"name":"movedContracts","type":"long","default":0,"doc":"since first shown: the moved total"},{"name":"pullTiming","type":["null","string"],"default":null,"doc":"when the pulling began, from the first bucket at which the pulled total reached a tenth of the block's first size: AFTER_TOUCH (the block had been touched), NEAR (price within 12 ticks) or FAR; null until it begins"},{"name":"firstPullAtMs","type":["null","long"],"default":null,"doc":"bucket end of that first bucket"}]}},"default":[],"doc":"the targets, above then below, nearest first within a side"},{"name":"label","type":"string","doc":"the constant DISPLAY_NOT_A_FINDING","default":"DISPLAY_NOT_A_FINDING"}]}