{"type":"record","name":"LiquidityWallEvent","namespace":"com.optionsedge.contracts.liquiditywall","doc":"document D sections 7 and 7b: one lifecycle change or one flip","fields":[{"name":"schemaVersion","type":"int","doc":"1 for this revision"},{"name":"depthEnvironment","type":"string","doc":"the environment literal of the admitted depth frames, e.g. Rithmic Test, or the live literal"},{"name":"contract","type":"string","doc":"the contract table's row for the trade date, e.g. ESZ6"},{"name":"bucketEnd","type":"long","doc":"bucket end on the collector clock, epoch ms"},{"name":"configFingerprint","type":"string","doc":"SHA-256 over the sorted name=value configuration lines plus the detector's logic version"},{"name":"kind","type":"string","doc":"BORN, RETIRED, DEFENDED, DEFENCE_ENDED, BROKEN, BREAK_ENDED or FLIP"},{"name":"spotTick","type":["null","long"],"default":null},{"name":"wall","type":["null",{"type":"record","name":"LiquidityWallEventWall","doc":"one live wall as published (document D section 7)","fields":[{"name":"clusterId","type":"string"},{"name":"lane","type":"string","doc":"RESISTANCE or SUPPORT"},{"name":"loTick","type":"long"},{"name":"hiTick","type":"long"},{"name":"frozenTicks","type":{"type":"array","items":"long"},"doc":"every tick from loTick to hiTick inclusive"},{"name":"birthBucketEnd","type":"long"},{"name":"peakSizeAtBirth","type":"long"},{"name":"totalSizeAtBirth","type":"long"},{"name":"ladderMedianAtBirth","type":"long"},{"name":"levelCountAtBirth","type":"int"},{"name":"heldBuckets","type":"int"},{"name":"defendedBuckets","type":"int"},{"name":"brokenBuckets","type":"int"},{"name":"brokenBucketsFrozen","type":["null","int"],"default":null,"doc":"the break term's count frozen at the settle; null before it"},{"name":"termHold","type":"int","doc":"the capped score terms of section 7: hold"},{"name":"termDefense","type":"int"},{"name":"termPeak","type":"int"},{"name":"termLevels","type":"int"},{"name":"termBreaks","type":"int","doc":"the break term as published (frozen after the settle)"},{"name":"scoreRaw","type":"int"},{"name":"scorePublished","type":"int"},{"name":"scoreSettled","type":"boolean"},{"name":"grade","type":"string","doc":"STRONG, MODERATE or WEAK"},{"name":"defendedState","type":"boolean"},{"name":"brokenState","type":"boolean"},{"name":"lastEvidenceBucketEnd","type":["null","long"],"default":null,"doc":"the last LIVE bucket on which evidence was read"},{"name":"breachOpen","type":"boolean","doc":"a breach episode is open"},{"name":"breachT0","type":["null","long"],"default":null,"doc":"exchange timestamp of the open breach episode's first print, or null"},{"name":"breachTickReached","type":["null","long"],"default":null}]}],"default":null,"doc":"the wall at the event; null for FLIP"},{"name":"retireReason","type":["null","string"],"default":null,"doc":"BREACHED, AGED, REPLACED, CAP, CONFIG or DISABLED; RETIRED only"},{"name":"breachT0","type":["null","long"],"default":null,"doc":"BREACHED only: the episode's first print"},{"name":"breachConfirmedAt","type":["null","long"],"default":null},{"name":"breachTickReached","type":["null","long"],"default":null},{"name":"flip","type":["null",{"type":"record","name":"LiquidityWallFlip","doc":"document D section 7b: the flip's measured quantities","fields":[{"name":"direction","type":"string","doc":"FLIP_TO_DOWNSIDE or FLIP_TO_UPSIDE"},{"name":"b0BucketEnd","type":"long"},{"name":"b1BucketEnd","type":"long"},{"name":"fadeShareThousandths","type":"int"},{"name":"riseRatioThousandths","type":"int"},{"name":"spotTickB0","type":"long"},{"name":"spotTickB1","type":"long"},{"name":"aboveB0","type":"long"},{"name":"belowB0","type":"long"},{"name":"aboveB1","type":"long"},{"name":"belowB1","type":"long"},{"name":"leanB0Thousandths","type":"int"},{"name":"leanB1Thousandths","type":"int"}]}],"default":null,"doc":"FLIP only"}]}