{"type":"record","name":"LeanEvent","namespace":"com.optionsedge.contracts.lineacc","doc":"Append-only pre-decision lean, one per (episodeId, leanBarOrdinal) (O8). Key: episodeId|leanBarOrdinal.","fields":[{"name":"schemaVersion","type":"int"},{"name":"recordType","type":{"type":"enum","name":"RecordType","symbols":["UNKNOWN","EPISODE_CORE","EPISODE_EVIDENCE","EPISODE_OUTCOME","EPISODE_INTEGRITY","LEAN_EVENT","SESSION_COVERAGE","MONITOR_STATUS"],"default":"UNKNOWN"}},{"name":"sessionDate","type":"string"},{"name":"sessionSegment","type":{"type":"enum","name":"SessionSegment","symbols":["UNKNOWN","RTH","GLOBEX"],"default":"UNKNOWN"}},{"name":"timeframe","type":{"type":"enum","name":"Timeframe","symbols":["UNKNOWN","M1","M5","M15"],"default":"UNKNOWN"}},{"name":"asOfMs","type":"long"},{"name":"publishSeq","type":"long"},{"name":"episodeId","type":"string"},{"name":"leanBarOrdinal","type":"int"},{"name":"lean","type":{"type":"enum","name":"Lean","symbols":["UNKNOWN","NO_LEAN","LEANS_ACCEPT","LEANS_REJECT"],"default":"UNKNOWN"}},{"name":"reason","type":{"type":"enum","name":"LeanReason","symbols":["UNKNOWN","UNVALIDATED","NO_MEASURED_EDGE","INSUFFICIENT_SAMPLE","CONFLICT","EVIDENCE_INCOMPLETE","RULE_FIRED"],"default":"UNKNOWN"}},{"name":"snapshotIds","type":{"type":"array","items":"string"},"default":[]},{"name":"cellRef","type":["null",{"type":"record","name":"CellRef","doc":"A pointer into the calibration status artifact (K9b); the record holds no mutable calibration state.","fields":[{"name":"cellId","type":"string"},{"name":"parameterSetHash","type":"string"}]}],"default":null},{"name":"parameterSetHash","type":"string"}]}