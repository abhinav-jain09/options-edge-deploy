{"type":"record","name":"LineAcceptanceDlq","namespace":"com.optionsedge.contracts.lineacc","doc":"R3 dead-letter: source position, reason, size, sha256 and a payload head bounded to 4096 bytes. Key: stream|topic|partition|offset.","fields":[{"name":"schemaVersion","type":"int"},{"name":"stream","type":"string"},{"name":"topic","type":"string"},{"name":"partition","type":"int"},{"name":"offset","type":"long"},{"name":"reasonCode","type":"string"},{"name":"schemaId","type":["null","int"],"default":null},{"name":"sizeBytes","type":"long"},{"name":"sha256","type":"string"},{"name":"payloadHead","type":"bytes"},{"name":"truncated","type":"boolean"}]}