{"type":"record","name":"SessionCoverage","namespace":"com.optionsedge.contracts.lineacc","doc":"What the session did and did not evaluate (O5): counters, absent kinds and measures, stream availability. Key: sessionDate|timeframe.","fields":[{"name":"schemaVersion","type":"int"},{"name":"recordType","type":{"type":"enum","name":"RecordType","symbols":["UNKNOWN","EPISODE_CORE","EPISODE_EVIDENCE","EPISODE_OUTCOME","EPISODE_INTEGRITY","LEAN_EVENT","SESSION_COVERAGE","MONITOR_STATUS"],"default":"UNKNOWN"}},{"name":"sessionDate","type":"string"},{"name":"sessionSegment","type":{"type":"enum","name":"SessionSegment","symbols":["UNKNOWN","RTH","GLOBEX"],"default":"UNKNOWN"}},{"name":"timeframe","type":{"type":"enum","name":"Timeframe","symbols":["UNKNOWN","M1","M5","M15"],"default":"UNKNOWN"}},{"name":"asOfMs","type":"long"},{"name":"publishSeq","type":"long"},{"name":"coverageVersion","type":"int"},{"name":"evidenceMeasuresAbsent","type":{"type":"array","items":{"type":"record","name":"AbsentMeasure","fields":[{"name":"measure","type":{"type":"enum","name":"FootprintMeasure","symbols":["UNKNOWN","M1","M2","M3","M4","M5","M6","M7"],"default":"UNKNOWN"}},{"name":"reason","type":"string"}]}},"default":[]},{"name":"linesEvaluated","type":{"type":"array","items":"string"},"default":[]},{"name":"kindsAbsent","type":{"type":"array","items":{"type":"record","name":"AbsentKind","fields":[{"name":"kind","type":{"type":"enum","name":"LineKind","symbols":["UNKNOWN","VWAP_MEAN","VWAP_UPPER","VWAP_LOWER","DOUBLE_FORMATION","TRIPLE_FORMATION","RECTANGLE","TRENDLINE","TREND_CHANNEL","SR_ZONE","CONGESTION_ZONE","CONFLUENCE_ZONE","VOLUME_NODE","EQUAL_LEVEL","SESSION_HIGH","SESSION_LOW","PRIOR_HIGH","PRIOR_LOW","PRIOR_CLOSE","OR15_HIGH","OR30_HIGH","ROUND_NUMBER","GEOMETRY_BOUNDARY","OTHER","OR15_LOW","OR30_LOW","SPEEDLINES","FAN_LINES","DOW_LINE"],"default":"UNKNOWN"}},{"name":"reason","type":"string"}]}},"default":[]},{"name":"counters","type":{"type":"array","items":{"type":"record","name":"CoverageCounter","fields":[{"name":"name","type":"string"},{"name":"value","type":"long"}]}},"default":[]},{"name":"footprintStream","type":{"type":"enum","name":"StreamStatus","symbols":["UNKNOWN","LIVE","STALE","ABSENT","PRODUCER_OFF"],"default":"UNKNOWN"}},{"name":"candleStream","type":"StreamStatus"},{"name":"calibrationCells","type":{"type":"array","items":{"type":"record","name":"CellRef","doc":"A pointer into the calibration status artifact (K9b); the record holds no mutable calibration state.","fields":[{"name":"cellId","type":"string"},{"name":"parameterSetHash","type":"string"}]}},"default":[]}]}