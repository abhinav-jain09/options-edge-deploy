{"type":"record","name":"CvdBarEnvelope","namespace":"com.optionsedge.contracts.cvd","doc":"Canonical CVD Avro migration contract. Counts use exact integer units. Prices use decimal(38,18), exact conversion with no rounding. The Kafka key and trading semantics are unchanged. Avro-only new writes; explicit compatible readers also accept retained JSON during same-topic roll-forward.","fields":[{"name":"schemaVersion","type":"string"},{"name":"symbol","type":"string"},{"name":"timeframe","type":"string"},{"name":"widthMs","type":["null","long"],"default":null},{"name":"sessionDate","type":"string"},{"name":"bar","type":{"type":"record","name":"CvdBar","fields":[{"name":"timeframe","type":"string"},{"name":"barStart","type":"string"},{"name":"barStartMs","type":"long"},{"name":"barEndMs","type":["null","long"],"default":null},{"name":"barEnd","type":["null","string"],"default":null},{"name":"complete","type":"boolean"},{"name":"hasTrades","type":"boolean"},{"name":"openCvd","type":"long"},{"name":"highCvd","type":"long"},{"name":"lowCvd","type":"long"},{"name":"closeCvd","type":"long"},{"name":"deltaCvd","type":"long"},{"name":"cvdChangePct","type":["null",{"type":"record","name":"CvdCumulativeChangePercent","fields":[{"name":"value","type":{"type":"bytes","logicalType":"decimal","precision":38,"scale":2}},{"name":"scale","type":"int"},{"name":"kind","type":"string"},{"name":"negativeZero","type":"boolean"}],"optionsedge.api-scalar":"decimal-text"}],"doc":"Backend-owned cumulative CVD change from previous candle, divided by absolute previous CVD, times 100. API plain decimal text; backend rounds HALF_UP to two places. Missing when not yet supplied or previous CVD is zero.","default":null,"optionsedge.api-omit-null":"true"},{"name":"cvdChangePctReason","type":["null","string"],"doc":"Backend unavailable reason; ZERO_PREVIOUS_CVD when the preceding cumulative CVD is zero. Missing for existing records and when a percentage is available.","default":null,"optionsedge.api-omit-null":"true"},{"name":"buyerTrades","type":"long"},{"name":"sellerTrades","type":"long"},{"name":"unknownTrades","type":"long"},{"name":"totalTrades","type":"long"},{"name":"buyerContracts","type":"long"},{"name":"sellerContracts","type":"long"},{"name":"unknownContracts","type":"long"},{"name":"totalContracts","type":"long"},{"name":"unknownContractPct","type":["null","double"],"default":null},{"name":"unknownTradePct","type":["null","double"],"default":null},{"name":"open","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"high","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"low","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"close","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"priceChange","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"spxEqOpen","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"spxEqHigh","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"spxEqLow","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"spxEqClose","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"spxEqChange","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"spxOpen","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"spxHigh","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"spxLow","type":["null",{"type":"bytes","logicalType":"decimal","precision":38,"scale":18}],"default":null},{"name":"