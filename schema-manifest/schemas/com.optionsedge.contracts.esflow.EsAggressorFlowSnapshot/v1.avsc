{"type":"record","name":"EsAggressorFlowSnapshot","namespace":"com.optionsedge.contracts.esflow","doc":"es.futures.aggressor-flow: one compacted snapshot per second keyed ES.v.0. windows is a MAP keyed by the window label (10s, 1m, 5m, 10m, 1h, 4h, 8h, session) because an Avro field name cannot start with a digit; every strings vocabulary is a string (an enum addition would break FULL compatibility).","fields":[{"name":"schemaVersion","type":"string"},{"name":"symbol","type":"string"},{"name":"expiry","type":"string"},{"name":"eventTimeMs","type":"long"},{"name":"eventTime","type":"string"},{"name":"lastPrice","type":["null","double"],"default":null},{"name":"lastTradeAgeMs","type":"long"},{"name":"quality","type":"string"},{"name":"windows","type":{"type":"map","values":{"type":"record","name":"AggressorWindow","doc":"One window of the aggressor-flow snapshot, field for field the object the service has always published under windows.<label>.","fields":[{"name":"buyerTrades","type":"long"},{"name":"sellerTrades","type":"long"},{"name":"unknownTrades","type":"long"},{"name":"totalTrades","type":"long"},{"name":"buyerContracts","type":"long"},{"name":"sellerContracts","type":"long"},{"name":"unknownContracts","type":"long"},{"name":"totalContracts","type":"long"},{"name":"netTrades","type":"long"},{"name":"netContracts","type":"long"},{"name":"volumeDeltaPct","type":"double"},{"name":"unknownTradePct","type":["null","double"],"default":null},{"name":"unknownContractPct","type":["null","double"],"default":null},{"name":"observable","type":"boolean"},{"name":"reliable","type":"boolean"},{"name":"score","type":["null","double"],"default":null},{"name":"direction","type":"string"},{"name":"analysis","type":"string"},{"name":"comparisonReady","type":"boolean"},{"name":"previousVolumeDeltaPct","type":["null","double"],"default":null},{"name":"flowChangePct","type":["null","double"],"default":null},{"name":"flowTrend","type":"string"},{"name":"open","type":["null","double"],"default":null},{"name":"high","type":["null","double"],"default":null},{"name":"low","type":["null","double"],"default":null},{"name":"close","type":["null","double"],"default":null},{"name":"priceChange","type":"double"},{"name":"priceThreshold","type":"double"},{"name":"momentumThresholdPct","type":"double"}]}}},{"name":"consensus","type":{"type":"record","name":"AggressorConsensus","doc":"The overall regime across the reliable windows.","fields":[{"name":"reliableWindows","type":"int"},{"name":"reliableWeight","type":"double"},{"name":"unreliableWindows","type":"int"},{"name":"unobservableWindows","type":"int"},{"name":"bullishWindows","type":"int"},{"name":"bearishWindows","type":"int"},{"name":"regime","type":"string"},{"name":"confidence","type":"string"},{"name":"score","type":["null","double"],"default":null}]}}]}