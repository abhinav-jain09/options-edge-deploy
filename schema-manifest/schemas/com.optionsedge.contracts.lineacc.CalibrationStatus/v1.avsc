{"type":"record","name":"CalibrationStatus","namespace":"com.optionsedge.contracts.lineacc","doc":"K9b calibration status artifact: one immutable record per (cellId, parameterSetHash, statusVersion), never compacted. Rates in basis points. Key: cellId|parameterSetHash|statusVersion.","fields":[{"name":"schemaVersion","type":"int"},{"name":"cellId","type":"string"},{"name":"parameterSetHash","type":"string"},{"name":"statusVersion","type":"int"},{"name":"effectiveAtMs","type":"long"},{"name":"trainingCutoffSession","type":"string"},{"name":"validationResultId","type":"string"},{"name":"state","type":{"type":"enum","name":"CalState","symbols":["UNKNOWN","UNVALIDATED","CALIBRATED","NO_MEASURED_EDGE","NOT_TESTABLE","INSUFFICIENT_SAMPLE","STATUS_NOT_YET_EFFECTIVE"],"default":"UNKNOWN"}},{"name":"reasonCode","type":"string"},{"name":"hits","type":"long"},{"name":"cases","type":"long"},{"name":"baselineBp","type":"int"},{"name":"rateBp","type":"int"},{"name":"intervalLowBp","type":"int"},{"name":"intervalHighBp","type":"int"}]}