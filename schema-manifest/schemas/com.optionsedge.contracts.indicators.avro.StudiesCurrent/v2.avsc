{"type":"record","name":"StudiesCurrent","namespace":"com.optionsedge.contracts.indicators.avro","doc":"STUDIES_V1 current state (INDICATOR-STUDIES-REQUIREMENT.md Appendix J.2). Registered subject com.optionsedge.contracts.indicators.avro.StudiesCurrent: version 1 id 2502, version 2 (this file) adds the optional calibrationSummary. The legacy field calibration keeps its name and now carries CALIBRATED (or NOT_CALIBRATED), never UNVALIDATED.","fields":[{"name":"schemaVersion","type":"int"},{"name":"methodVersion","type":"string"},{"name":"parameterSetHash","type":"string"},{"name":"symbol","type":"string"},{"name":"tradeDate","type":"string"},{"name":"runId","type":"string"},{"name":"revision","type":"long"},{"name":"publishedAt","type":"string"},{"name":"asOfEventTime","type":["null","string"],"default":null},{"name":"quality","type":{"type":"enum","name":"QualityState","symbols":["WARMING_UP","READY","STALE","INCOMPLETE","ABSENT"]}},{"name":"restored","type":"boolean"},{"name":"calibration","type":"string"},{"name":"timeframes","type":{"type":"map","values":{"type":"record","name":"StudyTimeframe","fields":[{"name":"resetCount","type":"int"},{"name":"closesSeen","type":"long"},{"name":"values","type":{"type":"map","values":{"type":"record","name":"IndicatorValue","doc":"Mirror of the registered IndicatorValue (embedded verbatim, A-R10.2 / Appendix J)","fields":[{"name":"value","type":["null",{"type":"string","oe.decimal":"plain"}],"default":null},{"name":"state","type":"QualityState"},{"name":"reason","type":{"type":"enum","name":"Reason","symbols":["NONE","RESTORING","WARMING_UP_WINDOW","SOURCE_HAS_NO_VOLUME","SOURCE_QUALITY","RETIRED_EPOCH","STALE_FEED","FEED_GAP","RETENTION_GAP","INSTRUMENT_ROLL","NO_OPENING_WINDOW_DATA","OUTSIDE_RTH","ZERO_WINDOW_VOLUME","ZERO_CUMULATIVE_VOLUME","INSUFFICIENT_SIDE_COVERAGE","ZERO_VARIANCE","PRIOR_SESSION_INCOMPLETE","DEADLINE_FINALIZED","STREAM_END","INSUFFICIENT_COVERAGE","INSUFFICIENT_HISTORY","IDLE_REACTIVATION_FENCE","NUMERIC_BOUNDS","SCOPE_NOT_APPLICABLE"]}},{"name":"incompleteKind","type":["null",{"type":"enum","name":"IncompleteKind","symbols":["LATCHED","RECOVERABLE"]}],"default":null},{"name":"warmupBarsRemaining","type":["null","int"],"default":null}]}}},{"name":"states","type":{"type":"map","values":{"type":"record","name":"StudyState","fields":[{"name":"value","type":["null","string"],"default":null},{"name":"state","type":"QualityState"},{"name":"reason","type":"Reason"}]}}},{"name":"lastEvents","type":{"type":"array","items":"string"}},{"name":"lastEventBarStart","type":["null","string"],"default":null},{"name":"divergences","type":{"type":"array","items":{"type":"record","name":"DivergenceAnnotation","fields":[{"name":"id","type":"string"},{"name":"series","type":"string"},{"name":"kind","type":{"type":"enum","name":"DivergenceKind","symbols":["BULLISH","BEARISH"]}},{"name":"state","type":{"type":"enum","name":"DivergenceState","symbols":["ACTIVE","CONFIRMED","INVALIDATED","EXPIRED","CHAIN_BREAK"]}},{"name":"zone","type":"int"},{"name":"p1BarStart","type":"string"},{"name":"p2BarStart","type":"string"},{"name":"p1PriceTicks","type":"long"},{"name":"p2PriceTicks","type":"long"},{"name":"p1Value","type":{"type":"string","oe.decimal":"plain"}},{"name":"p2Value","type":{"type":"string","oe.decimal":"plain"}},{"name":"trigger","type":["null",{"type":"string","oe.decimal":"plain"}],"default":null},{"name":"detectedAtBarStart","type":"string"},{"name":"resolvedAtBarStart","type":["null","string"],"default":null}]}}}]}}},{"name":"calibrationSummary","type":["null",{"type":"record","name":"StudyCalibrationSummary","doc":"Version 2 (optional): what the running parameter set measured on SPX history; the results are per family and timeframe.","fields":[{"name":"state","type":"string","doc":"CALIBRATED (the running parameterSetHash is the one measured) or NOT_CALIBRATED."},{"name":"parameterSetHash","type":"string"},{"name":"validationResultId","type":"string"},{"name":"ledgerSha256","type":"string","doc":"SHA-256 of LEDGER-VAL.tsv."},{"name":"datasetSha256","type":"string","doc":"The 1m-bar digest of the validation fold (equal to Phase E PLAN-VAL.txt)."},{"name":"developmentFromDay","type":"int"},{"name":"developmentToDay","type":"int"},{"name":"validationFromDay","type":"int"},{"name":"validationToDay","type":"int"},{"name":"scope","type":"string","doc":"Which symbol and timeframes were measured."},{"name":"results","type":{"type":"array","items":{"type":"record","name":"StudyFamilyResult","doc":"One measured result: a study family on one timeframe ('ALL' = every timeframe of the symbol) with the fixed statement the chart shows verbatim.","fields":[{"name":"family","type":"string","doc":"Closed vocabulary of INDICATOR-STUDIES-CALIBRATION-REPORT.md section 1 (at most 24 characters)."},{"name":"timeframe","type":"string","doc":"1m, 5m, 15m, 30s, 1h, 4h or ALL."},{"name":"measuredEdge","type":"string","doc":"NONE, POSITIVE, NOT_TESTABLE or EXACT_CONSTRUCT."},{"name":"cell","type":["null","string"],"doc":"The headline cell of the verdict, null where none exists.","default":null},{"name":"n","type":"long","doc":"Trials of the headline cell (NOT_TESTABLE: events of the family)."},{"name":"effectBp","type":["null","int"],"doc":"Hit-rate (or efficiency-ratio) difference to the baseline in basis points; null unless measured.","default":null},{"name":"pAdjPpm","type":["null","int"],"doc":"Adjusted p in parts per million; null unless measured.","default":null},{"name":"members","type":"string","doc":"Comma-separated event ids and divergence series (series:kind) the family covers; empty on rows that repeat another timeframe's members."},{"name":"statement","type":"string","doc":"The sentence the chart shows verbatim (at most 300 bytes)."}]}}}]}],"doc":"Version 2 (optional): null in a version-1 record and where the running parameter set was not measured.","default":null}]}