{"type":"record","name":"BreakoutEmission","namespace":"com.optionsedge.contracts.breakout","doc":"Requirement LBL 11/LBL 16 outputs, keyed by episode_id. Version records are immutable; Finalization is written once.","fields":[{"name":"episode_id","type":"string"},{"name":"at_offset","type":"long"},{"name":"envelope","type":{"type":"record","name":"EmissionEnvelope","doc":"Requirement ARC 03 envelope of resolver outputs; populated by the publisher.","fields":[{"name":"event_id","type":"string"},{"name":"correlation_id","type":"string"},{"name":"run_id","type":"string"},{"name":"mode","type":"string"},{"name":"instrument_id","type":"string"},{"name":"exchange_time_ms","type":"long"},{"name":"receive_time_ms","type":"long"},{"name":"availability_time_ms","type":"long"},{"name":"emitted_time_ms","type":"long"},{"name":"schema_version","type":"string"},{"name":"producer_version","type":"string"},{"name":"lineage","type":"string"},{"name":"as_of_cutoff_offset","type":"long"},{"name":"input_manifest_hash","type":{"type":"fixed","name":"Sha256","size":32}},{"name":"quality_status","type":{"type":"enum","name":"QualityStatus","symbols":["CLEAN","DEGRADED","EXCLUDED"]}},{"name":"arbitration_policy_version","type":"string","doc":"MON 06 / L10: the frozen arbitration policy version in force for this output. UNSPECIFIED_LEGACY only ever appears on records written before 0.28.0; a producer never writes it.","default":"UNSPECIFIED_LEGACY"}]}},{"name":"emission","type":[{"type":"record","name":"OutcomeVersion","fields":[{"name":"version","type":"int"},{"name":"supersedes","type":"int"},{"name":"terminal","type":{"type":"enum","name":"Terminal","symbols":["TARGET_REACHED","INVALIDATED_AFTER_BREAKOUT","REJECTED_BEFORE_BREAKOUT","TIMEOUT_AFTER_BREAKOUT","TIMEOUT_NO_BREAKOUT","DATA_INVALID","CENSORED","CANCELLED"]}},{"name":"reason","type":{"type":"enum","name":"Reason","symbols":["TARGET_FIRST","INVALIDATION_FIRST","INVALIDATION_PRE_CONFIRM","HORIZON","FEED_GAP","LATE_NOTICE","HALT","SESSION_END","TRUNCATED","OPERATOR_WITHDRAWN","BAD_GEOMETRY","STREAM_INTEGRITY","CLOCK_INTEGRITY","EPOCH_CHANGE","RECORD_LOSS"]}},{"name":"cause","type":["null",{"type":"enum","name":"GapCause","symbols":["SOURCE_SILENCE","LOG_OFFSET_GAP","SEQUENCE_GAP","SEQUENCE_RESET","SEQUENCER_STALL"]}],"default":null},{"name":"terminal_time_ms","type":"long"},{"name":"t0_ms","type":"long"},{"name":"deadline_ms","type":"long"},{"name":"confirmed_at_ms","type":["null","long"],"default":null},{"name":"target_reached_at_ms","type":["null","long"],"default":null},{"name":"invalidated_at_ms","type":["null","long"],"default":null}]},{"type":"record","name":"Reopened","fields":[{"name":"references_version","type":"int"}]},{"type":"record","name":"CorrectionAudit","fields":[{"name":"correction_event_id","type":"string"},{"name":"version_unchanged","type":"int"}]},{"type":"record","name":"Finalization","fields":[{"name":"final_version","type":"int"},{"name":"finalization_time_ms","type":"long"}]},{"type":"record","name":"Logged","fields":[{"name":"kind","type":{"type":"enum","name":"LogKind","symbols":["LATE_AFTER_DEADLINE","INELIGIBLE_CORRECTION","NON_MATCHING_CONTROL","NON_CRITICAL_NOTICE","NON_CANONICAL_EVENT","CORRECTION_AFTER_FINALIZATION","NOTICE_AFTER_FINALIZATION"]}}]},{"type":"record","name":"Transition","fields":[{"name":"kind","type":{"type":"enum","name":"TransitionKind","symbols":["ARMED","ACTIVE","CONFIRMED"]}},{"name":"reason","type":"string"}]},{"type":"record","name":"AlertEligibility","doc":"Requirement MON 06: whether this episode (alert_eligible) is the alert-eligible one of its direction under the frozen arbitration policy. Published when the eligibility CHANGES (once at creation, again whenever another episode terminates or is created and the verdict moves). Stage 1 computes and records it and raises no alert.","fields":[{"name":"alert_eligible","type":"boolean"},{"name":"reason","type":{"type":"enum","name":"AlertEligibilityReason","symbols":["NEAREST_IN_DIRECTION","NOT_NEAREST","TIE_LOST_TO_EARLIER_EPISODE","STRIKE_IN_COOLDOWN","TERMINAL"]}},{"name":"distance_cents","type":"long","doc":"|SPX - K| in cents at the deciding record; -1 once terminal."},{"name":"displaced_by","type":["null","string"],"doc":"The episode that holds the eligibility when this one does not.","default":null},{"name":"actionable","type":"boolean","default":false},{"name":"non_actionable_reason","type":{"type":"enum","name":"NonActionableReason","doc":"STG 05: why an output must not be acted on. Stage 1 has exactly one reason.","symbols":["MODEL_NOT_APPROVED"],"default":"MODEL_NOT_APPROVED"},"default":"MODEL_NOT_APPROVED"}]}]}]}