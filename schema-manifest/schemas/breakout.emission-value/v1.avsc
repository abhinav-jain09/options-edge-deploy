{"type":"record","name":"BreakoutEmission","namespace":"com.optionsedge.contracts.breakout","doc":"Requirement LBL 11/LBL 16 outputs, keyed by episode_id. Version records are immutable; Finalization is written once.","fields":[{"name":"episode_id","type":"string"},{"name":"at_offset","type":"long"},{"name":"envelope","type":{"type":"record","name":"EmissionEnvelope","doc":"Requirement ARC 03 envelope of resolver outputs; populated by the publisher.","fields":[{"name":"event_id","type":"string"},{"name":"correlation_id","type":"string"},{"name":"run_id","type":"string"},{"name":"mode","type":"string"},{"name":"instrument_id","type":"string"},{"name":"exchange_time_ms","type":"long"},{"name":"receive_time_ms","type":"long"},{"name":"availability_time_ms","type":"long"},{"name":"emitted_time_ms","type":"long"},{"name":"schema_version","type":"string"},{"name":"producer_version","type":"string"},{"name":"lineage","type":"string"},{"name":"as_of_cutoff_offset","type":"long"},{"name":"input_manifest_hash","type":{"type":"fixed","name":"Sha256","size":32}},{"name":"quality_status","type":{"type":"enum","name":"QualityStatus","symbols":["CLEAN","DEGRADED","EXCLUDED"]}}]}},{"name":"emission","type":[{"type":"record","name":"OutcomeVersion","fields":[{"name":"version","type":"int"},{"name":"supersedes","type":"int"},{"name":"terminal","type":{"type":"enum","name":"Terminal","symbols":["TARGET_REACHED","INVALIDATED_AFTER_BREAKOUT","REJECTED_BEFORE_BREAKOUT","TIMEOUT_AFTER_BREAKOUT","TIMEOUT_NO_BREAKOUT","DATA_INVALID","CENSORED","CANCELLED"]}},{"name":"reason","type":{"type":"enum","name":"Reason","symbols":["TARGET_FIRST","INVALIDATION_FIRST","INVALIDATION_PRE_CONFIRM","HORIZON","FEED_GAP","LATE_NOTICE","HALT","SESSION_END","TRUNCATED","OPERATOR_WITHDRAWN","BAD_GEOMETRY","STREAM_INTEGRITY","CLOCK_INTEGRITY","EPOCH_CHANGE","RECORD_LOSS"]}},{"name":"cause","type":["null",{"type":"enum","name":"GapCause","symbols":["SOURCE_SILENCE","LOG_OFFSET_GAP","SEQUENCE_GAP","SEQUENCE_RESET