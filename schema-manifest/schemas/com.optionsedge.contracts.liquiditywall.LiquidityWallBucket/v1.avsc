{"type":"record","name":"LiquidityWallBucket","namespace":"com.optionsedge.contracts.liquiditywall","doc":"document D section 5: one bucket x side x price level inside the near band","fields":[{"name":"schemaVersion","type":"int","doc":"1 for this revision"},{"name":"depthEnvironment","type":"string","doc":"the environment literal of the admitted depth frames, e.g. Rithmic Test, or the live literal"},{"name":"contract","type":"string","doc":"the contract table's row for the trade date, e.g. ESZ6"},{"name":"bucketEnd","type":"long","doc":"bucket end on the collector clock, epoch ms"},{"name":"configFingerprint","type":"string","doc":"SHA-256 over the sorted name=value configuration lines plus the detector's logic version"},{"name":"side","type":"string","doc":"BID or ASK"},{"name":"tick","type":"long","doc":"ES quarter-point ticks"},{"name":"quality","type":"string","doc":"LIVE, GAP, STALE, DEGRADED or RESTART"},{"name":"closePath","type":"string","doc":"WATERMARK or DEGRADED"},{"name":"openSize","type":"long"},{"name":"lastSize","type":"long"},{"name":"maxSize","type":"long"},{"name":"minSize","type":"long"},{"name":"sizeDeltaSum","type":"long"},{"name":"smoothedSize","type":"long"},{"name":"smoothingCount","type":"int","doc":"buckets the median was taken over"},{"name":"added","type":["null","long"],"default":null,"doc":"over the classification window; null when the window is not fully LIVE"},{"name":"decrease","type":["null","long"],"default":null},{"name":"traded","type":["null","long"],"default":null},{"name":"accounted","type":["null","long"],"default":null},{"name":"unaccounted","type":["null","long"],"default":null},{"name":"hidden","type":["null","long"],"default":null},{"name":"pullCount","type":["null","int"],"default":null},{"name":"refillCount","type":["null","int"],"default":null},{"name":"state","type":"string","doc":"INSUFFICIENT_DATA, EATEN, HIDDEN, REFILLING, PULLED, STABLE_WALL, LOW_LIQUIDITY or NEUTRAL"},{"name":"lastAdmittedFrameReceivedAtMs","type":["null","long"],"default":null,"doc":"the carried frame's receivedAtMs"},{"name":"lastAdmittedStreamId","type":["null","string"],"default":null},{"name":"closingFramePresent","type":"boolean","doc":"true only when the bucket had a frame of its own"}]}