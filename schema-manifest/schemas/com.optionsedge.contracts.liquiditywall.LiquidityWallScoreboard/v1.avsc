{"type":"record","name":"LiquidityWallScoreboard","namespace":"com.optionsedge.contracts.liquiditywall","doc":"liq-AA: ONE running counter row of the target tracker per (trade date, configuration identity, class, horizon), on the COMPACTED topic futures.liquidity-wall.scoreboard (key '<tradeDate>|<identityDigest>|<classKey>|M<seconds>'), published by es-liquidity-wall-service. Counts and integer thousandths only: the page shows these fields and computes nothing. DESCRIPTIVE and UNVALIDATED. Two families: TARGET (reach and fate per distance and size band) and ROLE_FLIP (the invaded blocks by number of prior tests, fate, distance and size band).","fields":[{"name":"schemaVersion","type":"int","doc":"1","default":1},{"name":"outcomeRuleVersion","type":"string","doc":"liq-AA-v1"},{"name":"service","type":"string","doc":"es-liquidity-wall-service"},{"name":"depthEnvironment","type":"string","doc":"depth environment literal"},{"name":"contract","type":"string","doc":"contract"},{"name":"tradeDate","type":"string","doc":"yyyy-MM-dd"},{"name":"classKey","type":"string","doc":"SIDE=<ABOVE|BELOW|ALL>/DIST=<D00_10|D10_25|D25_50|ALL>/SIZE=<X3_4|X4_6|X6_UP|ALL>"},{"name":"side","type":"string","doc":"ABOVE, BELOW or ALL"},{"name":"distanceBand","type":"string","doc":"D00_10 (up to 10 points), D10_25, D25_50 or ALL"},{"name":"sizeBand","type":"string","doc":"X3_4 (3x up to 4x typical), X4_6, X6_UP or ALL"},{"name":"horizonSeconds","type":"int","doc":"600 or 1800"},{"name":"signals","type":"long","doc":"targets registered in this row"},{"name":"decided","type":"long","doc":"records decided without an exclusion"},{"name":"reached","type":"long","doc":"decided records whose price came within the tolerance"},{"name":"reachedRateThousandths","type":["null","int"],"doc":"reached over decided, thousandths; null when decided is 0","default":null},{"name":"consumed","type":"long","doc":"decided records with fate CONSUMED"},{"name":"pulled","type":"long","doc":"decided records with fate PULLED"},{"name":"heldSize","type":"long","doc":"decided records with fate HELD_SIZE"},{"name":"fateUnknown","type":"long","doc":"decided records with fate UNKNOWN"},{"name":"consumedShareThousandths","type":["null","int"],"doc":"consumed over consumed plus pulled, thousandths; null when both are 0","default":null},{"name":"stopPastCount","type":"long","doc":"reached records that have a stop-past distance"},{"name":"stopPastMeanMilliTicks","type":["null","long"],"doc":"mean stop-past distance in thousandths of a tick; null when stopPastCount is 0","default":null},{"name":"stopPastMaxTicks","type":["null","long"],"doc":"largest stop-past distance in ticks","default":null},{"name":"secondsToReachMeanMillis","type":["null","long"],"doc":"mean ms from t0 to the first reaching print over reached records","default":null},{"name":"excluded","type":{"type":"map","values":"long"},"default":{},"doc":"exclusion code to count"},{"name":"smallN","type":"boolean","doc":"decided is below 30"},{"name":"identityDigest","type":"string","doc":"sha-256 over configFingerprint=<value> of the targets' own configuration"},{"name":"configFingerprint","type":"string","doc":"the wall engine's configuration fingerprint"},{"name":"bucketEnd","type":"long","doc":"bucket end of the latest outcome folded into the row"},{"name":"label","type":"string","doc":"DESCRIPTIVE_UNVALIDATED","default":"DESCRIPTIVE_UNVALIDATED"},{"name":"family","type":"string","default":"TARGET","doc":"TARGET or ROLE_FLIP"},{"name":"priorTestsBand","type":["null","string"],"default":null,"doc":"ROLE_FLIP rows: P0, P1, P2, P3_UP or ALL"},{"name":"fateBand","type":["null","string"],"default":null,"doc":"ROLE_FLIP rows: CONSUMED, PULLED, HELD_SIZE, UNKNOWN or ALL (the fate found by the invasion)"},{"name":"invaded","type":["null","long"],"default":null,"doc":"ROLE_FLIP: blocks whose tracking closed with an invasion"},{"name":"neverInvaded","type":["null","long"],"default":null,"doc":"ROLE_FLIP: blocks whose tracking closed without an invasion"},{"name":"retested","type":["null","long"],"default":null,"doc":"ROLE_FLIP: invaded blocks that were retested"},{"name":"retestHeld","type":["null","long"],"default":null,"doc":"ROLE_FLIP: retests with outcome HELD"},{"name":"retestFailed","type":["null","long"],"default":null,"doc":"ROLE_FLIP: retests with outcome FAILED"},{"name":"retestUnresolved","type":["null","long"],"default":null,"doc":"ROLE_FLIP: retests with neither inside the window"},{"name":"noRetest","type":["null","long"],"default":null,"doc":"ROLE_FLIP: invaded blocks never retested inside the horizon"},{"name":"retestRateThousandths","type":["null","int"],"default":null,"doc":"retested over invaded, thousandths"},{"name":"heldRateThousandths","type":["null","int"],"default":null,"doc":"held over invaded, thousandths"},{"name":"failedRateThousandths","type":["null","int"],"default":null,"doc":"failed over invaded, thousandths"},{"name":"noRetestRateThousandths","type":["null","int"],"default":null,"doc":"no-retest over invaded, thousandths"},{"name":"reachBand","type":["null","string"],"default":null,"doc":"TARGET rows: YES (price reached the block), NO, or ALL (rows with a REACH dimension count their signals at the decision, not at registration)"},{"name":"lostContracts","type":"long","default":0,"doc":"TARGET rows: contracts lost over the decided records of the row"},{"name":"eatenSum","type":"long","default":0,"doc":"of which eaten by trades"},{"name":"pulledSum","type":"long","default":0,"doc":"of which pulled without executions"},{"name":"movedSum","type":"long","default":0,"doc":"of which moved"},{"name":"eatenShareThousandths","type":["null","int"],"default":null,"doc":"eaten over lost, thousandths; null when lost is 0"},{"name":"pulledShareThousandths","type":["null","int"],"default":null,"doc":"pulled over lost, thousandths"},{"name":"movedShareThousandths","type":["null","int"],"default":null,"doc":"moved over lost, thousandths"}]}