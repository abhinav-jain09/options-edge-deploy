{"type":"record","name":"LiquidityWallScoreboard","namespace":"com.optionsedge.contracts.liquiditywall","doc":"liq-AA: ONE running counter row of the target tracker per (trade date, configuration identity, class, horizon), on the COMPACTED topic futures.liquidity-wall.scoreboard (key '<tradeDate>|<identityDigest>|<classKey>|M<seconds>'), published by es-liquidity-wall-service. Counts and integer thousandths only: the page shows these fields and computes nothing. DESCRIPTIVE and UNVALIDATED.","fields":[{"name":"schemaVersion","type":"int","doc":"1","default":1},{"name":"outcomeRuleVersion","type":"string","doc":"liq-AA-v1"},{"name":"service","type":"string","doc":"es-liquidity-wall-service"},{"name":"depthEnvironment","type":"string","doc":"depth environment literal"},{"name":"contract","type":"string","doc":"contract"},{"name":"tradeDate","type":"string","doc":"yyyy-MM-dd"},{"name":"classKey","type":"string","doc":"SIDE=<ABOVE|BELOW|ALL>/DIST=<D00_10|D10_25|D25_50|ALL>/SIZE=<X3_4|X4_6|X6_UP|ALL>"},{"name":"side","type":"string","doc":"ABOVE, BELOW or ALL"},{"name":"distanceBand","type":"string","doc":"D00_10 (up to 10 points), D10_25, D25_50 or ALL"},{"name":"sizeBand","type":"string","doc":"X3_4 (3x up to 4x typical), X4_6, X6_UP or ALL"},{"name":"horizonSeconds","type":"int","doc":"600 or 1800"},{"name":"signals","type":"long","doc":"targets registered in this row"},{"name":"decided","type":"long","doc":"records decided without an exclusion"},{"name":"reached","type":"long","doc":"decided records whose price came within the tolerance"},{"name":"reachedRateThousandths","type":["null","int"],"doc":"reached over decided, thousandths; null when decided is 0","default":null},{"name":"consumed","type":"long","doc":"decided records with fate CONSUMED"},{"name":"pulled","type":"long","doc":"decided records with fate PULLED"},{"name":"heldSize","type":"long","doc":"decided records with fate HELD_SIZE"},{"name":"fateUnknown","type":"long","doc":"decided records with fate UNKNOWN"},{"name":"consumedShareThousandths","type":["null","int"],"doc":"consumed over consumed plus pulled, thousandths; null when both are 0","default":null},{"name":"stopPastCount","type":"long","doc":"reached records that have a stop-past distance"},{"name":"stopPastMeanMilliTicks","type":["null","long"],"doc":"mean stop-past distance in thousandths of a tick; null when stopPastCount is 0","default":null},{"name":"stopPastMaxTicks","type":["null","long"],"doc":"largest stop-past distance in ticks","default":null},{"name":"secondsToReachMeanMillis","type":["null","long"],"doc":"mean ms from t0 to the first reaching print over reached records","default":null},{"name":"excluded","type":{"type":"map","values":"long"},"default":{},"doc":"exclusion code to count"},{"name":"smallN","type":"boolean","doc":"decided is below 30"},{"name":"identityDigest","type":"string","doc":"sha-256 over configFingerprint=<value> of the targets' own configuration"},{"name":"configFingerprint","type":"string","doc":"the wall engine's configuration fingerprint"},{"name":"bucketEnd","type":"long","doc":"bucket end of the latest outcome folded into the row"},{"name":"label","type":"string","doc":"DESCRIPTIVE_UNVALIDATED","default":"DESCRIPTIVE_UNVALIDATED"}]}