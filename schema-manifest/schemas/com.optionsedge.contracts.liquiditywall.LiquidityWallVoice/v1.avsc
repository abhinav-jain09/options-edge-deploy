{"type":"record","name":"LiquidityWallVoice","namespace":"com.optionsedge.contracts.liquiditywall","doc":"document D section 7b: the spoken flip, one record per published flip","fields":[{"name":"schemaVersion","type":"int","doc":"1 for this revision"},{"name":"depthEnvironment","type":"string","doc":"the environment literal of the admitted depth frames, e.g. Rithmic Test, or the live literal"},{"name":"contract","type":"string","doc":"the contract table's row for the trade date, e.g. ESZ6"},{"name":"bucketEnd","type":"long","doc":"bucket end on the collector clock, epoch ms"},{"name":"configFingerprint","type":"string","doc":"SHA-256 over the sorted name=value configuration lines plus the detector's logic version"},{"name":"voiceId","type":"string","doc":"<contract>|<b1 bucket end>"},{"name":"text","type":"string","doc":"the exact ASCII bytes of section 7b"},{"name":"direction","type":"string","doc":"FLIP_TO_DOWNSIDE or FLIP_TO_UPSIDE"},{"name":"spotTick","type":"long","doc":"spot as an integer count of quarter-point ticks"}]}