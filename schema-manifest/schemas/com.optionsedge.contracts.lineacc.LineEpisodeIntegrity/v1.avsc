{"type":"record","name":"LineEpisodeIntegrity","namespace":"com.optionsedge.contracts.lineacc","doc":"Integrity addendum: exclusions that arise after finalization (HOST_LATE_CONFLICT, HOST_PRICE_CONFLICT, ...). Read together with the S0 core. Key: episodeId.","fields":[{"name":"schemaVersion","type":"int"},{"name":"recordType","type":{"type":"enum","name":"RecordType","symbols":["UNKNOWN","EPISODE_CORE","EPISODE_EVIDENCE","EPISODE_OUTCOME","EPISODE_INTEGRITY","LEAN_EVENT","SESSION_COVERAGE","MONITOR_STATUS"],"default":"UNKNOWN"}},{"name":"sessionDate","type":"string"},{"name":"sessionSegment","type":{"type":"enum","name":"SessionSegment","symbols":["UNKNOWN","RTH","GLOBEX"],"default":"UNKNOWN"}},{"name":"timeframe","type":{"type":"enum","name":"Timeframe","symbols":["UNKNOWN","M1","M5","M15"],"default":"UNKNOWN"}},{"name":"asOfMs","type":"long"},{"name":"publishSeq","type":"long"},{"name":"episodeId","type":"string"},{"name":"integrityVersion","type":"int"},{"name":"calibrationExclusions","type":{"type":"array","items":{"type":"record","name":"ExclusionEntry","fields":[{"name":"exclusion","type":{"type":"enum","name":"Exclusion","symbols":["UNKNOWN","LINE_DRIVEN","LINE_MOVED","HOST_LATE_CONFLICT","CLUSTER_VERDICT_CONFLICT","HOST_PRICE_CONFLICT","BASIS_ESTIMATED","NO_LEAN_BAR","EVIDENCE_TRUNCATED"],"default":"UNKNOWN"}},{"name":"excludes","type":{"type":"enum","name":"ExcludesSet","symbols":["UNKNOWN","ALL","ALL_EXCEPT_ESTIMATE_CELLS","EVIDENCE_ONLY"],"default":"UNKNOWN"}}]}},"default":[]},{"name":"hostLateConflict","type":"boolean"},{"name":"hostPriceConflict","type":"boolean"}]}