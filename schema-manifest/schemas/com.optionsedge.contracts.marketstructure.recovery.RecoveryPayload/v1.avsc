{"type":"record","name":"RecoveryPayload","namespace":"com.optionsedge.contracts.marketstructure.recovery","doc":"The checkpoint's state, as the Avro binary datum inside RecoveryCheckpoint.payloadGzip (not a topic value).","fields":[{"name":"inputTopic","type":"string"},{"name":"inputTopicId","type":"string"},{"name":"schedule","type":{"type":"record","name":"RecoverySchedule","fields":[{"name":"scheduleId","type":"string"},{"name":"tradeDate","type":"string"},{"name":"segmentId","type":"string"},{"name":"rthOpenMs","type":"long"},{"name":"rthCloseMs","type":"long"},{"name":"sessionLengthMs","type":"long"},{"name":"calendarVersion","type":"string"},{"name":"scheduledEnds","type":{"type":"array","items":{"type":"record","name":"RecoveryEnds","fields":[{"name":"timeframe","type":{"type":"enum","name":"RecoveryTimeframe","symbols":["UNKNOWN","M1","M5","M15"],"default":"UNKNOWN"}},{"name":"ends","type":{"type":"array","items":"long"}}]}}}]}},{"name":"inputs","type":{"type":"array","items":{"type":"record","name":"RecoveryInput","fields":[{"name":"key","type":["null","string"],"default":null},{"name":"partition","type":"int"},{"name":"offset","type":"long"},{"name":"payload","type":"bytes"}]}}},{"name":"offsets","type":{"type":"array","items":{"type":"record","name":"RecoveryOffset","fields":[{"name":"partition","type":"int"},{"name":"offset","type":"long"}]}}},{"name":"originFatal","type":["null",{"type":"enum","name":"RecoveryFatalReason","symbols":["UNKNOWN","UNSUPPORTED_CALENDAR","AMBIGUOUS_SUCCESSOR","TERMINAL_MISSING","PROOF_SCAN_EXHAUSTED","BUFFER_OVERFLOW","ORDINAL_CONFLICT","BAR_ID_CONFLICT","ORDINAL_REGRESSION","LATE_AFTER_SYNTHESIS","OPERATOR_ABORT"],"default":"UNKNOWN"}],"default":null},{"name":"originFatalDetail","type":["null","string"],"default":null},{"name":"fingerprint","type":"string"},{"name":"toolsEnabledForSession","type":["null","boolean"],"default":null},{"name":"geometryEnabledForSession","type":["null","boolean"],"default":null}]}