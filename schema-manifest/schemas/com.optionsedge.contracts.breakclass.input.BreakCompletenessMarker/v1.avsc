{"type":"record","name":"BreakCompletenessMarker","namespace":"com.optionsedge.contracts.breakclass.input","doc":"X1 completeness (market-structure-service BREAK-COMPLETENESS-MARKER-REQUIREMENT.md): one marker per folded bar per timeframe on options.spx.market-structure.break-events, sent in the transaction that folded the bar, immediately after that bar's BreakParentRecord events, under the same key. It states whether the host-tracked break lifecycle of the bar is complete and, if not, why. An absent marker is itself 'not complete'.","fields":[{"name":"schemaVersion","type":"int"},{"name":"scheduleId","type":"string","doc":"The label of the event stream (the key prefix, 'SPX'), as on BreakParentRecord."},{"name":"sessionScheduleId","type":"string","doc":"The engine's schedule id of the session: the scheduleId of the tools sets of the same session (the join key to a set)."},{"name":"timeframe","type":{"type":"enum","name":"MarkerTimeframe","symbols":["UNKNOWN","M1","M5","M15"],"default":"UNKNOWN"}},{"name":"sessionDate","type":"string"},{"name":"barOrdinal","type":"int","doc":"The timeframe's folded bar this marker closes (the ordinal of its events)."},{"name":"previousBarOrdinal","type":"int","doc":"barOrdinal of the previous marker of this timeframe in this session, -1 for the first."},{"name":"decisionOrdinal","type":"int","doc":"The 1m decision fold ordinal of the fold group that folded this bar (the decisionOrdinal of the tools set of the same timeframe built by that group); -1 when the group had no 1m member."},{"name":"complete","type":"boolean","doc":"No loss touches this bar: incompleteReasons is empty."},{"name":"completeThrough","type":"boolean","doc":"No loss touched any bar <= barOrdinal of this timeframe in this session: firstIncompleteBar < 0."},{"name":"firstIncompleteBar","type":"int","doc":"The earliest bar of this timeframe with a loss, -1 when none."},{"name":"incompleteReasons","type":{"type":"array","items":{"type":"enum","name":"IncompleteReason","symbols":["UNKNOWN","COLLECTOR_FAULT","EVENTS_ENCODE_FAILURE","EVENTS_PUBLISHING_OFF","UNATTRIBUTED_EVENT","NO_RECLAIM_FILTER","INCONSISTENT_BOUNDARY","SEQUENCE_EXHAUSTED","RESTORE_REPLAY","TOOLS_FOLD_UNAVAILABLE","TOOLS_FOLD_FAILURE","HOST_QUARANTINED","TOOLS_SET_UNAVAILABLE","TOOLS_SET_OVERSIZED"],"default":"UNKNOWN"}},"doc":"Every reason that applies to this bar, in enum order, without duplicates."},{"name":"eventSeq","type":"long","doc":"The highest lastEventSeq over sources, 0 when no event was ever sent."},{"name":"sources","type":{"type":"array","items":{"type":"record","name":"SourceWatermark","fields":[{"name":"source","type":{"type":"enum","name":"WatermarkSource","symbols":["UNKNOWN","DOUBLE_FORMATION","TRIPLE_FORMATION","RECTANGLE","TRENDLINE","TREND_CHANNEL","SR_ZONE"],"default":"UNKNOWN"}},{"name":"lastEventSeq","type":"long","doc":"The last eventSeq of this source actually sent on this timeframe's stream, 0 none."},{"name":"eventCount","type":"long","doc":"The number of events of this source sent on this timeframe's stream in this session."}]}},"doc":"One entry per host-tracked source, in enum order (the six of BreakEvents.SOURCES)."},{"name":"phaseBParameterHash","type":"string"}]}