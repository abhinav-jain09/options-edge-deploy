{"type":"record","name":"SequenceRecord","namespace":"com.optionsedge.contracts.marketstructure.sequence","doc":"One sequence record (R3): SESSION_START, FOLD_GROUP, SESSION_END or SESSION_FATAL.","fields":[{"name":"schemaVersion","type":"int"},{"name":"kind","type":{"type":"enum","name":"SequenceKind","symbols":["UNKNOWN","SESSION_START","FOLD_GROUP","SESSION_END","SESSION_FATAL"],"default":"UNKNOWN"}},{"name":"sequencePosition","type":"long"},{"name":"scheduleId","type":["null","string"],"default":null},{"name":"tradeDate","type":["null","string"],"default":null},{"name":"scheduledEndMs","type":["null","long"],"default":null},{"name":"slots","type":{"type":"array","items":{"type":"record","name":"SequenceSlot","fields":[{"name":"timeframe","type":"string"},{"name":"ordinal","type":"int"},{"name":"scheduledEndMs","type":"long"}]}}},{"name":"reason","type":["null",{"type":"enum","name":"SequenceFatalReason","symbols":["UNKNOWN","UNSUPPORTED_CALENDAR","AMBIGUOUS_SUCCESSOR","TERMINAL_MISSING","PROOF_SCAN_EXHAUSTED","BUFFER_OVERFLOW","ORDINAL_CONFLICT","BAR_ID_CONFLICT","ORDINAL_REGRESSION","LATE_AFTER_SYNTHESIS","OPERATOR_ABORT"],"default":"UNKNOWN"}],"default":null},{"name":"detail","type":["null","string"],"default":null},{"name":"ingressCanonicalHash","type":["null","string"],"default":null}]}