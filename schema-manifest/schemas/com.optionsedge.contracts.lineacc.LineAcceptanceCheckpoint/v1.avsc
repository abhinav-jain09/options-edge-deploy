{"type":"record","name":"LineAcceptanceCheckpoint","namespace":"com.optionsedge.contracts.lineacc","doc":"Compacted checkpoint of the engine state (zstd), offsets and per-timeframe publish counters, written in the same transaction as the outputs. Fixed key.","fields":[{"name":"schemaVersion","type":"int"},{"name":"parameterSetHash","type":"string"},{"name":"sessionDate","type":"string"},{"name":"createdAtMs","type":"long"},{"name":"lastArrivalSeq","type":"long"},{"name":"publishSeq","type":{"type":"array","items":{"type":"record","name":"TimeframePublishSeq","fields":[{"name":"timeframe","type":{"type":"enum","name":"Timeframe","symbols":["UNKNOWN","M1","M5","M15"],"default":"UNKNOWN"}},{"name":"publishSeq","type":"long"}]}},"default":[]},{"name":"offsets","type":{"type":"array","items":{"type":"record","name":"SourceOffset","fields":[{"name":"topic","type":"string"},{"name":"partition","type":"int"},{"name":"offset","type":"long"}]}},"default":[]},{"name":"stateCodec","type":"string"},{"name":"stateSha256","type":"string"},{"name":"state","type":"bytes"}]}