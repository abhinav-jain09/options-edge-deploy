{"type":"record","name":"LiquidityWallClosure","namespace":"com.optionsedge.contracts.liquiditywall","doc":"document D section 4: the recorded close decision of one bucket, written before the bucket record","fields":[{"name":"schemaVersion","type":"int","doc":"1 for this revision"},{"name":"depthEnvironment","type":"string","doc":"the environment literal of the admitted depth frames, e.g. Rithmic Test, or the live literal"},{"name":"contract","type":"string","doc":"the contract table's row for the trade date, e.g. ESZ6"},{"name":"bucketEnd","type":"long","doc":"bucket end on the collector clock, epoch ms"},{"name":"configFingerprint","type":"string","doc":"SHA-256 over the sorted name=value configuration lines plus the detector's logic version"},{"name":"path","type":"string","doc":"WATERMARK or DEGRADED"},{"name":"depthOffset","type":"long","doc":"exclusive next-unread offset of the depth consumer at the decision"},{"name":"tapeOffset","type":"long","doc":"exclusive next-unread offset of the tape consumer at the decision"}]}