{"type":"record","name":"LiquidityWallDashboard","namespace":"com.optionsedge.contracts.liquiditywall","doc":"document D section 8: the per-bucket frame the page renders. VERSION 2 (id 3408): each wall gains sizeNow, sizeTape and wordState (nullable, default null); version 1 is id 3403 (v1/LiquidityWallDashboard.avsc)","fields":[{"name":"schemaVersion","type":"int","doc":"1 for this revision"},{"name":"depthEnvironment","type":"string","doc":"the environment literal of the admitted depth frames, e.g. Rithmic Test, or the live literal"},{"name":"contract","type":"string","doc":"the contract table's row for the trade date, e.g. ESZ6"},{"name":"bucketEnd","type":"long","doc":"bucket end on the collector clock, epoch ms"},{"name":"configFingerprint","type":"string","doc":"SHA-256 over the sorted name=value configuration lines plus the detector's logic version"},{"name":"quality","type":"string"},{"name":"closePath","type":"string"},{"name":"layerBEnabled","type":"boolean","doc":"false on the test system: no walls, no flip fields"},{"name":"spotTick","type":["null","long"],"default":null},{"name":"spotAgeMs","type":["null","long"],"default":null},{"name":"levels","type":{"type":"array","items":{"type":"record","name":"LiquidityWallDashboardLevel","doc":"one band level","fields":[{"name":"side","type":"string"},{"name":"tick","type":"long"},{"name":"lastSize","type":"long"},{"name":"smoothedSize","type":"long"},{"name":"state","type":"string"}]}}},{"name":"clusters","type":{"type":"array","items":{"type":"record","name":"LiquidityWallDashboardCluster","doc":"one emitted Layer-A cluster","fields":[{"name":"clusterId","type":"string"},{"name":"side","type":"string"},{"name":"loTick","type":"long"},{"name":"hiTick","type":"long"},{"name":"peakTick","type":"long"},{"name":"peakSize","type":"long"},{"name":"totalSize","type":"long"},{"name":"levelCount","type":"int"},{"name":"geometry","type":"string","doc":"OK, SPOT_ABSENT or CROSSED"},{"name":"persistenceRun","type":"int"}]}}},{"name":"walls","type":{"type":"array","items":{"type":"record","name":"LiquidityWallDashboardWall","doc":"one live wall as published (document D section 7)","fields":[{"name":"clusterId","type":"string"},{"name":"lane","type":"string","doc":"RESISTANCE or SUPPORT"},{"name":"loTick","type":"long"},{"name":"hiTick","type":"long"},{"name":"frozenTicks","type":{"type":"array","items":"long"},"doc":"every tick from loTick to hiTick inclusive"},{"name":"birthBucketEnd","type":"long"},{"name":"peakSizeAtBirth","type":"long"},{"name":"totalSizeAtBirth","type":"long"},{"name":"ladderMedianAtBirth","type":"long"},{"name":"levelCountAtBirth","type":"int"},{"name":"heldBuckets","type":"int"},{"name":"defendedBuckets","type":"int"},{"name":"brokenBuckets","type":"int"},{"name":"brokenBucketsFrozen","type":["null","int"],"default":null,"doc":"the break term's count frozen at the settle; null before it"},{"name":"termHold","type":"int","doc":"the capped score terms of section 7: hold"},{"name":"termDefense","type":"int"},{"name":"termPeak","type":"int"},{"name":"termLevels","type":"int"},{"name":"termBreaks","type":"int","doc":"the break term as published (frozen after the settle)"},{"name":"scoreRaw","type":"int"},{"name":"scorePublished","type":"int"},{"name":"scoreSettled","type":"boolean"},{"name":"grade","type":"string","doc":"STRONG, MODERATE or WEAK"},{"name":"defendedState","type":"boolean"},{"name":"brokenState","type":"boolean"},{"name":"lastEvidenceBucketEnd","type":["null","long"],"default":null,"doc":"the last LIVE bucket on which evidence was read"},{"name":"breachOpen","type":"boolean","doc":"a breach episode is open"},{"name":"breachT0","type":["null","long"],"default":null,"doc":"exchange timestamp of the open breach episode's first print, or null"},{"name":"breachTickReached","type":["null","long"],"default":null},{"name":"sizeNow","type":["null","long"],"default":null,"doc":"contracts resting on the wall's side over loTick..hiTick at this bucket's close; null when the bucket is not LIVE, spot is absent, or a frozen tick is outside the band read"},{"name":"sizeTape","type":["null",{"type":"array","items":["null","long"]}],"default":null,"doc":"7 entries, oldest first; entry i is sizeNow of bucket bucketEnd - (6 - i) * 1000 ms; entry 6 equals sizeNow; null for a bucket before birth or unseen"},{"name":"wordState","type":["null","string"],"default":null,"doc":"NEW HOLDING UNDER_ATTACK TRADED_INTO HIDDEN_SIZE REFILLING PULLED BROKEN BAND_ONLY NO_READING"}]}}},{"name":"leanThousandths","type":["null","int"],"default":null,"doc":"(Below - Above)/(Below + Above) in thousandths, half-up; null when unread or Layer B is off"},{"name":"above","type":["null","long"],"default":null},{"name":"below","type":["null","long"],"default":null},{"name":"sideRead","type":["null","string"],"default":null,"doc":"UP_HEAVY, DOWN_HEAVY, BALANCED or NO_READ; null when Layer B is off"},{"name":"confirmedSide","type":["null","string"],"default":null,"doc":"UP_HEAVY, DOWN_HEAVY or UNCONFIRMED; null when Layer B is off"},{"name":"lastAdmittedFrameReceivedAtMs","type":["null","long"],"default":null,"doc":"the carried frame's receivedAtMs"},{"name":"lastAdmittedStreamId","type":["null","string"],"default":null},{"name":"closingFramePresent","type":"boolean","doc":"true only when the bucket had a frame of its own"}]}