{"type":"record","name":"IngressBatch","namespace":"com.optionsedge.contracts.lineacc","doc":"Write-ahead journal batch: the immutable input archive of a live session. INPUT items carry key/value/headers in full; TIMER items carry timerKind/eventTimeMs; REFUSED items carry only sizeBytes/sha256/reasonCode. Key: batchSeq.","fields":[{"name":"schemaVersion","type":"int"},{"name":"batchSeq","type":"long"},{"name":"receivedAtMs","type":"long"},{"name":"items","type":{"type":"array","items":{"type":"record","name":"IngressItem","fields":[{"name":"arrivalSeq","type":"long"},{"name":"receivedAtMs","type":"long"},{"name":"stream","type":"string"},{"name":"topic","type":"string"},{"name":"partition","type":"int"},{"name":"offset","type":"long"},{"name":"kind","type":{"type":"enum","name":"IngressKind","symbols":["UNKNOWN","INPUT","TIMER","REFUSED"],"default":"UNKNOWN"}},{"name":"timerKind","type":["null",{"type":"enum","name":"TimerKind","symbols":["UNKNOWN","DECISION_CUTOFF","EVIDENCE_T_E","STALE_CHECK","SESSION_END"],"default":"UNKNOWN"}],"default":null},{"name":"eventTimeMs","type":["null","long"],"default":null},{"name":"keyBytes","type":["null","bytes"],"default":null},{"name":"valueBytes","type":["null","bytes"],"default":null},{"name":"headers","type":["null",{"type":"array","items":{"type":"record","name":"IngressHeader","fields":[{"name":"key","type":"string"},{"name":"value","type":"bytes"}]}}],"default":null},{"name":"sizeBytes","type":["null","long"],"default":null},{"name":"sha256","type":["null","string"],"default":null},{"name":"reasonCode","type":["null","string"],"default":null}]}},"default":[]}]}