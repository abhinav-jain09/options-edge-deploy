{"type":"record","name":"LineMonitorStatus","namespace":"com.optionsedge.contracts.lineacc","doc":"Live status of one line monitor for the page. Non-durable, never calibrated. Key: lineId|timeframe.","fields":[{"name":"schemaVersion","type":"int"},{"name":"recordType","type":{"type":"enum","name":"RecordType","symbols":["UNKNOWN","EPISODE_CORE","EPISODE_EVIDENCE","EPISODE_OUTCOME","EPISODE_INTEGRITY","LEAN_EVENT","SESSION_COVERAGE","MONITOR_STATUS"],"default":"UNKNOWN"}},{"name":"sessionDate","type":"string"},{"name":"sessionSegment","type":{"type":"enum","name":"SessionSegment","symbols":["UNKNOWN","RTH","GLOBEX"],"default":"UNKNOWN"}},{"name":"timeframe","type":{"type":"enum","name":"Timeframe","symbols":["UNKNOWN","M1","M5","M15"],"default":"UNKNOWN"}},{"name":"asOfMs","type":"long"},{"name":"publishSeq","type":"long"},{"name":"lineId","type":"string"},{"name":"monitorState","type":{"type":"enum","name":"MonitorState","symbols":["UNKNOWN","ARMED","APPROACHING"],"default":"UNKNOWN"}},{"name":"settledSide","type":{"type":"enum","name":"Side","symbols":["UNKNOWN","ABOVE","BELOW"],"default":"UNKNOWN"}}]}