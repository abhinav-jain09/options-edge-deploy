OPTIONS_EDGE_TOPICS="options.marketdata.selection:1 options.databento.control:1 options.databento.raw:32 options.databento.events.raw:32 options.databento.normalized:32 options.ibkr.raw:32 options.ibkr.display:32 options.ibkr.display.volume.current:32 options.ibkr.display.gamma.history:32 options.ibkr.pace:32 options.ibkr.directional-pressure:32 underlying.vix.price:1 options.ibkr.volume-sandwich.current:32 options.ibkr.volume-sandwich.alerts:32 options.databento.display:32 options.databento.display.volume.current:32 options.databento.display.gamma.history:32 options.databento.pace:32 options.databento.pace.mission:32 options.databento.directional-pressure:32 options.databento.market-pressure.mission:32 options.databento.sandwich.mission:32 options.databento.volume-sandwich.current:32 options.databento.volume-sandwich.alerts:32 options.databento.volume.state.compacted:32 options.databento.maxpain:4 options.spx.vix-option-inteligence-service.current:32 display.volume.current:32 display.volume.sandwich.current:32 display.volume.sandwich.alerts:32 options.spx.participant-flow:32 options.spx.mission-control.current:32 options.rewind.journal:1 options.rewind.audit:1 strike-liquidity-heatmap-bucket:32 strike-liquidity-heatmap-dashboard:32 underlying.es.trades:32 es.open-direction.forecast:4 es.open-direction.outcome:4 es.open-direction.status:4 options.databento.gex.strike:32 options.databento.gex.strike.history:32 options.databento.gex.flow.by-strike:32 options.databento.gex.flow.10s:32 options.databento.gex.flow.1m:32 options.databento.gex.flow.5m:32 options.databento.gex.flow.15m:32 options.databento.gex.flow.session:32 options.databento.gex.flow.dashboard:32 options.databento.gex.magnet:32 spx.basis.state:1 spx.basis.a1.evidence:1"
# options.rewind.journal MUST be single-partition + compacted: the Rewind
# service's hydrate path relies on compaction-keyed-by-run_id and
# single-partition ordering as its consistency model (Journal.hydrate
# refuses to start otherwise).
# options.rewind.audit: append-only audit trail, single partition (key=run_id
# for log-locality). delete cleanup with default retention is acceptable for
# v1; a follow-up PR will set retention.ms=7776000000 (90d) via the
# apply-internal-topic-configs.sh pattern. Audit replay within 24h is also
# served by Loki on the same logs.
# options.databento.gex.strike is compacted (compact,delete): the GEX service creates it via
# ensureCompactedTopic and downstream relies on last-value-per-strike keying. Adding it here so the deploy's
# apply-topics step keeps it compacted (a plain-delete entry would strip compaction). The gex-flow.* and
# gex.magnet topics are plain delete (last-value-wins is served by the consumers), so they are NOT compacted.
OPTIONS_EDGE_COMPACTED_TOPICS="options.databento.pace.mission options.databento.market-pressure.mission options.databento.sandwich.mission options.databento.volume.state.compacted options.databento.maxpain options.spx.vix-option-inteligence-service.current options.spx.mission-control.current options.rewind.journal options.databento.gex.strike"
PROTECTED_TOPIC_REGEX='^(__consumer_offsets|_schemas|__transaction_state|options\.rewind\.(journal|audit))$|.*-(changelog|repartition)$'

# --- ES<->SPX basis engine state (design: es_spx_basis_engine) ---
# spx.basis.state holds STATE_CURRENT: the trusted ES-SPX anchor the feed resumes from on boot
# (the watcher assigns TopicPartition(topic, 0) explicitly, so it MUST be single-partition), and
# it must survive indefinitely -> PURE compact + retention -1. Previously undeclared, so every
# env auto-created it with broker defaults (32 partitions, delete): the anchor was unreachable on
# dev and the ES-on-SPX overlay fail-closed with basisState=UNAVAILABLE. Prod's correct topic was
# hand-made during the 2026-07-18 operator bootstrap; this declaration makes it reproducible.
OPTIONS_EDGE_PURE_COMPACT_TOPICS="spx.basis.state"
# spx.basis.state is read via assign(TopicPartition(topic, 0)) — it is ONLY correct at exactly one
# partition, so an auto-created 32-partition copy must be destructively repaired (and re-seeded).
OPTIONS_EDGE_EXACT_PARTITION_TOPICS="spx.basis.state"
# spx.basis.a1.evidence is an append-only A1 evidence trail: single partition, plain delete, 3d.
OPTIONS_EDGE_TOPIC_RETENTION_OVERRIDES="spx.basis.state=-1 spx.basis.a1.evidence=259200000"
