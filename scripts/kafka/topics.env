OPTIONS_EDGE_TOPICS="options.databento.oi.anchor-manifest:1 options.databento.oi.shadow.by-strike:4 options.es-strike-intel-spx-aligned:4 rates.sofr.databento-sr3-feed-service.history:1 options.marketdata.selection:1 options.databento.control:1 options.databento.raw:32 options.databento.events.raw:32 options.databento.normalized:32 options.ibkr.raw:32 options.ibkr.display:32 options.ibkr.display.volume.current:32 options.ibkr.display.gamma.history:32 options.ibkr.pace:32 options.ibkr.directional-pressure:32 underlying.vix.price:1 options.ibkr.volume-sandwich.current:32 options.ibkr.volume-sandwich.alerts:32 options.databento.display:32 options.databento.display.volume.current:32 options.databento.display.gamma.history:32 options.databento.pace:32 options.databento.pace.mission:32 options.databento.directional-pressure:32 options.databento.market-pressure.mission:32 options.databento.sandwich.mission:32 options.databento.volume-sandwich.current:32 options.databento.volume-sandwich.alerts:32 options.databento.volume.state.compacted:32 options.databento.maxpain:4 options.spx.vix-option-inteligence-service.current:32 display.volume.current:32 display.volume.sandwich.current:32 display.volume.sandwich.alerts:32 options.spx.participant-flow:32 options.spx.mission-control.current:32 options.rewind.journal:1 options.rewind.audit:1 strike-liquidity-heatmap-bucket:32 strike-liquidity-heatmap-dashboard:32 underlying.es.trades:32 es.open-direction.forecast:4 es.open-direction.outcome:4 es.open-direction.status:4 options.databento.gex.strike:32 options.databento.gex.strike.history:32 options.databento.gex.flow.by-strike:32 options.databento.gex.flow.10s:32 options.databento.gex.flow.1m:32 options.databento.gex.flow.5m:32 options.databento.gex.flow.15m:32 options.databento.gex.flow.session:32 options.databento.gex.flow.dashboard:32 options.databento.gex.magnet:32 spx.basis.state:1 spx.basis.a1.evidence:1 underlying.spx.index.price:1 options.spx.gamma-migration.current:4 options.spx.gamma-migration.scoring:4"
# options.rewind.journal MUST be single-partition + compacted: the Rewind
# service's hydrate path relies on compaction-keyed-by-run_id and
# single-partition ordering as its consistency model (Journal.hydrate
# refuses to start otherwise).
# options.rewind.audit: append-only audit trail, single partition (key=run_id
# for log-locality). delete cleanup with default retention is acceptable for
# v1; a follow-up PR will set retention.ms=7776000000 (90d) via the
# apply-internal-topic-configs.sh pattern. Audit replay within 24h is also
# served by Loki on the same logs.
# options.databento.gex.strike is compacted (compact,delete): the GEX service creates it via
# ensureCompactedTopic and downstream relies on last-value-per-strike keying. Adding it here so the deploy's
# apply-topics step keeps it compacted (a plain-delete entry would strip compaction). The gex-flow.* and
# gex.magnet topics are plain delete (last-value-wins is served by the consumers), so they are NOT compacted.
# options.spx.gamma-migration.current is compacted for the same reason as gex.strike: it is a
# last-value-per-chain LIVE view, so a consumer that starts late needs the newest record per key and
# nothing else. options.spx.gamma-migration.scoring is deliberately NOT compacted — every record
# there is a distinct (call, horizon) observation and compaction would discard the accumulated
# evidence the topic exists for.
OPTIONS_EDGE_COMPACTED_TOPICS="options.spx.gamma-migration.current options.databento.oi.anchor-manifest options.databento.oi.shadow.by-strike options.es-strike-intel-spx-aligned options.databento.pace.mission options.databento.market-pressure.mission options.databento.sandwich.mission options.databento.volume.state.compacted options.databento.maxpain options.spx.vix-option-inteligence-service.current options.spx.mission-control.current options.rewind.journal options.databento.gex.strike"
PROTECTED_TOPIC_REGEX='^(__consumer_offsets|_schemas|__transaction_state|options\.rewind\.(journal|audit))$|.*-(changelog|repartition)$'

# options.spx.gamma-migration.{current,scoring} are declared here rather than left to the
# service's own ensureTopic so the partition count is a reviewed decision, not a broker default:
# after the re-key one option chain is ONE key, so 4 partitions carry the handful of live expiries
# and nothing is gained by more. They are plain delete (no compaction): `current` is a 1/s live
# snapshot read only at the head, and `scoring` is an append-only evidence log where every record
# is a distinct (call, horizon) observation — compaction would silently discard the record the
# topic exists to accumulate.
#
# --- ES<->SPX basis engine state (design: es_spx_basis_engine) ---
# spx.basis.state holds STATE_CURRENT: the trusted ES-SPX anchor the feed resumes from on boot
# (the watcher assigns TopicPartition(topic, 0) explicitly, so it MUST be single-partition), and
# it must survive indefinitely -> PURE compact + retention -1. Previously undeclared, so every
# env auto-created it with broker defaults (32 partitions, delete): the anchor was unreachable on
# dev and the ES-on-SPX overlay fail-closed with basisState=UNAVAILABLE. Prod's correct topic was
# hand-made during the 2026-07-18 operator bootstrap; this declaration makes it reproducible.
OPTIONS_EDGE_PURE_COMPACT_TOPICS="spx.basis.state"
# spx.basis.state is read via assign(TopicPartition(topic, 0)) — it is ONLY correct at exactly one
# partition, so an auto-created 32-partition copy must be destructively repaired (and re-seeded).
OPTIONS_EDGE_EXACT_PARTITION_TOPICS="spx.basis.state"
# spx.basis.a1.evidence is an append-only A1 evidence trail: single partition, plain delete, 3d.
OPTIONS_EDGE_TOPIC_RETENTION_OVERRIDES="rates.sofr.databento-sr3-feed-service.history=1800000 spx.basis.state=-1 spx.basis.a1.evidence=259200000"

# --- VIX feed separation (design VIX-FEED-SEPARATION-DESIGN.md rev 4 §6 — PROD-SCOPED) ---
# These OPTIONS_EDGE_PROD_ONLY_* sets are honored by apply-topics.sh / verify-topics.sh
# ONLY when ENVIRONMENT is EXPLICITLY 'production' (the env var set to that exact value)
# AND TOPIC_SET is the default (non-es4) set. If ENVIRONMENT is unset/empty they are
# SKIPPED with a loud notice (fail-closed) — load-kafka-settings.sh's default-to-production
# is deliberately never trusted here, and the environment is never inferred from a broker
# address. Dev's topic set and policies are untouched (r2 finding 7 / finding 11).
#
# underlying.spx.index.price (declared above, :1): the IBKR SPX cash-index hop topic
# (ibkr-feed dual-produces it to BOTH clusters; each env's databento-feed consumes its LOCAL
# copy as spot tier-1). SINGLE partition on purpose — the feed's replay watermark is the
# partition offset, which is only monotonic at exactly one partition. Plain delete retention.
# underlying.vix.price.shadow: the shadow phase's output topic — plain delete, 1 day.
OPTIONS_EDGE_PROD_ONLY_TOPICS="underlying.vix.price.shadow:1"
# underlying.vix.price (already declared in OPTIONS_EDGE_TOPICS as :1 for every env) is
# PURE compact on prod: the latest VIX price per key must survive indefinitely — a
# compact,delete policy would drop it once the global retention elapsed.
OPTIONS_EDGE_PROD_ONLY_PURE_COMPACT_TOPICS="underlying.vix.price"
# Both topics carry a single-partition read contract on prod: partition count must be
# EXACT (not "at least"), enforced by apply AND verify.
OPTIONS_EDGE_PROD_ONLY_EXACT_PARTITION_TOPICS="underlying.vix.price underlying.vix.price.shadow"
# Explicit retention encoding (verify-then-codify, design §6.3): real topic -1 (compact,
# never expires), shadow 86400000 (1d). Kept in a PROD_ONLY overrides var (merged into
# OPTIONS_EDGE_TOPIC_RETENTION_OVERRIDES under the same explicit-production predicate)
# so dev's underlying.vix.price keeps its default retention — dev untouched.
OPTIONS_EDGE_PROD_ONLY_TOPIC_RETENTION_OVERRIDES="underlying.vix.price=-1 underlying.vix.price.shadow=86400000"
# NEVER-RECREATE guard (VFS-R8, r2 finding 7): a partition-count mismatch on a listed
# topic is a HARD ERROR in apply-topics.sh EVEN IF KAFKA_RECREATE_MISMATCHED_TOPICS=true —
# a global operator cleanup flag must never be able to destroy the compacted VIX price
# history. Unconditional (protective only; it never mutates anything).
OPTIONS_EDGE_NEVER_RECREATE_TOPICS="underlying.vix.price"
# ---------------------------------------------------------------------------
# ES4 TOPIC SET (the es4 broker on 192.168.100.4 — the ES-0DTE environment).
#
# SINGLE SOURCE OF TRUTH: es4 topics are declared HERE and applied by the SAME
# scripts/kafka/apply-topics.sh that Jenkins uses for dev/prod. They were
# previously hardcoded in scripts/es4/create-es-topics.sh, which drifted from
# this file and encoded the partition/retention contract only in bash arrays.
#
# SCOPED ON PURPOSE: es4 runs ONLY these es.* topics. Applying the SPX
# OPTIONS_EDGE_TOPICS set to the es4 broker would create ~50 unrelated
# options.* topics there. apply-topics.sh selects this set via TOPIC_SET=es4.
#
# Kafka-Streams changelog/repartition topics are NOT listed: the apps create
# them at runtime, and PROTECTED_TOPIC_REGEX keeps them out of destructive
# reconciliation.
# Service OUTPUT topics of the es4 deployments (delta-flow, gex-flow, strike-intelligence,
# option-price-behavior, volume-pace, greek-move-authenticity, option-truth-engine). Declared here so
# the reset recreates them with their REAL partition counts instead of relying on broker auto-create
# (which would silently give them the default). Orphan topics from services that do NOT run on es4
# (ibkr.*, hpsf.*, mission-control, strike-invasion, strike-sr, open-direction, volume-sandwich,
# market-carry) are deliberately EXCLUDED — a reset must not resurrect them.
OPTIONS_EDGE_ES4_TOPICS="es.dealer-ledger-calibration-state:4 es.dealer-ledger-outcome-scored:4 es.dealer-ledger-profile:4 es.dealer-ledger-signal-fired:4 es.dealer-ledger-state:4 es.delta-flow-10s:32 es.delta-flow-15m:32 es.delta-flow-1m:32 es.delta-flow-30s:32 es.delta-flow-5m:32 es.delta-flow-by-strike:32 es.delta-flow-by-trade:4 es.delta-flow-corrections:32 es.delta-flow-dashboard:32 es.delta-flow-diagnostics:32 es.delta-flow-session:4 es.option-price-behavior-by-strike:32 es.option-price-behavior-dashboard:4 es.option-price-behavior-by-option:4 es.option-price-behavior-session:4 es.options.databento.control:4 es.options.databento.directional-pressure:4 es.options.databento.display.gamma.history:4 es.options.databento.display.volume.current:4 es.options.databento.display:4 es.options.databento.events.raw:4 es.options.databento.gex.flow.10s:32 es.options.databento.gex.flow.15m:32 es.options.databento.gex.flow.1m:32 es.options.databento.gex.flow.5m:32 es.options.databento.gex.flow.by-strike:32 es.options.databento.gex.flow.dashboard:32 es.options.databento.gex.flow.session:32 es.options.databento.gex.magnet:32 es.options.databento.gex.spxbridge:4 es.options.databento.gex.strike-lifecycle:32 es.options.databento.gex.strike.history:4 es.options.databento.gex.strike:4 es.options.databento.market-pressure.mission:4 es.options.databento.maxpain:4 es.options.databento.normalized:4 es.options.databento.pace.mission:4 es.options.databento.pace.rank:32 es.options.databento.pace:4 es.options.databento.raw:4 es.options.databento.sandwich.mission:4 es.options.databento.strike-flow.strike.avro:4 es.options.databento.strike-flow:4 es.options.databento.seller-activity:32 es.options.databento.volume.state.compacted:4 es.options.es.option-truth-engine-service.by-strike:32 es.options.es.spread-skew.current:4 es.options.es.spread-skew.events:4 es.options.hpsf.dlq:4 es.options.marketdata.selection:4 es.options.opra.tcbbo:4 es.options.spx.greek-move-auth.current:32 es.options.spx.greek-move-auth.events:32 es.options.spx.vix-option-inteligence-service.current:4 es.reversal.final-summary:1 es.reversal.outcome:1 es.reversal.strength:1 es.reversal.verdicts:1 es.futures.aggressor-flow:1 es.signal-follower.hot-strike:1 es.strike-intelligence-by-strike:32 es.strike-intelligence-dashboard:32 es.strike-intelligence-turn-alert:4 es.strike-liquidity-heatmap-bucket:4 es.strike-liquidity-heatmap-dashboard:4 es.underlying.es.price:4 es.underlying.es.trades:4 es.underlying.spx.price:4 es.underlying.vix.price:4 es.close.direction.signal:4 es.close.direction.state:1 es.market.spx.market-carry-service.current:32 es.options.databento.gex.oi-status:4 es.options.hpsf.audit:4 es.options.hpsf.exit-signal:4 es.options.hpsf.latest-signal:4 es.options.hpsf.market-flow:4 es.options.hpsf.strike-score:4 es.options.spx.strike-invasion.current:4 es.options.spx.strike-sr.current:4 es.heartbeats:1"
# compact,delete (compaction plus the global retention floor)
OPTIONS_EDGE_ES4_COMPACTED_TOPICS="es.options.databento.pace.mission es.options.databento.market-pressure.mission es.options.databento.sandwich.mission es.options.databento.volume.state.compacted es.options.databento.maxpain es.options.databento.seller-activity es.dealer-ledger-calibration-state es.underlying.es.price es.underlying.vix.price es.options.spx.vix-option-inteligence-service.current es.reversal.final-summary es.reversal.outcome es.futures.aggressor-flow es.close.direction.state es.market.spx.market-carry-service.current"
# Single-partition read contracts: es.reversal.* and es.signal-follower.* are
# consumed with single-partition ordering. Broker auto-create would give them
# the default 4 partitions, and ensure_topic_custom never repaired that — this
# is exactly the drift that made an auto-created topic unusable.
OPTIONS_EDGE_ES4_EXACT_PARTITION_TOPICS="es.reversal.verdicts es.reversal.strength es.reversal.final-summary es.reversal.outcome es.signal-follower.hot-strike es.futures.aggressor-flow es.close.direction.state es.heartbeats"
OPTIONS_EDGE_ES4_TOPIC_RETENTION_OVERRIDES="es.reversal.verdicts=604800000 es.reversal.strength=172800000 es.signal-follower.hot-strike=604800000"
