OPTIONS_EDGE_TOPICS="options.marketdata.selection:1 options.databento.control:1 options.databento.raw:32 options.databento.events.raw:32 options.databento.normalized:32 options.ibkr.raw:32 options.ibkr.display:32 options.ibkr.display.volume.current:32 options.ibkr.display.gamma.history:32 options.ibkr.pace:32 options.ibkr.directional-pressure:32 underlying.vix.price:1 options.ibkr.volume-sandwich.current:32 options.ibkr.volume-sandwich.alerts:32 options.ibkr.unusualwhales.gex.strike:32 options.ibkr.unusualwhales.gex.strike.history:32 options.databento.display:32 options.databento.display.volume.current:32 options.databento.display.gamma.history:32 options.databento.pace:32 options.databento.pace.mission:32 options.databento.directional-pressure:32 options.databento.market-pressure.mission:32 options.databento.sandwich.mission:32 options.databento.volume-sandwich.current:32 options.databento.volume-sandwich.alerts:32 options.databento.volume.state.compacted:32 options.databento.maxpain:32 display.volume.current:32 display.volume.sandwich.current:32 display.volume.sandwich.alerts:32 options.spx.participant-flow:32 options.spx.mission-control.current:32 options.rewind.journal:1 options.rewind.audit:1"
# options.rewind.journal MUST be single-partition + compacted: the Rewind
# service's hydrate path relies on compaction-keyed-by-run_id and
# single-partition ordering as its consistency model (Journal.hydrate
# refuses to start otherwise).
# options.rewind.audit: append-only audit trail, single partition (key=run_id
# for log-locality). delete cleanup with default retention is acceptable for
# v1; a follow-up PR will set retention.ms=7776000000 (90d) via the
# apply-internal-topic-configs.sh pattern. Audit replay within 24h is also
# served by Loki on the same logs.
OPTIONS_EDGE_COMPACTED_TOPICS="options.databento.pace.mission options.databento.market-pressure.mission options.databento.sandwich.mission options.databento.volume.state.compacted options.databento.maxpain options.spx.mission-control.current options.rewind.journal"
PROTECTED_TOPIC_REGEX='^(__consumer_offsets|_schemas|__transaction_state|options\.rewind\.(journal|audit))$|.*-(changelog|repartition)$'
