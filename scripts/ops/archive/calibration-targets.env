# calibration-targets.env — THE preregistration for the Candle Direction calibration corpus.
#
# A5.7 and A5.8 both read their targets from HERE and from nowhere else. This file is repo-managed and
# installed by Jenkins with the rest of the archive unit, which is the whole point: it is not derived
# from oe-topics.env and not derived from what happens to be in the archive, because those are exactly
# the two things that go quiet together. If the ledger were dropped from oe-topics.env, target discovery
# from archived data would find no corpus and report nothing; with an independent declaration, the same
# omission reports a target whose corpus is MISSING.
#
# Everything below is frozen BEFORE the data is seen. The evaluator refuses to let the caller override
# any of it (r6 #1): a stopping boundary, a cell universe or a threshold chosen after seeing the numbers
# makes every number meaningless, and an environment variable is exactly how that would happen.
#
# Changing any value here restarts the cohort. That is the intended cost.

OE_CAL_TOPIC=context-tape.direction.ledger

# ---- prod --------------------------------------------------------------------------------------
# The parameter set is still CALIBRATION: TRACK_FROM_PUSH is deliberately in the far future, so no call
# counts toward any cohort yet and no artifact can be produced. The stopping boundary is declared as
# UNFROZEN for the same reason — it is set, once, in the same commit that freezes the literals, and the
# evaluator refuses to run until it is a real RTH close instant.
OE_CAL_PARAMETER_SET_HASH_prod=UNFROZEN
OE_CAL_TRACK_FROM_PUSH_prod=2099-01-01
OE_CAL_STOPPING_BOUNDARY_MS_prod=UNFROZEN
OE_CAL_CORPUS_START_DATE_prod=2026-09-08
# A5.7: all four counters admit only sessions matching the exact hash, TRACK_FROM_PUSH **and SEMANTIC
# STAMP**. The hash and the stamp are not the same thing — the stamp is what changes when the literals
# change — so without this two different parameter sets could pool into one cohort while every other
# check passed. PushEngine.SEMANTIC_STAMP is the value.
OE_CAL_SEMANTIC_STAMP_prod=2026-09-08T18:00:00Z

# ---- dev ---------------------------------------------------------------------------------------
OE_CAL_PARAMETER_SET_HASH_dev=UNFROZEN
OE_CAL_TRACK_FROM_PUSH_dev=2099-01-01
OE_CAL_STOPPING_BOUNDARY_MS_dev=UNFROZEN
OE_CAL_CORPUS_START_DATE_dev=2026-09-08
OE_CAL_SEMANTIC_STAMP_dev=2026-09-08T18:00:00Z

# ---- the size targets, adopted from A2 ----------------------------------------------------------
OE_CAL_T_SESSIONS=30
OE_CAL_T_COHORT=200
OE_CAL_T_CLASS=50
OE_CAL_T_CELL=50

# ---- the required universe, frozen before validation begins -------------------------------------
# A cell listed here and never observed counts as ZERO. Taking a minimum over the cells that happen to
# APPEAR would let a cell with no calls satisfy the threshold by being absent.
OE_CAL_REQUIRED_CLASSES="1 -1"
OE_CAL_REQUIRED_CELLS="EXHAUSTED|CALL_WALL|POS_GAMMA EXHAUSTED|PUT_WALL|POS_GAMMA EXHAUSTED|CALL_WALL|NEG_GAMMA EXHAUSTED|PUT_WALL|NEG_GAMMA STRONG|CALL_WALL|NEG_GAMMA STRONG|PUT_WALL|NEG_GAMMA EXHAUSTED|NONE|POS_GAMMA EXHAUSTED|NONE|NEG_GAMMA STRONG|NONE|NEG_GAMMA STRONG|NONE|POS_GAMMA"

# ---- A2's estimator, verbatim -------------------------------------------------------------------
# Resampling unit, replicate count, quantile convention and seed are all part of the estimator. Naming
# one without the others leaves the pass/fail free to move.
OE_CAL_BOOTSTRAP_SEED=20260906
OE_CAL_BOOTSTRAP_B=10000

# ---- the acceptance numbers ---------------------------------------------------------------------
# The SHAPE is frozen in the design; these numbers are PROVISIONAL_PENDING_MEASUREMENT and are chosen at
# the same moment the engine's literals are frozen, exactly as A4.11 does. While the state below says
# PROVISIONAL_PENDING_MEASUREMENT the evaluator CANNOT return ACCEPT, whatever the data says — an
# acceptance measured against numbers nobody has committed to is not an acceptance.
OE_CAL_THRESHOLDS_STATE=PROVISIONAL_PENDING_MEASUREMENT
OE_CAL_RESULT_LCB_FLOOR=UNFROZEN
OE_CAL_HIT_RATE_LCB_FLOOR=UNFROZEN
OE_CAL_MEDIAN_MAE_CEIL=UNFROZEN
OE_CAL_P90_MAE_CEIL=UNFROZEN
OE_CAL_COVERAGE_FLOOR=UNFROZEN
OE_CAL_ATTRITION_CEIL=UNFROZEN
