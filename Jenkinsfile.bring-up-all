// =============================================================================
// Jenkinsfile.bring-up-all  —  one job to deploy the whole OptionsEdge platform.
//
// Triggers every component's existing Jenkins job in dependency order, for a
// chosen environment (dev | prod). Sequential where there is a dependency,
// parallel where the jobs are independent.
//
//   build job: '<child>', parameters: [string(name:'PROFILE', value: PROFILE)],
//             wait: true, propagate: true
//
// Children consume the canonical ENVIRONMENT contract from @Library('oe') oeProfile
// (values: 'dev' | 'staging' | 'production'). This file's PROFILE param stays
// 'dev'/'prod' for operator UI back-compat and is mapped to canonical ENVIRONMENT
// internally (see env block). The web job (options-edge-web-deploy) still takes
// the legacy PROFILE input — kept as-is until it migrates.
// =============================================================================
@Library('oe') _

pipeline {
  agent { label 'local-mac' }

  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  parameters {
    choice(name: 'PROFILE', choices: ['dev', 'prod'],
           description: 'Environment to bring up (passed to every child job).')
    booleanParam(name: 'FEEDS',  defaultValue: true,  description: 'Include the Databento/IBKR market feeds.')
    booleanParam(name: 'WEB_UI', defaultValue: true,  description: 'Include the web UI (options-edge-web-deploy).')
    booleanParam(name: 'CONTINUE_ON_FAILURE', defaultValue: false,
                 description: 'If true, keep going when a child job fails (otherwise abort the bring-up).')
  }

  environment {
    // The umbrella derives the dev/prod knobs once from PROFILE and passes each child
    // the parameters IT actually declares (children do NOT share a single PROFILE param):
    //   - web (options-edge):            PROFILE, BUILD_PLATFORM, PUSH_IMAGE, RUN_LOCAL, IMAGE
    //   - processing/ibkr/feed-gateway:  ENVIRONMENT, BUILD_PLATFORM, PUSH_IMAGE(S), IMAGE_REGISTRY
    //   - databento-feed:                ENVIRONMENT, IMAGE_REGISTRY, PUSH_IMAGE
    //
    // Non-env-derived knobs (operator behavior):
    PUSH_IMAGE     = "${params.PROFILE == 'prod' ? 'true' : 'false'}"
    RUN_LOCAL      = "${params.PROFILE == 'prod' ? 'false' : 'true'}"
    IS_PROD        = "${params.PROFILE == 'prod' ? 'true' : 'false'}"
    // Canonical ENVIRONMENT for child jobs (every child now uses @Library('oe') oeProfile
    // which accepts ONLY ['dev','staging','production']). UI param PROFILE stays 'dev'/'prod'
    // for operator back-compat; we map 'prod' -> 'production' for the canonical value.
    ENVIRONMENT    = "${params.PROFILE == 'prod' ? 'production' : params.PROFILE}"
    // BUILD_PLATFORM, IMAGE_REGISTRY and WEB_IMAGE are all derived from oeProfile in the
    // 'Resolve profile' stage below (single source of truth — no hardcoded registries/arches
    // in this umbrella). Children that don't yet require ENVIRONMENT still accept these as
    // explicit overrides, so the contract is unchanged.
  }

  // PREREQUISITE (not a stage): Keycloak + Postgres are a ONE-TIME setup, run as standalone
  // Docker containers (oe-keycloak-dev, oe-keycloak-postgres). They stay up across deploys, so
  // this pipeline does NOT manage them — it assumes they are already running before a bring-up.

  stages {
    stage('Resolve profile') {
      steps {
        script {
          // Derive registry + platform + web image from the single source of truth
          // (oeProfile / deploy-profiles.yaml). oeProfile() fails loudly on an unknown env.
          def p = oeProfile(env.ENVIRONMENT)
          env.IMAGE_REGISTRY = p.registry
          env.BUILD_PLATFORM = p.platform
          env.WEB_IMAGE      = oeProfile.image('web', env.ENVIRONMENT, params.PROFILE == 'prod' ? 'prod' : 'dev')
          echo "umbrella resolved (env=${env.ENVIRONMENT}): registry=${env.IMAGE_REGISTRY} platform=${env.BUILD_PLATFORM} web=${env.WEB_IMAGE}"
        }
      }
    }

    // 1) Build every service image and push it to the registry (independent -> parallel).
    //    These jobs only build/push; the single Deploy stage below applies ALL the k8s manifests.
    stage('Build images') {
      parallel {
        stage('Processing / streams') {
          steps {
            build job: 'options-edge-processing',
                  parameters: [string(name: 'BUILD_PLATFORM', value: env.BUILD_PLATFORM), string(name: 'IMAGE_REGISTRY', value: env.IMAGE_REGISTRY), booleanParam(name: 'PUSH_IMAGES', value: env.PUSH_IMAGE == 'true')],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
        stage('Databento feed') {
          when { expression { params.FEEDS } }
          steps {
            build job: 'options-edge-databento-feed-deploy',  // build+push only (Deploy stage was removed; options-edge-deploy is the sole deployer)
                  parameters: [string(name: 'ENVIRONMENT', value: env.ENVIRONMENT), string(name: 'IMAGE_REGISTRY', value: env.IMAGE_REGISTRY), booleanParam(name: 'PUSH_IMAGE', value: env.PUSH_IMAGE == 'true')],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
        stage('IBKR feed') {
          when { expression { params.FEEDS } }
          steps {
            build job: 'options-edge-ibkr-feed',
                  parameters: [string(name: 'BUILD_PLATFORM', value: env.BUILD_PLATFORM), string(name: 'IMAGE_REGISTRY', value: env.IMAGE_REGISTRY), booleanParam(name: 'PUSH_IMAGE', value: env.PUSH_IMAGE == 'true')],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
        stage('Feed-gateway') {
          steps {
            build job: 'option-edge-feed-gateway',
                  parameters: [string(name: 'BUILD_PLATFORM', value: env.BUILD_PLATFORM), string(name: 'IMAGE_REGISTRY', value: env.IMAGE_REGISTRY), booleanParam(name: 'PUSH_IMAGE', value: env.PUSH_IMAGE == 'true')],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
      }
    }

    // 2) ONE deploy applies the ENTIRE options-edge namespace (feeds + all stream apps) via
    //    `kubectl kustomize k8s/overlays/<env> | kubectl apply`. Images above must already be pushed.
    stage('Deploy to Kubernetes') {
      steps {
        build job: 'options-edge-deploy',
              parameters: [string(name: 'ENVIRONMENT', value: env.ENVIRONMENT)],
              wait: true, propagate: !params.CONTINUE_ON_FAILURE
      }
    }

    stage('Web UI') {                          // needs auth + backend up
      when { expression { params.WEB_UI } }
      steps {
        build job: 'options-edge-web-deploy',            // confirmed (params: see options-edge#45)
              parameters: [
                string(name: 'PROFILE',        value: params.PROFILE),
                string(name: 'BUILD_PLATFORM', value: env.BUILD_PLATFORM),
                booleanParam(name: 'PUSH_IMAGE', value: env.PUSH_IMAGE == 'true'),
                booleanParam(name: 'RUN_LOCAL',  value: env.RUN_LOCAL == 'true'),
                string(name: 'IMAGE',          value: env.WEB_IMAGE)
                // prod also needs the prod URLs/issuer overridden (VITE_AUTH_ISSUER, VITE_API_BASE_URL, …)
                // once those endpoints are defined — see options-edge#45 parameter list.
              ],
              wait: true, propagate: !params.CONTINUE_ON_FAILURE
      }
    }
    // NOTE: hpsf-historical-replay is intentionally NOT part of this bring-up (run it on its own).
  }

  post {
    success { echo "OptionsEdge platform bring-up complete (PROFILE=${params.PROFILE})." }
    failure { echo "Bring-up failed (PROFILE=${params.PROFILE}) — see the failed downstream stage above." }
  }
}
