// =============================================================================
// Jenkinsfile.bring-up-all  —  one job to deploy the whole OptionsEdge platform.
//
// Triggers every component's existing Jenkins job in dependency order, for a
// chosen environment (dev | prod). Sequential where there is a dependency,
// parallel where the jobs are independent.
//
//   build job: '<child>', parameters: [string(name:'PROFILE', value: PROFILE)],
//             wait: true, propagate: true
//
// Children consume the canonical ENVIRONMENT contract from @Library('oe') oeProfile
// (values: 'dev' | 'production'). This file's PROFILE param stays
// 'dev'/'prod' for operator UI back-compat and is mapped to canonical ENVIRONMENT
// internally (see env block). The web job (options-edge-web-deploy) still takes
// the legacy PROFILE input — kept as-is until it migrates.
// =============================================================================
@Library('oe') _

pipeline {
  agent { label 'local-mac' }

  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  parameters {
    choice(name: 'PROFILE', choices: ['dev', 'prod'],
           description: 'Environment to bring up (passed to every child job).')
    booleanParam(name: 'FEEDS',  defaultValue: true,  description: 'Include the Databento/IBKR market feeds.')
    booleanParam(name: 'WEB_UI', defaultValue: true,  description: 'Include the web UI (options-edge-web-deploy).')
    booleanParam(name: 'CONTINUE_ON_FAILURE', defaultValue: false,
                 description: 'If true, keep going when a child job fails (otherwise abort the bring-up).')
  }

  environment {
    // The umbrella derives the dev/prod knobs once from PROFILE and passes each child
    // the parameters IT actually declares (children do NOT share a single PROFILE param):
    //   - web (options-edge):            PROFILE, BUILD_PLATFORM, PUSH_IMAGE, RUN_LOCAL, IMAGE
    //   - processing/ibkr/feed-gateway:  ENVIRONMENT, BUILD_PLATFORM, PUSH_IMAGE(S), IMAGE_REGISTRY
    //   - databento-feed:                ENVIRONMENT, IMAGE_REGISTRY, PUSH_IMAGE
    //
    // Non-env-derived knobs (operator behavior):
    PUSH_IMAGE     = "${params.PROFILE == 'prod' ? 'true' : 'false'}"
    // RUN_LOCAL is OFF for every profile now. Dev used to docker-run the web image on the
    // Mac agent at :8090 (legacy local-run); the web UI runs in k8s in both envs now
    // (LoadBalancer Service options-edge-web :8094) so the local-run path is no longer
    // wanted. Operators who need a one-off local-run can still pass RUN_LOCAL=true
    // directly to options-edge-web-deploy.
    RUN_LOCAL      = "false"
    IS_PROD        = "${params.PROFILE == 'prod' ? 'true' : 'false'}"
    // Canonical ENVIRONMENT for child jobs (every child now uses @Library('oe') oeProfile
    // which accepts ONLY ['dev','production']). UI param PROFILE stays 'dev'/'prod'
    // for operator back-compat; we map 'prod' -> 'production' for the canonical value.
    ENVIRONMENT    = "${params.PROFILE == 'prod' ? 'production' : params.PROFILE}"
    // BUILD_PLATFORM, IMAGE_REGISTRY and WEB_IMAGE are all derived from oeProfile in the
    // 'Resolve profile' stage below (single source of truth — no hardcoded registries/arches
    // in this umbrella). Children that don't yet require ENVIRONMENT still accept these as
    // explicit overrides, so the contract is unchanged.
    //
    // Per-env web URLs baked into the web image at build time. THIS IS CRITICAL: the web
    // serves /api/config.feedGatewayWsUrl from the build-time VITE_WS_URL/APP_FEED_GATEWAY_WS_URL,
    // so building with the wrong gateway URL (the old job default ws://…:8093, the dead host
    // gateway) makes the browser connect to a gateway that serves no chain. Bake the correct
    // per-env values: dev -> the k8s gateway LB on :8091; prod -> the public wss edge.
    WEB_WS_URL      = "${params.PROFILE == 'prod' ? 'wss://fullfunding.nl/ws/events' : 'ws://localhost:8091/ws/events'}"
    WEB_API_BASE    = "${params.PROFILE == 'prod' ? 'https://fullfunding.nl' : 'http://localhost:8090'}"
    WEB_AUTH_ISSUER = "${params.PROFILE == 'prod' ? 'https://auth.fullfunding.nl/realms/optionsedge' : 'http://192.168.100.102:8089/realms/optionsedge'}"
    WEB_REPLAY_URL  = "${params.PROFILE == 'prod' ? 'https://fullfunding.nl' : 'http://localhost:8095'}"
    REMOTE_BUILD_HOST = "192.168.100.252"
    REMOTE_BUILD_ROOT = "/home/abhinav/ci/remote-builds"
  }

  // PREREQUISITE (not a stage): Keycloak + Postgres are a ONE-TIME setup, run as standalone
  // Docker containers (oe-keycloak-dev, oe-keycloak-postgres). They stay up across deploys, so
  // this pipeline does NOT manage them — it assumes they are already running before a bring-up.

  stages {
    stage('Resolve profile') {
      steps {
        script {
          // Derive registry + platform + web image from the single source of truth
          // (oeProfile / deploy-profiles.yaml). oeProfile() fails loudly on an unknown env.
          def p = oeProfile(env.ENVIRONMENT)
          env.IMAGE_REGISTRY = p.registry
          env.BUILD_PLATFORM = p.platform
          env.WEB_IMAGE      = oeProfile.image('web', env.ENVIRONMENT, params.PROFILE == 'prod' ? 'prod' : 'dev')
          echo "umbrella resolved (env=${env.ENVIRONMENT}): registry=${env.IMAGE_REGISTRY} platform=${env.BUILD_PLATFORM} web=${env.WEB_IMAGE}"
        }
      }
    }

    // 1) Build every service image and push it to the registry (independent -> parallel).
    //    These jobs only build/push; the single Deploy stage below applies ALL the k8s manifests.
    stage('Build images') {
      parallel {
        stage('Processing / streams') {
          steps {
            build job: 'options-edge-processing',
                  parameters: [string(name: 'ENVIRONMENT', value: env.ENVIRONMENT), string(name: 'BUILD_PLATFORM', value: env.BUILD_PLATFORM), string(name: 'IMAGE_REGISTRY', value: env.IMAGE_REGISTRY), booleanParam(name: 'PUSH_IMAGES', value: env.PUSH_IMAGE == 'true'), string(name: 'REMOTE_BUILD_HOST', value: env.REMOTE_BUILD_HOST), string(name: 'REMOTE_BUILD_ROOT', value: env.REMOTE_BUILD_ROOT)],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
        stage('Databento feed') {
          when { expression { params.FEEDS } }
          steps {
            build job: 'options-edge-databento-feed-deploy',  // build+push only (Deploy stage was removed; options-edge-deploy is the sole deployer)
                  parameters: [string(name: 'ENVIRONMENT', value: env.ENVIRONMENT), string(name: 'IMAGE_REGISTRY', value: env.IMAGE_REGISTRY), booleanParam(name: 'PUSH_IMAGE', value: env.PUSH_IMAGE == 'true'), string(name: 'REMOTE_BUILD_HOST', value: env.REMOTE_BUILD_HOST), string(name: 'REMOTE_BUILD_ROOT', value: env.REMOTE_BUILD_ROOT)],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
        stage('IBKR feed') {
          when { expression { params.FEEDS } }
          steps {
            build job: 'options-edge-ibkr-feed',
                  parameters: [string(name: 'ENVIRONMENT', value: env.ENVIRONMENT), string(name: 'BUILD_PLATFORM', value: env.BUILD_PLATFORM), string(name: 'IMAGE_REGISTRY', value: env.IMAGE_REGISTRY), booleanParam(name: 'PUSH_IMAGE', value: env.PUSH_IMAGE == 'true'), string(name: 'REMOTE_BUILD_HOST', value: env.REMOTE_BUILD_HOST), string(name: 'REMOTE_BUILD_ROOT', value: env.REMOTE_BUILD_ROOT)],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
        stage('Feed-gateway') {
          steps {
            build job: 'option-edge-feed-gateway',
                  parameters: [string(name: 'ENVIRONMENT', value: env.ENVIRONMENT), string(name: 'BUILD_PLATFORM', value: env.BUILD_PLATFORM), string(name: 'IMAGE_REGISTRY', value: env.IMAGE_REGISTRY), booleanParam(name: 'PUSH_IMAGE', value: env.PUSH_IMAGE == 'true'), string(name: 'REMOTE_BUILD_HOST', value: env.REMOTE_BUILD_HOST), string(name: 'REMOTE_BUILD_ROOT', value: env.REMOTE_BUILD_ROOT)],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
        // Web image is built HERE (in the build phase, BEFORE Deploy) with the correct per-env
        // gateway/auth URLs baked in, so the single Deploy stage below rolls the FRESH web image.
        // Previously the web was a stage AFTER Deploy, so every run deployed the PRIOR run's web
        // image and silently fell behind main — the root cause of the dev/prod drift.
        stage('Web') {
          when { expression { params.WEB_UI } }
          steps {
            build job: 'options-edge-web-deploy',
                  parameters: [
                    string(name: 'PROFILE',                      value: params.PROFILE),
                    string(name: 'BUILD_PLATFORM',               value: env.BUILD_PLATFORM),
                    booleanParam(name: 'PUSH_IMAGE',             value: env.PUSH_IMAGE == 'true'),
                    booleanParam(name: 'RUN_LOCAL',              value: env.RUN_LOCAL == 'true'),
                    // Push to the mutable :dev tag the deploy resolves (resolve-images.sh ->
                    // <registry>/options-edge-web:dev for BOTH envs), so the Deploy stage rolls
                    // THIS freshly-built image. env.WEB_IMAGE may carry a :prod tag the deploy
                    // never reads, which would silently deploy a stale web (Codex HIGH).
                    string(name: 'IMAGE',                        value: "${env.IMAGE_REGISTRY}/options-edge-web:dev"),
                    string(name: 'VITE_WS_URL',                  value: env.WEB_WS_URL),
                    string(name: 'APP_FEED_GATEWAY_WS_URL',      value: env.WEB_WS_URL),
                    string(name: 'VITE_API_BASE_URL',            value: env.WEB_API_BASE),
                    string(name: 'VITE_MISSION_CONTROL_URL',     value: env.WEB_API_BASE),
                    string(name: 'VITE_AUTH_ISSUER',             value: env.WEB_AUTH_ISSUER),
                    string(name: 'VITE_REPLAY_ORCHESTRATOR_URL', value: env.WEB_REPLAY_URL),
                    string(name: 'REMOTE_BUILD_HOST',            value: env.REMOTE_BUILD_HOST),
                    string(name: 'REMOTE_BUILD_ROOT',            value: env.REMOTE_BUILD_ROOT),
                    // Build-only here: the deploy + UI verification happen in the Deploy stage
                    // (and the prod promote). The web job's post-deploy Selenium smoke targets a
                    // separately-deployed UI, so it would red-fail this build — skip it.
                    booleanParam(name: 'SKIP_SELENIUM_SMOKE', value: true)
                  ],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
      }
    }

    // 2) ONE deploy applies the ENTIRE options-edge namespace (feeds + all stream apps + the web
    //    image built above) via `kubectl kustomize k8s/overlays/<env> | kubectl apply`.
    //    dev  -> deploy to dev, no promote gate (SKIP_PRODUCTION_PROMOTION=true).
    //    prod -> the dev-first gate REJECTS a direct ENVIRONMENT=production deploy, so we run the
    //            SAME dev deploy + smoke, then AUTO_PROMOTE auto-approves the Promote stage, which
    //            launches the real prod deploy. With AUTO_PROMOTE the prod build is waited-on and
    //            its failure propagates, so a prod failure fails this bring-up (the "nothing fails"
    //            contract holds end-to-end).
    stage('Deploy to Kubernetes') {
      steps {
        script {
          if (params.PROFILE == 'prod') {
            build job: 'options-edge-deploy',
                  parameters: [
                    string(name: 'ENVIRONMENT', value: 'dev'),
                    booleanParam(name: 'SKIP_PRODUCTION_PROMOTION', value: false),
                    booleanParam(name: 'AUTO_PROMOTE', value: true)
                  ],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          } else {
            build job: 'options-edge-deploy',
                  parameters: [
                    string(name: 'ENVIRONMENT', value: 'dev'),
                    booleanParam(name: 'SKIP_PRODUCTION_PROMOTION', value: true)
                  ],
                  wait: true, propagate: !params.CONTINUE_ON_FAILURE
          }
        }
      }
    }
    // NOTE: hpsf-historical-replay is intentionally NOT part of this bring-up (run it on its own).
  }

  post {
    success { echo "OptionsEdge platform bring-up complete (PROFILE=${params.PROFILE})." }
    failure { echo "Bring-up failed (PROFILE=${params.PROFILE}) — see the failed downstream stage above." }
  }
}
