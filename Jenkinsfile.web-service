@Library('oe') _

// STANDALONE WEB DEPLOY — the per-service fast path (standalone-service-deployment
// design §3.2, pilot service). Ships a web change to ONE environment WITHOUT the
// monolithic all-services build/deploy:
//
//   Build (native, on the target arch's machine)  →  Deploy ONLY the web workload
//   →  rollout  →  health gate  →  rollback instructions.
//
// * Build reuses the existing options-edge-web-deploy job with the exact same
//   per-env contract the bring-up-all umbrella uses (native: dev builds on the Mac
//   arm64, prod builds on .252 amd64 via ssh — §2.3 native two-arch rule).
// * Deploy applies ONLY k8s/services/web/overlays/<env> (Deployment+Service), digest-
//   pinned; the blast-radius guard in scripts/deploy/service-deploy.sh refuses any
//   infra kind (§13.5). Common infra must already be in place (Jenkinsfile.common-infra).
// * Rollback never rebuilds: the job log prints the previously-running digest and the
//   exact re-point command (§13.2).
// The validate stage is pure local rendering and the expensive part (44+ min on the loaded
// dev Mac during market hours vs 2-4 min idle) — it runs on the .74 builders; everything
// that needs the deploy host stays pinned there. `agent none` so a fallback resolution can
// never hold two executors at once.
VALIDATE_AGENT_LABEL = oeBuildAgent.labels('build-mac-74', 'hpsf-replay-mac')

pipeline {
  agent none
  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before any effect unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`. NOTE: this binds the manifests and scripts deployed from this repository; the web IMAGE is built by options-edge-web-deploy (repo options-edge), which carries no guard yet — see the Build stage.')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'production', 'experiment'],
      description: 'Target environment — selects k8s/services/web/overlays/<env> and the deployer kubeconfig (oeProfile).')
    booleanParam(name: 'BUILD_IMAGE', defaultValue: false,
      description: 'Build+push the web image first (options-edge-web-deploy, native on the target machine) — needs WEB_PERMITTED_SHA, and is REFUSED until that job\'s live definition enforces PERMITTED_SHA (Deployment Permission Rule). false (DEFAULT) = deploy the image already in the registry.')
    string(name: 'WEB_PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED when BUILD_IMAGE=true — Deployment Permission Rule. The full 40-character commit id of options-edge (the web application) permitted for the image build this job triggers. Forwarded to options-edge-web-deploy as its PERMITTED_SHA, where ITS guard refuses unless its checkout is exactly this commit on main. This job refuses the build path outright while that job does not yet declare PERMITTED_SHA.')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: false,
      description: 'true = render + digest-pin + server-side validate only; nothing changes.')
    string(name: 'HEALTH_URL', defaultValue: '',
      description: 'Optional post-rollout endpoint that must answer 200. Empty = per-env default (dev http://localhost:8090/, production http://192.168.100.252:8094/, experiment skip).')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
  }
  options {
    disableRestartFromStage()   // Deployment Permission Rule: no "Restart from Stage" past the permitted-commit guard
    // §13.6 deploy locking: one web deploy at a time (covers all envs of this job —
    // conservative, plugin-free serialisation).
    disableConcurrentBuilds()
    // 120 min, not 45: during US market hours the agent Mac runs the dev k8s stack plus live
    // trading apps (load avg 60+), and the validate-services.sh stage alone has been measured
    // at 44+ min (builds #405/#406, 2026-08-06) vs its ~2-4 min idle baseline. 45 min made
    // market-hours deploys abort mid-chain; the lock above still serialises runs.
    timeout(time: 120, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG  = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    ENVIRONMENT = "${params.ENVIRONMENT}"
    // Per-env web URL matrix (kept in sync with Jenkinsfile.bring-up-all). NOTE: these are
    // BUILD-time image defaults/documentation only — the deployed truth is the k8s runtime env
    // (RuntimeProfileConfig injects pod env into the served page), so a URL flip needs a manifest
    // change + rollout, not a rebuild.
    IS_PROD         = "${params.ENVIRONMENT == 'production' ? 'true' : 'false'}"
    // Same PROFILE contract as Jenkinsfile.bring-up-all: production -> 'prod',
    // dev -> 'dev', experiment -> 'experiment' (the web job branches on it).
    WEB_PROFILE     = "${params.ENVIRONMENT == 'production' ? 'prod' : params.ENVIRONMENT}"
    WEB_WS_URL      = "${params.ENVIRONMENT == 'production' ? 'wss://bleadingoptions.com/ws/events' : 'ws://localhost:8091/ws/events'}"
    WEB_API_BASE    = "${params.ENVIRONMENT == 'production' ? 'https://bleadingoptions.com' : 'http://localhost:8090'}"
    WEB_AUTH_ISSUER = "${params.ENVIRONMENT == 'production' ? 'https://auth.bleadingoptions.com/realms/optionsedge' : 'http://192.168.100.102:8089/realms/optionsedge'}"
    WEB_REPLAY_URL  = "${params.ENVIRONMENT == 'production' ? 'https://bleadingoptions.com' : 'http://localhost:8095'}"
    REMOTE_BUILD_HOST = "${params.ENVIRONMENT == 'experiment' ? '192.168.100.2' : '192.168.100.252'}"
    REMOTE_BUILD_ROOT = "${params.ENVIRONMENT == 'experiment' ? '/Users/rajuljain/ci/remote-builds' : '/home/abhinav/ci/remote-builds'}"
    HEALTH_URL_DEFAULT = "${params.ENVIRONMENT == 'production' ? 'http://192.168.100.252:8094/' : (params.ENVIRONMENT == 'dev' ? 'http://localhost:8090/' : '')}"
    // Passed to the sh step as REAL environment variables (never interpolated into the
    // shell script text — a param containing $/`/quotes must not alter the script).
    HEALTH_URL_PARAM     = "${params.HEALTH_URL ?: ''}"
    DEPLOY_DRY_RUN_PARAM = "${params.DEPLOY_DRY_RUN}"
  }
  stages {
    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    // PERMITTED_SHA is REQUIRED. scripts/jenkins/permitted-sha-guard.sh refuses, in this order: a checkout
    // that is not on origin/main (the environment-branch restriction, kept as its own condition); a
    // missing, empty, short or otherwise malformed PERMITTED_SHA (nothing is substituted for it); a
    // checked-out HEAD that is not exactly PERMITTED_SHA. FIRST, on the deploy host, before the long
    // validate stage — a refused build costs seconds, not an hour. error(), never catchError.
    stage('Permitted commit guard') {
      agent { label 'hpsf-replay-mac' }
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }
    stage('Validate service registry') {
      // Own agent = own fresh `checkout scm` of the same build revision; pure gate,
      // nothing later stages consume.
      agent { label VALIDATE_AGENT_LABEL }
      steps {
        sh '''
          set -euo pipefail
          bash scripts/ci/validate-services.sh
        '''
      }
    }
    // Everything below needs the deploy host (kubeconfigs, kubectl, the chained build's
    // digest-pin flow) — one agent, one workspace. Bodies unchanged.
    stage('Deploy path') {
      agent { label 'hpsf-replay-mac' }
      stages {
    stage('Permitted commit guard (deploy workspace)') {
      // Re-established HERE, in the workspace the deploy stages read manifests and scripts from.
      // The first guard ran on its own agent allocation; a checkout is bound across allocations
      // only by Jenkins's revision pinning, so the same guard runs again right before the first
      // effect. No checkout happens after this point: what it permits is what deploys.
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard (deploy workspace) REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          // Its OWN flag, set nowhere else (see Jenkinsfile.service-deploy for why the first guard's
          // flag must not stand in for it on post/recovery paths).
          env.DEPLOY_WORKSPACE_PERMITTED = 'PASSED'
        }
      }
    }
    stage('Resolve profile') {
      steps {
        script {
          def p = oeProfile(params.ENVIRONMENT)
          env.IMAGE_REGISTRY = p.registry
          env.BUILD_PLATFORM = p.platform
          echo "web-service resolved (env=${params.ENVIRONMENT}): registry=${env.IMAGE_REGISTRY} platform=${env.BUILD_PLATFORM}"
        }
      }
    }
    stage('Build web image (native)') {
      when { expression { params.BUILD_IMAGE && !params.DEPLOY_DRY_RUN } }
      steps {
        // Same contract as the bring-up-all Web stage: native build on the target
        // machine, push to the env registry's mutable :dev tag; the Deploy stage
        // below digest-pins whatever that tag resolves to (immutable in the pod spec).
        //
        // Downstream deployment trigger (Deployment Permission Rule): the web image is built from
        // ANOTHER repository (options-edge), so it needs that repository's permitted commit, and it
        // is FAIL-CLOSED: options-edge-web-deploy is triggered only if its live definition declares
        // PERMITTED_SHA (options-edge PR feat/jenkins-permitted-sha-guard adds its guard; until that
        // has merged and run once, this path refuses and nothing is triggered). Forwarding alone
        // would bind nothing — Jenkins drops a parameter the child does not declare.
        script {
          def wsha = (params.WEB_PERMITTED_SHA ?: '').trim()
          if (!wsha.matches('^[0-9a-f]{40}$')) {
            error("BUILD_IMAGE=true needs WEB_PERMITTED_SHA: the full 40-character options-edge commit permitted for this web image build (got '${wsha}'). Nothing was triggered.")
          }
          def compat = sh(returnStatus: true, script: 'bash scripts/jenkins/require-guarded-downstream.sh options-edge-web-deploy')
          if (compat != 0) {
            error("options-edge-web-deploy does not enforce PERMITTED_SHA yet (rc=${compat}) — not triggering an unguarded image build. Build the image under that job's own permission once it carries the guard, or deploy an existing image with BUILD_IMAGE=false. Nothing was triggered.")
          }
        }
        build job: 'options-edge-web-deploy',
              parameters: [
                // options-edge-web-deploy's own guard compares its checkout against this before it builds.
                string(name: 'PERMITTED_SHA',                value: params.WEB_PERMITTED_SHA.trim()),
                string(name: 'PROFILE',                      value: env.WEB_PROFILE),
                string(name: 'BUILD_PLATFORM',               value: env.BUILD_PLATFORM),
                booleanParam(name: 'PUSH_IMAGE',             value: true),
                booleanParam(name: 'RUN_LOCAL',              value: false),
                string(name: 'IMAGE',                        value: "${env.IMAGE_REGISTRY}/options-edge-web:${params.ENVIRONMENT == 'production' ? 'prod' : 'dev'}"),
                string(name: 'VITE_WS_URL',                  value: env.WEB_WS_URL),
                string(name: 'APP_FEED_GATEWAY_WS_URL',      value: env.WEB_WS_URL),
                string(name: 'VITE_API_BASE_URL',            value: env.WEB_API_BASE),
                string(name: 'VITE_MISSION_CONTROL_URL',     value: env.WEB_API_BASE),
                string(name: 'VITE_AUTH_ISSUER',             value: env.WEB_AUTH_ISSUER),
                string(name: 'VITE_REPLAY_ORCHESTRATOR_URL', value: env.WEB_REPLAY_URL),
                string(name: 'REMOTE_BUILD_HOST',            value: env.REMOTE_BUILD_HOST),
                string(name: 'REMOTE_BUILD_ROOT',            value: env.REMOTE_BUILD_ROOT),
                booleanParam(name: 'SKIP_SELENIUM_SMOKE',    value: true),
                // We ARE the rollout — the Deploy stage below pins + rolls + verifies. Suppress the
                // build job's own dev auto-deploy (its DEPLOY_AND_VERIFY defaults true) so a
                // BUILD_IMAGE=true button press does not trigger a SECOND, nested web-service-deploy.
                booleanParam(name: 'DEPLOY_AND_VERIFY',      value: false)
              ],
              wait: true, propagate: true
      }
    }
    stage('Deploy (service-scoped)') {
      steps {
        sh '''
          set -euo pipefail
          export SERVICE=web
          # Jenkins DROPS environment{} entries whose value is the empty string, so any
          # of these can be entirely unset here — default them under set -u.
          export DEPLOY_DRY_RUN="${DEPLOY_DRY_RUN_PARAM:-false}"
          HEALTH_URL="${HEALTH_URL_PARAM:-}"
          [ -n "$HEALTH_URL" ] || HEALTH_URL="${HEALTH_URL_DEFAULT:-}"
          export HEALTH_URL
          WORK_DIR="$WORKSPACE/.jenkins-tmp" bash scripts/deploy/service-deploy.sh
        '''
      }
    }
      }
      post {
        always {
          archiveArtifacts artifacts: '.jenkins-tmp/web-*.yaml', allowEmptyArchive: true
        }
      }
    }
  }
}
