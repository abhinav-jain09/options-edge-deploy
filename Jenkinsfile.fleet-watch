@Library('oe') _

// Fleet watch (docs/schema-governance R16, R18(b)). READ-ONLY. Every 15 minutes:
//   1. READINESS: any Deployment or StatefulSet that WANTS replicas but has had fewer available for more than 30 minutes (scripts/watch/fleet-readiness.py).
//      Workloads held at 0 replicas are never reported. This is the check that would have caught the 9-hour early-auction crash-loop.
//   2. DEAD LETTERS: any `*.dlq` topic whose end offsets grew since the previous run (scripts/watch/dlq-growth.py; baseline kept per environment under
//      $HOME/.oe-watch on the agent, written only after a fully successful read).
// A red build is the alert: native k8s CronJobs are denied by the cluster's admission policy and no Kafka or registry exporter is scraped, so a Jenkins
// cron job is the trigger that can run. It changes nothing in any cluster, registry or topic.
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    string(name: 'ENVS', defaultValue: 'production dev', description: 'Space-separated profiles to watch (production, dev).')
    string(name: 'STUCK_MINUTES', defaultValue: '30', description: 'A wanted-but-unavailable workload is reported after this many minutes.')
  }
  triggers {
    cron('*/15 * * * *')
  }
  options {
    disableConcurrentBuilds()
    timeout(time: 10, unit: 'MINUTES')
  }
  stages {
    stage('Readiness') {
      steps {
        script {
          def bad = []
          params.ENVS.trim().split(/\s+/).each { profile ->
            if (!(profile in ['production', 'dev'])) { error("unknown profile '${profile}' (production or dev)") }
            def kc = oeProfile(profile).kubeconfigDeployer
            def rc = sh(returnStatus: true, script: """
              set -uo pipefail
              out="\$(mktemp)"
              KUBECONFIG='${kc}' kubectl -n options-edge get deploy,statefulset -o json > "\$out" || { echo 'ERROR: kubectl get failed for ${profile}'; exit 2; }
              echo '=== ${profile} ==='
              python3 scripts/watch/fleet-readiness.py --input "\$out" --minutes "\$STUCK_MINUTES"
            """)
            if (rc != 0) { bad << "${profile} (rc=${rc})" }
          }
          if (bad) { error("readiness check failed: ${bad.join(', ')}") }
        }
      }
    }
    stage('Dead letters') {
      steps {
        script {
          def bad = []
          params.ENVS.trim().split(/\s+/).each { profile ->
            def envName = profile == 'production' ? 'prod' : profile
            def rc = sh(returnStatus: true, script: "mkdir -p \"\$HOME/.oe-watch\" && python3 scripts/watch/dlq-growth.py --env ${envName} --state \"\$HOME/.oe-watch\"")
            if (rc != 0) { bad << "${envName} (rc=${rc})" }
          }
          if (bad) { error("dead-letter check failed: ${bad.join(', ')}") }
        }
      }
    }
  }
}
