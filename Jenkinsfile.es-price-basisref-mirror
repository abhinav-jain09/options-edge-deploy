// ES-PRICE BASIS-REFERENCE MIRROR — decode-and-re-encode mirror dev underlying.es.price -> es4 es.underlying.es.price.basis-reference,
// as a managed launchd service. It REPLACES the hand-written text bridge com.optionsedge.es-price-basisref-bridge-192-168-100-4-9092
// (a kafka-console-consumer | kafka-console-producer pipe on the dev Mac, written 2026-10-27 as an emergency failover while production was
// down), which cannot carry Avro: the payload is binary and a schema id is PER REGISTRY, so a byte or text copy is undecodable on es4.
//
// Why it exists: the es4 es-feed has no SPX leg, so it stamps the spxBasis* fields it reads off a basis-reference topic onto its own ES
// publishes (DBP-R32). With production down that reference is the dev feed's enriched underlying.es.price (dev ES_PRICE_ENABLED=true).
// Both topics are Confluent Avro of com.optionsedge.contracts.hpsf.EsUnderlyingPrice (docs/ES-UNDERLYING-PRICE-AVRO-CUTOVER.md).
//
// What it does (scripts/kafka/es-price-mirror/EsPriceAvroMirror.java, one JVM, Confluent 7.3.1 jars): consume the source topic in a DURABLE
// group, decode each value with the SOURCE (dev) registry, serialize it again with the TARGET (es4) registry under the SAME subject
// (RecordNameStrategy; the target must already carry the subject, the mirror never registers), and produce it with the same key bytes,
// headers and source timestamp. Offsets are committed only after the producer flushed. JSON, non-Avro bytes or a foreign record STOP the
// mirror; there is no skip and no fallback. It runs on the 'local-mac' agent, which reaches the dev broker/registry (127.0.0.1:19092 and
// :8082, the published listener) and es4 (192.168.100.4) over the LAN. Nothing is hand-edited: the config and the launchd unit are generated.
// MIRROR-TRANSPORT: reencode
// MIRROR-TOPICS: underlying.es.price, es.underlying.es.price.basis-reference
// MIRROR-INSTALL: reencodes
// MIRROR-SUBJECTS: com.optionsedge.contracts.hpsf.EsUnderlyingPrice
// MIRROR-DIRECTION: default->es4
// MIRROR-PATHS: dev->es4
// (schema-governance R3f, read by scripts/ci/schema-mirrors-generate.py. Decodes with the dev registry and re-encodes with es4's (EsPriceAvroMirror).)
pipeline {
  agent { label 'local-mac' }
  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before any effect unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`.')
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: '2f6fc2ab7aa51eb8a9e8aa350f2d774cd2fb7a253de2591e43645a19a9886b24',
      description: 'DO NOT EDIT BY HAND — the sha256 of scripts/jenkins/permitted-sha-guard.sh this definition runs (Deployment Permission Rule). The guard refuses to run under any other value. It is a DECLARATION, not proof that this job enforces the guard: a caller that triggers this job judges its SCM definition and its Jenkinsfile at the forwarded commit (scripts/jenkins/require-guarded-downstream.sh). Regenerate with scripts/jenkins/permitted-sha-guard-version.sh when the guard changes.')
    choice(name: 'ACTION', choices: ['install', 'teardown'], description: 'install = create+run the mirror; teardown = stop+remove it (the consumer group is kept).')
    // Applies only to a BRAND-NEW durable group. latest on purpose: the topic is a latest-value spot stream, so a restart that resumes a
    // few records late loses nothing, and earliest would replay the retained history into a live topic.
    choice(name: 'OFFSET_RESET', choices: ['latest', 'earliest'], description: 'Where a BRAND-NEW consumer group starts. Ignored once the group has committed offsets.')
  }
  options { disableRestartFromStage(); disableConcurrentBuilds(); timeout(time: 30, unit: 'MINUTES') }
  environment {
    CONFLUENT = '/Users/abhinav/development/confluent-7.3.1'
    // One fixed path (the only one this job can install): dev -> es4. Registries: dev 8082, es4 8081.
    SRC_BS    = '127.0.0.1:19092'
    SRC_REG   = 'http://localhost:8082'
    SRC_TOPIC = 'underlying.es.price'
    TGT_BS    = '192.168.100.4:9092'
    TGT_REG   = 'http://192.168.100.4:8081'
    TGT_TOPIC = 'es.underlying.es.price.basis-reference'
    TARGET    = 'es4'
    GROUP     = 'es-price-mirror-es4'
    LABEL     = 'com.optionsedge.es-price-mirror-es4'
    MDIR      = '/Users/abhinav/oe-ops/es-price-mirror-es4'
    PLIST     = '/Users/abhinav/Library/LaunchAgents/com.optionsedge.es-price-mirror-es4.plist'
    OLD_BRIDGE_LABEL = 'com.optionsedge.es-price-basisref-bridge-192-168-100-4-9092'
    OLD_BRIDGE_HOST  = 'abhinav@192.168.100.102'
  }
  stages {
    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    // PERMITTED_SHA is REQUIRED. scripts/jenkins/permitted-sha-guard.sh refuses, in this order: a checkout
    // that is not on origin/main (the environment-branch restriction, kept as its own condition); a
    // missing, empty, short or otherwise malformed PERMITTED_SHA (nothing is substituted for it); a
    // checked-out HEAD that is not exactly PERMITTED_SHA. It runs FIRST, in the workspace every later
    // stage uses, so nothing below can build, push, apply, roll, restart, create a topic or copy a file
    // under an unpermitted commit — including a build queued for one commit that checked out a newer one.
    // error(), never catchError: a refusal is a stop, not a coloured result. Both SHAs are in the log.
    stage('Permitted commit guard') {
      options { timeout(time: 10, unit: 'MINUTES') }
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }

    stage('Teardown') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'teardown') } }
      steps {
        sh '''
          set -euo pipefail
          launchctl unload "$PLIST" 2>/dev/null || true
          rm -f "$PLIST" "$MDIR/run.sh" "$MDIR/mirror.env" "$MDIR/EsPriceAvroMirror.java"
          echo "torn down ${LABEL} (consumer group ${GROUP} retained; logs left in ${MDIR})"
        '''
      }
    }

    stage('Preflight (fail-closed)') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'install') } }
      steps {
        sh '''
          set -euo pipefail
          echo "TARGET=$TARGET  ${SRC_BS}/${SRC_TOPIC} (${SRC_REG}) -> ${TGT_BS}/${TGT_TOPIC} (${TGT_REG})  group=${GROUP}"
          [ "$SRC_BS/$SRC_TOPIC" != "$TGT_BS/$TGT_TOPIC" ] || { echo "FAIL: source and target are identical — a same-topic mirror would loop"; exit 1; }
          JH="$(/usr/libexec/java_home 2>/dev/null || true)"
          [ -n "$JH" ] || { echo "FAIL: no JDK found"; exit 1; }
          export JAVA_HOME="$JH"; export PATH="$JAVA_HOME/bin:$PATH"
          for hp in "$SRC_BS" "$TGT_BS"; do
            nc -z -G 5 "${hp%:*}" "${hp#*:}" || { echo "FAIL: broker $hp unreachable"; exit 1; }
            echo "  reachable: $hp"
          done

          # 0. Stop OUR OWN unit if this is a re-install, so the "no legacy writer" behaviour sample below sees only foreign writers.
          launchctl unload "$PLIST" 2>/dev/null || true
          # 1. Retire the old text bridge BEFORE any target-state check. It runs under launchd on the dev Mac (.102). Renamed, not deleted, so the
          #    retirement is reversible and visible; a KeepAlive unit would otherwise return at the next login.
          OLDPL="/Users/abhinav/Library/LaunchAgents/${OLD_BRIDGE_LABEL}.plist"
          ssh -o BatchMode=yes "$OLD_BRIDGE_HOST" "launchctl unload '$OLDPL' 2>/dev/null; if [ -f '$OLDPL' ]; then mv '$OLDPL' '$OLDPL.retired-by-es-price-mirror'; fi; pkill -f es-price-basisref-bridge || true; sleep 2; launchctl list | grep -F '$OLD_BRIDGE_LABEL' || echo RETIRED" > /tmp/es-price-mirror-retire.out 2>&1 || true
          tail -1 /tmp/es-price-mirror-retire.out | grep -qx RETIRED || { echo "FAIL: the old es-price basis-reference bridge is still loaded on $OLD_BRIDGE_HOST"; cat /tmp/es-price-mirror-retire.out; exit 1; }
          echo "  es-price-basisref-bridge retired"
        '''
      }
    }

    stage('Preflight (registries, topics, group)') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'install') } }
      steps {
        sh '''
          set -euo pipefail
          JH="$(/usr/libexec/java_home 2>/dev/null || true)"
          [ -n "$JH" ] || { echo "FAIL: no JDK found"; exit 1; }
          export JAVA_HOME="$JH"; export PATH="$JAVA_HOME/bin:$PATH"
          # 2. Both registries carry the subject in the same shape (the mirror never registers; ids may differ).
          bash "scripts/kafka/es-price-mirror/assert-subject-parity.sh" "$SRC_REG" "$TGT_REG" "$SRC_BS" "$SRC_TOPIC" "$CONFLUENT/bin"

          # 3. Both topics exist and every partition is led; the TARGET holds no retained JSON (earliest AND newest record of every
          #    non-empty partition are framed Avro whose id resolves to the subject on the TARGET registry).
          CP="$CONFLUENT/share/java/kafka/*:$CONFLUENT/share/java/kafka-serde-tools/*:$CONFLUENT/share/java/confluent-common/*"
          for side in SRC TGT; do
            if [ "$side" = SRC ]; then bs="$SRC_BS"; t="$SRC_TOPIC"; else bs="$TGT_BS"; t="$TGT_TOPIC"; fi
            "$CONFLUENT/bin/kafka-topics" --bootstrap-server "$bs" --describe --topic "$t" > "/tmp/es-price-mirror-$TARGET.$side.describe"
            parts=$(awk '/Partition:/ { n++ } END { print n+0 }' "/tmp/es-price-mirror-$TARGET.$side.describe")
            bad=$(awk '/Partition:/ { for (i = 1; i <= NF; i++) if ($i == "Leader:" && $(i+1) !~ /^[0-9]+$/) b++ } END { print b+0 }' "/tmp/es-price-mirror-$TARGET.$side.describe")
            [ "$parts" -ge 1 ] || { echo "FAIL: $t does not exist on $bs (this mirror must not rely on broker auto-create)"; exit 1; }
            [ "$bad" -eq 0 ] || { echo "FAIL: $t on $bs has $bad partition(s) without a leader"; exit 1; }
            echo "  $side topic $t on $bs: $parts partition(s), all led"
          done
          # the target must not be fed by a legacy byte copier: no such process, and its end offset is steady with no mirror of ours installed
          bash "scripts/kafka/es-price-mirror/assert-no-legacy-writer.sh" "$TGT_BS" "$TGT_TOPIC" "$CONFLUENT/bin"
          bash "scripts/kafka/es-price-mirror/assert-target-fresh.sh" "$TGT_BS" "$TGT_TOPIC" "$GROUP" "$SRC_BS" "$SRC_TOPIC" "$CONFLUENT/bin"
          bash "scripts/kafka/es-price-mirror/assert-timestamp-type.sh" "$TGT_BS" "$TGT_TOPIC" "$CONFLUENT/bin"
          # FULL SCAN of the target (the middle of the log): every record decodes to the canonical record under the target registry; bounded, fail closed
          java -cp "$CP" scripts/kafka/es-price-mirror/EsPriceAvroMirror.java verify-all "$TGT_BS" "$TGT_REG" "$TGT_TOPIC" 200000 300
          CHECK_FIRST=true ALLOW_EMPTY=true bash "scripts/kafka/es-price-mirror/verify-target-record.sh" "$TGT_BS" "$TGT_REG" "$TGT_TOPIC" "$CONFLUENT/bin"
          CHECK_FIRST=true ALLOW_EMPTY=true bash "scripts/kafka/es-price-mirror/verify-target-record.sh" "$SRC_BS" "$SRC_REG" "$SRC_TOPIC" "$CONFLUENT/bin"

          # 4. Compile check of the mirror against the installed jars, then report the durable group's position.
          javac -proc:none -cp "$CP" -d "$(mktemp -d)" "scripts/kafka/es-price-mirror/EsPriceAvroMirror.java"
          GRC=0
          GD=$("$CONFLUENT/bin/kafka-consumer-groups" --bootstrap-server "$SRC_BS" --describe --group "$GROUP" --offsets 2>&1) || GRC=$?
          [ "$GRC" -eq 0 ] || { echo "FAIL: cannot query consumer group $GROUP on $SRC_BS (exit $GRC)"; exit 1; }
          PRIOR=$(printf '%s\\n' "$GD" | awk -v g="$GROUP" -v t="$SRC_TOPIC" '$1 == g && $2 == t && $4 ~ /^[0-9]+$/ { n++ } END { print n+0 }')
          if [ "$PRIOR" -ge 1 ]; then echo "  group $GROUP holds committed offsets on $PRIOR partition(s): this install RESUMES"; else echo "  group $GROUP is NEW: it starts at OFFSET_RESET=${OFFSET_RESET}"; fi
        '''
      }
    }

    stage('Install') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'install') } }
      steps {
        sh '''
          set -euo pipefail
          launchctl unload "$PLIST" 2>/dev/null || true
          mkdir -p "$MDIR"
          cp "scripts/kafka/es-price-mirror/EsPriceAvroMirror.java" "$MDIR/EsPriceAvroMirror.java"

          cat > "$MDIR/mirror.env" <<EOS
# GENERATED by Jenkinsfile.es-price-basisref-mirror — do not hand-edit; re-run the job instead.
CONFLUENT=${CONFLUENT}
SRC_BS=${SRC_BS}
SRC_TOPIC=${SRC_TOPIC}
SRC_REG=${SRC_REG}
TGT_BS=${TGT_BS}
TGT_TOPIC=${TGT_TOPIC}
TGT_REG=${TGT_REG}
GROUP=${GROUP}
OFFSET_RESET=${OFFSET_RESET}
EOS

          cat > "$MDIR/run.sh" <<'EOS'
#!/usr/bin/env bash
# GENERATED by Jenkinsfile.es-price-basisref-mirror — do not hand-edit; re-run the job instead.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/mirror.env"
LOG="$HERE/mirror.log"
# launchd has a minimal environment: resolve a JDK explicitly.
if [ -z "${JAVA_HOME:-}" ]; then JAVA_HOME="$(/usr/libexec/java_home 2>/dev/null || true)"; fi
export JAVA_HOME
export PATH="$JAVA_HOME/bin:/usr/bin:/bin:$PATH"
[ -x "$JAVA_HOME/bin/java" ] || { echo "[$(date '+%F %T')] ERROR: no JDK found" >> "$LOG"; exit 2; }
echo "[$(date '+%F %T')] starting es-price mirror $SRC_BS/$SRC_TOPIC -> $TGT_BS/$TGT_TOPIC (group=$GROUP reset=$OFFSET_RESET)" >> "$LOG"
exec java -cp "$CONFLUENT/share/java/kafka/*:$CONFLUENT/share/java/kafka-serde-tools/*:$CONFLUENT/share/java/confluent-common/*" \
  "$HERE/EsPriceAvroMirror.java" mirror "$SRC_BS" "$SRC_TOPIC" "$SRC_REG" "$TGT_BS" "$TGT_TOPIC" "$TGT_REG" "$GROUP" "$OFFSET_RESET" 2>>"$LOG"
EOS
          chmod +x "$MDIR/run.sh"

          cat > "$PLIST" <<EOS
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>${MDIR}/run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- a crash-looping mirror (a record it refuses) must not respawn faster than the group coordinator evicts the dead member -->
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>${MDIR}/mirror.out.log</string>
  <key>StandardErrorPath</key><string>${MDIR}/mirror.err.log</string>
</dict>
</plist>
EOS
          launchctl load "$PLIST"
          echo "installed ${LABEL}"
        '''
      }
    }

    stage('Verify') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.ACTION == 'install') } }
      steps {
        sh '''
          set -euo pipefail
          JH="$(/usr/libexec/java_home 2>/dev/null || true)"
          [ -n "$JH" ] || { echo "FAIL: no JDK found"; exit 1; }
          export JAVA_HOME="$JH"; export PATH="$JAVA_HOME/bin:$PATH"
          T="/tmp/es-price-mirror-$TARGET"
          rm -f "$T.verdict"
          # grep through a FILE, never a pipe (SIGPIPE under pipefail)
          launchctl list > "$T.launchctl"
          grep -qF "$LABEL" "$T.launchctl" || { echo "FAIL: launchd unit $LABEL not loaded"; exit 1; }
          echo "  launchd unit loaded: $LABEL"

          # FLOW is proven by the MIRROR's own group, not by the target offset (any other writer advances that too):
          # the group must advance while the source does, its lag must be bounded, and the last record it flushed must be on the target with the
          # same key, timestamp and decoded value. Exit 0 FLOWING, 3 INCONCLUSIVE (source flat: market closed), anything else FAIL.
          sleep 20
          RC=0
          bash "scripts/kafka/es-price-mirror/verify-flow.sh" "$SRC_BS" "$SRC_REG" "$SRC_TOPIC" "$TGT_BS" "$TGT_REG" "$TGT_TOPIC" "$GROUP" "$CONFLUENT/bin" || RC=$?
          case "$RC" in
            0) echo FLOWING > "$T.verdict" ;;
            3) echo INCONCLUSIVE > "$T.verdict" ;;
            *) echo DROPPING > "$T.verdict"; echo "FAIL: the mirror is not moving data (see above); check ${MDIR}/mirror.log"; exit 1 ;;
          esac
          CP="$CONFLUENT/share/java/kafka/*:$CONFLUENT/share/java/kafka-serde-tools/*:$CONFLUENT/share/java/confluent-common/*"
          java -cp "$CP" scripts/kafka/es-price-mirror/EsPriceAvroMirror.java verify-all "$TGT_BS" "$TGT_REG" "$TGT_TOPIC" 200000 300
          # the earliest and newest target records fully decode under the target registry (a byte copy fails this)
          ALLOW_EMPTY=true CHECK_FIRST=true bash "scripts/kafka/es-price-mirror/verify-target-record.sh" "$TGT_BS" "$TGT_REG" "$TGT_TOPIC" "$CONFLUENT/bin"
        '''
        script {
          // The shell cannot set a Jenkins result, so the verdict crosses the boundary as a file. No traffic is NOT proof of flow.
          def verdict = sh(script: "cat '/tmp/es-price-mirror-${params.TARGET}.verdict' 2>/dev/null || echo MISSING", returnStdout: true).trim()
          echo "es-price mirror verify verdict: ${verdict}"
          if (verdict == 'INCONCLUSIVE') {
            currentBuild.result = 'UNSTABLE'
            currentBuild.description = 'mirror installed; flow NOT proven (no spot ticks in window)'
          } else if (verdict == 'FLOWING') {
            currentBuild.description = 'mirror installed and flow proven'
          } else {
            error("mirror verify produced no verdict (${verdict}) — treat as unverified")
          }
        }
      }
    }
  }
}
