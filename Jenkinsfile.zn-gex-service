@Library('oe') _

// STANDALONE ZN-GEX DEPLOY — the per-service fast path for the CME ZN (10-Year T-Note
// futures) options yield-equivalent GEX service (source repo: options-edge-zn-gex).
// Mirrors Jenkinsfile.nifty-gex-service / Jenkinsfile.web-service:
//
//   Build (native, on the target arch's machine) → Deploy ONLY this workload
//   → digest-pin → rollout → health gate → rollback instructions (service-deploy.sh).
//
// * dev builds locally on the Mac (arm64) and pushes to localhost:5001. Production is
//   NOT wired up yet — services.yaml declares envs: [dev] only, deliberately, until the
//   Databento ingestion path and DV01 mapping have a live dev proof (same posture as
//   vol-state). Add `production` to services.yaml + a k8s/services/zn-gex/overlays/production
//   + the 'production' ENVIRONMENT choice below only after that soak.
// * Deploy applies ONLY k8s/services/zn-gex/overlays/<env>; blast-radius guard in
//   scripts/deploy/service-deploy.sh refuses any infra kind. The options-edge-databento-feed-env
//   Secret (DATABENTO_API_KEY) and the shared options-edge-config ConfigMap are common
//   infra and must already exist; the zn-gex-dv01-map ConfigMap is optional (its absence
//   fails closed inside the service — every record comes out dv01Stale=true, never a
//   silent default DV01).
// * No NodePort exists for this service yet (ClusterIP only) — HEALTH_URL is left empty
//   for now, so the rollout gate is `kubectl rollout status` + the pinned-imageID check
//   in service-deploy.sh, not an external HTTP probe. Add a HEALTH_URL default here once
//   there's a reachable route (port-forward or an Ingress/NodePort) worth automating.
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before any effect unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`.')
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: '2f6fc2ab7aa51eb8a9e8aa350f2d774cd2fb7a253de2591e43645a19a9886b24',
      description: 'DO NOT EDIT BY HAND — the sha256 of scripts/jenkins/permitted-sha-guard.sh this definition runs (Deployment Permission Rule). The guard refuses to run under any other value. It is a DECLARATION, not proof that this job enforces the guard: a caller that triggers this job judges its SCM definition and its Jenkinsfile at the forwarded commit (scripts/jenkins/require-guarded-downstream.sh). Regenerate with scripts/jenkins/permitted-sha-guard-version.sh when the guard changes.')
    choice(name: 'ENVIRONMENT', choices: ['dev'],
      description: 'Target environment — selects k8s/services/zn-gex/overlays/<env> and the deployer kubeconfig (oeProfile). Only dev exists so far (services.yaml envs: [dev]).')
    booleanParam(name: 'BUILD_IMAGE', defaultValue: true,
      description: 'Build+push the image first (native on the target machine). false = deploy the image already in the registry.')
    string(name: 'ZN_PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED when BUILD_IMAGE=true — Deployment Permission Rule. The full 40-character commit id of options-edge-zn-gex (the SECOND source this job builds: it clones that repository and docker-pushes the result). PERMITTED_SHA binds only THIS repository; this binds the application checkout, checked right after the clone and before the build. Empty, short or mismatched values are refused.')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: false,
      description: 'true = render + digest-pin + server-side validate only; nothing changes.')
    string(name: 'HEALTH_URL', defaultValue: '',
      description: 'Optional post-rollout endpoint that must answer 200. Empty = per-env default (currently empty for both — no reachable route yet; the rollout-status + pinned-imageID gate in service-deploy.sh still applies).')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
  }
  options {
    disableRestartFromStage()   // Deployment Permission Rule: no "Restart from Stage" past the permitted-commit guard
    disableConcurrentBuilds()
    timeout(time: 120, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG  = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    ENVIRONMENT = "${params.ENVIRONMENT}"
    SOURCE_REPO = 'git@github.com:abhinav-jain09/options-edge-zn-gex.git'
    PROD_BUILD_HOST = '192.168.100.252'
    PROD_BUILD_ROOT = '/home/abhinav/ci/remote-builds'
    IMAGE_REF   = "${params.ENVIRONMENT == 'production' ? '192.168.100.252:5000/options-edge-zn-gex:prod' : 'localhost:5001/options-edge-zn-gex:dev'}"
    HEALTH_URL_DEFAULT   = ''
    HEALTH_URL_PARAM     = "${params.HEALTH_URL ?: ''}"
    DEPLOY_DRY_RUN_PARAM = "${params.DEPLOY_DRY_RUN}"
  }
  stages {
    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    stage('Permitted commit guard') {
      options { timeout(time: 10, unit: 'MINUTES') }
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }
    stage('Validate service registry') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' } }
      steps {
        sh '''
          set -euo pipefail
          bash scripts/ci/validate-services.sh
        '''
      }
    }
    stage('Build image (native)') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.BUILD_IMAGE && !params.DEPLOY_DRY_RUN) } }
      steps {
        dir('zn-gex-src') {
          git url: env.SOURCE_REPO, branch: 'main'
        }
        timeout(time: 10, unit: 'MINUTES') {
          sh 'PERMITTED_SHA="${ZN_PERMITTED_SHA:-}" bash scripts/jenkins/permitted-sha-guard.sh --dir zn-gex-src --ref main'
        }
        sh '''
          set -euo pipefail
          SRC_COMMIT="$(git -C zn-gex-src rev-parse HEAD)"
          [ "$SRC_COMMIT" = "${ZN_PERMITTED_SHA:?}" ] || { echo "zn-gex checkout $SRC_COMMIT is not ZN_PERMITTED_SHA" >&2; exit 1; }
          mkdir -p .jenkins-tmp
          rm -f ".jenkins-tmp/zn-gex-push-$BUILD_ID.log"
        '''
        // The Dockerfile is single-stage (COPY target/options-edge-zn-gex.jar) — unlike nifty-gex
        // (whose image builds from source directly), this is a plain Maven/Java service, so the
        // jar must exist BEFORE `docker build` sees it. Re-verify the checkout immediately before
        // this dedicated `mvn package` step (validator rule 9b — same shape as templates/Jenkinsfile.new-service's
        // own Build stage), same as the docker build steps below each re-verify before their effect.
        timeout(time: 10, unit: 'MINUTES') {
          sh 'PERMITTED_SHA="${ZN_PERMITTED_SHA:-}" bash scripts/jenkins/verify-permitted-tree.sh --dir zn-gex-src'
        }
        sh 'mvn -B -f zn-gex-src/pom.xml clean package -DskipTests'
        script {
          def zsha = (params.ZN_PERMITTED_SHA ?: '').trim()
          def uniqueTag = "b${env.BUILD_ID}-${zsha}"
          def uniqueRef = "${env.IMAGE_REF.substring(0, env.IMAGE_REF.lastIndexOf('/'))}/options-edge-zn-gex:${uniqueTag}"
          withEnv(["UNIQUE_TAG=${uniqueTag}", "UNIQUE_REF=${uniqueRef}", "BUILD_DIR=${env.PROD_BUILD_ROOT}/zn-gex-${env.BUILD_NUMBER}"]) {
            if (env.ENVIRONMENT == 'production') {
              sh '''
                set -euo pipefail
                ssh -o BatchMode=yes "abhinav@$PROD_BUILD_HOST" "mkdir -p '$BUILD_DIR'"
              '''
              timeout(time: 10, unit: 'MINUTES') {
                sh 'PERMITTED_SHA="${ZN_PERMITTED_SHA:-}" bash scripts/jenkins/verify-permitted-tree.sh --dir zn-gex-src'
              }
              sh 'rsync -a --delete --exclude .git zn-gex-src/ "abhinav@${PROD_BUILD_HOST}:${BUILD_DIR}/"'
              sh '''
                set -euo pipefail
                ssh -o BatchMode=yes "abhinav@$PROD_BUILD_HOST" \
                  "cd '$BUILD_DIR' && docker build -t '$IMAGE_REF' -t '$UNIQUE_REF' . && docker push '$IMAGE_REF' && docker push '$UNIQUE_REF' && rm -rf '$BUILD_DIR'" \
                  | tee ".jenkins-tmp/zn-gex-push-$BUILD_ID.log"
              '''
            } else {
              timeout(time: 10, unit: 'MINUTES') {
                sh 'PERMITTED_SHA="${ZN_PERMITTED_SHA:-}" bash scripts/jenkins/verify-permitted-tree.sh --dir zn-gex-src'
              }
              sh 'docker build -t "${IMAGE_REF}" -t "${UNIQUE_REF}" zn-gex-src'
              sh '''
                set -euo pipefail
                docker push "$IMAGE_REF"
                docker push "$UNIQUE_REF" | tee ".jenkins-tmp/zn-gex-push-$BUILD_ID.log"
              '''
            }
            sh '''
              set -euo pipefail
              SRC_COMMIT="$(git -C zn-gex-src rev-parse HEAD)"
              [ "$SRC_COMMIT" = "${ZN_PERMITTED_SHA:?}" ] || { echo "zn-gex checkout $SRC_COMMIT is not ZN_PERMITTED_SHA" >&2; exit 1; }
              REG="${IMAGE_REF%/*}"
              PUSHED="$(sed -n "s/^$UNIQUE_TAG: digest: \\(sha256:[0-9a-f]\\{64\\}\\) size: [0-9]*$/\\1/p" ".jenkins-tmp/zn-gex-push-$BUILD_ID.log" | tail -1)"
              [ -n "$PUSHED" ] || { echo "the push of $UNIQUE_REF reported no digest — no image lock, nothing deployable" >&2; exit 1; }
              SERVED="$(bash scripts/jenkins/resolve-pushed-digest.sh "$REG" options-edge-zn-gex "$UNIQUE_TAG")"
              [ "$SERVED" = "$PUSHED" ] || { echo "the registry serves $SERVED for $UNIQUE_TAG, this push reported $PUSHED — refusing" >&2; exit 1; }
              {
                echo "OPTIONS_EDGE_IMAGE_LOCK_FORMAT=1"
                echo "OPTIONS_EDGE_IMAGE_LOCK_SOURCE_REPO=$SOURCE_REPO"
                echo "OPTIONS_EDGE_IMAGE_LOCK_GIT_COMMIT=$SRC_COMMIT"
                echo "OPTIONS_EDGE_IMAGE_LOCK_DEPLOY_REPO_COMMIT=$(git rev-parse HEAD)"
                echo "OPTIONS_EDGE_IMAGE_LOCK_GUARD_VERSION=${PERMITTED_SHA_GUARD_VERSION:-}"
                echo "OPTIONS_EDGE_IMAGE_LOCK_BUILD_ID=$BUILD_ID"
                echo "OPTIONS_EDGE_IMAGE_LOCK_BUILD_URL=${BUILD_URL:-}"
                echo "OPTIONS_EDGE_IMAGE_LOCK_TAG=$UNIQUE_TAG"
                echo "ZN_GEX_IMAGE=$UNIQUE_REF@$PUSHED"
                echo "ZN_GEX_IMAGE_GIT_COMMIT=$SRC_COMMIT"
              } > ".jenkins-tmp/image-lock-$BUILD_ID.env"
              sed 's/^/image-lock: /' ".jenkins-tmp/image-lock-$BUILD_ID.env"
            '''
          }
        }
        script {
          def lockFile = ".jenkins-tmp/image-lock-${env.BUILD_ID}.env"
          def lock = readFile(lockFile)
          String ref = ''
          String lockBuild = ''
          for (String l : lock.split('\n')) {
            if (l.startsWith('ZN_GEX_IMAGE=')) { ref = l.substring('ZN_GEX_IMAGE='.length()) }
            if (l.startsWith('OPTIONS_EDGE_IMAGE_LOCK_BUILD_ID=')) { lockBuild = l.substring('OPTIONS_EDGE_IMAGE_LOCK_BUILD_ID='.length()) }
          }
          if (lockBuild != env.BUILD_ID.toString() || !ref.matches('^[^@\\s]+@sha256:[0-9a-f]{64}$')) {
            error("this build's image lock ${lockFile} does not name a digest-pinned image for build ${env.BUILD_ID}. Nothing was deployed.")
          }
          env.REQUIRED_IMAGE = ref
          writeFile file: '.jenkins-tmp/options-edge-image-lock.env', text: lock
          archiveArtifacts artifacts: '.jenkins-tmp/options-edge-image-lock.env', fingerprint: true
          echo "deploying exactly ${env.REQUIRED_IMAGE} (built by this build from ${params.ZN_PERMITTED_SHA})"
        }
      }
    }
    stage('Identity preflight (the v1 rename abandons nothing)') {
      // zn-gex's KAFKA_APPLICATION_ID was renamed zn-gex-v1 -> zn-gex. Renaming a Streams application id
      // abandons its consumer group AND the internal topics holding its state stores, so the rename was only
      // safe because zn-gex had never been built. That was an OBSERVATION; this is the ENFORCEMENT (Codex):
      // every rollout refuses if the broker still carries the old identity, and it runs on a DRY RUN too,
      // because a dry run is exactly when an operator wants to find this out.
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' } }
      steps {
        sh '''
          set -euo pipefail
          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          scripts/kafka/zn-gex-identity-preflight.sh
        '''
      }
    }
    stage('Verify zn-gex Kafka topics') {
      // BEFORE the rollout, same barrier as Jenkinsfile.service-deploy's "Verify gamma-ladder-path
      // output topics" stage: apply-topics.sh lives in the MONOLITHIC deploy job, not this
      // per-service fast path, so on a FIRST deploy neither topic exists and the broker either
      // auto-creates them with cluster defaults (dev's broker runs num.partitions=32, not the
      // declared 1) or, with auto-create off, the idempotent raw-snapshot producer fails at
      // startup and the pod crash-loops. Skipped on DEPLOY_DRY_RUN (nothing should be created by
      // a dry run) — same condition Jenkinsfile.service-deploy uses for its per-service topic gates.
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (!params.DEPLOY_DRY_RUN) } }
      steps {
        sh '''
          set -euo pipefail
          export PATH="/home/confluent/confluent-8.2.1/bin:$PATH"
          . scripts/kafka/load-kafka-settings.sh
          scripts/kafka/ensure-zn-gex-topics.sh
        '''
      }
    }
    stage('Deploy (service-scoped)') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' } }
      steps {
        sh '''
          set -euo pipefail
          mkdir -p .jenkins-tmp
          rm -rf zn-gex-src
          bash scripts/jenkins/write-permission-receipt.sh "$WORKSPACE/.jenkins-tmp/permission-receipt.env"
          HEALTH_URL="${HEALTH_URL_PARAM:-}"
          [ -n "$HEALTH_URL" ] || HEALTH_URL="${HEALTH_URL_DEFAULT:-}"
          printf '%s\\n' "$HEALTH_URL" > .jenkins-tmp/health-url
        '''
        script {
          withEnv(["SERVICE=zn-gex",
                   "DEPLOY_DRY_RUN=${env.DEPLOY_DRY_RUN_PARAM ?: 'false'}",
                   "HEALTH_URL=${readFile('.jenkins-tmp/health-url').trim()}",
                   "WORK_DIR=${env.WORKSPACE}/.jenkins-tmp",
                   "PATH+EFFECT_SHIM=${env.WORKSPACE}/scripts/jenkins/effect-shim",
                   "OE_SHIM_DIR=${env.WORKSPACE}",
                   "OE_SHIM_SHA=${params.PERMITTED_SHA}",
                   "OE_SHIM_ALLOW=--allow-ignored target --allow-ignored .jenkins-tmp"]) {
            sh 'bash scripts/jenkins/effect-shim-integrity.sh --dir . --when start'
            timeout(time: 10, unit: 'MINUTES') {
              sh 'PERMITTED_SHA="${PERMITTED_SHA:-}" bash scripts/jenkins/verify-permitted-tree.sh --dir . --allow-ignored target --allow-ignored .jenkins-tmp'
            }
            def deployFailure = null
            try {
              sh 'bash scripts/deploy/service-deploy.sh'
            } catch (Exception deployError) {
              deployFailure = deployError
            }
            def shimIntegrity = null
            def inspectionFailure = null
            try {
              shimIntegrity = sh(returnStatus: true, script: 'bash scripts/jenkins/effect-shim-integrity.sh --dir . --when end')
            } catch (Exception inspectionError) {
              inspectionFailure = inspectionError
            }
            if (inspectionFailure != null) {
              echo 'effect-shim-integrity(end): THE INSPECTION DID NOT RUN (' + inspectionFailure.toString() + '). This build cannot say whether the shim was intact while the effects above ran.'
            } else if (shimIntegrity != 0) {
              echo 'effect-shim-integrity(end): the shim changed during this stage; coverage CANNOT BE ATTESTED for all effects above.'
            }
            if (deployFailure != null) {
              throw deployFailure
            }
            if (inspectionFailure != null) {
              error('the end inspection did not run (' + inspectionFailure.toString() + '); this build cannot attest that the shim was intact')
            }
            if (shimIntegrity != 0) {
              error('effect-shim integrity failed after the deployment: coverage cannot be attested for all effects in this stage')
            }
          }
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: '.jenkins-tmp/zn-gex-*.yaml, .jenkins-tmp/permission-receipt.env', allowEmptyArchive: true
    }
  }
}
