// ES-CVD MIRROR — stand up a clean SINGLE-TOPIC .4->target mirror as a managed launchd service.
//
// Requirement (0DTE-INDICATOR-SERVICE rev 14 §7.3, compute-once + mirror): es4 is the SOLE ES
// indicator producer; its two output topics are mirrored VERBATIM (record-copy, identity name,
// ES-keyed records only) to dev and prod so all three envs share one uniform ES view. NO local
// ES fallback on the targets — a broken mirror means ES goes STALE there, never different.
//
// WHY MM1 (kafka-mirror-maker), NOT MM2 (connect-mirror-maker): MM2's Heartbeat/Checkpoint
// connectors replicate .4's runaway `es.es.es...heartbeats` junk (its own broken es4 MM2) and
// create es4.* / mm2-*.internal topics on the target -> pollution. MM1 --whitelist mirrors ONLY
// the one topic, byte-copy, identity name, no heartbeat/checkpoint machinery. (Verified 2026-07-19.)
//
// The Verify stage enforces that as a DELTA, not an absolute: Preflight snapshots the target's
// topic list before install and Verify fails only on pattern matches that appear AFTER it. Prod
// permanently carries four dead-MM2 leftovers (heartbeats, mm2-{configs,offsets,status}.es4.internal)
// that an absolute check read as this mirror's pollution, failing every prod install (2026-08-06).
//
// Unlike the strike-intel/futures-flow mirrors (one topic family each, target-only slug), this
// job serves BOTH indicator topics, so the launchd identity includes the TOPIC: one unit per
// (target, topic) — dev+prod x snapshot+bars = four coexisting units, none overwriting another.
//
// The job runs on the 'local-mac' agent (the dev Mac, which IS the target for dev). It generates
// the config + installs a KeepAlive launchd unit; NOTHING is hand-edited.
pipeline {
  agent { label 'local-mac' }
  parameters {
    string(name: 'SOURCE_ES_CLUSTER_IP', defaultValue: '192.168.100.4', description: 'ES source-of-truth broker IP (.4).')
    string(name: 'SOURCE_PORT',          defaultValue: '9092',          description: 'Source Kafka port.')
    string(name: 'TARGET_SPX_CLUSTER_IP',defaultValue: '127.0.0.1',     description: 'Target env broker IP (dev = 127.0.0.1, prod = 192.168.100.252).')
    string(name: 'TARGET_PORT',          defaultValue: '19092',         description: 'Target Kafka port (dev = 19092, prod = 9092).')
    choice(name: 'TOPIC', choices: ['es.futures.cvd.bars', 'es.futures.cvd', 'es.futures.cvd.levels'], description: 'CVD topic to mirror (frozen allow-list — the shape contract below is per-topic).')
    choice(name: 'ACTION', choices: ['install', 'teardown'], description: 'install = create+run the mirror; teardown = stop+remove it.')
  }
  options { disableConcurrentBuilds(); timeout(time: 15, unit: 'MINUTES') }
  environment {
    KBIN  = '/Users/abhinav/development/confluent-7.3.1/bin'
    // Per-(TARGET,TOPIC) identity: dev/prod each mirror BOTH indicator topics from .4, so every
    // (env, topic) pair must be an independent launchd unit instead of one shared label/dir.
    SLUG  = "${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT + '-' + params.TOPIC).replaceAll('[^A-Za-z0-9-]', '-')}"
    MDIR  = "/Users/abhinav/oe-ops/es-cvd-mirror-${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT + '-' + params.TOPIC).replaceAll('[^A-Za-z0-9-]', '-')}"
    LABEL = "com.optionsedge.es-cvd-mirror-${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT + '-' + params.TOPIC).replaceAll('[^A-Za-z0-9-]', '-')}"
    PLIST = "/Users/abhinav/Library/LaunchAgents/com.optionsedge.es-cvd-mirror-${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT + '-' + params.TOPIC).replaceAll('[^A-Za-z0-9-]', '-')}.plist"
    SRC   = "${params.SOURCE_ES_CLUSTER_IP}:${params.SOURCE_PORT}"
    TGT   = "${params.TARGET_SPX_CLUSTER_IP}:${params.TARGET_PORT}"
    // Target-only slug (no topic): the approved-legacy-topics allow-list is a property of the
    // BROKER, shared by both indicator topics mirrored to it.
    TSLUG = "${(params.TARGET_SPX_CLUSTER_IP + '-' + params.TARGET_PORT).replaceAll('[^A-Za-z0-9-]', '-')}"
    // Single definition of the MM2-pollution pattern, shared by the Preflight baseline capture and
    // the Verify guard. It MUST be one string: if the two stages ever matched different patterns,
    // a pre-existing topic could be missing from the baseline and fail the build as "new".
    JUNK_RE = '^es4\\.|es\\.es\\.es|heartbeat|mm2-.*\\.internal'
  }
  stages {

    stage('Teardown') {
      when { expression { params.ACTION == 'teardown' } }
      steps {
        sh '''
          set -euo pipefail
          launchctl unload "$PLIST" 2>/dev/null || true
          rm -f "$PLIST"
          # unit-specific: kill ONLY this (target, topic) mirror via its own run script, never a sibling
          pkill -f "$MDIR/run-mirror.sh" 2>/dev/null || true
          pkill -f "kafka-mirror-maker.*$MDIR" 2>/dev/null || true
          echo "mirror service removed (topic + data left intact)"
        '''
      }
    }

    stage('Preflight (fail-closed)') {
      when { expression { params.ACTION == 'install' } }
      steps {
        sh '''
          set -euo pipefail
          echo "SOURCE=$SRC  TARGET=$TGT  TOPIC=$TOPIC"
          # SAFETY: source and target must be different clusters
          [ "$SOURCE_ES_CLUSTER_IP:$SOURCE_PORT" != "$TARGET_SPX_CLUSTER_IP:$TARGET_PORT" ] || { echo "FAIL: source==target"; exit 1; }
          # source broker reachable
          nc -z -w5 "$SOURCE_ES_CLUSTER_IP" "$SOURCE_PORT" || { echo "FAIL: source $SRC unreachable"; exit 1; }
          # target broker reachable + usable — and CAPTURE ITS PRE-INSTALL TOPIC LIST.
          # The Verify pollution guard diffs against this baseline so it fails only on junk THIS
          # install introduced. Prod (192.168.100.252:9092) permanently carries four legacy topics
          # from the old, stopped es4 MM2 setup (heartbeats, mm2-{configs,offsets,status}.es4.internal)
          # that match JUNK_RE; the previous absolute match-count check therefore failed every prod
          # install (builds #6/#7/#8, 2026-08-06) even though the mirror was clean.
          mkdir -p "$MDIR"
          BASE="$MDIR/target-topics-preinstall.txt"
          rm -f "$BASE" "$BASE.tmp"
          "$KBIN/kafka-topics" --bootstrap-server "$TGT" --list > "$BASE.tmp" || { echo "FAIL: target $TGT unusable"; exit 1; }
          # Header stamps build+target so Verify can never grandfather from a stale file, and keeps
          # the file non-empty (an empty broker is a legitimate baseline). No Kafka topic name can
          # ever collide with it: '#' and ' ' are not legal topic-name characters.
          { echo "#BASELINE build=$BUILD_NUMBER target=$TGT"; cat "$BASE.tmp"; } > "$BASE"
          rm -f "$BASE.tmp"
          echo "baseline: $(grep -vc '^#' "$BASE" || true) topic(s) on $TGT before install"

          # GROWTH GATE (fail-closed). A delta guard ALONE would launder pollution: junk created by
          # an earlier failed/aborted build lands in the next build's baseline and gets grandfathered
          # forever. So the pre-install junk set must be a SUBSET of this target's durable,
          # code-reviewed allow-list. Approving prod's four dead-MM2 leftovers is a reviewed commit
          # to that file — never something this job grants itself. No file = nothing approved = any
          # junk-pattern topic blocks the install (which is why dev, being clean, needs no file).
          APPROVED="$WORKSPACE/config/es-mirror-approved-legacy-topics/$TSLUG.txt"
          # Every grep below handles status EXPLICITLY: 1 = "no lines matched" (a legitimate result),
          # anything >1 is a real grep/read error. A blanket `|| true` would convert an unreadable
          # file into "no junk found" and pass the gate vacuously.
          PRE=$(grep -E "$JUNK_RE" "$BASE") || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: junk scan of $BASE errored (grep rc=$rc)"; exit 1; }; PRE=""; }
          if [ -n "$PRE" ]; then
            [ -f "$APPROVED" ] || { echo "FAIL: $TGT already carries junk-pattern topic(s), but config/es-mirror-approved-legacy-topics/$TSLUG.txt does not exist to approve them:"; printf '%s\\n' "$PRE" | sed 's/^/  /'; exit 1; }
            CLEAN="$MDIR/approved-legacy.clean.txt"
            grep -vE '^[[:space:]]*(#|$)' "$APPROVED" > "$CLEAN" || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: cannot read $APPROVED (grep rc=$rc)"; exit 1; }; : > "$CLEAN"; }
            UNAPPROVED=$(printf '%s\\n' "$PRE" | grep -vxFf "$CLEAN") || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: allow-list subtraction errored (grep rc=$rc)"; exit 1; }; UNAPPROVED=""; }
            [ -z "$UNAPPROVED" ] || { echo "FAIL: $TGT carries junk-pattern topic(s) NOT approved in config/es-mirror-approved-legacy-topics/$TSLUG.txt — clean the target, or get the allow-list extended by review:"; printf '%s\\n' "$UNAPPROVED" | sed 's/^/  /'; exit 1; }
            echo "pre-existing junk topics on $TGT (all approved; Verify will grandfather them):"
            printf '%s\\n' "$PRE" | sed 's/^/  /'
          else
            echo "pre-existing junk topics on $TGT: <none>"
          fi
          # source topic exists (nothing to mirror otherwise)
          "$KBIN/kafka-topics" --bootstrap-server "$SRC" --describe --topic "$TOPIC" >/dev/null 2>&1 || { echo "FAIL: source topic $TOPIC missing"; exit 1; }
          # MM1 binary present
          [ -x "$KBIN/kafka-mirror-maker" ] || { echo "FAIL: kafka-mirror-maker missing"; exit 1; }
          echo "preflight OK"
        '''
      }
    }

    stage('Generate config + match target topic') {
      when { expression { params.ACTION == 'install' } }
      steps {
        sh '''
          set -euo pipefail

          # FROZEN per-topic shape contract (ES-CVD-DESIGN.md R31 + scripts/kafka/topics.env — keep in sync):
          #   cvd.bars : 1 partition, compact,delete, retention -1   (keyed bar history — unique key
          #              per bar, so compaction never destroys it; -1 because this IS the history
          #              consumers backfill from, and a finite retention deletes overnight bars
          #              mid-session)
          #   cvd      : 1 partition, compact,delete, retention 12 h — the U15 snapshot contract. The
          #              live es4 topic was created with -1; the es4 create-topics reconcile applies
          #              the declared 12 h BEFORE any mirror install (operational ordering in the
          #              PR), so the source assert below holds. Safe: the 1 Hz writer keeps the
          #              latest value in the active segment, which time-retention never deletes.
          case "$TOPIC" in
            es.futures.cvd.bars) PARTS=1; POLICY=delete; RET=-1 ;;
            es.futures.cvd)      PARTS=1; POLICY=delete; RET=43200000 ;;
            es.futures.cvd.levels) PARTS=1; POLICY=compact; RET=-1 ;;   # U16 AA1: pure compact, never expires
            *) echo "FAIL: topic $TOPIC not in the cvd-mirror allow-list"; exit 1 ;;
          esac

          mkdir -p "$MDIR"
          cat > "$MDIR/consumer.properties" <<C
bootstrap.servers=$SRC
group.id=es-cvd-mirror-${TARGET_SPX_CLUSTER_IP}-${TOPIC}
# earliest, deliberately (merge-gate finding 1): the FIRST install must copy the retained history
# — for cvd.bars the whole point is that dev/prod can backfill overnight bars; `latest` would skip
# everything already on es4. Re-installs are unaffected: the group's committed offsets win.
auto.offset.reset=earliest
key.deserializer=org.apache.kafka.common.serialization.ByteArrayDeserializer
value.deserializer=org.apache.kafka.common.serialization.ByteArrayDeserializer
C
          cat > "$MDIR/producer.properties" <<P
bootstrap.servers=$TGT
key.serializer=org.apache.kafka.common.serialization.ByteArraySerializer
value.serializer=org.apache.kafka.common.serialization.ByteArraySerializer
acks=1
P
          cat > "$MDIR/log4j.properties" <<L
log4j.rootLogger=INFO, stdout
log4j.appender.stdout=org.apache.log4j.ConsoleAppender
log4j.appender.stdout.layout=org.apache.log4j.PatternLayout
log4j.appender.stdout.layout.ConversionPattern=%d{ISO8601} %-5p %c{1} - %m%n
L
          # escape dots for the MM1 whitelist regex (exact single topic)
          RE=$(printf '%s' "$TOPIC" | sed 's/\\./\\\\./g')
          cat > "$MDIR/run-mirror.sh" <<S
#!/usr/bin/env bash
set -euo pipefail
export KAFKA_LOG4J_OPTS="-Dlog4j.configuration=file:$MDIR/log4j.properties"
exec "$KBIN/kafka-mirror-maker" \\
  --consumer.config "$MDIR/consumer.properties" \\
  --producer.config "$MDIR/producer.properties" \\
  --whitelist '$RE' --num.streams 1
S
          chmod +x "$MDIR/run-mirror.sh"

          # >>> BEGIN SHAPE ASSERTIONS (extracted verbatim by scripts/ci/es-cvd-mirror-shape-test.sh) <<<
          # TARGET SCOPE, FAIL-CLOSED, BEFORE ANY MUTATION (ES-CVD-SPX-LEVELS-DESIGN.md CL-R6 L1/M1).
          # U16's normative scope is es4 + PRODUCTION only: the dev resources must stay ABSENT. This
          # job's target parameters DEFAULT to dev (127.0.0.1:19092), and `--create --if-not-exists`
          # on an absent dev topic would create it at the matching shape — after which every
          # assertion below passes and the forbidden resource exists. So the production-only topics
          # are gated on the EXACT production target here, before the create.
          case "$TOPIC" in
            es.futures.cvd.levels)
              [ "$TGT" = "192.168.100.252:9092" ] || {
                echo "FAIL: $TOPIC is PRODUCTION-ONLY (CL-R6 L1/M1) but the target is $TGT."
                echo "      Re-run with TARGET_SPX_CLUSTER_IP=192.168.100.252 TARGET_PORT=9092."
                echo "      Dev resources for U16 must stay absent until the design says otherwise."
                exit 1
              } ;;
          esac
          # EFFECTIVE config reader (merge-gate finding 2): first match of kafka-configs --describe
          # for the named config — dynamic if set, else the broker-default synonym; empty output is
          # a query FAILURE, never an implicit pass.
          eff() { # broker topic config-name -> effective value, or nonzero
            local out
            out=$("$KBIN/kafka-configs" --bootstrap-server "$1" --entity-type topics \
                  --entity-name "$2" --describe 2>/dev/null \
                  | grep -oE "(^|[ ])$3=[^ ]+" | head -1 | sed 's/^ *//' | cut -d= -f2)
            # boundary-anchored on SPACE only: a bare "$3=" grep substring-matched
            # delete.retention.ms before retention.ms (install #1), and a comma in the terminator
            # class then truncated the VALUE "compact,delete" to "compact" (install #2) — in
            # kafka-configs' space-delimited output, commas belong to values, never to delimiters.
            [ -n "$out" ] || { echo "FAIL: cannot read $3 for $2 on $1"; return 1; }
            printf '%s' "$out"
          }
          # SOURCE shape assert against the SAME frozen arm — the shape contract must hold at both
          # ends, or the byte-copy propagates a wrong shape's records under a right shape's name.
          SD=$("$KBIN/kafka-topics" --bootstrap-server "$SRC" --describe --topic "$TOPIC" 2>/dev/null)
          printf '%s\n' "$SD" | grep -Eq "PartitionCount: ${PARTS}([[:space:]]|$)" \
            || { echo "FAIL: source $TOPIC partition count does not match frozen contract PARTS=$PARTS: $SD"; exit 1; }
          SPOL=$(eff "$SRC" "$TOPIC" cleanup.policy) || exit 1
          [ "$SPOL" = "$POLICY" ] || { echo "FAIL: source $TOPIC cleanup.policy=$SPOL, frozen contract says $POLICY"; exit 1; }
          SRET=$(eff "$SRC" "$TOPIC" retention.ms) || exit 1
          [ "$SRET" = "$RET" ] || { echo "FAIL: source $TOPIC retention.ms=$SRET, frozen contract says $RET"; exit 1; }

          # pre-create target topic to the FROZEN contract (idempotent; §7.3 forbids ever
          # recreating/truncating an existing target)...
          "$KBIN/kafka-topics" --bootstrap-server "$TGT" --create --if-not-exists --topic "$TOPIC" \
            --partitions "$PARTS" --replication-factor 1 \
            --config cleanup.policy="$POLICY" --config retention.ms="$RET" 2>&1 | tail -1
          # ...and because --if-not-exists silently keeps an EXISTING malformed topic, assert the
          # target's ACTUAL shape now. A partition-count mismatch would silently re-shard the
          # key->partition mapping mid-stream; a policy mismatch would truncate the live view.
          TD=$("$KBIN/kafka-topics" --bootstrap-server "$TGT" --describe --topic "$TOPIC" 2>/dev/null)
          printf '%s\\n' "$TD" | grep -Eq "PartitionCount: ${PARTS}([[:space:]]|$)" || { echo "FAIL: target $TOPIC exists with wrong partition count (want $PARTS): $TD"; exit 1; }
          # EXACT policy equality, read the same way the source side reads it. The old per-policy
          # `case` matched SUBSTRINGS, so it could not express the U16 pure-compact contract at all:
          # a pre-existing es.futures.cvd.levels sitting at compact,delete satisfied a
          # "grep compact" arm while its delete half ages out the latest attestation — the one
          # record the producer reads back at startup (AA1). --create --if-not-exists repairs
          # nothing on an existing topic, so this assertion is the only thing standing between a
          # drifted target and a mirror that runs against it.
          TPOL=$(eff "$TGT" "$TOPIC" cleanup.policy) || exit 1
          [ "$TPOL" = "$POLICY" ] || { echo "FAIL: target $TOPIC cleanup.policy=$TPOL, frozen contract says $POLICY"; exit 1; }
          # Target EFFECTIVE retention must equal the frozen contract even for a PRE-EXISTING topic
          # (merge-gate finding 2): --create --if-not-exists binds nothing on an existing topic, and
          # a cvd.bars sitting at a finite default would silently delete overnight history.
          TRET=$(eff "$TGT" "$TOPIC" retention.ms) || exit 1
          [ "$TRET" = "$RET" ] || { echo "FAIL: target $TOPIC retention.ms=$TRET, frozen contract says $RET"; exit 1; }
          echo "config generated; target $TOPIC verified: $PARTS partition(s), $POLICY"
          # >>> END SHAPE ASSERTIONS <<<
        '''
      }
    }

    stage('Install launchd service') {
      when { expression { params.ACTION == 'install' } }
      steps {
        sh '''
          set -euo pipefail
          cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$MDIR/run-mirror.sh</string></array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>$MDIR/mirror.out.log</string>
  <key>StandardErrorPath</key><string>$MDIR/mirror.err.log</string>
</dict></plist>
PL
          launchctl unload "$PLIST" 2>/dev/null || true
          launchctl load "$PLIST"
          echo "launchd unit $LABEL loaded"
        '''
      }
    }

    stage('Verify (running + zero pollution)') {
      when { expression { params.ACTION == 'install' } }
      steps {
        sh '''
          set -euo pipefail
          sleep 8
          # A loaded-but-crashed unit still appears in `launchctl list` — require a NUMERIC PID
          # (merge-gate finding 3). Column 1 is the PID or "-".
          PID=$(launchctl list | awk -v l="$LABEL" '$3==l{print $1}')
          case "$PID" in (*[!0-9]*|"") echo "FAIL: service not running (launchctl pid='$PID')"; exit 1;; esac
          echo "mirror process pid=$PID"
          # pollution guard: MM1 must NOT ADD es4.* / es.es.es / heartbeat / mm2 topics to the target.
          # Judged as a DELTA against the pre-install baseline captured in Preflight: topics that were
          # already there (prod's dead-MM2 leftovers) are grandfathered, anything new fails the build.
          # Fail-closed: no baseline from THIS build, or an unreadable topic list, is a FAIL — never a
          # silent pass, because either one would make the delta vacuously empty.
          BASE="$MDIR/target-topics-preinstall.txt"
          [ -f "$BASE" ] || { echo "FAIL: pre-install topic baseline $BASE missing — cannot distinguish new pollution from legacy topics"; exit 1; }
          head -1 "$BASE" | grep -qxF "#BASELINE build=$BUILD_NUMBER target=$TGT" \
            || { echo "FAIL: baseline $BASE is not from this build/target (got: $(head -1 "$BASE"))"; exit 1; }
          # Everything the delta grandfathers was already proved approved by Preflight's growth gate,
          # so this is a report, not a decision — but print it every build so the approved set stays
          # visible in the log next to the result it licensed.
          GRAND=$(grep -E "$JUNK_RE" "$BASE" | tr '\\n' ' ') || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: junk scan of $BASE errored (grep rc=$rc)"; exit 1; }; GRAND=""; }
          echo "grandfathered pre-existing junk topics on $TGT: ${GRAND:-<none>}"
          # (read twice — kafka-topics --list gives flaky counts during MM startup)
          for i in 1 2; do
            L=$("$KBIN/kafka-topics" --bootstrap-server "$TGT" --list 2>/dev/null) \
              || { echo "FAIL: cannot list topics on $TGT"; exit 1; }
            # Both greps handle status EXPLICITLY (1 = no match, >1 = real error). This is the
            # decisive guard: a blanket `|| true` here would turn an unreadable baseline file into
            # an empty delta and PASS a genuinely polluted target.
            JUNK=$(printf '%s\\n' "$L" | grep -E "$JUNK_RE") || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: junk scan of $TGT errored (grep rc=$rc)"; exit 1; }; JUNK=""; }
            NEW=""
            if [ -n "$JUNK" ]; then
              NEW=$(printf '%s\\n' "$JUNK" | grep -vxFf "$BASE") || { rc=$?; [ "$rc" = 1 ] || { echo "FAIL: baseline subtraction errored (grep rc=$rc)"; exit 1; }; NEW=""; }
            fi
            if [ -n "$NEW" ]; then J=$(printf '%s\\n' "$NEW" | wc -l | tr -d ' '); else J=0; fi
            echo "read $i: new-junk-topics=$J  target-topic-present=$(printf '%s\\n' "$L" | grep -c "^$TOPIC$")"
            [ "$J" = "0" ] || { echo "FAIL: mirror polluted the target with $J NEW junk topic(s):"; printf '%s\\n' "$NEW" | sed 's/^/  /'; exit 1; }
            sleep 2
          done
          # End-to-end progress proof (merge-gate finding 3): the mirror consumer-group lag on the
          # SOURCE must drain to <= 5 within 180s. Works in every topic state: empty topic = lag 0
          # immediately; history topic = drains the earliest-bootstrap copy; live 1 Hz topic =
          # proves continuous replication. (Cross-broker offset comparison cannot do this:
          # compaction makes source offsets sparse and target offsets dense.)
          GRP="es-cvd-mirror-${TARGET_SPX_CLUSTER_IP}-${TOPIC}"
          ok=""; LAG=unread
          for i in $(seq 1 36); do
            # Column layout: GROUP TOPIC PARTITION CURRENT LOG-END LAG ... — the topic is $2 and the
            # lag is $6, and the sum is emitted ONLY when at least one partition row matched: a
            # EMPTY-topic rule (install #6): an earliest-bootstrap consumer on a ZERO-record log never
            # commits, so its row shows CURRENT '-' forever — with LOG-END 0 there is nothing to
            # copy and that IS drained; with LOG-END > 0 it is merely pre-commit and we wait.
            # missing group, malformed output, or a malformed LAG/LOG-END field all
            # print NOTHING (round 3: awk's string->0 coercion made NOT_A_LAG read as drained), so
            # accident (merge-gate round 2: matching $1 made an absent group read as lag 0).
            LAG=$("$KBIN/kafka-consumer-groups" --bootstrap-server "$SRC" --describe --group "$GRP" 2>/dev/null \
                  | awk -v t="$TOPIC" '$2==t {
                        if ($5 !~ /^[0-9]+$/)               { bad++ }             # LOG-END must be numeric on EVERY row
                        else if ($6 ~ /^[0-9]+$/)           { s+=$6; n++ }        # committed: real lag
                        else if ($6=="-" && $5=="0")        { n++ }               # EMPTY partition: 0 to copy IS drained
                        else if ($6=="-")                   { wait++ }            # pre-commit on a non-empty log: WHOLE read waits
                        else                                { bad++ }
                     } END{ if (bad > 0 || wait > 0) exit 0; if (n > 0) print s+0 }')
            if [ -n "$LAG" ] && [ "$LAG" -le 5 ] 2>/dev/null; then ok=yes; echo "replication lag=$LAG (drained)"; break; fi
            sleep 5
          done
          [ "$ok" = yes ] || { echo "FAIL: mirror group $GRP lag did not drain within 180s (last=$LAG)"; exit 1; }
          echo "VERIFIED: $LABEL running (pid=$PID), only $TOPIC mirrored, lag drained, no NEW pollution on $TGT."
        '''
      }
    }
  }
}
