pipeline {
  agent {
    label 'hpsf-replay-agent'
  }
  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  parameters {
    string(name: 'JENKINS_ALLOWED_DEPLOY_BRANCH', defaultValue: 'main', description: 'Allowed branch for this deploy/replay Jenkinsfile checkout guard')
    string(name: 'OPTIONS_EDGE_BRANCH', defaultValue: 'main', description: 'options-edge branch used by replay validation helpers')
    string(name: 'CONTRACTS_BRANCH', defaultValue: 'main', description: 'options-edge-contracts branch used by replay')
    string(name: 'DATABENTO_FEED_BRANCH', defaultValue: 'main', description: 'options-edge-databento-feed branch used by replay')
    string(name: 'PROCESSING_BRANCH', defaultValue: 'main', description: 'options-edge-processing branch used to build HPSF replay image')
    string(name: 'INTEGRATION_TEST_BRANCH', defaultValue: 'main', description: 'options-edge-integration-test branch used by replay')
    string(name: 'FEED_GATEWAY_BRANCH', defaultValue: 'main', description: 'option-edge-feed-gateway branch used by replay')
    string(name: 'REPLAY_DATE', defaultValue: '', description: 'Historical replay date, for example 2026-06-11. Required.')
    string(name: 'REPLAY_START', defaultValue: '', description: 'Replay start UTC. Empty derives <REPLAY_DATE>T13:30:00Z.')
    string(name: 'REPLAY_END', defaultValue: '', description: 'Replay end UTC. Empty derives <REPLAY_DATE>T20:00:00Z.')
    string(name: 'OPRA_DATASET', defaultValue: 'OPRA.PILLAR', description: 'Databento OPRA dataset')
    string(name: 'OPRA_SCHEMA', defaultValue: 'tcbbo', description: 'Databento OPRA schema')
    string(name: 'ES_DATASET', defaultValue: 'GLBX.MDP3', description: 'Databento ES dataset')
    string(name: 'ES_SCHEMA', defaultValue: 'trades', description: 'Databento ES schema')
    choice(name: 'ES_REFERENCE_MODE', choices: ['PINNED_RAW_CONTRACT', 'CONTINUOUS_FRONT', 'AUTO_LIQUIDITY_SELECT'], description: 'ES reference mode')
    string(name: 'ES_SYMBOL', defaultValue: 'ESM6', description: 'Selected ES symbol for pinned replay')
    string(name: 'ES_STYPE_IN', defaultValue: 'raw_symbol', description: 'Databento stype_in for selected ES symbol')
    booleanParam(name: 'COMPARE_NEXT_CONTRACT_VOLUME', defaultValue: true, description: 'Record ESM6 vs ESU6 comparison')
    string(name: 'NEXT_CONTRACT_SYMBOL', defaultValue: 'ESU6', description: 'Next ES contract for comparison')
    string(name: 'TOPIC_PREFIX', defaultValue: '', description: 'Replay topic prefix. Empty derives options.replay.<REPLAY_DATE> from REPLAY_DATE.')
    choice(name: 'REPLAY_SPEED', choices: ['FAST', 'REALTIME'], description: 'Replay publishing speed')
    string(name: 'HPSF_REPLAY_TICK_BY_TICK', defaultValue: 'false', description: 'Replay publish sampling. yes/true publishes every tick; false publishes one record per topic/key/second.')
    string(name: 'HPSF_MODE', defaultValue: 'REPLAY', description: 'HPSF mode')
    string(name: 'HPSF_STATE_DIR', defaultValue: '', description: 'Remote HPSF replay state dir. Empty derives /home/options-edge/data/kafka-streams/hpsf-replay-<REPLAY_DATE>.')
    string(name: 'HPSF_PROCESSING_IMAGE', defaultValue: '', description: 'Replay-only HPSF processing image. Empty derives a unique replay tag; shared deploy tags such as dev/latest/main/prod are rejected.')
    string(name: 'BUILD_PLATFORM', defaultValue: 'linux/amd64', description: 'Docker buildx target platform for the replay image. Jenkins runs on Mac ARM; replay pods run on CentOS amd64 Kubernetes nodes.')
    string(name: 'HPSF_REPLAY_SOURCE_DIR', defaultValue: '', description: 'Prepared Databento JSONL replay files on the Jenkins agent. Empty derives .replay/data/hpsf-replay/<REPLAY_DATE> under the workspace.')
    string(name: 'HPSF_REPLAY_EVIDENCE_JSON', defaultValue: '', description: 'Optional prebuilt real replay evidence JSON from a completed replay run')
    string(name: 'HPSF_REPLAY_GROUP_CATCHUP_ATTEMPTS', defaultValue: '2000', description: 'Kafka consumer-group catch-up polling attempts for replay processors')
    string(name: 'REPLAY_TOPIC_PARTITIONS', defaultValue: '12', description: 'Replay OPRA, Stage A strike-flow, strike-score, and DLQ topic partitions. Keep at 12 for the Stage A replay tuning ladder.')
    string(name: 'HPSF_STAGE_A_REPLAY_STREAM_THREADS', defaultValue: '6', description: 'Stage A replay Kafka Streams processing threads. With 12 partitions use 6 as the starting point; try 8 only if lag remains high and CPU is not saturated; use 12 only if CPU/GC remain healthy.')
    string(name: 'HPSF_STAGE_A_REPLAY_CACHE_MAX_BYTES_BUFFERING', defaultValue: '134217728', description: 'Stage A replay Kafka Streams cache bytes')
    string(name: 'HPSF_STAGE_A_REPLAY_COMMIT_INTERVAL_MS', defaultValue: '5000', description: 'Stage A replay Kafka Streams commit interval')
    string(name: 'HPSF_STAGE_A_REPLAY_PROCESSING_GUARANTEE', defaultValue: 'at_least_once', description: 'Stage A replay Kafka Streams processing guarantee')
    string(name: 'HPSF_STAGE_A_REPLAY_PRODUCER_COMPRESSION_TYPE', defaultValue: 'lz4', description: 'Stage A replay Kafka Streams producer compression')
    string(name: 'HPSF_STAGE_A_REPLAY_CPU_REQUEST', defaultValue: '4', description: 'Stage A replay pod CPU request')
    string(name: 'HPSF_STAGE_A_REPLAY_CPU_LIMIT', defaultValue: '8', description: 'Stage A replay pod CPU limit')
    string(name: 'HPSF_STAGE_A_REPLAY_MEMORY_REQUEST', defaultValue: '8Gi', description: 'Stage A replay pod memory request')
    string(name: 'HPSF_STAGE_A_REPLAY_MEMORY_LIMIT', defaultValue: '12Gi', description: 'Stage A replay pod memory limit')
    string(name: 'HPSF_STAGE_A_REPLAY_EPHEMERAL_STORAGE_REQUEST', defaultValue: '10Gi', description: 'Stage A replay pod ephemeral-storage request')
    string(name: 'HPSF_STAGE_A_REPLAY_EPHEMERAL_STORAGE_LIMIT', defaultValue: '20Gi', description: 'Stage A replay pod ephemeral-storage limit')
    string(name: 'HPSF_STAGE_A_REPLAY_JAVA_TOOL_OPTIONS', defaultValue: '-Xms3g -Xmx8g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError', description: 'Stage A replay JVM options')
    string(name: 'HPSF_STAGE_B_REPLAY_STREAM_THREADS', defaultValue: '6', description: 'Stage B replay Kafka Streams processing threads')
    string(name: 'HPSF_STAGE_B_REPLAY_CPU_REQUEST', defaultValue: '6', description: 'Stage B replay pod CPU request')
    string(name: 'HPSF_STAGE_B_REPLAY_CPU_LIMIT', defaultValue: '10', description: 'Stage B replay pod CPU limit')
    string(name: 'HPSF_STAGE_B_REPLAY_MEMORY_REQUEST', defaultValue: '12Gi', description: 'Stage B replay pod memory request')
    string(name: 'HPSF_STAGE_B_REPLAY_MEMORY_LIMIT', defaultValue: '16Gi', description: 'Stage B replay pod memory limit')
    string(name: 'HPSF_STAGE_B_REPLAY_EPHEMERAL_STORAGE_REQUEST', defaultValue: '10Gi', description: 'Stage B replay pod ephemeral-storage request')
    string(name: 'HPSF_STAGE_B_REPLAY_EPHEMERAL_STORAGE_LIMIT', defaultValue: '20Gi', description: 'Stage B replay pod ephemeral-storage limit')
    string(name: 'HPSF_STAGE_B_STRIKE_FLOW_CONSUMED_LOG_ENABLED', defaultValue: 'false', description: 'Enable per-record Stage B strike-flow consumed JSON logs during replay')
    string(name: 'HPSF_STAGE_B_CHAIN_SHARDING_ENABLED', defaultValue: 'true', description: 'Enable Stage B sharded chain assembly shadow/evaluation path during replay')
    string(name: 'HPSF_STAGE_B_CHAIN_SHARDS', defaultValue: '12', description: 'Stage B chain shard count for replay')
    string(name: 'HPSF_STAGE_B_CHAIN_SHARD_SHADOW_MODE', defaultValue: 'true', description: 'Run sharded chain assembly in shadow mode before Phase 6 cutover')
    string(name: 'HPSF_STAGE_B_CHAIN_SHARD_EVALUATION_ENABLED', defaultValue: 'false', description: 'Use sharded assembled chain for evaluation only after parity passes')
    string(name: 'HPSF_STAGE_B_RAW_CHAIN_REPARTITION_FALLBACK_ENABLED', defaultValue: 'true', description: 'Allow raw by-chain fallback during sharded-chain rollout')
    string(name: 'HPSF_STAGE_B_CHAIN_SHARD_PARITY_REQUIRED', defaultValue: 'true', description: 'Require Stage B sharded-chain parity evidence in black-box validation')
    string(name: 'DATABENTO_API_KEY_CREDENTIAL_ID', defaultValue: 'options-edge-databento-api-key', description: 'Jenkins secret text credential for Databento API key')
    string(name: 'BUGZILLA_URL', defaultValue: 'http://192.168.100.252:8092', description: 'Bugzilla base URL')
    string(name: 'BUGZILLA_USER', defaultValue: 'admin@options-edge.local', description: 'Bugzilla user')
    string(name: 'BUGZILLA_PASSWORD_CREDENTIAL_ID', defaultValue: 'options-edge-bugzilla-password', description: 'Jenkins secret text credential for Bugzilla password/token')
  }

  environment {
    PATH = "/opt/homebrew/opt/openjdk@21/bin:/opt/homebrew/bin:/Users/abhinav/development/confluent-7.3.1/bin:/home/confluent/confluent-8.2.1/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"
    KAFKA_BOOTSTRAP_SERVERS = "${env.KAFKA_BOOTSTRAP_SERVERS ?: 'localhost:9092'}"
    KAFKA_REPLAY_POD_BOOTSTRAP_SERVERS = "${env.KAFKA_REPLAY_POD_BOOTSTRAP_SERVERS ?: 'host.docker.internal:9092'}"
    KAFKA_TOPIC_REPLICATION_FACTOR = '1'
    KAFKA_TOPIC_MIN_IN_SYNC_REPLICAS = '1'
    KAFKA_SCHEMA_REGISTRY_URL = "${env.KAFKA_SCHEMA_REGISTRY_URL ?: 'http://localhost:8081'}"
    KAFKA_REPLAY_POD_SCHEMA_REGISTRY_URL = "${env.KAFKA_REPLAY_POD_SCHEMA_REGISTRY_URL ?: 'http://host.docker.internal:8081'}"
    JENKINS_PUBLIC_URL = "${env.JENKINS_PUBLIC_URL ?: 'http://localhost:8085'}"
    NAMESPACE = "${env.NAMESPACE ?: 'options-edge'}"
    HPSF_REPLAY_POD_OVERRIDES = '{"spec":{"hostNetwork":true,"dnsPolicy":"ClusterFirstWithHostNet"}}'
    HPSF_REPLAY_ARTIFACT_DIR = 'artifacts'
    HPSF_REPLAY_EVIDENCE_LOCAL_ROOT = "${env.HPSF_REPLAY_EVIDENCE_LOCAL_ROOT ?: '/Users/abhinav/development/workspace/options-edge/evidence-report'}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          def replayDate = params.REPLAY_DATE?.trim()
          if (!replayDate) {
            error("REPLAY_DATE is required, for example 2026-06-11")
          }
          def replayDateId = replayDate.replaceAll('[^0-9]', '')
          if (replayDateId.length() != 8) {
            error("REPLAY_DATE must produce an 8 digit replay date id, got '${replayDate}'")
          }
          env.REPLAY_DATE = replayDate
          if (!params.REPLAY_START?.trim()) {
            env.REPLAY_START = "${replayDate}T13:30:00Z"
          }
          if (!params.REPLAY_END?.trim()) {
            env.REPLAY_END = "${replayDate}T20:00:00Z"
          }
          env.HPSF_REPLAY_DATE_ID = replayDateId
          env.HPSF_REPLAY_RUN_NAME = "hpsf-historical-replay-${replayDateId}"
          env.HPSF_REPLAY_BUILD_DIR = "build/hpsf-replay-${replayDateId}"
          env.HPSF_REPLAY_REPORT = "artifacts/hpsf-replay-report-${replayDateId}.md"
          if (!params.TOPIC_PREFIX?.trim()) {
            env.TOPIC_PREFIX = "options.replay.${replayDateId}"
          }
          if (!params.HPSF_STATE_DIR?.trim()) {
            env.HPSF_STATE_DIR = "/home/options-edge/data/kafka-streams/hpsf-replay-${replayDateId}"
          }
          if (!params.HPSF_REPLAY_SOURCE_DIR?.trim()) {
            env.HPSF_REPLAY_SOURCE_DIR = "${env.WORKSPACE}/.replay/data/hpsf-replay/${replayDateId}"
          }
          def processingBranch = params.PROCESSING_BRANCH?.trim() ?: 'main'
          def case2Branches = ['feature/hpsf-vix-mean-reversion-case2', 'feature/hpsf-case2-blackbox-coverage-diagnostics']
          env.HPSF_CASE2_REPLAY_BRANCH = case2Branches.contains(processingBranch) ? 'true' : 'false'
          def replayImage = params.HPSF_PROCESSING_IMAGE?.trim()
          if (!replayImage) {
            replayImage = "localhost:5000/options-edge-hpsf-processing:replay-${replayDateId}-${env.BUILD_NUMBER ?: 'manual'}"
          }
          def imageTag = replayImage.contains(':') ? replayImage.substring(replayImage.lastIndexOf(':') + 1) : ''
          def blockedReplayTags = ['dev', 'latest', 'main', 'prod', 'production', 'stable']
          if (blockedReplayTags.contains(imageTag)) {
            error("HPSF_PROCESSING_IMAGE must be replay-specific, not shared deploy tag '${imageTag}': ${replayImage}")
          }
          env.HPSF_PROCESSING_IMAGE = replayImage
          def effectiveBuildPlatform = params.BUILD_PLATFORM?.trim() ?: 'linux/amd64'
          if (!['linux/amd64', 'linux/arm64'].contains(effectiveBuildPlatform)) {
            error("Unsupported BUILD_PLATFORM '${effectiveBuildPlatform}'. Use linux/amd64 or linux/arm64.")
          }
          env.EFFECTIVE_BUILD_PLATFORM = effectiveBuildPlatform
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.HPSF_REPLAY_RUN_NAME}"
          currentBuild.description = "Replay date ${replayDate}; topics ${env.TOPIC_PREFIX ?: params.TOPIC_PREFIX}; processing ${processingBranch}; case2 ${env.HPSF_CASE2_REPLAY_BRANCH}"
        }
        sh '''
          set -euo pipefail
          export JENKINS_ALLOWED_DEPLOY_BRANCH="${JENKINS_ALLOWED_DEPLOY_BRANCH:-main}"
          scripts/jenkins/enforce-main-branch.sh
          git rev-parse HEAD > build-git-sha.txt
          rm -rf artifacts "$HPSF_REPLAY_BUILD_DIR" artifact-manifest.json
          mkdir -p artifacts/logs "$HPSF_REPLAY_BUILD_DIR/logs" .replay
        '''
      }
    }

    stage('Checkout repos') {
      steps {
        sh '''
          set -euo pipefail
          rm -rf .replay
          mkdir -p .replay
          clone_branch() {
            repo="$1"
            branch="$2"
            target="$3"
            git clone --depth 1 --branch "$branch" "$repo" "$target"
          }
          clone_branch git@github.com:abhinav-jain09/options-edge.git "${OPTIONS_EDGE_BRANCH:-main}" .replay/options-edge
          clone_branch git@github.com:abhinav-jain09/options-edge-contracts.git "${CONTRACTS_BRANCH:-main}" .replay/options-edge-contracts
          clone_branch git@github.com:abhinav-jain09/options-edge-databento-feed.git "${DATABENTO_FEED_BRANCH:-main}" .replay/options-edge-databento-feed
          clone_branch git@github.com:abhinav-jain09/options-edge-processing.git "${PROCESSING_BRANCH:-main}" .replay/options-edge-processing
          clone_branch git@github.com:abhinav-jain09/options-edge-integration-test.git "${INTEGRATION_TEST_BRANCH:-main}" .replay/options-edge-integration-test
          clone_branch git@github.com:abhinav-jain09/option-edge-feed-gateway.git "${FEED_GATEWAY_BRANCH:-main}" .replay/option-edge-feed-gateway || true
          git -C .replay/options-edge-processing rev-parse HEAD > artifacts/hpsf-processing-source-sha.txt
          git -C .replay/options-edge-processing branch --show-current > artifacts/hpsf-processing-source-branch.txt
        '''
      }
    }

    stage('Build') {
      steps {
        sh '''
          set -euo pipefail
          if [ -n "${JAVA_HOME:-}" ] && [ ! -x "${JAVA_HOME}/bin/java" ]; then
            unset JAVA_HOME
          fi
          if [ -z "${JAVA_HOME:-}" ]; then
            for candidate in /opt/homebrew/opt/openjdk@21 /usr/lib/jvm/java-26 /usr/lib/jvm/java-21; do
              if [ -x "$candidate/bin/java" ]; then
                export JAVA_HOME="$candidate"
                break
              fi
            done
          fi
          if [ -z "${JAVA_HOME:-}" ] || [ ! -x "${JAVA_HOME}/bin/java" ]; then
            echo "No valid JAVA_HOME found for Maven replay build" >&2
            exit 1
          fi
          export MAVEN_SKIP_RC=true
          export PATH="$JAVA_HOME/bin:$PATH"
          unset HPSF_STAGE_B_CHAIN_SHARDING_ENABLED \
            HPSF_STAGE_B_CHAIN_SHARDS \
            HPSF_STAGE_B_CHAIN_SHARD_SHADOW_MODE \
            HPSF_STAGE_B_CHAIN_SHARD_EVALUATION_ENABLED \
            HPSF_STAGE_B_RAW_CHAIN_REPARTITION_FALLBACK_ENABLED \
            HPSF_STAGE_B_CHAIN_SHARD_PARITY_REQUIRED \
            HPSF_STAGE_B_STRIKE_FLOW_CONSUMED_LOG_ENABLED \
            HPSF_STAGE_B_REPLAY_STREAM_THREADS \
            HPSF_VOL_REGIME_ENABLED \
            HPSF_VOL_REGIME_REQUIRE_VIX_FOR_MEAN_REVERSION \
            HPSF_MEAN_REVERSION_ENABLED \
            HPSF_HTF_TREND_ENABLED \
            HPSF_CASE2_DIAGNOSTIC_REQUIRED \
            HPSF_CASE2_EXPECTED_SCENARIO
          java -version
          (cd .replay/options-edge-contracts && mvn -B test package)
          (
            cd .replay/options-edge-databento-feed
            FEED_PYTHON="$(command -v python3.13 || command -v python3.12 || command -v python3.11 || true)"
            if [ -z "$FEED_PYTHON" ]; then
              echo "Python 3.11+ is required for options-edge-databento-feed historical replay" >&2
              exit 1
            fi
            "$FEED_PYTHON" -m venv .venv
            .venv/bin/python -m pip install --upgrade pip
            .venv/bin/python -m pip install -e .
            .venv/bin/python -m compileall src
            PYTHONPATH=src .venv/bin/python -m unittest tests.test_hpsf_replay_es_reference tests.test_hpsf_historical_replay tests.test_hpsf_mapping
          )
          (cd .replay/options-edge-processing && mvn -B -pl hpsf-processing-service -am test package)
          docker buildx inspect options-edge-builder >/dev/null 2>&1 || docker buildx create --name options-edge-builder --use
          docker buildx use options-edge-builder
          docker buildx build \
            --platform "$EFFECTIVE_BUILD_PLATFORM" \
            -t "$HPSF_PROCESSING_IMAGE" \
            --push \
            -f .replay/options-edge-processing/hpsf-processing-service/Dockerfile \
            .replay/options-edge-processing/hpsf-processing-service
          docker buildx imagetools inspect "$HPSF_PROCESSING_IMAGE" | tee artifacts/hpsf-processing-image-imagetools.txt
          grep -Eq "Platform:[[:space:]]*$EFFECTIVE_BUILD_PLATFORM($|[[:space:]])|$EFFECTIVE_BUILD_PLATFORM" artifacts/hpsf-processing-image-imagetools.txt
          (cd .replay/options-edge-integration-test && mvn -B test package)
          python3 scripts/hpsf/test_merge_stage_b_performance_metrics.py
        '''
      }
    }

    stage('Static safety check') {
      steps {
        sh '''
          set -euo pipefail
          export HPSF_REPO_ROOTS="$PWD:$PWD/.replay/options-edge:$PWD/.replay/options-edge-databento-feed:$PWD/.replay/options-edge-processing:$PWD/.replay/options-edge-integration-test"
          scripts/hpsf/validate-hpsf-spec-compliance.sh
        '''
      }
    }

    stage('Create replay topics') {
      steps {
        sh '''
          set -euo pipefail
          export HPSF_REPLAY_RESET_TOPICS=true
          export REPLAY_DATE="${REPLAY_DATE}"
          export TOPIC_PREFIX="${TOPIC_PREFIX}"
          export REPLAY_TOPIC_PARTITIONS="${REPLAY_TOPIC_PARTITIONS:-12}"
          compact_date="${REPLAY_DATE//-/}"
          export UNDERLYING_TOPIC_PREFIX="${UNDERLYING_TOPIC_PREFIX:-underlying.replay.${compact_date}}"
          scripts/hpsf/create-replay-topics-20260612.sh | tee artifacts/logs/create-replay-topics.log
        '''
      }
    }

    stage('Resolve ES reference') {
      steps {
        withCredentials([string(credentialsId: params.DATABENTO_API_KEY_CREDENTIAL_ID, variable: 'DATABENTO_API_KEY')]) {
          sh '''
            set -euo pipefail
            export REPLAY_DATE="${REPLAY_DATE}"
            export REPLAY_START="${REPLAY_START}"
            export REPLAY_END="${REPLAY_END}"
            export OPRA_DATASET="${OPRA_DATASET}"
            export OPRA_SCHEMA="${OPRA_SCHEMA}"
            export ES_DATASET="${ES_DATASET}"
            export ES_SCHEMA="${ES_SCHEMA}"
            export ES_REFERENCE_MODE="${ES_REFERENCE_MODE}"
            export ES_SYMBOL="${ES_SYMBOL}"
            export ES_STYPE_IN="${ES_STYPE_IN}"
            export COMPARE_NEXT_CONTRACT_VOLUME="${COMPARE_NEXT_CONTRACT_VOLUME}"
            export NEXT_CONTRACT_SYMBOL="${NEXT_CONTRACT_SYMBOL}"
            export HPSF_REPLAY_SOURCE_DIR="${HPSF_REPLAY_SOURCE_DIR}"
            export HPSF_REPLAY_REFRESH_SOURCE=true
            export DATABENTO_FEED_REPO="$PWD/.replay/options-edge-databento-feed"
            export DATABENTO_FEED_PYTHON="$PWD/.replay/options-edge-databento-feed/.venv/bin/python"
            scripts/hpsf/download-databento-history.sh | tee artifacts/logs/resolve-es-reference.log
          '''
        }
      }
    }

    stage('Download / load historical Databento data') {
      steps {
        sh '''
          set -euo pipefail
          test -s "$HPSF_REPLAY_BUILD_DIR/download-summary.json"
          cp "$HPSF_REPLAY_BUILD_DIR/download-summary.json" artifacts/hpsf-download-summary.json
        '''
      }
    }

    stage('Publish replay input records') {
      steps {
        sh '''
          set -euo pipefail
          export REPLAY_DATE="${REPLAY_DATE}"
          export REPLAY_START="${REPLAY_START}"
          export REPLAY_END="${REPLAY_END}"
          export OPRA_DATASET="${OPRA_DATASET}"
          export OPRA_SCHEMA="${OPRA_SCHEMA}"
          export ES_DATASET="${ES_DATASET}"
          export ES_SCHEMA="${ES_SCHEMA}"
          export ES_REFERENCE_MODE="${ES_REFERENCE_MODE}"
          export ES_SYMBOL="${ES_SYMBOL}"
          export ES_STYPE_IN="${ES_STYPE_IN}"
          export COMPARE_NEXT_CONTRACT_VOLUME="${COMPARE_NEXT_CONTRACT_VOLUME}"
          export NEXT_CONTRACT_SYMBOL="${NEXT_CONTRACT_SYMBOL}"
          export TOPIC_PREFIX="${TOPIC_PREFIX}"
          export REPLAY_SPEED="${REPLAY_SPEED}"
          export HPSF_REPLAY_TICK_BY_TICK="${HPSF_REPLAY_TICK_BY_TICK:-false}"
          export HPSF_REPLAY_SOURCE_DIR="${HPSF_REPLAY_SOURCE_DIR}"
          export DATABENTO_FEED_REPO="$PWD/.replay/options-edge-databento-feed"
          export DATABENTO_FEED_PYTHON="$PWD/.replay/options-edge-databento-feed/.venv/bin/python"
          scripts/hpsf/publish-historical-replay.sh | tee artifacts/logs/publish-historical-replay.log
        '''
      }
    }

    stage('Run Stage A replay') {
      steps {
        sh '''
          set -euo pipefail
          pod="hpsf-stage-a-replay-${HPSF_REPLAY_DATE_ID}"
          stage_a_java_tool_options="${HPSF_STAGE_A_REPLAY_JAVA_TOOL_OPTIONS:--Xms3g -Xmx8g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError}"
          kubectl -n "$NAMESPACE" delete pod "$pod" --ignore-not-found=true
          kubectl -n "$NAMESPACE" run "$pod" --image="$HPSF_PROCESSING_IMAGE" --image-pull-policy=Always --restart=Never --overrides="$HPSF_REPLAY_POD_OVERRIDES" \
            --env=APP_MARKET_DATA_SOURCE=DATABENTO \
            --env=JAVA_TOOL_OPTIONS="$stage_a_java_tool_options" \
            --env=HPSF_MODE="$HPSF_MODE" \
            --env=HPSF_REPLAY_DATE="$REPLAY_DATE" \
            --env=HPSF_MARKET_CALENDAR_ALLOW_INCOMPLETE=true \
            --env=HPSF_MARKET_CALENDAR_MIN_HOLIDAYS_PER_YEAR=0 \
            --env=HPSF_MARKET_CALENDAR_REQUIRE_EARLY_CLOSES=false \
            --env=HPSF_ENABLED=true \
            --env=HPSF_TOPOLOGY_ENABLED=true \
            --env=HPSF_STAGE_A_ENABLED=true \
            --env=HPSF_STAGE_B_ENABLED=false \
            --env=HPSF_UNDERLYING_STATE_ENABLED=false \
            --env=HPSF_STREAMS_APPLICATION_ID=options-edge-hpsf-stage-a-replay-${HPSF_REPLAY_DATE_ID}-${BUILD_NUMBER:-manual} \
            --env=HPSF_STREAMS_STATE_DIR="$HPSF_STATE_DIR/stage-a-${BUILD_NUMBER:-manual}" \
            --env=HPSF_STREAMS_AUTO_OFFSET_RESET=earliest \
