        mkdir -p artifacts/logs "$HPSF_REPLAY_BUILD_DIR/logs"
        export CODE_GIT_SHA="$(cat build-git-sha.txt 2>/dev/null || true)"
        job_path="$(printf '%s' "$JOB_NAME" | sed 's#/#/job/#g')"
        export BUILD_URL="${BUILD_URL:-${JENKINS_PUBLIC_URL%/}/job/${job_path}/${BUILD_NUMBER}/}"
        replay_topic_prefix="${TOPIC_PREFIX:-options.replay.${HPSF_REPLAY_DATE_ID:-${REPLAY_DATE//-/}}}"
        export HPSF_REPLAY_FAILURE_REASON="Jenkins failed before a valid PASS replay report was generated. Verify required credentials including DATABENTO_API_KEY_CREDENTIAL_ID=${DATABENTO_API_KEY_CREDENTIAL_ID:-options-edge-databento-api-key}, prepared replay source data, Kafka, Kubernetes, and Databento access in the console log."
        export HPSF_REPLAY_FAILURE_CODE="JENKINS_REPLAY_PIPELINE_FAILED"
        if [ -s artifacts/logs/replay-failure-code.env ]; then
          . artifacts/logs/replay-failure-code.env
          export HPSF_REPLAY_FAILURE_CODE
          export HPSF_REPLAY_FAILURE_REASON
        fi
        if grep -F "strike-flow count = 0" artifacts/logs/validate-stage-a.log >/dev/null 2>&1; then
          export HPSF_REPLAY_FAILURE_CODE="STAGE_A_STRIKE_FLOW_EMPTY"
          export HPSF_REPLAY_FAILURE_REASON="Stage A replay started but emitted zero strike-flow records from ${replay_topic_prefix}.opra.tcbbo into ${replay_topic_prefix}.hpsf.strike-flow during validation."
        fi
        scripts/hpsf/collect-replay-root-cause-diagnostics.sh || true
        current_report_matches_build=false
        if [ -s "$HPSF_REPLAY_REPORT" ] && grep -F "Build number: ${BUILD_NUMBER:-}" "$HPSF_REPLAY_REPORT" >/dev/null 2>&1; then
          current_report_matches_build=true
        fi
        if [ "$current_report_matches_build" != "true" ] || [ ! -s artifacts/hpsf-replay-summary.json ] || [ ! -s artifacts/replay-validation-result.json ]; then
          rm -f \
            "$HPSF_REPLAY_REPORT" \
            artifacts/hpsf-replay-summary.json \
            artifacts/replay-validation-result.json \
            artifacts/hpsf-stage-a-validation.json \
            "$HPSF_REPLAY_BUILD_DIR/evidence.json" \
            "$HPSF_REPLAY_BUILD_DIR/stage-a-validation.json"
          export HPSF_REPLAY_REPORT_ALLOW_FAIL=true
          scripts/hpsf/run-hpsf-replay-20260612.sh --dry-run || true
        fi
        scripts/hpsf/archive-replay-evidence-report.sh | tee artifacts/logs/archive-replay-evidence-report.log || true
      '''
      archiveArtifacts artifacts: ".replay/options-edge/evidence-report/${env.HPSF_REPLAY_RUN_NAME}/**/*.md", fingerprint: true, allowEmptyArchive: false
      archiveArtifacts artifacts: 'artifacts/logs/replay-agent-preflight.log,artifacts/hpsf-download-summary.json,artifacts/hpsf-publish-summary.json,artifacts/logs/replay-source-topic-offsets-before-stage-a.log,artifacts/logs/replay-source-health-before-stage-a.json,artifacts/logs/stage-a-pod.json,artifacts/logs/stage-a-describe.log,artifacts/logs/stage-a-events.log,artifacts/logs/stage-a-previous.log,artifacts/logs/stage-a-env-redacted.log,artifacts/logs/stage-a.log,artifacts/logs/stage-a-consumer-group.log,artifacts/logs/stage-a-consumer-group-catchup.log,artifacts/logs/stage-a-internal-topics.log,artifacts/logs/replay-strike-flow-topic-offsets-before-stage-b.log,artifacts/logs/stage-b-pod.json,artifacts/logs/stage-b.log,artifacts/hpsf-replay-summary.json,artifacts/replay-validation-result.json', fingerprint: true, allowEmptyArchive: true
      archiveArtifacts artifacts: 'artifacts/hpsf-0dte-data-quality-validation-result.json,artifacts/hpsf-0dte-data-quality-validation-report.md,artifacts/hpsf-chain-coverage-drill-result.json,artifacts/hpsf-chain-coverage-drill-report.md,artifacts/hpsf-near-spot-quote-drill-result.json,artifacts/hpsf-near-spot-quote-drill-report.md,artifacts/hpsf-dlq-impact-result.json,artifacts/hpsf-dlq-impact-report.md,artifacts/hpsf-stage-b-hot-partition-result.json,artifacts/hpsf-stage-b-hot-partition-report.md,artifacts/hpsf-stage-b-chain-shard-parity-result.json,artifacts/hpsf-stage-b-chain-shard-parity-report.md,artifacts/hpsf-blackbox-validation-result.json,artifacts/hpsf-blackbox-validation-report.md,artifacts/logs/hpsf-blackbox-replay-validation.log,artifacts/logs/hpsf-blackbox-replay-validation.exit-code', fingerprint: true, allowEmptyArchive: true
      archiveArtifacts artifacts: 'artifacts/case2-diagnostic-validation-result.json,artifacts/case2-diagnostic-validation-report.md', fingerprint: true, allowEmptyArchive: true
    }
    always {
      sh '''
        set +e
        replay_date_id="${HPSF_REPLAY_DATE_ID:-${REPLAY_DATE//-/}}"
        kubectl -n "${NAMESPACE:-options-edge}" delete pod "hpsf-stage-a-replay-${replay_date_id}" --ignore-not-found=true
        kubectl -n "${NAMESPACE:-options-edge}" delete pod "hpsf-underlying-replay-${replay_date_id}" --ignore-not-found=true
        kubectl -n "${NAMESPACE:-options-edge}" delete pod "hpsf-stage-b-replay-${replay_date_id}" --ignore-not-found=true
      '''
    }
  }
}
