pipeline {
  agent any
  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
  }

  parameters {
    string(name: 'REPLAY_DATE', defaultValue: '2026-06-12', description: 'Historical replay date')
    string(name: 'REPLAY_START', defaultValue: '2026-06-12T13:30:00Z', description: 'Replay start UTC')
    string(name: 'REPLAY_END', defaultValue: '2026-06-12T20:00:00Z', description: 'Replay end UTC')
    string(name: 'OPRA_DATASET', defaultValue: 'OPRA.PILLAR', description: 'Databento OPRA dataset')
    string(name: 'OPRA_SCHEMA', defaultValue: 'tcbbo', description: 'Databento OPRA schema')
    string(name: 'ES_DATASET', defaultValue: 'GLBX.MDP3', description: 'Databento ES dataset')
    string(name: 'ES_SCHEMA', defaultValue: 'trades', description: 'Databento ES schema')
    choice(name: 'ES_REFERENCE_MODE', choices: ['PINNED_RAW_CONTRACT', 'CONTINUOUS_FRONT', 'AUTO_LIQUIDITY_SELECT'], description: 'ES reference mode')
    string(name: 'ES_SYMBOL', defaultValue: 'ESM6', description: 'Selected ES symbol for pinned replay')
    string(name: 'ES_STYPE_IN', defaultValue: 'raw_symbol', description: 'Databento stype_in for selected ES symbol')
    booleanParam(name: 'COMPARE_NEXT_CONTRACT_VOLUME', defaultValue: true, description: 'Record ESM6 vs ESU6 comparison')
    string(name: 'NEXT_CONTRACT_SYMBOL', defaultValue: 'ESU6', description: 'Next ES contract for comparison')
    string(name: 'TOPIC_PREFIX', defaultValue: 'options.replay.20260612', description: 'Replay topic prefix')
    choice(name: 'REPLAY_SPEED', choices: ['FAST', 'REALTIME'], description: 'Replay publishing speed')
    string(name: 'HPSF_MODE', defaultValue: 'REPLAY', description: 'HPSF mode')
    string(name: 'HPSF_STATE_DIR', defaultValue: '/home/options-edge/data/kafka-streams/hpsf-replay-20260612', description: 'Remote HPSF replay state dir')
    string(name: 'HPSF_PROCESSING_IMAGE', defaultValue: '192.168.100.252:5000/options-edge-hpsf-processing:dev', description: 'HPSF processing image')
    string(name: 'HPSF_REPLAY_SOURCE_DIR', defaultValue: '/home/options-edge/data/hpsf-replay/20260612', description: 'Prepared Databento JSONL replay files on Jenkins/remote')
    string(name: 'HPSF_REPLAY_EVIDENCE_JSON', defaultValue: '', description: 'Optional prebuilt real replay evidence JSON from a completed replay run')
    string(name: 'DATABENTO_API_KEY_CREDENTIAL_ID', defaultValue: 'options-edge-databento-api-key', description: 'Jenkins secret text credential for Databento API key')
    string(name: 'BUGZILLA_URL', defaultValue: 'http://192.168.100.252:8092', description: 'Bugzilla base URL')
    string(name: 'BUGZILLA_USER', defaultValue: 'admin@options-edge.local', description: 'Bugzilla user')
    string(name: 'BUGZILLA_PASSWORD_CREDENTIAL_ID', defaultValue: 'options-edge-bugzilla-password', description: 'Jenkins secret text credential for Bugzilla password/token')
    password(name: 'BUGZILLA_PASSWORD', defaultValue: '', description: 'Bugzilla password/token for replay comment')
  }

  environment {
    JAVA_HOME = '/usr/lib/jvm/java-26'
    PATH = "/usr/lib/jvm/java-26/bin:/home/confluent/confluent-8.2.1/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"
    KAFKA_BOOTSTRAP_SERVERS = "${env.KAFKA_BOOTSTRAP_SERVERS ?: '192.168.100.252:9092,192.168.100.252:9094,192.168.100.252:9096'}"
    KAFKA_TOPIC_REPLICATION_FACTOR = '1'
    KAFKA_TOPIC_MIN_IN_SYNC_REPLICAS = '1'
    KAFKA_SCHEMA_REGISTRY_URL = "${env.KAFKA_SCHEMA_REGISTRY_URL ?: 'http://192.168.100.252:8082'}"
    JENKINS_PUBLIC_URL = "${env.JENKINS_PUBLIC_URL ?: 'http://192.168.100.252:8085'}"
    NAMESPACE = "${env.NAMESPACE ?: 'options-edge'}"
    HPSF_REPLAY_POD_OVERRIDES = '{"spec":{"hostNetwork":true,"dnsPolicy":"ClusterFirstWithHostNet"}}'
    HPSF_REPLAY_BUILD_DIR = 'build/hpsf-replay-20260612'
    HPSF_REPLAY_ARTIFACT_DIR = 'artifacts'
    HPSF_REPLAY_REPORT = 'artifacts/hpsf-replay-report-20260612.md'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh '''
          set -euo pipefail
          git rev-parse HEAD > build-git-sha.txt
          rm -rf artifacts build/hpsf-replay-20260612 artifact-manifest.json
          mkdir -p artifacts/logs build/hpsf-replay-20260612/logs .replay
        '''
      }
    }

    stage('Checkout repos') {
      steps {
        sh '''
          set -euo pipefail
          rm -rf .replay
          mkdir -p .replay
          git clone --depth 1 git@github.com:abhinav-jain09/options-edge.git .replay/options-edge
          git clone --depth 1 git@github.com:abhinav-jain09/options-edge-contracts.git .replay/options-edge-contracts
          git clone --depth 1 git@github.com:abhinav-jain09/options-edge-databento-feed.git .replay/options-edge-databento-feed
          git clone --depth 1 git@github.com:abhinav-jain09/options-edge-processing.git .replay/options-edge-processing
          git clone --depth 1 git@github.com:abhinav-jain09/options-edge-integration-test.git .replay/options-edge-integration-test
          git clone --depth 1 git@github.com:abhinav-jain09/option-edge-feed-gateway.git .replay/option-edge-feed-gateway || true
        '''
      }
    }

    stage('Build') {
      steps {
        sh '''
          set -euo pipefail
          export JAVA_HOME=/usr/lib/jvm/java-26
          export MAVEN_SKIP_RC=true
          export PATH="$JAVA_HOME/bin:$PATH"
          java -version
          (cd .replay/options-edge-contracts && mvn -B test package)
          (
            cd .replay/options-edge-databento-feed
            FEED_PYTHON="$(command -v python3.13 || command -v python3.12 || command -v python3.11 || true)"
            if [ -z "$FEED_PYTHON" ]; then
              echo "Python 3.11+ is required for options-edge-databento-feed historical replay" >&2
              exit 1
            fi
            "$FEED_PYTHON" -m venv .venv
            .venv/bin/python -m pip install --upgrade pip
            .venv/bin/python -m pip install -e .
            .venv/bin/python -m compileall src
            PYTHONPATH=src .venv/bin/python -m unittest tests.test_hpsf_replay_es_reference tests.test_hpsf_historical_replay tests.test_hpsf_mapping
          )
          (cd .replay/options-edge-processing && mvn -B -pl hpsf-processing-service -am test package)
          docker build -t "$HPSF_PROCESSING_IMAGE" -f .replay/options-edge-processing/hpsf-processing-service/Dockerfile .replay/options-edge-processing/hpsf-processing-service
          docker push "$HPSF_PROCESSING_IMAGE"
          (cd .replay/options-edge-integration-test && mvn -B test package)
          python3 scripts/hpsf/test_merge_stage_b_performance_metrics.py
        '''
      }
    }

    stage('Static safety check') {
      steps {
        sh '''
          set -euo pipefail
          export HPSF_REPO_ROOTS="$PWD:$PWD/.replay/options-edge:$PWD/.replay/options-edge-databento-feed:$PWD/.replay/options-edge-processing:$PWD/.replay/options-edge-integration-test"
          scripts/hpsf/validate-hpsf-spec-compliance.sh
        '''
      }
    }

    stage('Create replay topics') {
      steps {
        sh '''
          set -euo pipefail
          export HPSF_REPLAY_RESET_TOPICS=true
          scripts/hpsf/create-replay-topics-20260612.sh | tee artifacts/logs/create-replay-topics.log
        '''
      }
    }

    stage('Resolve ES reference') {
      steps {
        withCredentials([string(credentialsId: params.DATABENTO_API_KEY_CREDENTIAL_ID, variable: 'DATABENTO_API_KEY')]) {
          sh '''
            set -euo pipefail
            export REPLAY_DATE="${REPLAY_DATE}"
            export REPLAY_START="${REPLAY_START}"
            export REPLAY_END="${REPLAY_END}"
            export OPRA_DATASET="${OPRA_DATASET}"
            export OPRA_SCHEMA="${OPRA_SCHEMA}"
            export ES_DATASET="${ES_DATASET}"
            export ES_SCHEMA="${ES_SCHEMA}"
            export ES_REFERENCE_MODE="${ES_REFERENCE_MODE}"
            export ES_SYMBOL="${ES_SYMBOL}"
            export ES_STYPE_IN="${ES_STYPE_IN}"
            export COMPARE_NEXT_CONTRACT_VOLUME="${COMPARE_NEXT_CONTRACT_VOLUME}"
            export NEXT_CONTRACT_SYMBOL="${NEXT_CONTRACT_SYMBOL}"
            export HPSF_REPLAY_SOURCE_DIR="${HPSF_REPLAY_SOURCE_DIR}"
            export HPSF_REPLAY_REFRESH_SOURCE=true
            export DATABENTO_FEED_REPO="$PWD/.replay/options-edge-databento-feed"
            export DATABENTO_FEED_PYTHON="$PWD/.replay/options-edge-databento-feed/.venv/bin/python"
            scripts/hpsf/download-databento-history.sh | tee artifacts/logs/resolve-es-reference.log
          '''
        }
      }
    }

    stage('Download / load historical Databento data') {
      steps {
        sh '''
          set -euo pipefail
          test -s build/hpsf-replay-20260612/download-summary.json
          cp build/hpsf-replay-20260612/download-summary.json artifacts/hpsf-download-summary.json
        '''
      }
    }

    stage('Publish replay input records') {
      steps {
        sh '''
          set -euo pipefail
          export REPLAY_DATE="${REPLAY_DATE}"
          export REPLAY_START="${REPLAY_START}"
          export REPLAY_END="${REPLAY_END}"
          export OPRA_DATASET="${OPRA_DATASET}"
          export OPRA_SCHEMA="${OPRA_SCHEMA}"
          export ES_DATASET="${ES_DATASET}"
          export ES_SCHEMA="${ES_SCHEMA}"
          export ES_REFERENCE_MODE="${ES_REFERENCE_MODE}"
          export ES_SYMBOL="${ES_SYMBOL}"
          export ES_STYPE_IN="${ES_STYPE_IN}"
          export COMPARE_NEXT_CONTRACT_VOLUME="${COMPARE_NEXT_CONTRACT_VOLUME}"
          export NEXT_CONTRACT_SYMBOL="${NEXT_CONTRACT_SYMBOL}"
          export TOPIC_PREFIX="${TOPIC_PREFIX}"
          export REPLAY_SPEED="${REPLAY_SPEED}"
          export HPSF_REPLAY_SOURCE_DIR="${HPSF_REPLAY_SOURCE_DIR}"
          export DATABENTO_FEED_REPO="$PWD/.replay/options-edge-databento-feed"
          export DATABENTO_FEED_PYTHON="$PWD/.replay/options-edge-databento-feed/.venv/bin/python"
          scripts/hpsf/publish-historical-replay.sh | tee artifacts/logs/publish-historical-replay.log
        '''
      }
    }

    stage('Run Stage A replay') {
      steps {
        sh '''
          set -euo pipefail
          pod="hpsf-stage-a-replay-20260612"
          kubectl -n "$NAMESPACE" delete pod "$pod" --ignore-not-found=true
          kubectl -n "$NAMESPACE" run "$pod" --image="$HPSF_PROCESSING_IMAGE" --image-pull-policy=Always --restart=Never --overrides="$HPSF_REPLAY_POD_OVERRIDES" \
            --env=APP_MARKET_DATA_SOURCE=DATABENTO \
            --env=HPSF_MODE="$HPSF_MODE" \
            --env=HPSF_REPLAY_DATE="$REPLAY_DATE" \
            --env=HPSF_MARKET_CALENDAR_ALLOW_INCOMPLETE=true \
            --env=HPSF_MARKET_CALENDAR_MIN_HOLIDAYS_PER_YEAR=0 \
            --env=HPSF_MARKET_CALENDAR_REQUIRE_EARLY_CLOSES=false \
            --env=HPSF_ENABLED=true \
            --env=HPSF_TOPOLOGY_ENABLED=true \
            --env=HPSF_STAGE_A_ENABLED=true \
            --env=HPSF_STAGE_B_ENABLED=false \
            --env=HPSF_UNDERLYING_STATE_ENABLED=false \
            --env=HPSF_STREAMS_APPLICATION_ID=options-edge-hpsf-stage-a-replay-20260612-${BUILD_NUMBER:-manual} \
            --env=HPSF_STREAMS_STATE_DIR="$HPSF_STATE_DIR/stage-a-${BUILD_NUMBER:-manual}" \
            --env=HPSF_STREAMS_AUTO_OFFSET_RESET=earliest \
            --env=HPSF_STREAMS_PROCESSING_GUARANTEE=at_least_once \
            --env=HPSF_STREAMS_NUM_STREAM_THREADS=1 \
            --env=HPSF_STREAMS_CACHE_MAX_BYTES_BUFFERING=0 \
            --env=HPSF_STREAMS_CONSUMER_ISOLATION_LEVEL=read_uncommitted \
            --env=KAFKA_BOOTSTRAP_SERVERS="$KAFKA_BOOTSTRAP_SERVERS" \
            --env=KAFKA_SCHEMA_REGISTRY_URL="$KAFKA_SCHEMA_REGISTRY_URL" \
            --env=HPSF_TOPIC_OPRA_TCBBO="$TOPIC_PREFIX.opra.tcbbo" \
            --env=HPSF_TOPIC_STRIKE_FLOW="$TOPIC_PREFIX.hpsf.strike-flow" \
            --env=HPSF_TOPIC_SIGNAL="$TOPIC_PREFIX.hpsf.signal" \
            --env=HPSF_TOPIC_DLQ="$TOPIC_PREFIX.hpsf.dlq" \
            --env=HPSF_ORDER_PLACEMENT_ENABLED=false \
            --env=ORDER_PLACEMENT_ENABLED=false
          : > artifacts/logs/stage-a.log
          for attempt in $(seq 1 180); do
            phase="$(kubectl -n "$NAMESPACE" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
            kubectl -n "$NAMESPACE" logs "$pod" --tail=300 > artifacts/logs/stage-a.log 2>/dev/null || true
            if grep -E 'HPSF Stage A topology enabled|HPSF Stage A consuming|HPSF Stage A producing' artifacts/logs/stage-a.log; then
              break
            fi
            if [ "$phase" = "Failed" ] || [ "$phase" = "Succeeded" ]; then
              kubectl -n "$NAMESPACE" describe pod "$pod" > artifacts/logs/stage-a-describe.log 2>/dev/null || true
              cat artifacts/logs/stage-a.log
              exit 1
            fi
            sleep 1
          done
          for attempt in $(seq 1 180); do
            phase="$(kubectl -n "$NAMESPACE" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
            kubectl -n "$NAMESPACE" logs "$pod" --tail=600 > artifacts/logs/stage-a.log 2>/dev/null || true
            if grep -E 'HPSF stage-a stream state transition .* -> RUNNING|state=stage-a=RUNNING' artifacts/logs/stage-a.log; then
              break
            fi
            if [ "$phase" = "Failed" ] || [ "$phase" = "Succeeded" ]; then
              kubectl -n "$NAMESPACE" describe pod "$pod" > artifacts/logs/stage-a-describe.log 2>/dev/null || true
              cat artifacts/logs/stage-a.log
              exit 1
            fi
            sleep 1
          done
          kubectl -n "$NAMESPACE" logs "$pod" --tail=600 > artifacts/logs/stage-a.log || true
          grep -E 'HPSF Stage A topology enabled|HPSF Stage A consuming|HPSF Stage A producing' artifacts/logs/stage-a.log
          grep -E 'HPSF stage-a stream state transition .* -> RUNNING|state=stage-a=RUNNING' artifacts/logs/stage-a.log
        '''
      }
    }

    stage('Validate Stage A replay') {
      steps {
        sh '''
          set -euo pipefail
          export REPLAY_DATE="${REPLAY_DATE}"
          export TOPIC_PREFIX="${TOPIC_PREFIX}"
          scripts/hpsf/validate-replay-output.sh --stage-a-only 2>&1 | tee artifacts/logs/validate-stage-a.log
        '''
      }
    }

    stage('Run underlying replay processor') {
      steps {
        sh '''
          set -euo pipefail
          pod="hpsf-underlying-replay-20260612"
          kubectl -n "$NAMESPACE" delete pod "$pod" --ignore-not-found=true
          kubectl -n "$NAMESPACE" run "$pod" --image="$HPSF_PROCESSING_IMAGE" --image-pull-policy=Always --restart=Never --overrides="$HPSF_REPLAY_POD_OVERRIDES" \
            --env=APP_MARKET_DATA_SOURCE=DATABENTO \
            --env=HPSF_MODE="$HPSF_MODE" \
            --env=HPSF_REPLAY_DATE="$REPLAY_DATE" \
            --env=HPSF_MARKET_CALENDAR_ALLOW_INCOMPLETE=true \
            --env=HPSF_MARKET_CALENDAR_MIN_HOLIDAYS_PER_YEAR=0 \
            --env=HPSF_MARKET_CALENDAR_REQUIRE_EARLY_CLOSES=false \
            --env=HPSF_ENABLED=true \
            --env=HPSF_TOPOLOGY_ENABLED=true \
            --env=HPSF_STAGE_A_ENABLED=false \
            --env=HPSF_STAGE_B_ENABLED=false \
            --env=HPSF_UNDERLYING_STATE_ENABLED=true \
            --env=HPSF_STREAMS_APPLICATION_ID=options-edge-hpsf-underlying-replay-20260612-${BUILD_NUMBER:-manual} \
            --env=HPSF_STREAMS_STATE_DIR="$HPSF_STATE_DIR/underlying-${BUILD_NUMBER:-manual}" \
            --env=HPSF_STREAMS_AUTO_OFFSET_RESET=earliest \
            --env=HPSF_STREAMS_PROCESSING_GUARANTEE=at_least_once \
            --env=HPSF_STREAMS_NUM_STREAM_THREADS=1 \
            --env=HPSF_STREAMS_CACHE_MAX_BYTES_BUFFERING=0 \
            --env=HPSF_STREAMS_CONSUMER_ISOLATION_LEVEL=read_uncommitted \
            --env=KAFKA_BOOTSTRAP_SERVERS="$KAFKA_BOOTSTRAP_SERVERS" \
            --env=KAFKA_SCHEMA_REGISTRY_URL="$KAFKA_SCHEMA_REGISTRY_URL" \
            --env=HPSF_TOPIC_UNDERLYING_ES_TRADES="underlying.replay.20260612.es.trades" \
            --env=HPSF_TOPIC_UNDERLYING_SPX_PRICE="underlying.replay.20260612.spx.price" \
            --env=HPSF_TOPIC_UNDERLYING_STATE="$TOPIC_PREFIX.hpsf.underlying-state" \
            --env=HPSF_ORDER_PLACEMENT_ENABLED=false \
            --env=ORDER_PLACEMENT_ENABLED=false
          : > artifacts/logs/underlying.log
          for attempt in $(seq 1 180); do
            phase="$(kubectl -n "$NAMESPACE" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
            kubectl -n "$NAMESPACE" logs "$pod" --tail=300 > artifacts/logs/underlying.log 2>/dev/null || true
            if grep -E 'HPSF underlying replay topology enabled|underlying replay consuming|underlying replay producing' artifacts/logs/underlying.log; then
              break
            fi
            if [ "$phase" = "Failed" ] || [ "$phase" = "Succeeded" ]; then
              kubectl -n "$NAMESPACE" describe pod "$pod" > artifacts/logs/underlying-describe.log 2>/dev/null || true
              cat artifacts/logs/underlying.log
              exit 1
            fi
            sleep 1
          done
          for attempt in $(seq 1 180); do
            phase="$(kubectl -n "$NAMESPACE" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
            kubectl -n "$NAMESPACE" logs "$pod" --tail=600 > artifacts/logs/underlying.log 2>/dev/null || true
            if grep -E 'HPSF underlying-replay stream state transition .* -> RUNNING|state=underlying-replay=RUNNING' artifacts/logs/underlying.log; then
              break
            fi
            if [ "$phase" = "Failed" ] || [ "$phase" = "Succeeded" ]; then
              kubectl -n "$NAMESPACE" describe pod "$pod" > artifacts/logs/underlying-describe.log 2>/dev/null || true
              cat artifacts/logs/underlying.log
              exit 1
            fi
            sleep 1
          done
          kubectl -n "$NAMESPACE" logs "$pod" --tail=600 > artifacts/logs/underlying.log || true
          grep -E 'HPSF underlying replay topology enabled|underlying replay consuming|underlying replay producing' artifacts/logs/underlying.log
          grep -E 'HPSF underlying-replay stream state transition .* -> RUNNING|state=underlying-replay=RUNNING' artifacts/logs/underlying.log
        '''
      }
    }

    stage('Run Stage B replay') {
      steps {
        sh '''
          set -euo pipefail
          pod="hpsf-stage-b-replay-20260612"
          kubectl -n "$NAMESPACE" delete pod "$pod" --ignore-not-found=true
          kubectl -n "$NAMESPACE" run "$pod" --image="$HPSF_PROCESSING_IMAGE" --image-pull-policy=Always --restart=Never --overrides="$HPSF_REPLAY_POD_OVERRIDES" \
            --env=APP_MARKET_DATA_SOURCE=DATABENTO \
            --env=HPSF_MODE="$HPSF_MODE" \
            --env=HPSF_REPLAY_DATE="$REPLAY_DATE" \
            --env=HPSF_MARKET_CALENDAR_ALLOW_INCOMPLETE=true \
            --env=HPSF_MARKET_CALENDAR_MIN_HOLIDAYS_PER_YEAR=0 \
            --env=HPSF_MARKET_CALENDAR_REQUIRE_EARLY_CLOSES=false \
            --env=HPSF_ENABLED=true \
            --env=HPSF_TOPOLOGY_ENABLED=true \
            --env=HPSF_STAGE_A_ENABLED=false \
            --env=HPSF_STAGE_B_ENABLED=true \
            --env=HPSF_UNDERLYING_STATE_ENABLED=false \
            --env=HPSF_STREAMS_APPLICATION_ID=options-edge-hpsf-stage-b-replay-20260612-${BUILD_NUMBER:-manual} \
            --env=HPSF_STREAMS_STATE_DIR="$HPSF_STATE_DIR/stage-b-${BUILD_NUMBER:-manual}" \
            --env=HPSF_STREAMS_AUTO_OFFSET_RESET=earliest \
            --env=HPSF_STREAMS_PROCESSING_GUARANTEE=at_least_once \
            --env=HPSF_STREAMS_NUM_STREAM_THREADS=1 \
            --env=HPSF_STREAMS_CACHE_MAX_BYTES_BUFFERING=0 \
            --env=HPSF_STREAMS_CONSUMER_ISOLATION_LEVEL=read_uncommitted \
            --env=KAFKA_BOOTSTRAP_SERVERS="$KAFKA_BOOTSTRAP_SERVERS" \
            --env=KAFKA_SCHEMA_REGISTRY_URL="$KAFKA_SCHEMA_REGISTRY_URL" \
            --env=HPSF_TOPIC_STRIKE_FLOW="$TOPIC_PREFIX.hpsf.strike-flow" \
            --env=HPSF_TOPIC_UNDERLYING_STATE="$TOPIC_PREFIX.hpsf.underlying-state" \
            --env=HPSF_TOPIC_MARKET_FLOW="$TOPIC_PREFIX.hpsf.market-flow" \
            --env=HPSF_TOPIC_STRIKE_SCORE="$TOPIC_PREFIX.hpsf.strike-score" \
            --env=HPSF_TOPIC_SIGNAL="$TOPIC_PREFIX.hpsf.signal" \
            --env=HPSF_TOPIC_LATEST_SIGNAL="$TOPIC_PREFIX.hpsf.latest-signal" \
            --env=HPSF_TOPIC_AUDIT="$TOPIC_PREFIX.hpsf.audit" \
            --env=HPSF_TOPIC_DLQ="$TOPIC_PREFIX.hpsf.dlq" \
            --env=HPSF_ORDER_PLACEMENT_ENABLED=false \
            --env=ORDER_PLACEMENT_ENABLED=false
          : > artifacts/logs/stage-b-startup.log
          for attempt in $(seq 1 180); do
            phase="$(kubectl -n "$NAMESPACE" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
            kubectl -n "$NAMESPACE" logs "$pod" --tail=200 > artifacts/logs/stage-b-startup.log 2>/dev/null || true
            if grep -E 'HPSF Stage B topology enabled|HPSF Stage B consuming|HPSF Stage B producing' artifacts/logs/stage-b-startup.log; then
              break
            fi
            if [ "$phase" = "Failed" ] || [ "$phase" = "Succeeded" ]; then
              kubectl -n "$NAMESPACE" describe pod "$pod" > artifacts/logs/stage-b-describe.log 2>/dev/null || true
              cat artifacts/logs/stage-b-startup.log
              exit 1
            fi
            sleep 1
          done
          for attempt in $(seq 1 180); do
            phase="$(kubectl -n "$NAMESPACE" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
            kubectl -n "$NAMESPACE" logs "$pod" --tail=600 > artifacts/logs/stage-b-startup.log 2>/dev/null || true
            if grep -E 'HPSF stage-b stream state transition .* -> RUNNING|state=stage-b=RUNNING' artifacts/logs/stage-b-startup.log; then
              break
            fi
            if [ "$phase" = "Failed" ] || [ "$phase" = "Succeeded" ]; then
              kubectl -n "$NAMESPACE" describe pod "$pod" > artifacts/logs/stage-b-describe.log 2>/dev/null || true
              cat artifacts/logs/stage-b-startup.log
              exit 1
            fi
            sleep 1
          done
          grep -E 'HPSF Stage B topology enabled|HPSF Stage B consuming|HPSF Stage B producing' artifacts/logs/stage-b-startup.log
          grep -E 'HPSF stage-b stream state transition .* -> RUNNING|state=stage-b=RUNNING' artifacts/logs/stage-b-startup.log
          sleep 30
          kubectl -n "$NAMESPACE" logs "$pod" --tail=2000 > artifacts/logs/stage-b-runtime.log || true
          cat artifacts/logs/stage-b-startup.log artifacts/logs/stage-b-runtime.log > artifacts/logs/stage-b.log
        '''
      }
    }

    stage('Collect replay outputs') {
      steps {
        sh '''
          set -euo pipefail
          export REPLAY_DATE="${REPLAY_DATE}"
          export REPLAY_START="${REPLAY_START}"
          export REPLAY_END="${REPLAY_END}"
          export OPRA_DATASET="${OPRA_DATASET}"
          export OPRA_SCHEMA="${OPRA_SCHEMA}"
          export ES_DATASET="${ES_DATASET}"
          export ES_SCHEMA="${ES_SCHEMA}"
          export TOPIC_PREFIX="${TOPIC_PREFIX}"
          scripts/hpsf/validate-replay-output.sh --final --collect-only | tee artifacts/logs/collect-replay-output.log
        '''
      }
    }

    stage('Merge Stage B Metrics Into Replay Summary') {
      steps {
        sh '''
          set -euo pipefail

          echo "Merging Stage B performance and underlying-state counters into replay summary"

          test -f artifacts/logs/stage-b.log
          test -f artifacts/hpsf-replay-summary.json
          test -f scripts/hpsf/merge-stage-b-performance-metrics.py

          python3 scripts/hpsf/merge-stage-b-performance-metrics.py \
            --stage-b-log artifacts/logs/stage-b.log \
            --summary artifacts/hpsf-replay-summary.json

          cp artifacts/hpsf-replay-summary.json build/hpsf-replay-20260612/evidence.json

          echo "Stage B metrics merged into artifacts/hpsf-replay-summary.json"

          python3 - <<'PY'
import json
from pathlib import Path

summary_path = Path("artifacts/hpsf-replay-summary.json")
summary = json.loads(summary_path.read_text())

stage_b = summary.get("stageBPerformance", {})
counts = summary.get("counts", {})

required = [
    "stageB.chainSnapshot.update.count",
    "activeChainStorePutCount",
    "activeChainRegisteredCount",
    "stageB.activeChains.count.max",
    "stageB.punctuation.fire.count",
    "activeChainsEvaluatedCount",
    "stageB.evaluation.count",
    "underlyingStateRecordsReceived",
    "underlyingStateRecordsStored",
    "underlyingStateLookupHitCount",
    "underlyingStateLookupMissCount",
    "underlyingStateNullVwapCount",
    "underlyingStateNullDistanceCount",
    "healthyUnderlyingStateCount",
]

missing = [key for key in required if key not in counts and key not in stage_b]
if missing:
    raise SystemExit(f"Missing Stage B replay counters after merge: {missing}")

print("Stage B metric merge validation passed")
PY
        '''
      }
    }

    stage('Validate replay outputs') {
      steps {
        sh '''
          set -euo pipefail
          export REPLAY_DATE="${REPLAY_DATE}"
          export REPLAY_START="${REPLAY_START}"
          export REPLAY_END="${REPLAY_END}"
          export OPRA_DATASET="${OPRA_DATASET}"
          export OPRA_SCHEMA="${OPRA_SCHEMA}"
          export ES_DATASET="${ES_DATASET}"
          export ES_SCHEMA="${ES_SCHEMA}"
          export TOPIC_PREFIX="${TOPIC_PREFIX}"
          set +e
          scripts/hpsf/validate-replay-output.sh --final --summary-only | tee artifacts/logs/validate-replay-output.log
          validation_status=$?
          set -e
          echo "$validation_status" > artifacts/logs/validate-replay-output.exit-code
          if [ "$validation_status" -ne 0 ]; then
            echo "Replay validation failed with status $validation_status; continuing to generate and archive the failure report."
          fi
        '''
      }
    }

    stage('Generate replay report') {
      steps {
        sh '''
          set -euo pipefail
          export REPLAY_DATE="${REPLAY_DATE}"
          export REPLAY_START="${REPLAY_START}"
          export REPLAY_END="${REPLAY_END}"
          export OPRA_DATASET="${OPRA_DATASET}"
          export OPRA_SCHEMA="${OPRA_SCHEMA}"
          export ES_DATASET="${ES_DATASET}"
          export ES_SCHEMA="${ES_SCHEMA}"
          export TOPIC_PREFIX="${TOPIC_PREFIX}"
          export HPSF_REPLAY_REPORT_ALLOW_FAIL=true
          scripts/hpsf/collect-replay-root-cause-diagnostics.sh || true
          previous_summary=""
          if [ -n "${JENKINS_HOME:-}" ] && [ -n "${JOB_NAME:-}" ] && [ -n "${BUILD_NUMBER:-}" ]; then
            previous_summary="$(python3 - <<'PY'
import os
from pathlib import Path

jenkins_home = Path(os.environ["JENKINS_HOME"])
job_name = os.environ["JOB_NAME"]
current = int(os.environ.get("BUILD_NUMBER", "0") or "0")
builds_dir = jenkins_home / "jobs" / job_name / "builds"
best = None
if builds_dir.exists():
    for child in builds_dir.iterdir():
        if not child.name.isdigit():
            continue
        number = int(child.name)
        if number >= current:
            continue
        candidate = child / "archive" / "artifacts" / "hpsf-replay-summary.json"
        if candidate.exists() and (best is None or number > best[0]):
            best = (number, candidate)
print(best[1] if best else "")
PY
)"
          fi
          if [ -n "$previous_summary" ]; then
            export HPSF_PREVIOUS_REPLAY_SUMMARY="$previous_summary"
            echo "Previous replay summary for comparison: $previous_summary"
          else
            echo "Previous replay summary for comparison: unavailable"
          fi
          scripts/hpsf/generate-replay-report.sh | tee artifacts/logs/generate-replay-report.log
        '''
      }
    }

    stage('Create replay evidence report') {
      steps {
        sh '''
          set -euo pipefail
          scripts/hpsf/archive-replay-evidence-report.sh | tee artifacts/logs/archive-replay-evidence-report.log
        '''
      }
    }

    stage('Archive artifacts') {
      steps {
        archiveArtifacts artifacts: '.replay/options-edge/evidence-report/hpsf-historical-replay-20260612/**/*.md', fingerprint: true, allowEmptyArchive: false
      }
    }

    stage('Validate replay report PASS') {
      steps {
        sh '''
          set -euo pipefail
          grep -F 'Final PASS/FAIL: PASS' artifacts/hpsf-replay-report-20260612.md
          grep -F 'orderInstruction.enabled=true ever appeared: NO' artifacts/hpsf-replay-report-20260612.md
          if [ -s artifacts/logs/validate-replay-output.exit-code ] && [ "$(cat artifacts/logs/validate-replay-output.exit-code)" -ne 0 ]; then
            echo "Replay report was archived, but validation failed; failing build after evidence archival."
            exit 1
          fi
          if [ -s artifacts/logs/generate-replay-report.exit-code ] && [ "$(cat artifacts/logs/generate-replay-report.exit-code)" -ne 0 ]; then
            echo "Replay report was archived, but report gate failed; failing build after evidence archival."
            exit 1
          fi
        '''
      }
    }

    stage('Bugzilla update') {
      steps {
        withCredentials([string(credentialsId: "${params.BUGZILLA_PASSWORD_CREDENTIAL_ID}", variable: 'BUGZILLA_PASSWORD_FROM_CREDENTIAL')]) {
          sh '''
            set -euo pipefail
            job_path="$(printf '%s' "$JOB_NAME" | sed 's#/#/job/#g')"
            build_url="${BUILD_URL:-${JENKINS_PUBLIC_URL%/}/job/${job_path}/${BUILD_NUMBER}/}"
            report_url="${build_url}artifact/.replay/options-edge/evidence-report/hpsf-historical-replay-20260612/"
            python3 - <<PY
import json
from pathlib import Path

summary = json.loads(Path("artifacts/hpsf-replay-summary.json").read_text())
validation = json.loads(Path("artifacts/replay-validation-result.json").read_text())
if validation.get("validationResult") != "PASS" or summary.get("validationResult") != "PASS":
    raise SystemExit("Bugzilla PASS comment blocked because validation result is not PASS")
counts = summary.get("counts", {})
stage_b = summary.get("stageBPerformance", {})
comment = (
    "HPSF-82A replay PASS. "
    "Build: ${build_url}. "
    "Report: ${report_url}. "
    "Selected ES: ${ES_SYMBOL}/${ES_STYPE_IN}. "
    f"StageB evaluations={stage_b.get('stageB.evaluation.count', counts.get('stageB.evaluation.count'))}, "
    f"activeChainsMax={stage_b.get('stageB.activeChains.count.max', counts.get('stageB.activeChains.count.max'))}, "
    f"signals={counts.get('signalRecordsEmitted')}, latest={counts.get('latestSignalRecordsEmitted')}, audit={counts.get('auditRecordsEmitted')}. "
    "See the archived one-file Markdown replay evidence report for canonical evidence."
)
Path("artifacts/logs/bugzilla-comment.txt").write_text(comment + "\\n")
PY
            bugzilla_password="${BUGZILLA_PASSWORD_FROM_CREDENTIAL:-${BUGZILLA_PASSWORD:-}}"
            if [ -n "$bugzilla_password" ]; then
              bugzilla_token="$(curl -fsS --get \
                --data-urlencode "login=${BUGZILLA_USER}" \
                --data-urlencode "password=${bugzilla_password}" \
                "${BUGZILLA_URL}/rest/login" | python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])')"
            curl -fsS -X POST "${BUGZILLA_URL}/rest/bug/74/comment" \
              -H 'Content-Type: application/json' \
              -d "$(BUGZILLA_TOKEN="$bugzilla_token" python3 -c 'import json,os; print(json.dumps({"Bugzilla_token": os.environ["BUGZILLA_TOKEN"], "comment": open("artifacts/logs/bugzilla-comment.txt").read()}))')"
            else
              echo 'BUGZILLA_PASSWORD not provided; archived Bugzilla comment text only.'
            fi
          '''
        }
      }
    }
  }

  post {
    unsuccessful {
      sh '''
        set +e
        mkdir -p artifacts/logs build/hpsf-replay-20260612/logs
        export CODE_GIT_SHA="$(cat build-git-sha.txt 2>/dev/null || true)"
        job_path="$(printf '%s' "$JOB_NAME" | sed 's#/#/job/#g')"
        export BUILD_URL="${BUILD_URL:-${JENKINS_PUBLIC_URL%/}/job/${job_path}/${BUILD_NUMBER}/}"
        export HPSF_REPLAY_FAILURE_REASON="Jenkins failed before a valid PASS replay report was generated. Verify required credentials including DATABENTO_API_KEY_CREDENTIAL_ID=${DATABENTO_API_KEY_CREDENTIAL_ID:-options-edge-databento-api-key}, prepared replay source data, Kafka, Kubernetes, and Databento access in the console log."
        export HPSF_REPLAY_FAILURE_CODE="JENKINS_REPLAY_PIPELINE_FAILED"
        if grep -F "strike-flow count = 0" artifacts/logs/validate-stage-a.log >/dev/null 2>&1; then
          export HPSF_REPLAY_FAILURE_CODE="STAGE_A_STRIKE_FLOW_EMPTY"
          export HPSF_REPLAY_FAILURE_REASON="Stage A replay started but emitted zero strike-flow records from ${TOPIC_PREFIX:-options.replay.20260612}.opra.tcbbo into ${TOPIC_PREFIX:-options.replay.20260612}.hpsf.strike-flow during validation."
        fi
        scripts/hpsf/collect-replay-root-cause-diagnostics.sh || true
        current_report_matches_build=false
        if [ -s artifacts/hpsf-replay-report-20260612.md ] && grep -F "Build number: ${BUILD_NUMBER:-}" artifacts/hpsf-replay-report-20260612.md >/dev/null 2>&1; then
          current_report_matches_build=true
        fi
        if [ "$current_report_matches_build" != "true" ] || [ ! -s artifacts/hpsf-replay-summary.json ] || [ ! -s artifacts/replay-validation-result.json ]; then
          rm -f \
            artifacts/hpsf-replay-report-20260612.md \
            artifacts/hpsf-replay-summary.json \
            artifacts/replay-validation-result.json \
            artifacts/hpsf-stage-a-validation.json \
            build/hpsf-replay-20260612/evidence.json \
            build/hpsf-replay-20260612/stage-a-validation.json
          export HPSF_REPLAY_REPORT_ALLOW_FAIL=true
          scripts/hpsf/run-hpsf-replay-20260612.sh --dry-run || true
        fi
        scripts/hpsf/archive-replay-evidence-report.sh | tee artifacts/logs/archive-replay-evidence-report.log || true
      '''
      archiveArtifacts artifacts: '.replay/options-edge/evidence-report/hpsf-historical-replay-20260612/**/*.md', fingerprint: true, allowEmptyArchive: false
    }
    always {
      sh '''
        set +e
        kubectl -n "${NAMESPACE:-options-edge}" delete pod hpsf-stage-a-replay-20260612 --ignore-not-found=true
        kubectl -n "${NAMESPACE:-options-edge}" delete pod hpsf-underlying-replay-20260612 --ignore-not-found=true
        kubectl -n "${NAMESPACE:-options-edge}" delete pod hpsf-stage-b-replay-20260612 --ignore-not-found=true
      '''
    }
  }
}
