@Library('oe') _

// Nightly trigger for the kafka-changelog-cleanup CronJob.
//
// WHY a Jenkins job instead of the native k8s CronJob schedule:
//   The cluster enforces a ValidatingAdmissionPolicy
//   (options-edge-jenkins-only-workloads) that DENIES batch/Job creation by
//   ANY principal except the jenkins-deployer ServiceAccount. The k8s CronJob
//   controller creates its Jobs under its own SA
//   (system:serviceaccount:kube-system:cronjob-controller), so the native
//   nightly firing is rejected every night (confirmed in the k3s controller
//   log). The CronJob is therefore kept suspend:true and serves ONLY as the
//   reusable Job template. We materialise a one-off Job from it HERE, from the
//   Jenkins Mac agent, using the deployer kubeconfig — the only principal the
//   admission policy permits to create Jobs.
//
// WHAT it does: `kubectl create job --from=cronjob/kafka-changelog-cleanup`,
//   waits for completion, surfaces the cleanup logs, then prunes its own old
//   Jobs (the CronJob history limits do NOT apply to manually-created Jobs).
//
// WHEN: 02:00 Europe/Amsterdam every day (operator request).
//
// RETIRED 2026-06-30 (off-hours clean-slate, decision #4): the gentle 24h
// changelog/repartition TRIM is SUPERSEDED by the aggressive off-hours
// clean-slate, which DELETES those topics outright (no 24h retention, no compact
// sparing). To avoid the two fighting, this job's nightly cron trigger is
// DISABLED — it stays runnable MANUALLY for ad-hoc trims but no longer self-fires.
// (The kafka-changelog-cleanup CronJob template itself is already suspend:true.)
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before any effect unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`.')
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: 'a3d2b9492162a2a6c92914ab17e6df5514ae6ecaaa7988dbab61b57a36160275',
      description: 'DO NOT EDIT BY HAND — the sha256 of scripts/jenkins/permitted-sha-guard.sh this job enforces (Deployment Permission Rule). The guard refuses to run under any other value, so this default, once registered by a run of this definition, is evidence to callers that this job executes THIS guard; a caller refuses to trigger a job whose registered default differs from its own. Regenerate with scripts/jenkins/permitted-sha-guard-version.sh when the guard changes.')
    choice(name: 'ENVIRONMENT', choices: ['production', 'dev'],
      description: 'Deploy profile (oeProfile) — selects the deployer kubeconfig. Scheduled runs use the default (production).')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
    string(name: 'CRONJOB_NAME', defaultValue: 'kafka-changelog-cleanup',
      description: 'CronJob whose jobTemplate we materialise a one-off Job from.')
    string(name: 'NAMESPACE', defaultValue: 'options-edge',
      description: 'Namespace of the CronJob / Jobs.')
    string(name: 'KEEP_JOBS', defaultValue: '5',
      description: 'How many most-recent cleanup Jobs to retain (older ones are pruned after each run).')
    booleanParam(name: 'PURGE_DRY_RUN', defaultValue: true,
      description: 'Orphan-generation purge: true = LOG which abandoned Streams changelog/repartition topics WOULD be deleted (no deletion). Set false to actually delete them. Default true — verify the dry-run list before deleting prod topics.')
  }
  // triggers {} — DISABLED. Retired in favour of the off-hours clean-slate (see
  // header). No cron: this job no longer self-fires; it is manual-only now.
  options {
    disableRestartFromStage()   // Deployment Permission Rule: no "Restart from Stage" past the permitted-commit guard
    disableConcurrentBuilds()
    timeout(time: 40, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG   = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    CRONJOB_NAME = "${params.CRONJOB_NAME}"
    NAMESPACE    = "${params.NAMESPACE}"
    KEEP_JOBS    = "${params.KEEP_JOBS}"
    PURGE_DRY_RUN = "${params.PURGE_DRY_RUN}"
  }
  stages {
    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    // PERMITTED_SHA is REQUIRED. scripts/jenkins/permitted-sha-guard.sh refuses, in this order: a checkout
    // that is not on origin/main (the environment-branch restriction, kept as its own condition); a
    // missing, empty, short or otherwise malformed PERMITTED_SHA (nothing is substituted for it); a
    // checked-out HEAD that is not exactly PERMITTED_SHA. It runs FIRST, in the workspace every later
    // stage uses, so nothing below can build, push, apply, roll, restart, create a topic or copy a file
    // under an unpermitted commit — including a build queued for one commit that checked out a newer one.
    // error(), never catchError: a refusal is a stop, not a coloured result. Both SHAs are in the log.
    stage('Permitted commit guard') {
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }
    stage('Refresh active Streams app-ids') {
      steps {
        sh '''
          set -euo pipefail
          # Build the authoritative ACTIVE set of Kafka Streams application.ids from live workload CONFIG
          # (not consumer-group liveness, so it is correct when a service is scaled to 0 off-hours). Scan
          # ALL kinds that can run a Streams app: Deployments, StatefulSets, AND bare Pods (replay workloads
          # run as Pods with HPSF_STREAMS_APPLICATION_ID). Deploy/STS keep containers under
          # .spec.template.spec; a Pod keeps them under .spec — the jq below unions both shapes.
          CONTAINERS='(.spec.template.spec.containers // .spec.containers // [])[]'
          # Match ONLY real Kafka Streams application.id env vars: names ENDING in APP_ID / APPLICATION_ID
          # (anchored). The trailing "$" excludes this cleanup Job's OWN bookkeeping env ACTIVE_STREAMS_APP_IDS
          # (plural APP_IDS), whose completed Pods linger in the namespace (Codex review).
          APPID_ENVS="( ${CONTAINERS}.env[]? | select(.name|test(\"(APP_ID|APPLICATION_ID)$\")) )"

          # FAIL CLOSED on an app-id we cannot resolve to a literal value here (valueFrom). If it were missing
          # from ACTIVE, a non-dry-run purge could delete that LIVE app's current changelog topics as "orphan".
          # Abort and tell the operator to make it a literal env value. (envFrom is NOT rejected — shared
          # ConfigMaps like options-edge-config are imported that way everywhere and never carry an app-id; a
          # per-service app-id sourced via envFrom would surface in the dry-run list for the operator to catch.)
          UNRESOLVED="$(kubectl -n "${NAMESPACE}" get deploy,statefulset,pod -o json \
            | jq -r ".items[]? | ${APPID_ENVS} | select(has(\"value\")|not) | .name" | sort -u)"
          if [ -n "${UNRESOLVED}" ]; then
            echo "FATAL: these APP_ID env(s) are non-literal (valueFrom) — cannot resolve here; aborting so a" >&2
            echo "       live app's topics are never misclassified as orphan. Make them literal env values:" >&2
            printf '  %s\n' ${UNRESOLVED} >&2
            exit 1
          fi

          ACTIVE="$(kubectl -n "${NAMESPACE}" get deploy,statefulset,pod -o json \
            | jq -r ".items[]? | ${APPID_ENVS} | .value // empty" | sed '/^[[:space:]]*$/d' | sort -u)"
          COUNT="$(printf '%s' "$ACTIVE" | grep -c . || true)"
          echo "Active configured Streams app-ids (${COUNT}):"
          printf '  %s\n' $ACTIVE
          # FAIL CLOSED: never refresh a suspiciously-small active set (would let the Job purge live topics).
          if [ "${COUNT}" -lt 3 ]; then
            echo "FATAL: only ${COUNT} active app-ids found — refusing to refresh (fail-closed; expected many)." >&2
            exit 1
          fi
          # Runtime source-scope suffix (application.id is "<configured>-<profile>"): production -> prod.
          case "${ENVIRONMENT}" in production) PROFILE=prod;; *) PROFILE="${ENVIRONMENT}";; esac
          kubectl -n "${NAMESPACE}" create configmap kafka-streams-active-appids \
            --from-literal=ACTIVE_STREAMS_APP_IDS="$(printf '%s' "$ACTIVE" | tr '\n' ' ')" \
            --from-literal=PURGE_DRY_RUN="${PURGE_DRY_RUN}" \
            --from-literal=PURGE_PROFILE="${PROFILE}" \
            --dry-run=client -o yaml | kubectl -n "${NAMESPACE}" apply -f -
          echo "Refreshed kafka-streams-active-appids (PURGE_DRY_RUN=${PURGE_DRY_RUN}, PROFILE=${PROFILE})."
        '''
      }
    }
    stage('Trigger kafka-changelog-cleanup') {
      steps {
        sh '''
          set -euo pipefail
          ts="$(date +%Y%m%d-%H%M%S)"
          JOB="${CRONJOB_NAME}-${ts}"
          echo "Creating Job ${JOB} from cronjob/${CRONJOB_NAME} in ns ${NAMESPACE}"
          echo "KUBECONFIG=${KUBECONFIG}"

          # PREFLIGHT — fail fast on the WRONG identity. The jenkins-only admission
          # policy permits Job creation ONLY for system:serviceaccount:options-edge:
          # jenkins-deployer; an admin/root kubeconfig (e.g. a manual KUBECONFIG_FILE
          # override) would be denied AT create time with a cryptic error. Assert the
          # resolved identity up front so a misconfigured run fails with a clear cause.
          WANT="system:serviceaccount:options-edge:jenkins-deployer"
          WHOAMI="$(kubectl auth whoami -o jsonpath='{.status.userInfo.username}' 2>/dev/null || echo '')"
          echo "kubectl identity: ${WHOAMI:-<unknown>}"
          if [ "${WHOAMI}" != "${WANT}" ]; then
            echo "FATAL: kubeconfig identity is '${WHOAMI:-<unknown>}', expected '${WANT}'." >&2
            echo "       This job must run as the jenkins-deployer SA (the only principal the" >&2
            echo "       jenkins-only admission policy allows to create Jobs). Aborting." >&2
            exit 1
          fi

          # The deployer SA is the only principal the jenkins-only admission policy
          # permits to create Jobs. --from copies the (suspended) CronJob jobTemplate;
          # suspend only gates the controller's auto-scheduling, not manual --from.
          kubectl -n "${NAMESPACE}" create job --from="cronjob/${CRONJOB_NAME}" "${JOB}"

          echo "Waiting for ${JOB} to finish (cap 30m)..."
          deadline=$(( $(date +%s) + 1800 ))
          rc=2
          while [ "$(date +%s)" -lt "$deadline" ]; do
            succeeded="$(kubectl -n "${NAMESPACE}" get job "${JOB}" -o jsonpath='{.status.succeeded}' 2>/dev/null || echo '')"
            failed="$(kubectl -n "${NAMESPACE}" get job "${JOB}" -o jsonpath='{.status.conditions[?(@.type=="Failed")].status}' 2>/dev/null || echo '')"
            if [ "${succeeded:-0}" -ge 1 ] 2>/dev/null; then rc=0; break; fi
            if [ "${failed:-}" = "True" ]; then rc=1; break; fi
            sleep 10
          done

          echo "===== cleanup logs (${JOB}) ====="
          kubectl -n "${NAMESPACE}" logs "job/${JOB}" --tail=-1 || true
          echo "===== end logs ====="

          if [ "$rc" -eq 1 ]; then
            echo "Cleanup Job ${JOB} FAILED." >&2; exit 1
          elif [ "$rc" -eq 2 ]; then
            echo "Cleanup Job ${JOB} did not finish within 30m." >&2; exit 1
          fi
          echo "Cleanup Job ${JOB} completed successfully."
        '''
      }
    }
  }
  post {
    always {
      // Prune our own old cleanup Jobs to the most recent ${KEEP_JOBS}. CronJob
      // successfulJobsHistoryLimit does NOT cover manually-created (--from) Jobs,
      // so without this they accumulate. Portable (BSD/macOS) — no GNU head -n -N.
      //
      // GATED on the permitted-commit guard: post{} runs unconditionally, and this prune DELETES
      // cluster objects. A build the guard refused must not reach the cluster through its post
      // path either (Deployment Permission Rule: no effect after a rejection, post/finally included).
      script {
        if (env.PERMITTED_SHA_GUARD == 'PASSED') {
      sh '''
        set +e
        [ "${PERMITTED_SHA_GUARD:-}" = "PASSED" ] || { echo "guard not passed — no prune"; exit 0; }
        keep="${KEEP_JOBS:-5}"
        names="$(kubectl -n "${NAMESPACE}" get jobs \
                   -l app.kubernetes.io/name="${CRONJOB_NAME}" \
                   --sort-by=.metadata.creationTimestamp -o name 2>/dev/null)"
        total="$(printf '%s\\n' "$names" | grep -c . )"
        del=$(( total - keep ))
        if [ "$del" -gt 0 ]; then
          echo "Pruning ${del} old cleanup Job(s) (keeping newest ${keep} of ${total})"
          printf '%s\\n' "$names" | sed -n "1,${del}p" | while read -r n; do
            [ -n "$n" ] && kubectl -n "${NAMESPACE}" delete "$n" --ignore-not-found
          done
        else
          echo "No old cleanup Jobs to prune (total=${total}, keep=${keep})"
        fi
        true
      '''
        } else {
          echo 'permitted-commit guard did not pass — skipping the cleanup-Job prune (no cluster access after a refusal)'
        }
      }
    }
  }
}
