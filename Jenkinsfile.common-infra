@Library('oe') _

// COMMON-INFRA DEPLOY (standalone-service-deployment design §3.1 / §13.8).
//
// Applies k8s/infra/overlays/<ENVIRONMENT> — the shared layer (namespace, shared
// ConfigMaps, ALL streams-state PVCs, ops CronJobs, prod Keycloak). Per-service deploy
// jobs (e.g. web-service-deploy) NEVER touch these resources; this job is their single
// owner. Runs RARELY — only when infra actually changes.
//
// Safety posture (§13.8):
//   * DRY-RUN BY DEFAULT — a real apply must be opted into per run.
//   * Production applies additionally require a manual approval gate.
//   * PVCs are create-only; an immutable storageClassName mismatch fails the job
//     loudly BEFORE any mutation (scripts/deploy/common-infra.sh).
//   * disableConcurrentBuilds serialises infra changes; per-service deploys should not
//     run while this job is applying (they share no resources, but keep ops simple).
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    string(name: 'PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'REQUIRED — Deployment Permission Rule (options-edge rule.md). The full 40-character commit id of THIS repository that Abhinav permitted for this run. The Permitted commit guard stage refuses the build before any effect unless the checked-out HEAD is exactly this commit AND on origin/main; empty, short or mismatched values are refused and nothing is substituted. A manual click needs it too: copy it from `git rev-parse origin/main`.')
    string(name: 'PERMITTED_SHA_GUARD_VERSION', defaultValue: '2f6fc2ab7aa51eb8a9e8aa350f2d774cd2fb7a253de2591e43645a19a9886b24',
      description: 'DO NOT EDIT BY HAND — the sha256 of scripts/jenkins/permitted-sha-guard.sh this definition runs (Deployment Permission Rule). The guard refuses to run under any other value. It is a DECLARATION, not proof that this job enforces the guard: a caller that triggers this job judges its SCM definition and its Jenkinsfile at the forwarded commit (scripts/jenkins/require-guarded-downstream.sh). Regenerate with scripts/jenkins/permitted-sha-guard-version.sh when the guard changes.')
    choice(name: 'ENVIRONMENT', choices: ['dev', 'production', 'experiment'],
      description: 'Target environment — selects k8s/infra/overlays/<env> and the deployer kubeconfig (oeProfile).')
    booleanParam(name: 'CONTEXT_TAPE_ORDER_INIT_ONLY', defaultValue: false,
      description: 'First-start only: initialize absent/empty order topics and canonical schemas under executor/bridge quiescence. Caps unbounded retention.bytes only on verified empty topics; no conversion, deletion, offset reset, workload, grant or realm changes.')
    booleanParam(name: 'CONTEXT_TAPE_DEV_FIXTURE_RECOVERY', defaultValue: false,
      description: 'Dev-only recovery: soft-delete exactly the accidental empty Order0 intent schema id32/version1 under empty-topic/quiescence checks, then register canonical. No permanent deletion or Kafka record change. Refuses all other schema identities.')
    string(name: 'CONTRACTS_PERMITTED_SHA', defaultValue: '', trim: true,
      description: 'Required for order initialization: exact current options-edge-contracts main SHA. Independently guarded before using its canonical schemas.')
    booleanParam(name: 'CONTEXT_TAPE_AUTH_ONLY', defaultValue: false,
      description: 'Only validate/create the shared private execution credential. No manifests, PVCs, realm configuration or workloads are applied in this mode.')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: true,
      description: 'true = render + diff + server-side validate only (DEFAULT). Set false to actually apply.')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
    booleanParam(name: 'RECONCILE_REALM', defaultValue: true,
      description: 'Reconcile the public bleedingoptions realm after applying (production only). Applying manifests does NOT configure the realm — --import-realm skips an existing one — so leaving this off means MFA binding, approval groups and OTP policy are whatever is live. Turn off ONLY when no reconciler credential is available.')
  }
  options {
    disableRestartFromStage()   // Deployment Permission Rule: no "Restart from Stage" past the permitted-commit guard
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG     = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    ENVIRONMENT    = "${params.ENVIRONMENT}"
    DEPLOY_DRY_RUN = "${params.DEPLOY_DRY_RUN}"
  }
  stages {
    // ---- Deployment Permission Rule (options-edge rule.md): Jenkins enforces the permitted commit ----
    // PERMITTED_SHA is REQUIRED. scripts/jenkins/permitted-sha-guard.sh refuses, in this order: a checkout
    // that is not on origin/main (the environment-branch restriction, kept as its own condition); a
    // missing, empty, short or otherwise malformed PERMITTED_SHA (nothing is substituted for it); a
    // checked-out HEAD that is not exactly PERMITTED_SHA. It runs FIRST, in the workspace every later
    // stage uses, so nothing below can build, push, apply, roll, restart, create a topic or copy a file
    // under an unpermitted commit — including a build queued for one commit that checked out a newer one.
    // error(), never catchError: a refusal is a stop, not a coloured result. Both SHAs are in the log.
    stage('Permitted commit guard') {
      options { timeout(time: 10, unit: 'MINUTES') }
      steps {
        script {
          def rc = sh(returnStatus: true, script: 'bash scripts/jenkins/permitted-sha-guard.sh')
          if (rc != 0) {
            error("Permitted commit guard REFUSED this build (rc=${rc}) — see its output above. No deployment effect has run.")
          }
          env.PERMITTED_SHA_GUARD = 'PASSED'
        }
      }
    }
    stage('Validate preparation mode') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' } }
      steps {
        script {
          if (params.CONTEXT_TAPE_AUTH_ONLY && params.CONTEXT_TAPE_ORDER_INIT_ONLY) {
            error('Select only one Context Tape preparation mode.')
          }
          if (params.CONTEXT_TAPE_DEV_FIXTURE_RECOVERY && (!params.CONTEXT_TAPE_ORDER_INIT_ONLY || params.ENVIRONMENT != 'dev')) {
            error('Fixture recovery requires dev order-initialization-only mode.')
          }
          if (params.CONTEXT_TAPE_ORDER_INIT_ONLY && !params.CONTRACTS_PERMITTED_SHA?.trim()) {
            error('Order initialization requires CONTRACTS_PERMITTED_SHA.')
          }
        }
      }
    }
    stage('Context Tape order initialization only') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.CONTEXT_TAPE_ORDER_INIT_ONLY) } }
      steps {
        dir('.jenkins-tmp/context-tape-contracts') {
          git url: 'https://github.com/abhinav-jain09/options-edge-contracts.git', branch: 'main'
        }
        timeout(time: 10, unit: 'MINUTES') {
          sh 'PERMITTED_SHA="${CONTRACTS_PERMITTED_SHA:-}" bash scripts/jenkins/permitted-sha-guard.sh --dir .jenkins-tmp/context-tape-contracts --ref main'
        }
        script {
          env.CONTRACTS_SHA_GUARD = 'PASSED'
          env.ORDER_INIT_RECOVERY_ARG = params.CONTEXT_TAPE_DEV_FIXTURE_RECOVERY ? '--recover-dev-fixture' : ''
          timeout(time: 20, unit: 'MINUTES') {
            sh 'python3 scripts/deploy/initialize-context-tape-orders.py --contracts .jenkins-tmp/context-tape-contracts ${ORDER_INIT_RECOVERY_ARG}'
          }
          if (!params.DEPLOY_DRY_RUN) {
            if (params.ENVIRONMENT == 'production') {
              timeout(time: 10, unit: 'MINUTES') {
                input message: 'Initialize missing order topics/canonical schemas and cap empty-topic byte retention in production? No records are converted/deleted, and no workload or account access changes.', ok: 'Initialize missing contracts'
              }
            }
            timeout(time: 10, unit: 'MINUTES') {
              sh 'PERMITTED_SHA="${CONTRACTS_PERMITTED_SHA:-}" bash scripts/jenkins/verify-permitted-tree.sh --dir .jenkins-tmp/context-tape-contracts'
            }
            timeout(time: 20, unit: 'MINUTES') {
              sh 'python3 scripts/deploy/initialize-context-tape-orders.py --contracts .jenkins-tmp/context-tape-contracts ${ORDER_INIT_RECOVERY_ARG} --apply'
            }
          }
        }
      }
    }
    stage('Context Tape execution credential only') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (params.CONTEXT_TAPE_AUTH_ONLY) } }
      steps {
        script {
          sh 'DEPLOY_DRY_RUN=true bash scripts/deploy/ensure-context-tape-execution-auth.sh'
          if (!params.DEPLOY_DRY_RUN) {
            if (params.ENVIRONMENT == 'production') {
              input message: 'Create the missing private execution credential in production? Existing valid credentials are preserved. No workload or realm changes.', ok: 'Create if missing'
            }
            sh 'DEPLOY_DRY_RUN=false bash scripts/deploy/ensure-context-tape-execution-auth.sh'
          }
        }
      }
    }
    // SECONDARY check. The public Gamma Lab is an application workload deployed by service-deploy.sh,
    // which runs this same gate on its own apply path — that is the primary and the one that matters,
    // because a control on a path the workload does not travel guards nothing. This copy runs here
    // too because infra and the service slice are deployed by different jobs at different times, and
    // an infra deploy is a natural moment to notice that the public workload has been scaled up
    // without evidence. Cheap, and it fails the same way.
    stage('Public gate (PGL-072, secondary)') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (!params.CONTEXT_TAPE_AUTH_ONLY && !params.CONTEXT_TAPE_ORDER_INIT_ONLY && params.ENVIRONMENT == 'production') } }
      steps {
        sh '''
          set -euo pipefail
          bash scripts/deploy/verify-public-gate.sh
        '''
      }
    }
    stage('Render + Diff (always)') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (!params.CONTEXT_TAPE_AUTH_ONLY && !params.CONTEXT_TAPE_ORDER_INIT_ONLY) } }
      steps {
        sh '''
          set -euo pipefail
          # First pass is ALWAYS a dry-run so the log carries the full render/diff/plan
          # even when a real apply follows.
          DEPLOY_DRY_RUN=true WORK_DIR="$WORKSPACE/.jenkins-tmp" bash scripts/deploy/common-infra.sh
        '''
      }
    }
    stage('Approve production infra change') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (!params.CONTEXT_TAPE_AUTH_ONLY && !params.CONTEXT_TAPE_ORDER_INIT_ONLY && params.ENVIRONMENT == 'production' && !params.DEPLOY_DRY_RUN) } }
      steps {
        // §13.8: manual approval for prod infra changes. The diff is in the stage above.
        input message: "Apply the rendered infra changes to PRODUCTION? Review the 'Render + Diff' stage log first.",
              ok: 'Apply to production'
      }
    }
    stage('Apply') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (!params.CONTEXT_TAPE_AUTH_ONLY && !params.CONTEXT_TAPE_ORDER_INIT_ONLY && !params.DEPLOY_DRY_RUN) } }
      steps {
        sh '''
          set -euo pipefail
          DEPLOY_DRY_RUN=false WORK_DIR="$WORKSPACE/.jenkins-tmp" bash scripts/deploy/common-infra.sh
        '''
      }
    }
    // Skipping realm reconciliation is ANNOUNCED, not silent: a build that quietly omitted it would
    // look identical to one that performed it.
    stage('WARN: realm reconciliation skipped') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (!params.CONTEXT_TAPE_AUTH_ONLY && !params.CONTEXT_TAPE_ORDER_INIT_ONLY && params.ENVIRONMENT == 'production' && !params.DEPLOY_DRY_RUN && !params.RECONCILE_REALM) } }
      steps {
        script {
          unstable('RECONCILE_REALM=false: the public realm was NOT reconciled. Its login settings, ' +
                   'OTP policy, approval groups and browser-flow binding are whatever is currently ' +
                   'live, NOT what the repo says. Applying manifests does not configure the realm.')
        }
      }
    }
    // Applying the manifests does NOT configure the public realm. `--import-realm` skips a realm that
    // already exists, so on every deploy after the first the realm's login settings, OTP policy,
    // approval groups and browser-flow binding come from whatever is live — not from the repo. Without
    // this stage the job would report success while MFA was unbound or an approval-bearing role had
    // drifted into the default composite (PGL-031A/PGL-031B). It FAILS THE BUILD on drift it cannot
    // correct.
    stage('Reconcile public realm') {
      when { expression { env.PERMITTED_SHA_GUARD == 'PASSED' && (!params.CONTEXT_TAPE_AUTH_ONLY && !params.CONTEXT_TAPE_ORDER_INIT_ONLY && params.ENVIRONMENT == 'production' && !params.DEPLOY_DRY_RUN && params.RECONCILE_REALM) } }
      steps {
        withCredentials([
          string(credentialsId: 'bo-keycloak-reconciler-secret', variable: 'KC_ADMIN_SECRET'),
          string(credentialsId: 'bo-keycloak-smtp-password',     variable: 'KC_SMTP_PASSWORD')
        ]) {
          sh '''
            set -euo pipefail
            bash scripts/ops/bleedingoptions-realm-reconcile.sh --apply
            # Re-read after applying. A reconciler that says it corrected something, and a realm that
            # is actually correct afterwards, are two different claims — this asserts the second.
            bash scripts/ops/bleedingoptions-realm-reconcile.sh --check
          '''
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: '.jenkins-tmp/infra-*.yaml, .jenkins-tmp/infra-diff.txt',
        allowEmptyArchive: true
    }
  }
}
