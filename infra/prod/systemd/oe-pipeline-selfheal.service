[Unit]
Description=OptionsEdge pipeline self-heal (hanging transactions, wedged Streams state)
Documentation=file:/usr/local/sbin/oe-pipeline-selfheal.sh
After=k3s.service kafka.service
Wants=k3s.service kafka.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/oe-pipeline-selfheal.sh
# The script samples offsets twice and may wait for a pod to terminate; it must never be killed
# half-way through a state reset, which would leave a deployment scaled to 0.
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
