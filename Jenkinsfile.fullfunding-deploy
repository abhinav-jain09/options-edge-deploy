@Library('oe') _

// FULLFUNDING TENANT DEPLOY.
//
// Applies k8s/tenants/<TENANT> — the second application's space on the prod node (namespace,
// budget, priority, network boundary, admission rules, deploy identity, and its own Postgres).
//
// Ownership: this job is the SINGLE owner of that namespace and of the cluster-scoped objects
// named after the tenant. common-infra-deploy owns options-edge's shared layer and never touches
// this namespace — and scripts/deploy/fullfunding.sh asserts the reverse before applying, so a
// stray `namespace: options-edge` fails the job instead of reaching the trading platform.
//
// Credential: the deployer kubeconfig, not the tenant's own ServiceAccount. The tenant SA is
// namespace-scoped by design and therefore cannot create the Namespace, PriorityClass or the
// admission policy — bootstrapping a boundary necessarily sits outside it. The tenant SA token is
// for the application deploys that follow.
//
// Safety posture (mirrors common-infra-deploy):
//   * DRY-RUN BY DEFAULT — a real apply must be opted into per run.
//   * Production applies additionally require a manual approval gate.
//   * The render is diffed first, so the log shows exactly what will change.
//   * Guardrails are re-verified AFTER the apply; the job fails if the boundary is not intact.
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    choice(name: 'ENVIRONMENT', choices: ['production'],
      description: 'Target environment. Only production exists today — the tenant has no dev overlay.')
    string(name: 'TENANT', defaultValue: 'fullfunding',
      description: 'Tenant directory under k8s/tenants. One application per tenant namespace.')
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: true,
      description: 'true = render + blast-radius gate + diff + server-side validate only (DEFAULT). Set false to actually apply.')
    string(name: 'KUBECONFIG_FILE', defaultValue: '',
      description: 'Deployer kubeconfig on the Jenkins agent. Empty = oeProfile(ENVIRONMENT).kubeconfigDeployer.')
  }
  options {
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }
  environment {
    KUBECONFIG     = "${params.KUBECONFIG_FILE ?: oeProfile(params.ENVIRONMENT).kubeconfigDeployer}"
    ENVIRONMENT    = "${params.ENVIRONMENT}"
    TENANT         = "${params.TENANT}"
    DEPLOY_DRY_RUN = "${params.DEPLOY_DRY_RUN}"
  }
  stages {
    stage('Render + Gate + Diff (always)') {
      steps {
        sh '''
          set -euo pipefail
          # Always a dry-run first, so the log carries the full render, the blast-radius gate and
          # the diff even when a real apply follows in the next stage.
          DEPLOY_DRY_RUN=true WORK_DIR="$WORKSPACE/.jenkins-tmp" bash scripts/deploy/fullfunding.sh
        '''
      }
    }
    stage('Approve production tenant change') {
      when {
        allOf {
          expression { params.ENVIRONMENT == 'production' }
          expression { !params.DEPLOY_DRY_RUN }
        }
      }
      steps {
        input message: "Apply the rendered ${params.TENANT} tenant changes to PRODUCTION? Review the 'Render + Gate + Diff' stage log first.",
              ok: 'Apply to production'
      }
    }
    stage('Apply') {
      when { expression { !params.DEPLOY_DRY_RUN } }
      steps {
        sh '''
          set -euo pipefail
          DEPLOY_DRY_RUN=false WORK_DIR="$WORKSPACE/.jenkins-tmp" bash scripts/deploy/fullfunding.sh
        '''
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: '.jenkins-tmp/tenant-*.yaml, .jenkins-tmp/tenant-diff.txt',
        allowEmptyArchive: true
    }
  }
}
