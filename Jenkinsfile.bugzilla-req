// REQUIREMENT-INTAKE PORTAL DEPLOY (REQ-8 of docs/req-portal-bugzilla-keycloak-sso.md).
//
// Builds and deploys the `bugzilla-req` compose stack — the DEDICATED, empty Bugzilla that serves
// https://req.fullfunding.nl. This is the only sanctioned path to change what runs for the portal;
// a hand-run `docker compose up` on .252 would be a non-Jenkins deployment.
//
// Notes specific to this stack:
//  * It is compose-on-a-host, not Kubernetes, so it does not use the k8s service-deploy path. The
//    build runs natively on .252 (amd64) over ssh — the same pattern the prod web image already
//    uses — while Jenkins itself never runs on the production machine.
//  * The internal Bugzilla (compose project `bugzilla`, port 8092) is NEVER touched by this job.
//    REQ-6 makes that a requirement, and the job prints its status as a spot check.
//  * Both images are consumed BY DIGEST; each successful deploy records last-known-good digests so
//    a rollback never rebuilds.
pipeline {
  agent { label 'hpsf-replay-mac' }
  parameters {
    booleanParam(name: 'DEPLOY_DRY_RUN', defaultValue: true,
      description: 'true (DEFAULT) = prepare + verify the build context only; no image is built and nothing is deployed.')
    string(name: 'BUGZILLA_UPSTREAM_COMMIT', defaultValue: '276673ab6',
      description: 'Pinned upstream Bugzilla commit (branch 5.2). Bumping this is the security-patch channel (REQ-12) and must be a reviewed PR, not an ad-hoc build parameter change.')
  }
  options {
    disableConcurrentBuilds()   // REQ-8: no two portal deploys may interleave
    timeout(time: 60, unit: 'MINUTES')   // the upstream image build (apt + CPAN) is slow
  }
  environment {
    BUILD_TAG_OE             = "prod-${env.BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'nosha'}"
    DEPLOY_DRY_RUN           = "${params.DEPLOY_DRY_RUN}"
    BUGZILLA_UPSTREAM_COMMIT = "${params.BUGZILLA_UPSTREAM_COMMIT}"
  }
  stages {
    stage('Guard: main only') {
      steps {
        sh '''
          set -euo pipefail
          # Production deploys come only from main (Tiered Environment-Branch Deployment Rule).
          SHA=$(git rev-parse HEAD)
          git fetch -q origin main
          MAIN=$(git rev-parse origin/main)
          echo "checked out $SHA; origin/main is $MAIN"
          # Must be main's TIP, not merely an ancestor of it: an ancestor check would happily
          # redeploy an old revision, including one whose vulnerability was already fixed on main.
          if [ "$SHA" != "$MAIN" ]; then
            echo "FATAL: HEAD is not origin/main's tip — refusing to deploy the portal" >&2
            exit 1
          fi
        '''
      }
    }
    stage('Lint') {
      steps {
        sh '''
          set -euo pipefail
          bash -n scripts/deploy/bugzilla-req.sh
          bash -n bugzilla-req/oidc/render-oidc-secrets.sh
          bash -n bugzilla-req/oidc/startup-portal.sh
          python3 -c "import yaml,sys; yaml.safe_load(open('bugzilla-req/docker-compose.yml')); print('compose YAML OK')"
        '''
      }
    }
    stage('REQ-6 internal-Bugzilla fingerprint (before)') {
      steps {
        sh '''
          set -euo pipefail
          # The internal instance must be a strict no-op. A fingerprint is taken before and after and
          # compared: image digests, mounts and compose config hash. A drift here fails the job even
          # if the portal itself deployed perfectly.
          bash scripts/deploy/internal-bugzilla-fingerprint.sh > internal-before.txt
          cat internal-before.txt
        '''
      }
    }
    stage('Build + Deploy') {
      steps {
        sh '''
          set -euo pipefail
          BUILD_TAG="$BUILD_TAG_OE" bash scripts/deploy/bugzilla-req.sh
        '''
      }
    }
  }
  post {
    always {
      sh '''
        set -euo pipefail
        if [ -f internal-before.txt ]; then
          bash scripts/deploy/internal-bugzilla-fingerprint.sh > internal-after.txt || true
          if ! diff -u internal-before.txt internal-after.txt; then
            echo "FATAL: the internal Bugzilla stack CHANGED during this deploy — REQ-6 violated" >&2
            exit 1
          fi
          echo "REQ-6 OK: internal Bugzilla fingerprint unchanged"
        fi
      '''
    }
    success {
      echo "Portal stack deployed. Rollback: re-run this job, or re-point .env at the digests in " +
           "/home/options-edge/deploy/bugzilla-req/last-known-good.env.prev — never rebuild to roll back."
    }
    failure {
      echo "Portal deploy FAILED. Diagnostics were captured before any LKG redeploy; see the log above."
    }
  }
}
